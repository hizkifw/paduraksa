<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PaduraksaKeyMaterialBoundary>true</PaduraksaKeyMaterialBoundary>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Paduraksa.Core/Paduraksa.Core.csproj" />
    <ProjectReference Include="../Paduraksa.Storage/Paduraksa.Storage.csproj" />
  </ItemGroup>
  <!-- Trust boundary: everything internal; only capability interfaces from Core are exposed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Argon2id for the backup passphrase (docs/design/vault-and-certificates.md "Backup and restore (M10)"); nothing outside the vault may reference it (BackupBoundaryTests). -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <!-- For `dotnet ef` (design time only; doesn't flow to referencing projects). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <InternalsVisibleTo Include="Paduraksa.Tests.Vault" />
    <!-- The backup archive reader, the manifest parser and the certificate import are fuzz targets (fuzz/README.md): they read what an attacker or an admin hands the vault. -->
    <InternalsVisibleTo Include="Paduraksa.Fuzz.Targets" />
  </ItemGroup>
</Project>
