@using Paduraksa.Contracts.Logging
@inject DisplayFormat Fmt
@* A request's stages on one axis from 0 to its total, each bar at its own start (RequestWaterfall). *@
@if (_stages.Count > 0)
{
    <ul class="pdk-waterfall" data-waterfall="@Entry.Sequence" aria-label="Time by stage">
        @for (var i = 0; i < _stages.Count; i++)
        {
            var stage = _stages[i];
            var tip = $"wf-{Entry.Sequence}-{i}";
            <li class="pdk-waterfall-row" data-stage="@stage.Key" data-derived="@(stage.Derived ? "true" : null)" tabindex="0" aria-describedby="@tip">
                <span class="pdk-waterfall-label">@stage.Label</span>
                <span class="pdk-waterfall-track">
                    <span class="@BarClass(stage)" style="@RequestWaterfall.Geometry(stage, _scale)" aria-hidden="true"></span>
                </span>
                <span class="pdk-waterfall-value">@Fmt.Duration(stage.ShownMs)</span>
                <span class="pdk-waterfall-tip" id="@tip">
                    <span class="pdk-chart-tip-time">@stage.Label</span>
                    <span class="pdk-chart-tip-row"><span class="pdk-chart-tip-name">Start</span><span class="pdk-chart-tip-value" data-tip="start">@Fmt.Duration(stage.StartMs)</span></span>
                    <span class="pdk-chart-tip-row"><span class="pdk-chart-tip-name">Duration</span><span class="pdk-chart-tip-value" data-tip="duration">@Fmt.Duration(stage.ShownMs)</span></span>
                    <span class="pdk-waterfall-note" data-tip="note">@stage.Note</span>
                </span>
            </li>
        }
        <li class="pdk-waterfall-scale" aria-hidden="true">
            <span class="pdk-waterfall-axis"><span>@Fmt.Duration(0)</span><span>@Fmt.Duration(_scale)</span></span>
        </li>
    </ul>
}

@code {
    private IReadOnlyList<WaterfallStage> _stages = [];
    private double _scale;

    private static string BarClass(WaterfallStage stage) =>
        stage.Derived ? $"pdk-waterfall-bar pdk-waterfall-derived pdk-waterfall-{stage.Key}" : $"pdk-waterfall-bar pdk-waterfall-{stage.Key}";

    [Parameter, EditorRequired]
    public LogTailEntry Entry { get; set; } = default!;

    protected override void OnParametersSet()
    {
        _stages = RequestWaterfall.Stages(Entry);
        _scale = RequestWaterfall.Scale(Entry, _stages);
    }
}
