@* Runs one ACME issuance or renewal and shows its live progress, pushed to this component's dispatcher (no polling). The
   run belongs to the server: closing the page doesn't stop it. *@
@implements IDisposable

<OrderProgressView ChallengeType="ChallengeType" Reports="_reports" Attempts="Attempts" Now="_now" />

@if (_errors.Count > 0)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="pdk-form-alert mt-3">
        @foreach (string error in _errors)
        {
            <div>@error</div>
        }
    </MudAlert>
}

@code {
    private readonly List<AcmeOrderProgress> _reports = [];
    private List<string> _errors = [];
    private DateTimeOffset _now;
    private bool _started;
    private volatile bool _disposed;
    private Timer? _ticker;

    /// <summary>Starts the run with the reporter it should tell (the page binds it to the issuance service).</summary>
    [Parameter, EditorRequired]
    public Func<IProgress<AcmeOrderProgress>, Task<IssuanceResult>> Start { get; set; } = default!;

    [Parameter, EditorRequired]
    public AcmeChallengeType ChallengeType { get; set; }

    [Parameter]
    public int? Attempts { get; set; }

    /// <summary>When the run ended (issued, failed or refused).</summary>
    [Parameter]
    public EventCallback<IssuanceResult> Finished { get; set; }

    [Inject]
    private TimeProvider Time { get; set; } = default!;

    [Inject]
    private Microsoft.Extensions.Logging.ILogger<AcmeRunPanel> Logger { get; set; } = default!;

    /// <summary>Whether the run is still going.</summary>
    public bool Running { get; private set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_started)
        {
            return;
        }

        _started = true;
        Running = true;
        _now = Time.GetUtcNow();
        // Only the elapsed time line ticks; the steps arrive as the service reports them.
        _ticker = new Timer(_ => _ = Tick(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        IssuanceResult result;
        string? failure = null;
        try
        {
            result = await Start(new Reporter(this));
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            // Thrown before the service could answer (the store busy as the run was set up): said here, not by the page's error boundary.
            Logger.LogStoreFailure(ex, "An ACME run failed before it could report how it ended.");
            failure = StoreFailures.Message("The run didn't get going.");
            result = new IssuanceResult(IssuanceOutcome.Unavailable);
        }
        finally
        {
            Running = false;
            _ticker?.Dispose();
            _ticker = null;
        }

        if (_disposed)
        {
            return;
        }

        if (failure is not null)
        {
            _errors = [failure];
        }
        else if (result.Outcome is not (IssuanceOutcome.Issued or IssuanceOutcome.Failed))
        {
            _errors = [.. CertificateMessages.Errors(result)];
        }

        await Finished.InvokeAsync(result);
    }

    public void Dispose()
    {
        _disposed = true;
        _ticker?.Dispose();
    }

    private async Task Tick()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                _now = Time.GetUtcNow();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The circuit went away.
        }
    }

    private void Add(AcmeOrderProgress report)
    {
        if (!_disposed)
        {
            _ = AddAsync(report);
        }
    }

    private async Task AddAsync(AcmeOrderProgress report)
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }

                _reports.Add(report);
                _now = Time.GetUtcNow();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The circuit went away.
        }
    }

    /// <summary>Passes the service's reports to the component; never throws back into the issuance.</summary>
    private sealed class Reporter(AcmeRunPanel panel) : IProgress<AcmeOrderProgress>
    {
        public void Report(AcmeOrderProgress value) => panel.Add(value);
    }
}
