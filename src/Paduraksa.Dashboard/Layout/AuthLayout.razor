@inherits LayoutComponentBase
@* The sign-in and setup pages: plain HTML on the dashboard's colours (app.css), centred, no script needed. *@

<div class="pdk-auth">
    <main class="pdk-auth-card">
        <div class="pdk-auth-brand">
            <BrandMark Size="34" Class="pdk-auth-mark" />
            <div>
                <div class="pdk-auth-product">Paduraksa</div>
                <div class="pdk-auth-tagline">Reverse proxy and gate</div>
            </div>
        </div>
        @Body
    </main>
</div>
