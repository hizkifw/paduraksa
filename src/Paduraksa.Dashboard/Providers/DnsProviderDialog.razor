@* The dialog around the DNS provider form: add one, or replace one's credential. *@
@inject ProviderActions Actions
@inject ISnackbar Snackbar

<MudDialog Class="pdk-dialog" ContentClass="pdk-dialog-content">
    <TitleContent>
        <div class="pdk-dialog-title">
            <span class="pdk-dialog-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Dns" Size="Size.Small" /></span>
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2">@(RotateFor is null ? "Add a DNS provider" : $"Replace the token of {RotateFor.Label}")</MudText>
                <MudText Typo="Typo.caption" Class="pdk-muted">For DNS-01: TXT records are written through its API while a certificate is validated.</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <DnsProviderForm Submit="SubmitAsync" RotateFor="RotateFor" Saved="Saved" OnCancel="() => Dialog?.Cancel()" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter]
    public DnsProviderSummary? RotateFor { get; set; }

    private Task<DnsProviderResult?> SubmitAsync(DnsCredentialSubmission submission) =>
        RotateFor is { } provider ? Actions.RotateCredentialAsync(provider.Id, submission) : Actions.CreateProviderAsync(submission);

    private void Saved(DnsProviderSummary provider)
    {
        Snackbar.Add(RotateFor is null ? $"{provider.Label} was added." : "The token was replaced.", Severity.Success);
        Dialog?.Close(DialogResult.Ok(provider));
    }

    public static Task<IDialogReference> ShowAsync(IDialogService dialogs, DnsProviderSummary? rotate = null)
    {
        ArgumentNullException.ThrowIfNull(dialogs);
        return dialogs.ShowAsync<DnsProviderDialog>(rotate is null ? "Add a DNS provider" : "Replace the token",
            new DialogParameters<DnsProviderDialog> { { d => d.RotateFor, rotate } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
    }
}
