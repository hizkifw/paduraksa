@* Add a DNS provider for DNS-01 (Cloudflare or deSEC), or replace its credential. The credential is write-only: a
   password field, emptied as the form is sent, usable only against the provider's own API host, never shown again. *@
@using Microsoft.Extensions.Logging
@inject ILogger<DnsProviderForm> Logger

<div class="pdk-form-stack">
    @if (RotateFor is null)
    {
        <div class="pdk-choice-grid" role="radiogroup" aria-label="Provider">
            @foreach (DnsProviderKind kind in Kinds)
            {
                <button type="button" class="pdk-choice pdk-dns-kind-@kind.ToName() @(_kind == kind ? "pdk-choice-on" : null)" role="radio"
                        aria-checked="@(_kind == kind ? "true" : "false")" disabled="@_busy" @onclick="() => _kind = kind">
                    <MudIcon Icon="@ProviderDisplay.KindIcon(kind)" Size="Size.Small" />
                    <span class="pdk-choice-title">@ProviderDisplay.KindLabel(kind)</span>
                    <span class="pdk-choice-hint">Sent only to @DnsProviderService.ApiHostOf(kind)</span>
                </button>
            }
        </div>
        <MudTextField T="string" @bind-Value="_label" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="DnsProviderService.MaxLabelLength"
                      Placeholder="@($"{ProviderDisplay.KindLabel(_kind)} - example.com")" Error="_labelError is not null" ErrorText="@_labelError"
                      Disabled="_busy" Class="pdk-dns-label" />
    }

    <MudTextField T="string" @bind-Value="_credential" Label="@(RotateFor is null ? "API token" : "New API token")" Variant="Variant.Outlined" Margin="Margin.Dense"
                  InputType="InputType.Password" autocomplete="off" Error="_credentialError is not null" ErrorText="@_credentialError" Disabled="_busy"
                  HelperText="@ProviderDisplay.CredentialHint(RotateFor?.Kind ?? _kind)" Class="pdk-dns-credential" />
    <div class="pdk-secret-note">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
        <span>Stored in the vault and usable only against @DnsProviderService.ApiHostOf(RotateFor?.Kind ?? _kind). It is never shown again.</span>
    </div>

    @if (_errors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="pdk-form-alert">
            @foreach (string error in _errors)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    <div class="pdk-form-actions">
        @if (OnCancel.HasDelegate)
        {
            <MudButton Variant="Variant.Text" OnClick="OnCancel" Disabled="_busy">@CancelText</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy" Class="pdk-dns-submit">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            @(RotateFor is null ? SubmitText : "Replace the token")
        </MudButton>
    </div>
</div>

@code {
    private static readonly DnsProviderKind[] Kinds = [DnsProviderKind.Cloudflare, DnsProviderKind.DeSec];

    private DnsProviderKind _kind = DnsProviderKind.Cloudflare;
    private string? _label;
    private string? _credential;
    private string? _labelError;
    private string? _credentialError;
    private bool _busy;
    private List<string> _errors = [];

    /// <summary>Adds the provider, or replaces <see cref="RotateFor"/>'s credential (the page wires it to the service).</summary>
    [Parameter, EditorRequired]
    public Func<DnsCredentialSubmission, Task<DnsProviderResult?>> Submit { get; set; } = default!;

    /// <summary>The provider whose credential is replaced; null to add a new one.</summary>
    [Parameter]
    public DnsProviderSummary? RotateFor { get; set; }

    [Parameter]
    public EventCallback<DnsProviderSummary> Saved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Add provider";

    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _errors = [];
        string label = RotateFor?.Label ?? (string.IsNullOrWhiteSpace(_label) ? $"{ProviderDisplay.KindLabel(_kind)}" : _label.Trim());
        _labelError = null;
        _credentialError = string.IsNullOrWhiteSpace(_credential) ? "Paste the provider's API token." : null;
        if (_credentialError is not null)
        {
            return;
        }

        // The token leaves the component's state before anything is awaited, and lives on only in this array until the call is done.
        char[] credential = _credential!.Trim().ToCharArray();
        _credential = null;
        _busy = true;
        DnsProviderResult? result;
        try
        {
            result = await Submit(new DnsCredentialSubmission(RotateFor?.Kind ?? _kind, label, credential));
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't save a DNS provider.");
            _errors = [StoreFailures.Message("The provider couldn't be saved."), "Paste the API token again to retry."];
            return;
        }
        finally
        {
            Array.Clear(credential);
            _busy = false;
        }

        if (result is { Status: IssuanceChangeStatus.Committed, Provider: { } provider })
        {
            _label = null;
            await Saved.InvokeAsync(provider);
        }
        else if (result is not null)
        {
            _errors = [.. CertificateMessages.Errors(result.Status, result.Errors, null, "DNS providers")];
        }
    }
}
