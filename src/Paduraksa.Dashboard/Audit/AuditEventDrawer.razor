@using Paduraksa.Contracts.Audit
@using Paduraksa.Contracts.Identity

<DrawerShell Title="@AuditText.Describe(Event.Action)" Subtitle="@RevisionText.Exact(Event.Timestamp)"
             Icon="@Icons.Material.Outlined.FactCheck" IconTone="AuditText.ToneOf(Event.Outcome)" Name="audit-event">
    <ChildContent>
        <div class="pdk-audit-event" data-detail="@Event.Id">
            <div class="pdk-detail-chips">
                <StatusChip Tone="AuditText.ToneOf(Event.Outcome)" Dot="true" Text="@AuditText.Name(Event.Outcome)" Name="outcome" />
                <StatusChip Tone="AuditText.AreaTone(Event.Action)" Class="pdk-mono" Text="@Event.Action" Name="action" />
            </div>
            <dl class="pdk-facts">
                <div class="pdk-fact"><dt>Who</dt><dd>@Actor</dd></div>
                <div class="pdk-fact"><dt>When</dt><dd>@RevisionText.Exact(Event.Timestamp)</dd></div>
                <div class="pdk-fact"><dt>Channel</dt><dd>@RevisionText.Channel(Event.Channel)</dd></div>
                @if (Event.ClientIp is { } ip)
                {
                    <div class="pdk-fact"><dt>Client</dt><dd class="pdk-mono">@ip</dd></div>
                }
                @if (Event.Target is { } target)
                {
                    <div class="pdk-fact">
                        <dt>Target</dt>
                        <dd class="pdk-mono">
                            @if (AuditText.LinkOf(target) is { } link)
                            {
                                <a href="@link" class="pdk-row-link">@target</a>
                            }
                            else
                            {
                                @target
                            }
                        </dd>
                    </div>
                }
                @if (Event.RevisionId is { } revision)
                {
                    <div class="pdk-fact"><dt>Revision</dt><dd><a href="@DashboardRoutes.Revision(revision)" class="pdk-row-link pdk-mono">@revision</a></dd></div>
                }
                <div class="pdk-fact"><dt>Event</dt><dd class="pdk-mono">@Event.Id</dd></div>
            </dl>
            <FormSection Title="Details" Name="details">
                @if (Event.Details is { } details)
                {
                    <pre class="pdk-json" data-details="@Event.Id">@AuditText.Pretty(details)</pre>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="pdk-muted">No further details.</MudText>
                }
            </FormSection>
        </div>
    </ChildContent>
</DrawerShell>

@code {
    [Parameter, EditorRequired]
    public AuditEventSummary Event { get; set; } = default!;

    /// <summary>Who did it, in words (a name where the page may read it).</summary>
    [Parameter, EditorRequired]
    public string Actor { get; set; } = string.Empty;

    /// <summary>The parameters for <see cref="DrawerStack.Push{TComponent}"/>.</summary>
    public static IReadOnlyDictionary<string, object?> For(AuditEventSummary auditEvent, string actor) =>
        new Dictionary<string, object?> { [nameof(Event)] = auditEvent, [nameof(Actor)] = actor };
}
