@implements IDisposable
@using Paduraksa.Contracts.Certificates
@using Paduraksa.Dashboard.Certificates
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject ISnackbar Snackbar
@inject ILogger<HostDrawer> Logger
@* A host in a drawer (PLAN §12): the form, and Review changes on top of it. "New upstream..." and "New profile..." stack the other form
   and stage what it makes into this host's draft: the host and the objects it needs are reviewed and applied as one revision, and
   cancelling the host leaves nothing behind. "New certificate..." stacks the certificate flow, which issues or uploads at once (a
   certificate lives in the vault, not in the config) and comes back with it selected. Hands back the commit's result when applied. *@

<DrawerShell Title="@Title" Overline="@(_model is { IsNew: true } ? "New host" : "Host")" Subtitle="@Subtitle" Icon="@Icons.Material.Outlined.Language"
             Name="host" OnSubmit="ReviewAsync">
    <HeaderActions>
        @if (_model is { IsNew: false } && _maySimulate)
        {
            <MudTooltip Text="Simulate a request" Placement="Placement.Bottom">
                <MudIconButton Href="@SimulateHref" Icon="@Icons.Material.Outlined.Science" Size="Size.Small" aria-label="Simulate a request" />
            </MudTooltip>
        }
    </HeaderActions>
    <Banner>
        @if (_changedElsewhere is { } elsewhere)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" data-banner="changed">
                This host was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
            </MudAlert>
        }
        @if (_failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-alert="load-failed">
                The host couldn't be read. The details are in the server log.
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
            </MudAlert>
        }
        @if (_denied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">Your role can't read the config. An Owner can give you the Viewer role or another that can.</MudAlert>
        }
        else if (!_mayWrite && _model is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: your role can see this host but not change it.</MudAlert>
        }
    </Banner>
    <ChildContent>
        @if (_missing)
        {
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such host" Description="It may have been deleted, or the link is wrong." />
        }
        else if (_model is null || _current is null)
        {
            @if (!_failed && !_denied)
            {
                <div class="pdk-form" aria-busy="true">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="pdk-section">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="24px" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" Class="mt-2" />
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <HostForm Model="_model" Upstreams="Draft.Upstreams" Staged="StagedUpstreamIds" Profiles="Draft.Profiles" StagedProfiles="StagedProfileIds"
                      Certificates="_certificates" InheritedForceHttps="InheritedForceHttps" Errors="_errors" ShowAll="_attempted" ReadOnly="!_mayWrite"
                      OnChanged="Changed"
                      OnNewUpstream="@(_mayWrite ? EventCallback.Factory.Create<RouteEntry>(this, NewUpstreamAsync) : default)"
                      OnNewProfile="@(_mayWrite ? EventCallback.Factory.Create(this, NewProfileAsync) : default)"
                      OnNewCertificate="@(_mayWrite && _mayWriteCertificates ? EventCallback.Factory.Create(this, NewCertificateAsync) : default)" />
            @if (_staged.Count > 0 || _stagedProfiles.Count > 0)
            {
                <div class="pdk-staged" data-section="staged">
                    <div class="pdk-staged-head">
                        <MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" />
                        <span>Made here, applied with this host in one revision when it uses them. Cancel the host and they go too.</span>
                    </div>
                    <ul class="pdk-staged-list">
                        @foreach (UpstreamConfig upstream in _staged)
                        {
                            bool used = _model.Kind == HostKind.Proxy && _model.Routes.Any(r => r.UpstreamId == upstream.Id);
                            <li data-staged="@upstream.Name" data-used="@(used ? "true" : "false")" class="@(used ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Small" />
                                <span class="pdk-staged-name">@upstream.Name</span>
                                <span class="pdk-staged-detail pdk-mono">@HostOverview.AddressOf(upstream)</span>
                                @if (!used)
                                {
                                    <StatusChip Text="Won't be created: no route uses it" Name="staged-unused" />
                                }
                                @if (_stagedUpstreamErrors.ContainsKey(upstream.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (_mayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedUpstreamAsync(upstream)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                        @foreach (ProfileConfig profile in _stagedProfiles)
                        {
                            bool picked = _model.ProfileId == profile.Id;
                            <li data-staged="@profile.Name" data-used="@(picked ? "true" : "false")" class="@(picked ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" />
                                <span class="pdk-staged-name">@profile.Name</span>
                                <span class="pdk-staged-detail">profile</span>
                                @if (!picked)
                                {
                                    <StatusChip Text="Won't be created: the host doesn't pick it" Name="staged-unused" />
                                }
                                @if (_stagedProfileErrors.ContainsKey(profile.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (_mayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedProfileAsync(profile)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <div class="pdk-drawer-actions">
            @if (_model is { IsNew: false } && _mayWrite)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="ReviewDeleteAsync" data-action="delete"
                           Class="pdk-drawer-actions-start">Delete</MudButton>
            }
            @if (_mayWrite && _model is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="Cancel" data-action="cancel">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">
                    Review changes
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cancel" data-action="cancel">Close</MudButton>
            }
        </div>
    </Footer>
</DrawerShell>

@code {
    private HostEditModel? _model;
    private CurrentConfig? _current;
    private HostConfig? _stored;
    private IReadOnlyList<CertificateSummary>? _certificates;
    private readonly List<UpstreamConfig> _staged = [];
    private readonly List<ProfileConfig> _stagedProfiles = [];

    // The dry run's errors about a staged object (relative to it), shown at its fields when it is opened again.
    private readonly Dictionary<UpstreamId, IReadOnlyDictionary<string, string>> _stagedUpstreamErrors = [];
    private readonly Dictionary<ProfileId, IReadOnlyDictionary<string, string>> _stagedProfileErrors = [];
    private ConfigDocument? _reviewed;
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, string> _serverErrors = new Dictionary<string, string>();
    private string _opened = string.Empty;
    private bool _attempted;
    private bool _mayWrite;
    private bool _maySimulate;
    private bool _mayWriteCertificates;
    private bool _denied;
    private bool _missing;
    private bool _failed;
    private bool _reviewing;
    private RevisionRef? _changedElsewhere;
    private IDisposable? _watch;

    [CascadingParameter]
    private DrawerLevel? Level { get; set; }

    /// <summary>The host to edit; null for a new one.</summary>
    [Parameter]
    public HostId? Id { get; set; }

    private string Title => _missing ? "Host not found" : _model is null ? (Id is null ? "New host" : "Host") : _model.IsNew ? "New host" : ChangeView.HostTitle(_stored ?? _model.ToConfig());

    private string Subtitle => _model is { IsNew: true } || Id is null
        ? "Give a service on your network a name. Nothing changes until you review and apply."
        : "Every change is reviewed as a diff before it goes live, and can be undone.";

    /// <summary>The config as the form sees it: what is stored, and what was made in this drawer.</summary>
    private ConfigDocument Draft => StagedChange.Draft(_current?.Document ?? new ConfigDocument(), _staged, _stagedProfiles);

    private HashSet<UpstreamId> StagedUpstreamIds => [.. _staged.Select(u => u.Id)];

    private HashSet<ProfileId> StagedProfileIds => [.. _stagedProfiles.Select(p => p.Id)];

    private string? SampleHost => _model?.Names.Select(n => n.Value.Trim()).FirstOrDefault(n => n.Length > 0 && !n.StartsWith('*'));

    private string SimulateHref => SampleHost is { } host ? $"{DashboardRoutes.Simulator}?url={Uri.EscapeDataString($"https://{host}/")}" : DashboardRoutes.Simulator;

    private bool InheritedForceHttps =>
        (_model?.ProfileId is { } profile ? Draft.Profiles.FirstOrDefault(p => p.Id == profile)?.Settings.ForceHttps : null)
        ?? _current?.Document.Settings.Defaults.ForceHttps
        ?? false;

    protected override async Task OnInitializedAsync()
    {
        _watch = Config.Watch(committed => InvokeAsync(() => OnCommittedAsync(committed)));
        await LoadAsync();
    }

    public void Dispose() => _watch?.Dispose();

    private async Task LoadAsync()
    {
        _failed = false;
        _changedElsewhere = null;
        _attempted = false;
        _serverErrors = new Dictionary<string, string>();
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        _maySimulate = user.Has(Permission.Simulate);
        _mayWriteCertificates = user.Has(Permission.CertificatesWrite);
        try
        {
            _current = await Config.GetCurrentAsync();
            _certificates = user.Has(Permission.CertificatesRead) ? await Config.ListCertificatesAsync() : null;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            // The form keeps what it shows (edits included); the alert offers another try.
            Logger.LogStoreFailure(ex, "Couldn't load the host form.");
            _failed = true;
            return;
        }

        if (Id is { } hostId)
        {
            if (_current.Document.Hosts.FirstOrDefault(h => h.Id == hostId) is not { } host)
            {
                _missing = true;
                return;
            }

            _stored = host;
            _model = HostEditModel.From(host);
        }
        else
        {
            _model = HostEditModel.New(_current.Document.Upstreams.Count == 1 ? _current.Document.Upstreams[0].Id : null);
        }

        _staged.Clear();
        _stagedProfiles.Clear();
        _stagedUpstreamErrors.Clear();
        _stagedProfileErrors.Clear();
        _opened = Fingerprint();
        Validate();
    }

    private string Fingerprint() =>
        _model is null ? string.Empty : StagedChange.Fingerprint(new ConfigDocument(Upstreams: [.. _staged], Profiles: [.. _stagedProfiles], Hosts: [_model.ToConfig()]));

    private void Changed()
    {
        Validate();
        if (Level is not null && _model is not null)
        {
            Level.IsDirty = Fingerprint() != _opened;
        }
    }

    private void Validate()
    {
        if (_model is null || _current is null)
        {
            return;
        }

        IReadOnlyDictionary<string, string> inline = InlineValidation.ForHost(Draft, _model.ToConfig());
        Dictionary<string, string> merged = new(_serverErrors, StringComparer.Ordinal);
        foreach ((string path, string message) in inline)
        {
            merged[path] = message;
        }

        _errors = merged;
        _serverErrors = new Dictionary<string, string>();
    }

    private async Task NewUpstreamAsync(RouteEntry route)
    {
        string? basis = SampleHost?.Split('.')[0];
        DrawerResult result = await Drawers.OpenAsync<UpstreamDrawer>(
            new Dictionary<string, object?>
            {
                [nameof(UpstreamDrawer.Stage)] = true,
                [nameof(UpstreamDrawer.Draft)] = Draft,
                [nameof(UpstreamDrawer.SuggestedName)] = basis is { Length: > 0 } ? UpstreamDrawer.UniqueName(Draft, basis) : null,
            },
            DrawerWidth.Medium);
        if (result.As<UpstreamConfig>() is { } upstream && _model?.Routes.Contains(route) == true)
        {
            _staged.Add(upstream);
            route.UpstreamId = upstream.Id;
            Changed();
        }
    }

    private async Task NewProfileAsync()
    {
        DrawerResult result = await Drawers.OpenAsync<ProfileDrawer>(
            new Dictionary<string, object?> { [nameof(ProfileDrawer.Stage)] = true, [nameof(ProfileDrawer.Draft)] = Draft },
            DrawerWidth.Medium);
        if (result.As<ProfileConfig>() is { } profile && _model is not null)
        {
            _stagedProfiles.Add(profile);
            _model.ProfileId = profile.Id;
            Changed();
        }
    }

    private async Task NewCertificateAsync()
    {
        if (_model is null)
        {
            return;
        }

        string[] names = [.. _model.Names.Select(n => n.Value.Trim().TrimEnd('.').ToLowerInvariant()).Where(n => n.Length > 0)];
        DrawerResult result = await Drawers.OpenAsync<CertificateCreateDrawer>(
            new Dictionary<string, object?> { [nameof(CertificateCreateDrawer.InitialNames)] = names },
            DrawerWidth.Medium);
        if (result.As<CertificateSummary>() is not { } certificate)
        {
            return;
        }

        await Logger.TryAsync(Snackbar, "Couldn't read the certificates again.", async () => _certificates = await Config.ListCertificatesAsync());
        if (HostOverview.IsUsable(certificate))
        {
            _model.CertificateMode = CertificateBindingMode.Specific;
            _model.CertificateId = certificate.Id;
        }
        else
        {
            _model.CertificateMode = CertificateBindingMode.Auto;
            _model.CertificateId = null;
            Snackbar.Add($"{CertificateDisplay.DisplayName(certificate)} isn't issued yet: Automatic picks it up once it is.", Severity.Info);
        }

        Changed();
    }

    private async Task ReviewAsync()
    {
        if (_model is null || !_mayWrite || _reviewing)
        {
            return;
        }

        _attempted = true;
        Validate();
        if (_errors.Count > 0)
        {
            return;
        }

        HostConfig host = _model.ToConfig();
        IReadOnlyList<UpstreamConfig> upstreams = StagedChange.UsedUpstreams(host, _staged);
        IReadOnlyList<ProfileConfig> profiles = StagedChange.UsedProfiles(host, _stagedProfiles);
        string name = ChangeView.HostTitle(host);
        ReviewRequest request;
        if (upstreams.Count == 0 && profiles.Count == 0)
        {
            request = new ReviewRequest(_model.IsNew ? $"New host {name}" : $"Edit {name}", new UpsertHostCommand(host));
        }
        else
        {
            // One revision for the host and what was made for it: a replace of the latest document, after the same version check an
            // object command makes (a host changed elsewhere since the form opened is a conflict, not something to overwrite).
            CurrentConfig head;
            try
            {
                head = await Config.GetCurrentAsync();
            }
            catch (Exception ex) when (StoreFailures.Survivable(ex))
            {
                Logger.LogStoreFailure(ex, "Couldn't read the config to review a host.");
                Snackbar.Add(StoreFailures.Message("The change couldn't be reviewed."), Severity.Error);
                return;
            }

            if (!_model.IsNew && head.Document.Hosts.FirstOrDefault(h => h.Id == _model.Id)?.Version != _model.Version)
            {
                _changedElsewhere = head.Revision;
                Snackbar.Add($"{name} was changed elsewhere since you opened it. Reload to start from the new version.", Severity.Warning);
                return;
            }

            ConfigDocument after = StagedChange.Apply(head.Document, host, upstreams, profiles);
            string with = string.Join(" and ", [.. upstreams.Select(u => $"upstream {u.Name}"), .. profiles.Select(p => $"profile {p.Name}")]);
            _reviewed = after;
            request = new ReviewRequest(_model.IsNew ? $"New host {name}" : $"Edit {name}", new ReplaceConfigCommand(after, head.Revision?.Id)
            {
                Message = $"{(_model.IsNew ? "New host" : "Edit")} {name} with {with}",
            })
            {
                AfterDocument = after,
                OnInvalidDocument = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalidDocument),
            };
        }

        await RunReviewAsync(request with
        {
            SuccessMessage = _model.IsNew ? $"Created {name}" : $"Saved {name}",
            SampleHost = SampleHost,
            OnInvalid = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalid),
        });
    }

    private async Task ReviewDeleteAsync()
    {
        if (_model is null || _model.IsNew || !_mayWrite || _stored is null)
        {
            return;
        }

        string name = ChangeView.HostTitle(_stored);
        await RunReviewAsync(new ReviewRequest($"Delete {name}", new DeleteHostCommand(_model.Id, _model.Version))
        {
            ApplyLabel = "Delete",
            Destructive = true,
            SuccessMessage = $"Deleted {name}",
        });
    }

    private async Task RunReviewAsync(ReviewRequest request)
    {
        _reviewing = true;
        ReviewOutcome outcome;
        try
        {
            outcome = await Drawers.ReviewAsync(request);
        }
        finally
        {
            _reviewing = false;
        }

        if (outcome.Applied is { } applied)
        {
            Level?.Close(applied);
        }
        else if (outcome.Reload)
        {
            if (request.Command is ReplaceConfigCommand)
            {
                // What was staged stays: the review is made again on the latest config (and checks this host's version again).
                await ReviewAsync();
            }
            else
            {
                await ReloadAsync();
            }
        }
    }

    /// <summary>
    /// The dry run refused the one revision of the host and what was staged with it: the host's errors go to its fields, a staged object's
    /// are kept for it (marked "Needs a fix", and shown at its fields when it is opened again).
    /// </summary>
    private void OnInvalidDocument(IReadOnlyList<ConfigError> errors)
    {
        if (_reviewed is not { } document || _model is null)
        {
            return;
        }

        int host = document.Hosts.ToList().FindIndex(h => h.Id == _model.Id);
        if (host >= 0)
        {
            OnInvalid([.. errors.Where(e => e.Path.StartsWith($"/hosts/{host}/", StringComparison.Ordinal) || e.Path == $"/hosts/{host}")
                .Select(e => e with { Path = e.Path[$"/hosts/{host}".Length..] })]);
        }

        for (int i = 0; i < document.Upstreams.Count; i++)
        {
            if (_staged.Any(u => u.Id == document.Upstreams[i].Id) && InlineValidation.Relative(errors, $"/upstreams/{i}") is { Count: > 0 } found)
            {
                _stagedUpstreamErrors[document.Upstreams[i].Id] = found;
            }
        }

        for (int i = 0; i < document.Profiles.Count; i++)
        {
            if (_stagedProfiles.Any(p => p.Id == document.Profiles[i].Id) && InlineValidation.Relative(errors, $"/profiles/{i}") is { Count: > 0 } found)
            {
                _stagedProfileErrors[document.Profiles[i].Id] = found;
            }
        }
    }

    private async Task EditStagedUpstreamAsync(UpstreamConfig staged)
    {
        DrawerResult result = await Drawers.OpenAsync<UpstreamDrawer>(
            new Dictionary<string, object?>
            {
                [nameof(UpstreamDrawer.Stage)] = true,
                [nameof(UpstreamDrawer.Draft)] = Draft,
                [nameof(UpstreamDrawer.Staged)] = staged,
                [nameof(UpstreamDrawer.Errors)] = _stagedUpstreamErrors.GetValueOrDefault(staged.Id),
            },
            DrawerWidth.Medium);
        if (result.As<UpstreamConfig>() is { } edited && _staged.FindIndex(u => u.Id == staged.Id) is >= 0 and var index)
        {
            _staged[index] = edited;
            _stagedUpstreamErrors.Remove(staged.Id);
            Changed();
        }
    }

    private async Task EditStagedProfileAsync(ProfileConfig staged)
    {
        DrawerResult result = await Drawers.OpenAsync<ProfileDrawer>(
            new Dictionary<string, object?>
            {
                [nameof(ProfileDrawer.Stage)] = true,
                [nameof(ProfileDrawer.Draft)] = Draft,
                [nameof(ProfileDrawer.Staged)] = staged,
                [nameof(ProfileDrawer.Errors)] = _stagedProfileErrors.GetValueOrDefault(staged.Id),
            },
            DrawerWidth.Medium);
        if (result.As<ProfileConfig>() is { } edited && _stagedProfiles.FindIndex(p => p.Id == staged.Id) is >= 0 and var index)
        {
            _stagedProfiles[index] = edited;
            _stagedProfileErrors.Remove(staged.Id);
            Changed();
        }
    }

    private void OnInvalid(IReadOnlyList<ConfigError> errors)
    {
        _serverErrors = InlineValidation.Relative(errors, string.Empty);
        _attempted = true;
        Dictionary<string, string> merged = new(_errors, StringComparer.Ordinal);
        foreach ((string path, string message) in _serverErrors)
        {
            merged[path] = message;
        }

        _errors = merged;
    }

    private async Task ReloadAsync()
    {
        _model = null;
        _stored = null;
        await LoadAsync();
        if (Level is not null)
        {
            Level.IsDirty = false;
        }
    }

    private void Cancel() => Level?.RequestClose();

    private async Task OnCommittedAsync(ConfigCommitted committed)
    {
        if (_reviewing || _model is null)
        {
            return;
        }

        if (!_model.IsNew && committed.Changes.Any(c => (c is HostChange h && h.HostId == _model.Id) || (c is RouteChange r && r.HostId == _model.Id)))
        {
            _changedElsewhere = committed.Revision;
        }

        // The pickers offer what exists now (an upstream added in another tab); the form keeps the version it opened with.
        try
        {
            _current = await Config.GetCurrentAsync();
            Validate();
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't refresh the host form's choices.");
        }

        StateHasChanged();
    }
}
