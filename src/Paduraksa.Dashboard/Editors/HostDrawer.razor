@using Paduraksa.Application.Compilation
@using Paduraksa.Contracts.Certificates
@using Paduraksa.Dashboard.Certificates
@using Microsoft.Extensions.Logging
@inject ILogger<HostDrawer> Logger
@inherits DraftDrawer<HostEditModel, HostConfig>

@* A host in a drawer: the form, with Review changes on top. "New upstream...", "New profile..." and "New certificate..."
   stack their own flows: the host and the config objects it needs are reviewed and applied as one revision, while a
   certificate (a vault object) is issued or uploaded at once. *@

<DrawerShell Title="@Title" Icon="@Icons.Material.Outlined.Language"
             Name="host" OnSubmit="ReviewAsync">
    <HeaderActions>
        @if (Model is { IsNew: false, Kind: not HostKind.Admin } && MayWrite)
        {
            <MudTooltip Text="@(InMaintenance ? "End maintenance (then review the change)" : "Put in maintenance (then review the change)")" Placement="Placement.Bottom">
                <MudIconButton Icon="@(InMaintenance ? Icons.Material.Filled.Construction : Icons.Material.Outlined.Construction)" Size="Size.Small"
                               Color="@(InMaintenance ? Color.Warning : Color.Default)" OnClick="ToggleMaintenance" data-action="maintenance"
                               aria-label="@(InMaintenance ? "End maintenance" : "Put in maintenance")" />
            </MudTooltip>
        }
        @if (Model is { IsNew: false } && _maySimulate)
        {
            <MudTooltip Text="Simulate a request" Placement="Placement.Bottom">
                <MudIconButton Href="@SimulateHref" Icon="@Icons.Material.Outlined.Science" Size="Size.Small" aria-label="Simulate a request" />
            </MudTooltip>
        }
    </HeaderActions>
    <Banner>
        @if (ChangedElsewhere is { } elsewhere)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" data-banner="changed">
                This host was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
            </MudAlert>
        }
        @if (Failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-alert="load-failed">
                The host couldn't be read. The details are in the server log.
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
            </MudAlert>
        }
        @if (Denied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@IdentityText.CantReadConfig. @IdentityText.CantReadConfigHelp</MudAlert>
        }
        else if (!MayWrite && Model is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: your role can see this host but not change it.</MudAlert>
        }
    </Banner>
    <ChildContent>
        @if (Missing)
        {
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such host" Description="It may have been deleted, or the link is wrong." />
        }
        else if (Model is null || _current is null)
        {
            @if (!Failed && !Denied)
            {
                <div class="pdk-form" aria-busy="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="pdk-section">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="24px" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" Class="mt-2" />
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <HostForm Model="Model" Upstreams="DraftDocument.Upstreams" Staged="StagedUpstreamIds" Profiles="DraftDocument.Profiles" StagedProfiles="StagedProfileIds"
                      RateLimits="DraftDocument.RateLimitPolicies" StagedRateLimits="StagedRateLimitIds"
                      AccessLists="DraftDocument.AccessLists" StagedAccessLists="StagedAccessListIds" RuleSets="DraftDocument.RuleSets" StagedRuleSets="StagedRuleSetIds"
                      AuthProviders="DraftDocument.AuthProviders" StagedAuthProviders="StagedAuthProviderIds"
                      Certificates="_certificates" Defaults="@(_current?.Document.Settings.Defaults ?? new HostSettings())" ProxyMode="DraftDocument.Settings.TrustedProxies.Mode" Errors="FieldErrors" ShowAll="Attempted" ReadOnly="!MayWrite"
                      OnChanged="Changed"
                      OnNewUpstream="@(MayWrite ? EventCallback.Factory.Create<RouteEntry>(this, NewUpstreamAsync) : default)"
                      OnEditUpstream="EventCallback.Factory.Create<UpstreamId>(this, EditUpstreamAsync)"
                      OnNewProfile="@(MayWrite ? EventCallback.Factory.Create(this, NewProfileAsync) : default)"
                      OnNewRateLimit="@(MayWrite ? EventCallback.Factory.Create<RouteEntry?>(this, NewRateLimitAsync) : default)"
                      OnNewAccessList="@(MayWrite ? EventCallback.Factory.Create<RouteEntry?>(this, NewAccessListAsync) : default)"
                      OnNewRuleSet="@(MayWrite ? EventCallback.Factory.Create<RouteEntry?>(this, NewRuleSetAsync) : default)"
                      OnNewAuthProvider="@(MayWrite ? EventCallback.Factory.Create<RouteEntry?>(this, NewAuthProviderAsync) : default)"
                      OnNewCertificate="@(MayWrite && _mayWriteCertificates ? EventCallback.Factory.Create(this, NewCertificateAsync) : default)" />
            @if (_staged.Count > 0 || _stagedProfiles.Count > 0 || _stagedRateLimits.Count > 0 || _stagedAccessLists.Count > 0 || _stagedRuleSets.Count > 0 || _stagedAuthProviders.Count > 0)
            {
                <div class="pdk-staged" data-section="staged">
                    <div class="pdk-staged-head">
                        <MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" />
                        <span>Made here, applied with this host in one revision when it uses them. Cancel the host and they go too.</span>
                    </div>
                    <ul class="pdk-staged-list">
                        @foreach (var upstream in _staged)
                        {
                            var used = Model.Kind == HostKind.Proxy && Model.Routes.Any(r => r.UpstreamId == upstream.Id);
                            <li data-staged="@upstream.Name" data-used="@(used ? "true" : "false")" class="@(used ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Small" />
                                <span class="pdk-staged-name">@upstream.Name</span>
                                <span class="pdk-staged-detail pdk-mono">@HostOverview.AddressOf(upstream)</span>
                                @if (!used)
                                {
                                    <StatusChip Text="Won't be created: no route uses it" Name="staged-unused" />
                                }
                                @if (_stagedUpstreamErrors.ContainsKey(upstream.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (MayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedUpstreamAsync(upstream)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                        @foreach (var profile in _stagedProfiles)
                        {
                            var picked = Model.ProfileId == profile.Id;
                            <li data-staged="@profile.Name" data-used="@(picked ? "true" : "false")" class="@(picked ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" />
                                <span class="pdk-staged-name">@profile.Name</span>
                                <span class="pdk-staged-detail">profile</span>
                                @if (!picked)
                                {
                                    <StatusChip Text="Won't be created: the host doesn't pick it" Name="staged-unused" />
                                }
                                @if (_stagedProfileErrors.ContainsKey(profile.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (MayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedProfileAsync(profile)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                        @foreach (var policy in _stagedRateLimits)
                        {
                            var usedRateLimits = StagedChange.UsedRateLimits(Model.ToConfig(), _stagedRateLimits);
                            var used = usedRateLimits.Any(p => p.Id == policy.Id);
                            <li data-staged="@policy.Name" data-used="@(used ? "true" : "false")" class="@(used ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.Speed" Size="Size.Small" />
                                <span class="pdk-staged-name">@policy.Name</span>
                                <span class="pdk-staged-detail">rate limit</span>
                                @if (!used)
                                {
                                    <StatusChip Text="Won't be created: no host or route uses it" Name="staged-unused" />
                                }
                                @if (_stagedRateLimitErrors.ContainsKey(policy.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (MayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedRateLimitAsync(policy)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                        @foreach (var list in _stagedAccessLists)
                        {
                            var used = StagedChange.UsedAccessLists(Model.ToConfig(), _stagedAccessLists).Any(l => l.Id == list.Id);
                            <li data-staged="@list.Name" data-used="@(used ? "true" : "false")" class="@(used ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
                                <span class="pdk-staged-name">@list.Name</span>
                                <span class="pdk-staged-detail">access list</span>
                                @if (!used)
                                {
                                    <StatusChip Text="Won't be created: no host or route uses it" Name="staged-unused" />
                                }
                                @if (_stagedAccessListErrors.ContainsKey(list.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (MayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedAccessListAsync(list)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                        @foreach (var set in _stagedRuleSets)
                        {
                            var used = StagedChange.UsedRuleSets(Model.ToConfig(), _stagedRuleSets).Any(r => r.Id == set.Id);
                            <li data-staged="@set.Name" data-used="@(used ? "true" : "false")" class="@(used ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.Rule" Size="Size.Small" />
                                <span class="pdk-staged-name">@set.Name</span>
                                <span class="pdk-staged-detail">rule set</span>
                                @if (!used)
                                {
                                    <StatusChip Text="Won't be created: no host or route uses it" Name="staged-unused" />
                                }
                                @if (_stagedRuleSetErrors.ContainsKey(set.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (MayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedRuleSetAsync(set)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                        @foreach (var provider in _stagedAuthProviders)
                        {
                            var used = StagedChange.UsedAuthProviders(Model.ToConfig(), _stagedAuthProviders).Any(p => p.Id == provider.Id);
                            <li data-staged="@provider.Name" data-used="@(used ? "true" : "false")" class="@(used ? null : "pdk-staged-unused")">
                                <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" />
                                <span class="pdk-staged-name">@provider.Name</span>
                                <span class="pdk-staged-detail">auth provider</span>
                                @if (!used)
                                {
                                    <StatusChip Text="Won't be created: no host or route uses it" Name="staged-unused" />
                                }
                                @if (_stagedAuthProviderErrors.ContainsKey(provider.Id))
                                {
                                    <StatusChip Tone="Tone.Error" Dot="true" Text="Needs a fix" Name="staged-error" />
                                }
                                @if (MayWrite)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditStagedAuthProviderAsync(provider)"
                                               data-action="edit-staged">Edit</MudButton>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        @if (MayWrite && Model is not null)
        {
            <DrawerActions ShowDelete="@(Model.IsNew == false)" OnDelete="ReviewDeleteAsync" OnCancel="Cancel"
                           PrimaryLabel="Review changes" PrimaryAction="review" Submit="true" EndIcon="@Icons.Material.Rounded.ArrowForward" />
        }
        else
        {
            <DrawerActions PrimaryLabel="Close" PrimaryAction="cancel" OnPrimary="Cancel" />
        }
    </Footer>
</DrawerShell>

@code {
    private CurrentConfig? _current;
    private HostConfig? _stored;
    private IReadOnlyList<CertificateSummary>? _certificates;
    private readonly List<UpstreamConfig> _staged = [];
    private readonly List<ProfileConfig> _stagedProfiles = [];
    private readonly List<RateLimitPolicyConfig> _stagedRateLimits = [];
    private readonly List<AccessListConfig> _stagedAccessLists = [];
    private readonly List<RuleSetConfig> _stagedRuleSets = [];
    private readonly List<AuthProviderConfig> _stagedAuthProviders = [];

    // The dry run's errors about a staged object (relative to it), shown at its fields when it is opened again.
    private readonly Dictionary<UpstreamId, IReadOnlyDictionary<string, string>> _stagedUpstreamErrors = [];
    private readonly Dictionary<ProfileId, IReadOnlyDictionary<string, string>> _stagedProfileErrors = [];
    private readonly Dictionary<RateLimitPolicyId, IReadOnlyDictionary<string, string>> _stagedRateLimitErrors = [];
    private readonly Dictionary<AccessListId, IReadOnlyDictionary<string, string>> _stagedAccessListErrors = [];
    private readonly Dictionary<RuleSetId, IReadOnlyDictionary<string, string>> _stagedRuleSetErrors = [];
    private readonly Dictionary<AuthProviderId, IReadOnlyDictionary<string, string>> _stagedAuthProviderErrors = [];
    private ConfigDocument? _reviewed;
    private IReadOnlyDictionary<string, string> _serverErrors = new Dictionary<string, string>();
    private bool _maySimulate;
    private bool _mayWriteCertificates;
    private bool _mayReadCertificates;

    /// <summary>The host to edit; null for a new one.</summary>
    [Parameter]
    public HostId? Id { get; set; }

    private string Title => Missing ? "Host not found" : Model is null ? (Id is null ? "New host" : "Host") : Model.IsNew ? "New host" : ChangeView.HostTitle(_stored ?? Model.ToConfig());

    /// <summary>The config as the form sees it: what is stored, and what was made in this drawer.</summary>
    private ConfigDocument DraftDocument => StagedChange.Draft(_current?.Document ?? new ConfigDocument(), _staged, _stagedProfiles, _stagedRateLimits, _stagedAccessLists, _stagedRuleSets, _stagedAuthProviders);

    private HashSet<UpstreamId> StagedUpstreamIds => [.. _staged.Select(u => u.Id)];

    private HashSet<ProfileId> StagedProfileIds => [.. _stagedProfiles.Select(p => p.Id)];

    private HashSet<RateLimitPolicyId> StagedRateLimitIds => [.. _stagedRateLimits.Select(p => p.Id)];

    private HashSet<AccessListId> StagedAccessListIds => [.. _stagedAccessLists.Select(l => l.Id)];

    private HashSet<RuleSetId> StagedRuleSetIds => [.. _stagedRuleSets.Select(r => r.Id)];

    private HashSet<AuthProviderId> StagedAuthProviderIds => [.. _stagedAuthProviders.Select(p => p.Id)];

    /// <summary>Whether maintenance resolves to on for the host as the form has it: its own layer over its profile and the global defaults.</summary>
    private bool InMaintenance =>
        Model is not null
        && HostSettingsLayers.MergeAll(
            _current?.Document.Settings.Defaults,
            Model.ProfileId is { } profile ? DraftDocument.Profiles.FirstOrDefault(candidate => candidate.Id == profile)?.Settings : null,
            Model.Settings).Maintenance?.Enabled == true;

    /// <summary>The wrench in the header sets the host's own switch to the opposite of what it resolves to; the change is reviewed like any other.</summary>
    private void ToggleMaintenance()
    {
        if (Model is null)
        {
            return;
        }

        var on = !InMaintenance;
        Model.Settings = HostSettingsEdit.WithMaintenance(Model.Settings, maintenance => maintenance with { Enabled = on });
        Changed();
    }

    private string? SampleHost => Model?.Names.Select(n => n.Value.Trim()).FirstOrDefault(n => n.Length > 0 && !n.StartsWith('*'));

    private string SimulateHref => SampleHost is { } host ? $"{DashboardRoutes.Simulator}?url={Uri.EscapeDataString($"https://{host}/")}" : DashboardRoutes.Simulator;

    protected override string LoadFailureMessage => "Couldn't load the host form.";

    protected override string RefreshFailureMessage => "Couldn't refresh the host form's choices.";

    protected override void OnPrincipal(DashboardPrincipal user)
    {
        _maySimulate = user.Has(Permission.Simulate);
        _mayWriteCertificates = user.Has(Permission.CertificatesWrite);
        _mayReadCertificates = user.Has(Permission.CertificatesRead);
    }

    protected override void OnReset() => _serverErrors = new Dictionary<string, string>();

    protected override void OnReload() => _stored = null;

    protected override async Task<ConfigDocument> LoadSourceAsync()
    {
        _current = await Config.GetWorkingAsync();
        _certificates = _mayReadCertificates ? await Config.ListCertificatesAsync() : null;
        return _current.Document;
    }

    protected override bool LoadModel(ConfigDocument document)
    {
        if (Id is { } hostId)
        {
            if (document.Hosts.FirstOrDefault(h => h.Id == hostId) is not { } host)
            {
                Missing = true;
                return false;
            }

            _stored = host;
            Model = HostEditModel.From(host);
        }
        else
        {
            Model = HostEditModel.New(document.Upstreams.Count == 1 ? document.Upstreams[0].Id : null);
        }

        _staged.Clear();
        _stagedProfiles.Clear();
        _stagedRateLimits.Clear();
        _stagedAccessLists.Clear();
        _stagedRuleSets.Clear();
        _stagedAuthProviders.Clear();
        _stagedUpstreamErrors.Clear();
        _stagedProfileErrors.Clear();
        _stagedRateLimitErrors.Clear();
        _stagedAccessListErrors.Clear();
        _stagedRuleSetErrors.Clear();
        _stagedAuthProviderErrors.Clear();
        return true;
    }

    protected override HostConfig ToConfig() => Model!.ToConfig();

    protected override string Fingerprint() =>
        Model is null ? string.Empty : StagedChange.Fingerprint(new ConfigDocument(Upstreams: [.. _staged], Profiles: [.. _stagedProfiles], RateLimitPolicies: [.. _stagedRateLimits], AccessLists: [.. _stagedAccessLists], RuleSets: [.. _stagedRuleSets], AuthProviders: [.. _stagedAuthProviders], Hosts: [ToConfig()]));

    protected override void Validate()
    {
        if (Model is null || _current is null)
        {
            return;
        }

        var inline = InlineValidation.ForHost(DraftDocument, ToConfig());
        Dictionary<string, string> merged = new(_serverErrors, StringComparer.Ordinal);
        foreach (var (path, message) in inline)
        {
            merged[path] = message;
        }

        FieldErrors = merged;
        _serverErrors = new Dictionary<string, string>();
    }

    protected override bool IsChangedElsewhere(ConfigCommitted committed) =>
        !Model!.IsNew && committed.Changes.Any(c => (c is HostChange h && h.HostId == Model.Id) || (c is RouteChange r && r.HostId == Model.Id));

    protected override async Task RefreshAsync()
    {
        _current = await Config.GetWorkingAsync();
        Validate();
    }

    private async Task NewUpstreamAsync(RouteEntry route)
    {
        var basis = SampleHost?.Split('.')[0];
        var result = await Drawers.OpenAsync<UpstreamDrawer>(
            new Dictionary<string, object?>
            {
                [nameof(UpstreamDrawer.Stage)] = true,
                [nameof(UpstreamDrawer.Draft)] = DraftDocument,
                [nameof(UpstreamDrawer.SuggestedName)] = basis is { Length: > 0 } ? UpstreamDrawer.UniqueName(DraftDocument, basis) : null,
            },
            DrawerWidth.Medium);
        if (result.As<UpstreamConfig>() is { } upstream && Model?.Routes.Contains(route) == true)
        {
            _staged.Add(upstream);
            route.UpstreamId = upstream.Id;
            Changed();
        }
    }

    private async Task NewProfileAsync()
    {
        var result = await Drawers.OpenAsync<ProfileDrawer>(
            new Dictionary<string, object?> { [nameof(ProfileDrawer.Stage)] = true, [nameof(ProfileDrawer.Draft)] = DraftDocument },
            DrawerWidth.Medium);
        if (result.As<ProfileConfig>() is { } profile && Model is not null)
        {
            _stagedProfiles.Add(profile);
            Model.ProfileId = profile.Id;
            Changed();
        }
    }

    /// <summary>
    /// A rate limit made from the host form: staged with the host, and selected where the picker was. The route is null
    /// for the host's own Access row.
    /// </summary>
    private async Task NewRateLimitAsync(RouteEntry? route)
    {
        var result = await Drawers.OpenAsync<RateLimitPolicyDrawer>(
            new Dictionary<string, object?> { [nameof(RateLimitPolicyDrawer.Stage)] = true, [nameof(RateLimitPolicyDrawer.Draft)] = DraftDocument },
            DrawerWidth.Medium);
        if (result.As<RateLimitPolicyConfig>() is not { } policy || Model is null)
        {
            return;
        }

        _stagedRateLimits.Add(policy);
        var chosen = new RateLimitSettings { Enabled = true, PolicyId = policy.Id };
        if (route is not null)
        {
            route.RateLimit = chosen;
        }
        else
        {
            Model.Settings = Model.Settings with { RateLimit = chosen };
        }

        Changed();
    }

    /// <summary>
    /// An access list made from the host form: staged with the host, and selected where the picker was. The route is null for
    /// the host's own Access row.
    /// </summary>
    private async Task NewAccessListAsync(RouteEntry? route)
    {
        var result = await Drawers.OpenAsync<AccessListDrawer>(
            new Dictionary<string, object?> { [nameof(AccessListDrawer.Stage)] = true, [nameof(AccessListDrawer.Draft)] = DraftDocument },
            DrawerWidth.Medium);
        if (result.As<AccessListConfig>() is not { } list || Model is null)
        {
            return;
        }

        _stagedAccessLists.Add(list);
        var chosen = new AccessListSettings { Enabled = true, AccessListId = list.Id };
        if (route is not null)
        {
            route.AccessList = chosen;
        }
        else
        {
            Model.Settings = Model.Settings with { AccessList = chosen };
        }

        Changed();
    }

    /// <summary>A rule set made from the host form: staged with the host, and selected where the picker was (the route is null for the host's own row).</summary>
    private async Task NewRuleSetAsync(RouteEntry? route)
    {
        var result = await Drawers.OpenAsync<RuleSetDrawer>(
            new Dictionary<string, object?> { [nameof(RuleSetDrawer.Stage)] = true, [nameof(RuleSetDrawer.Draft)] = DraftDocument },
            DrawerWidth.Medium);
        if (result.As<RuleSetConfig>() is not { } set || Model is null)
        {
            return;
        }

        _stagedRuleSets.Add(set);
        var chosen = new RuleSetSettings { Enabled = true, RuleSetId = set.Id };
        if (route is not null)
        {
            route.RuleSet = chosen;
        }
        else
        {
            Model.Settings = Model.Settings with { RuleSet = chosen };
        }

        Changed();
    }

    /// <summary>An auth provider made from the host form: staged with the host, and selected where the picker was (the route is null for the host's own row).</summary>
    private async Task NewAuthProviderAsync(RouteEntry? route)
    {
        var result = await Drawers.OpenAsync<AuthProviderDrawer>(
            new Dictionary<string, object?> { [nameof(AuthProviderDrawer.Stage)] = true, [nameof(AuthProviderDrawer.Draft)] = DraftDocument },
            DrawerWidth.Medium);
        if (result.As<AuthProviderConfig>() is not { } provider || Model is null)
        {
            return;
        }

        _stagedAuthProviders.Add(provider);
        var chosen = new AuthProviderSettings { Enabled = true, AuthProviderId = provider.Id };
        if (route is not null)
        {
            route.AuthProvider = chosen;
        }
        else
        {
            Model.Settings = Model.Settings with { AuthProvider = chosen };
        }

        Changed();
    }

    private async Task NewCertificateAsync()
    {
        if (Model is null)
        {
            return;
        }

        string[] names = [.. Model.Names.Select(n => n.Value.Trim().TrimEnd('.').ToLowerInvariant()).Where(n => n.Length > 0)];
        var result = await Drawers.OpenAsync<CertificateCreateDrawer>(
            new Dictionary<string, object?> { [nameof(CertificateCreateDrawer.InitialNames)] = names },
            DrawerWidth.Medium);
        if (result.As<CertificateSummary>() is not { } certificate)
        {
            return;
        }

        await Logger.TryAsync(Snackbar, "Couldn't read the certificates again.", async () => _certificates = await Config.ListCertificatesAsync());
        if (HostOverview.IsUsable(certificate))
        {
            Model.CertificateMode = CertificateBindingMode.Specific;
            Model.CertificateId = certificate.Id;
        }
        else
        {
            Model.CertificateMode = CertificateBindingMode.Auto;
            Model.CertificateId = null;
            Snackbar.Add($"{CertificateDisplay.DisplayName(certificate)} isn't issued yet: Automatic picks it up once it is.", Severity.Info);
        }

        Changed();
    }

    protected override Task SubmitAsync() => ReviewAsync();

    private async Task ReviewAsync()
    {
        if (!CanSubmit())
        {
            return;
        }

        var host = ToConfig();
        var upstreams = StagedChange.UsedUpstreams(host, _staged);
        var profiles = StagedChange.UsedProfiles(host, _stagedProfiles);
        var rateLimits = StagedChange.UsedRateLimits(host, _stagedRateLimits);
        var accessLists = StagedChange.UsedAccessLists(host, _stagedAccessLists);
        var ruleSets = StagedChange.UsedRuleSets(host, _stagedRuleSets);
        var authProviders = StagedChange.UsedAuthProviders(host, _stagedAuthProviders);
        var name = ChangeView.HostTitle(host);
        ReviewRequest request;
        if (upstreams.Count == 0 && profiles.Count == 0 && rateLimits.Count == 0 && accessLists.Count == 0 && ruleSets.Count == 0 && authProviders.Count == 0)
        {
            request = new ReviewRequest(Model!.IsNew ? $"New host {name}" : $"Edit {name}", new UpsertHostCommand(host));
        }
        else
        {
            // One revision for the host and what was made for it: a replace of the latest document, after the same version check an
            // object command makes (a host changed elsewhere since the form opened is a conflict, not something to overwrite).
            CurrentConfig head;
            try
            {
                head = await Config.GetCurrentAsync();
            }
            catch (Exception ex) when (StoreFailures.Survivable(ex))
            {
                Logger.LogStoreFailure(ex, "Couldn't read the config to review a host.");
                Snackbar.Add(StoreFailures.Message("The change couldn't be reviewed."), Severity.Error);
                return;
            }

            if (!Model!.IsNew && head.Document.Hosts.FirstOrDefault(h => h.Id == Model.Id)?.Version != Model.Version)
            {
                ChangedElsewhere = head.Revision;
                Snackbar.Add($"{name} was changed elsewhere since you opened it. Reload to start from the new version.", Severity.Warning);
                return;
            }

            var after = StagedChange.Apply(head.Document, host, upstreams, profiles, rateLimits, accessLists, ruleSets, authProviders);
            var with = string.Join(" and ", [
                .. upstreams.Select(u => $"upstream {u.Name}"),
                .. profiles.Select(p => $"profile {p.Name}"),
                .. rateLimits.Select(p => $"rate limit {p.Name}"),
                .. accessLists.Select(l => $"access list {l.Name}"),
                .. ruleSets.Select(r => $"rule set {r.Name}"),
                .. authProviders.Select(p => $"auth provider {p.Name}"),
            ]);
            _reviewed = after;
            request = new ReviewRequest(Model!.IsNew ? $"New host {name}" : $"Edit {name}", new ReplaceConfigCommand(after, head.Revision?.Id)
            {
                Message = $"{(Model.IsNew ? "New host" : "Edit")} {name} with {with}",
            })
            {
                AfterDocument = after,
                OnInvalidDocument = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalidDocument),
                // A draft keeps each object as an entry of its own, the ones the host uses first.
                DraftCommands =
                [
                    .. upstreams.Select(u => (ConfigCommand)new UpsertUpstreamCommand(u)),
                    .. profiles.Select(p => new UpsertProfileCommand(p)),
                    .. rateLimits.Select(p => new UpsertRateLimitPolicyCommand(p)),
                    .. accessLists.Select(l => new UpsertAccessListCommand(l)),
                    .. ruleSets.Select(r => new UpsertRuleSetCommand(r)),
                    .. authProviders.Select(p => new UpsertAuthProviderCommand(p)),
                    new UpsertHostCommand(host),
                ],
            };
        }

        var final = request with
        {
            SuccessMessage = Model.IsNew ? $"Created {name}" : $"Saved {name}",
            SampleHost = SampleHost,
            OnInvalid = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalid),
        };
        await RunReviewAsync(final, final.Command is ReplaceConfigCommand ? ReviewAsync : null);
    }

    private async Task ReviewDeleteAsync()
    {
        if (Model is null || Model.IsNew || !MayWrite || _stored is null)
        {
            return;
        }

        var name = ChangeView.HostTitle(_stored);
        await RunReviewAsync(new ReviewRequest($"Delete {name}", new DeleteHostCommand(Model.Id, Model.Version))
        {
            Destructive = true,
            SuccessMessage = $"Deleted {name}",
        });
    }

    /// <summary>
    /// The dry run refused the one revision of the host and what was staged with it: the host's errors go to its fields, a staged object's
    /// are kept for it (marked "Needs a fix", and shown at its fields when it is opened again).
    /// </summary>
    private void OnInvalidDocument(IReadOnlyList<ConfigError> errors)
    {
        if (_reviewed is not { } document || Model is null)
        {
            return;
        }

        var host = document.Hosts.ToList().FindIndex(h => h.Id == Model.Id);
        if (host >= 0)
        {
            OnInvalid([.. errors.Where(e => e.Path.StartsWith($"/hosts/{host}/", StringComparison.Ordinal) || e.Path == $"/hosts/{host}")
                .Select(e => e with { Path = e.Path[$"/hosts/{host}".Length..] })]);
        }

        RouteStagedErrors(errors, document.Upstreams, _staged, upstream => upstream.Id, (id, found) => _stagedUpstreamErrors[id] = found, "upstreams");
        RouteStagedErrors(errors, document.Profiles, _stagedProfiles, profile => profile.Id, (id, found) => _stagedProfileErrors[id] = found, "profiles");
        RouteStagedErrors(errors, document.RateLimitPolicies, _stagedRateLimits, policy => policy.Id, (id, found) => _stagedRateLimitErrors[id] = found, "rateLimitPolicies");
        RouteStagedErrors(errors, document.AccessLists, _stagedAccessLists, list => list.Id, (id, found) => _stagedAccessListErrors[id] = found, "accessLists");
        RouteStagedErrors(errors, document.RuleSets, _stagedRuleSets, set => set.Id, (id, found) => _stagedRuleSetErrors[id] = found, "ruleSets");
        RouteStagedErrors(errors, document.AuthProviders, _stagedAuthProviders, provider => provider.Id, (id, found) => _stagedAuthProviderErrors[id] = found, "authProviders");
    }

    // An upstream made in this drawer is still staged and is edited as such; any other is the config's own, edited and
    // applied in its own drawer on top, after which this drawer reloads so the route shows the new name and address.
    private async Task EditUpstreamAsync(UpstreamId id)
    {
        if (_staged.Find(upstream => upstream.Id == id) is { } staged)
        {
            await EditStagedUpstreamAsync(staged);
            return;
        }

        await Drawers.OpenAsync<UpstreamDrawer>(new Dictionary<string, object?> { [nameof(UpstreamDrawer.Id)] = id }, DrawerWidth.Medium);
        await RefreshAsync();
        StateHasChanged();
    }

    private async Task EditStagedUpstreamAsync(UpstreamConfig staged)
    {
        var result = await Drawers.OpenAsync<UpstreamDrawer>(
            new Dictionary<string, object?>
            {
                [nameof(UpstreamDrawer.Stage)] = true,
                [nameof(UpstreamDrawer.Draft)] = DraftDocument,
                [nameof(UpstreamDrawer.Staged)] = staged,
                [nameof(UpstreamDrawer.Errors)] = _stagedUpstreamErrors.GetValueOrDefault(staged.Id),
            },
            DrawerWidth.Medium);
        if (result.As<UpstreamConfig>() is { } edited && _staged.FindIndex(u => u.Id == staged.Id) is >= 0 and var index)
        {
            _staged[index] = edited;
            _stagedUpstreamErrors.Remove(staged.Id);
            Changed();
        }
    }

