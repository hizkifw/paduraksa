    /// <summary>
    /// Sends the dry run's errors about each staged object to that object, which shows them at its fields when opened again:
    /// the same walk for upstreams and profiles, which differ only in their ID and collection.
    /// </summary>
    private static void RouteStagedErrors<T, TId>(
        IReadOnlyList<ConfigError> errors,
        IReadOnlyList<T> objects,
        IReadOnlyList<T> staged,
        Func<T, TId> id,
        Action<TId, IReadOnlyDictionary<string, string>> keep,
        string collection)
    {
        for (var i = 0; i < objects.Count; i++)
        {
            var objectId = id(objects[i]);
            if (staged.Any(item => EqualityComparer<TId>.Default.Equals(id(item), objectId))
                && InlineValidation.Relative(errors, $"/{collection}/{i}") is { Count: > 0 } found)
            {
                keep(objectId, found);
            }
        }
    }

    protected override void OnInvalid(IReadOnlyList<ConfigError> errors)
    {
        _serverErrors = InlineValidation.Relative(errors, string.Empty);
        MergeErrors(_serverErrors);
    }
}
