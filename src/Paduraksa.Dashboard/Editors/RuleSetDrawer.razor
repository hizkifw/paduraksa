@inherits DraftDrawer<RuleSetEditModel, RuleSetConfig>

@* A rule set in a drawer: a name and the rules in the order they are tried, each "When [path] [methods] [user agent] then [action]". On its
   own it goes through Review changes; opened from a host's form it is handed back, to be applied with the host in one revision. Its ID is
   never shown: a host or a route picks it by name. *@

<DrawerShell Title="@Title"
             Subtitle="@(Staged is not null ? "Not applied yet: it goes in with the host, in one revision." : "Hosts and routes pick it in their Access settings.")"
             Icon="@Icons.Material.Outlined.Rule" Name="rule-set" OnSubmit="SubmitAsync">
    <Banner>
        @if (ChangedElsewhere is { } elsewhere)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" data-banner="changed">
                This rule set was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
            </MudAlert>
        }
        @if (DeleteRefusal is { } refusal)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" data-banner="in-use" ShowCloseIcon="true" CloseIconClicked="() => DeleteRefusal = null">
                <strong>@StoredName is still in use, so it can't be deleted.</strong> @refusal
            </MudAlert>
        }
        @if (Failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-alert="load-failed">
                The rule set couldn't be read. The details are in the server log.
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
            </MudAlert>
        }
        @if (Denied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@IdentityText.CantReadConfig. @IdentityText.CantReadConfigHelp</MudAlert>
        }
        else if (!MayWrite && Model is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: your role can see this rule set but not change it.</MudAlert>
        }
    </Banner>
    <ChildContent>
        @if (Missing)
        {
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such rule set" Description="It may have been deleted, or the link is wrong." />
        }
        else if (Model is null || Document is null)
        {
            @if (!Failed && !Denied)
            {
                <div class="pdk-form" aria-busy="true">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mt-2" />
                </div>
            }
        }
        else
        {
            <div class="pdk-form" data-form="rule-set">
                @if (Attempted && FieldErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pdk-form-summary" data-form="errors">
                        <strong>@(FieldErrors.Count == 1 ? "One thing to fix" : $"{FieldErrors.Count} things to fix"):</strong>
                        <ul class="pdk-error-list">
                            @foreach (var (path, message) in FieldErrors)
                            {
                                <li><span class="pdk-error-where">@ChangeView.Locate(path, null)</span> @message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <FormSection Title="Rule set" Name="rule-set">
                    <div class="pdk-field-grid">
                        <MudTextField T="string" Value="Model.Name" ValueChanged="@(value => Set(() => Model.Name = value, "/name"))" Immediate="true" DebounceInterval="250"
                                      Label="Name" Placeholder="Block scanners" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" AutoFocus="Model.IsNew"
                                      Error="@(E("/name") is not null)" ErrorText="@E("/name")" data-field="name" />
                        <MudTextField T="string" Value="Model.Notes" ValueChanged="@(value => Set(() => Model.Notes = value, "/notes"))" Label="Notes"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Error="@(E("/notes") is not null)" ErrorText="@E("/notes")" />
                    </div>
                </FormSection>

                <FormSection Title="Rules" Name="rules"
                             Description="Tried in order: the first rule a request matches decides, so put an exception before the rule it excepts. A request no rule matches goes on. Every condition a rule states has to match.">
                    @if (E("/rules") is { } tooMany)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" data-error="rules">@tooMany</MudText>
                    }

                    @if (Model.Rules.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pdk-muted" data-section="no-rules">No rules: every request goes on.</MudText>
                    }
                    else
                    {
                        <ol class="pdk-rule-rows" data-section="rules-list">
                            @for (var i = 0; i < Model.Rules.Count; i++)
                            {
                                var index = i;
                                var rule = Model.Rules[index];
                                <li class="pdk-rule-row" data-rule="@index" @key="rule">
                                    <div class="pdk-rule-head">
                                        <span class="pdk-rule-number">Rule @(index + 1)</span>
                                        @if (MayWrite)
                                        {
                                            <span class="pdk-rule-tools">
                                                <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)" OnClick="() => Move(rule, -1)"
                                                               aria-label="@($"Move rule {index + 1} up")" data-action="@($"move-up-{index}")" />
                                                <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" Size="Size.Small" Disabled="@(index == Model.Rules.Count - 1)" OnClick="() => Move(rule, 1)"
                                                               aria-label="@($"Move rule {index + 1} down")" data-action="@($"move-down-{index}")" />
                                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Remove(rule)"
                                                               aria-label="@($"Remove rule {index + 1}")" data-action="@($"remove-rule-{index}")" />
                                            </span>
                                        }
                                    </div>

                                    <div class="pdk-rule-body">
                                        <span class="pdk-rule-word">When</span>
                                        <div class="pdk-rule-fields">
                                            <div class="pdk-rule-path">
                                                <MudSelect T="RulePathKind?" Value="rule.PathKind" ValueChanged="@(value => SetKind(rule, index, value))"
                                                           Label="Path" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ReadOnly="!MayWrite"
                                                           Error="@(PathError(index) is not null && rule.PathKind is null)" data-field="@($"path-kind-{index}")">
                                                    <MudSelectItem T="RulePathKind?" Value="@((RulePathKind?)null)">@RuleSetText.PathLabel(null)</MudSelectItem>
                                                    <MudSelectItem T="RulePathKind?" Value="@((RulePathKind?)RulePathKind.Exact)">@RuleSetText.PathLabel(RulePathKind.Exact)</MudSelectItem>
                                                    <MudSelectItem T="RulePathKind?" Value="@((RulePathKind?)RulePathKind.Prefix)">@RuleSetText.PathLabel(RulePathKind.Prefix)</MudSelectItem>
                                                    <MudSelectItem T="RulePathKind?" Value="@((RulePathKind?)RulePathKind.Glob)">@RuleSetText.PathLabel(RulePathKind.Glob)</MudSelectItem>
                                                    <MudSelectItem T="RulePathKind?" Value="@((RulePathKind?)RulePathKind.Regex)">@RuleSetText.PathLabel(RulePathKind.Regex)</MudSelectItem>
                                                </MudSelect>
                                                @if (rule.PathKind is { } kind)
                                                {
                                                    <MudTextField T="string" Value="rule.Pattern" ValueChanged="@(value => Set(() => rule.Pattern = value, $"/rules/{index}/match/path/pattern"))"
                                                                  Immediate="true" DebounceInterval="250" Label="@(kind == RulePathKind.Regex ? "Regular expression" : "Pattern")"
                                                                  Placeholder="@PatternHint(kind)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Class="pdk-mono-input"
                                                                  HelperText="@PatternHelp(kind)" Error="@(PathError(index) is not null)" ErrorText="@PathError(index)"
                                                                  data-field="@($"pattern-{index}")" spellcheck="false" autocomplete="off" />
                                                }
                                            </div>

                                            <MudSelect T="string" MultiSelection="true" SelectedValues="rule.Methods" SelectedValuesChanged="@(values => SetMethods(rule, index, values))"
                                                       Label="Methods" Placeholder="Any method" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ReadOnly="!MayWrite"
                                                       Error="@(MethodsError(index) is not null)" ErrorText="@MethodsError(index)" data-field="@($"methods-{index}")">
                                                @foreach (var method in MethodChoices(rule))
                                                {
                                                    <MudSelectItem T="string" Value="@method">@method</MudSelectItem>
                                                }
                                            </MudSelect>

                                            <div class="pdk-rule-agent">
                                                <MudTextField T="string" Value="rule.AgentsText" ValueChanged="@(value => Set(() => rule.AgentsText = value, $"/rules/{index}/match/userAgent"))"
                                                              Immediate="true" DebounceInterval="250" Lines="2" Sizing="InputSizing.Auto" MaxLines="8" Label="User agent contains" Placeholder="sqlmap"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Class="pdk-mono-input"
                                                              HelperText="One per line, any case. A match on any of them counts."
                                                              Error="@(AgentError(index) is not null)" ErrorText="@AgentError(index)" data-field="@($"agents-{index}")" spellcheck="false" autocomplete="off" />
                                                <MudSwitch T="bool" Value="rule.EmptyAgent" ValueChanged="@(value => Set(() => rule.EmptyAgent = value, $"/rules/{index}/match/userAgent"))"
                                                           Color="Color.Primary" ReadOnly="!MayWrite" Label="Also when there is no user agent" data-field="@($"empty-agent-{index}")" />
                                            </div>
                                        </div>
                                    </div>

                                    @if (RuleError(index) is { } stated)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Error" data-error="@($"rule-{index}")">@stated</MudText>
                                    }

                                    <div class="pdk-rule-body">
                                        <span class="pdk-rule-word">Then</span>
                                        <MudSelect T="RuleAction" Value="rule.Action" ValueChanged="@(value => Set(() => rule.Action = value, $"/rules/{index}/action"))"
                                                   Label="Action" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ReadOnly="!MayWrite"
                                                   Error="@(E($"/rules/{index}/action") is not null)" ErrorText="@E($"/rules/{index}/action")" data-field="@($"action-{index}")">
                                            <MudSelectItem Value="RuleAction.Deny">@RuleSetText.ActionLabel(RuleAction.Deny)</MudSelectItem>
                                            <MudSelectItem Value="RuleAction.Drop">@RuleSetText.ActionLabel(RuleAction.Drop)</MudSelectItem>
                                            <MudSelectItem Value="RuleAction.Allow">@RuleSetText.ActionLabel(RuleAction.Allow)</MudSelectItem>
                                        </MudSelect>
                                    </div>
                                </li>
                            }
                        </ol>
                    }

                    @if (MayWrite)
                    {
                        <div>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add" OnClick="AddRule" data-action="add-rule">Add rule</MudButton>
                        </div>
                    }
                </FormSection>

                @if (!Stage && !Model.IsNew)
                {
                    <FormSection Title="Used by" Name="usage">
                        @if (Usage.IsEmpty)
                        {
                            <MudText Typo="Typo.body2" Class="pdk-muted">No host or route uses it yet. Pick it in a host's Access settings.</MudText>
                        }
                        else
                        {
                            <ul class="pdk-list" data-section="usage-list">
                                @foreach (var host in Usage.Hosts)
                                {
                                    <li class="pdk-list-row">
                                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Language" Size="Size.Small" /></span>
                                        <span class="pdk-list-main">
                                            <a class="pdk-row-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                            <span class="pdk-list-sub">Applies to the routes that name no set of their own</span>
                                        </span>
                                    </li>
                                }
                                @foreach (var use in Usage.Routes)
                                {
                                    <li class="pdk-list-row">
                                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.AltRoute" Size="Size.Small" /></span>
                                        <span class="pdk-list-main">
                                            <a class="pdk-row-link" href="@DashboardRoutes.Host(use.Host.Id)">@ChangeView.HostTitle(use.Host)</a>
                                            <span class="pdk-list-sub">Route @use.Route.Path uses it</span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </FormSection>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="pdk-drawer-actions">
            @if (!Stage && Model is { IsNew: false } && MayWrite && Usage.IsEmpty)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="ReviewDeleteAsync" data-action="delete"
                           Class="pdk-drawer-actions-start">Delete</MudButton>
            }
            @if (MayWrite && Model is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="Cancel" data-action="cancel">Cancel</MudButton>
                @if (Stage)
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Check" data-action="stage">
                        Use this rule set
                    </MudButton>
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">
                        Review changes
                    </MudButton>
                }
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cancel" data-action="cancel">Close</MudButton>
            }
        </div>
    </Footer>
</DrawerShell>

@code {
    /// <summary>The set to edit; null for a new one.</summary>
    [Parameter]
    public RuleSetId? Id { get; set; }

    /// <summary>A built-in preset to start a new set from; null for an empty one.</summary>
    [Parameter]
    public RuleSetConfig? Preset { get; set; }

    private string Title => Missing ? "Rule set not found" : Staged is { } staged ? staged.Name : Model is null ? (Id is null ? "New rule set" : "Rule set") : Model.IsNew ? "New rule set" : StoredName;

    private RuleSetUsage Usage =>
        Model is null || Document is null || Model.IsNew ? new RuleSetUsage([], []) : RuleSetUsageOf.Find(Document, Model.Id);

    protected override string LoadFailureMessage => "Couldn't load the rule-set form.";

    protected override string RefreshFailureMessage => "Couldn't refresh a rule set's usage.";

    protected override async Task<ConfigDocument> LoadSourceAsync() => (await Config.GetCurrentAsync()).Document;

    protected override bool LoadModel(ConfigDocument document)
    {
        if (Id is { } setId && !Stage)
        {
            if (document.RuleSets.FirstOrDefault(r => r.Id == setId) is not { } set)
            {
                Missing = true;
                return false;
            }

            StoredName = set.Name;
            Model = RuleSetEditModel.From(set);
            return true;
        }

        Model = Stage && Staged is { } staged ? RuleSetEditModel.FromDraft(staged)
            : Preset is { } preset ? RuleSetEditModel.CopyOf(preset)
            : RuleSetEditModel.New();
        return true;
    }

    protected override RuleSetConfig ToConfig() => Model!.ToConfig();

    protected override string Fingerprint() =>
        Model is null ? string.Empty : StagedChange.Fingerprint(new ConfigDocument(RuleSets: [ToConfig()]));

    protected override void Validate()
    {
        if (Model is not null && Document is not null)
        {
            FieldErrors = InlineValidation.ForRuleSet(Document, Model.ToConfig());
        }
    }

    protected override bool TracksCommits => Model is not { IsNew: true };

    protected override bool IsChangedElsewhere(ConfigCommitted committed) =>
        !Model!.IsNew && committed.Changes.Any(c => c is RuleSetChange set && set.RuleSetId == Model.Id);

    protected override async Task RefreshAsync()
    {
        Document = (await Config.GetCurrentAsync()).Document;
    }

    // An error is shown once its field was touched, or the form was submitted. Several fields can share a path prefix (a rule's
    // methods, each with an index), so a touch of the prefix counts.
    private string? FirstUnder(string path) =>
        FieldErrors.Where(error => error.Key == path || error.Key.StartsWith(path + "/", StringComparison.Ordinal))
            .Select(error => (Touched.Contains(path) || Attempted) ? error.Value : null).FirstOrDefault(message => message is not null);

    private string? PathError(int index) => FirstUnder($"/rules/{index}/match/path/pattern") ?? FirstUnder($"/rules/{index}/match/path/kind");

    private string? MethodsError(int index) => FirstUnder($"/rules/{index}/match/methods");

    private string? AgentError(int index) => FirstUnder($"/rules/{index}/match/userAgent");

    // The rule states no condition at all: said once anything of the rule was touched, or at the submit.
    private string? RuleError(int index) =>
        FieldErrors.TryGetValue($"/rules/{index}/match", out var message) && (Attempted || Touched.Any(touched => touched.StartsWith($"/rules/{index}/", StringComparison.Ordinal)))
            ? message
            : null;

    private static string PatternHint(RulePathKind kind) => kind switch
    {
        RulePathKind.Exact => "/wp-login.php",
        RulePathKind.Prefix => "/admin",
        RulePathKind.Glob => "/**/.env",
        _ => @"\.(php|asp)$",
    };

    private static string? PatternHelp(RulePathKind kind) => kind switch
    {
        RulePathKind.Prefix => "The path and what lies below it: /admin takes /admin and /admin/users, not /administrator.",
        RulePathKind.Glob => "* is any run inside a segment, ** across segments, /**/ none or more segments.",
        RulePathKind.Regex => "Matched anywhere in the path, ignoring case, without backtracking.",
        _ => "Written decoded; case is ignored.",
    };

    private static IEnumerable<string> MethodChoices(RuleEntry rule) =>
        RuleSetText.CommonMethods.Concat(rule.Methods.Where(method => !RuleSetText.CommonMethods.Contains(method)));

    private void SetKind(RuleEntry rule, int index, RulePathKind? kind) =>
        Set(() =>
        {
            rule.PathKind = kind;
            if (kind is null)
            {
                rule.Pattern = string.Empty;
            }
        }, $"/rules/{index}/match/path/pattern");

    private void SetMethods(RuleEntry rule, int index, IEnumerable<string>? values) =>
        Set(() => rule.Methods = [.. (values ?? []).OrderBy(method => method, StringComparer.Ordinal)], $"/rules/{index}/match/methods");

    private void AddRule()
    {
        Model!.Rules.Add(new RuleEntry());
        Changed();
    }

    private void Remove(RuleEntry rule)
    {
        Model!.Rules.Remove(rule);
        Reindexed();
    }

    private void Move(RuleEntry rule, int by)
    {
        var at = Model!.Rules.IndexOf(rule);
        var to = at + by;
        if (at < 0 || to < 0 || to >= Model.Rules.Count)
        {
            return;
        }

        Model.Rules.RemoveAt(at);
        Model.Rules.Insert(to, rule);
        Reindexed();
    }

    // Errors are kept by a rule's position, so a rule that moved or went must not take another's message along.
    private void Reindexed()
    {
        Touched.Clear();
        Changed();
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit())
        {
            return;
        }

        var set = ToConfig();
        if (Stage)
        {
            Level?.Close(set);
            return;
        }

        await RunReviewAsync(new ReviewRequest(Model!.IsNew ? $"New rule set {set.Name}" : $"Edit rule set {set.Name}", new UpsertRuleSetCommand(set))
        {
            SuccessMessage = Model.IsNew ? $"Created the rule set {set.Name}" : $"Saved the rule set {set.Name}",
            OnInvalid = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalid),
        });
    }

    private async Task ReviewDeleteAsync()
    {
        if (Model is null || Model.IsNew || !MayWrite)
        {
            return;
        }

        if (!Usage.IsEmpty)
        {
            DeleteRefusal = $"{Usage.CountText} {Usage.UseVerb} it. "
                + "Pick another rule set (or none) for them first.";
            Snackbar.Add($"{StoredName} is in use and can't be deleted.", Severity.Warning);
            return;
        }

        await RunReviewAsync(new ReviewRequest($"Delete rule set {StoredName}", new DeleteRuleSetCommand(Model.Id, Model.Version))
        {
            ApplyLabel = "Delete",
            Destructive = true,
            SuccessMessage = $"Deleted the rule set {StoredName}",
        });
    }
}
