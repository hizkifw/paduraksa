@implements IDisposable
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<ProfileDrawer> Logger
@* A profile in a drawer (PLAN §5.3, §12): a name, notes and the host settings it sets, each "Inherit" otherwise. On its own it goes
   through Review changes; opened from a host's form (Stage) it is handed back, to be applied with the host in one revision. *@

<DrawerShell Title="@Title" Overline="@(Stage ? (Staged is null ? "New profile for this host" : "New profile, not applied yet") : _model is { IsNew: true } ? "New profile" : "Profile")"
             Subtitle="Settings that every host with this profile inherits, on top of the global defaults. A host can still set its own."
             Icon="@Icons.Material.Outlined.Badge" Name="profile" OnSubmit="SubmitAsync">
    <Banner>
        @if (_changedElsewhere is { } elsewhere)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" data-banner="changed">
                This profile was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
            </MudAlert>
        }
        @if (_deleteRefusal is { } refusal)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" data-banner="in-use" ShowCloseIcon="true" CloseIconClicked="() => _deleteRefusal = null">
                <strong>@_storedName is still in use, so it can't be deleted.</strong> @refusal
            </MudAlert>
        }
        @if (_failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-alert="load-failed">
                The profile couldn't be read. The details are in the server log.
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
            </MudAlert>
        }
        @if (_denied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">Your role can't read the config. An Owner can give you a role that can.</MudAlert>
        }
        else if (!_mayWrite && _model is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: your role can see this profile but not change it.</MudAlert>
        }
    </Banner>
    <ChildContent>
        @if (_missing)
        {
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such profile" Description="It may have been deleted, or the link is wrong." />
        }
        else if (_model is null || _document is null)
        {
            @if (!_failed && !_denied)
            {
                <div class="pdk-form" aria-busy="true">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mt-2" />
                </div>
            }
        }
        else
        {
            <div class="pdk-form" data-form="profile">
                @if (_attempted && _errors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pdk-form-summary" data-form="errors">
                        <strong>@(_errors.Count == 1 ? "One thing to fix" : $"{_errors.Count} things to fix"):</strong>
                        <ul class="pdk-error-list">
                            @foreach ((string path, string message) in _errors)
                            {
                                <li><span class="pdk-error-where">@ChangeView.Locate(path, null)</span> @message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <FormSection Title="Profile" Description="A name hosts pick it by, and a note on what it is for." Name="profile">
                    <div class="pdk-field-grid">
                        <MudTextField T="string" Value="_model.Name" ValueChanged="@(value => Set(() => _model.Name = value, "/name"))" Immediate="true" DebounceInterval="250"
                                      Label="Name" Placeholder="LAN only" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_mayWrite" AutoFocus="_model.IsNew"
                                      Error="@(E("/name") is not null)" ErrorText="@E("/name")" data-field="name" />
                        <MudTextField T="string" Value="_model.Notes" ValueChanged="@(value => Set(() => _model.Notes = value, "/notes"))" Label="Notes"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_mayWrite" Error="@(E("/notes") is not null)" ErrorText="@E("/notes")" />
                    </div>
                </FormSection>

                <FormSection Title="Settings" Description="Each one left to inherit takes the global default, shown in brackets." Name="settings">
                    <Aside>
                        <StatusChip Tone="Tone.Primary" Text="@Overrides(_model.Settings.Overrides)" Name="overrides" />
                    </Aside>
                    <ChildContent>
                        <HostSettingsFields Model="_model.Settings" Inherited="_inherited" InheritedFrom="the global defaults" InheritWord="Inherit"
                                            PathPrefix="/settings" Errors="_errors" ShowAll="_attempted" Touched="_touched" ReadOnly="!_mayWrite" OnChanged="Touch" />
                    </ChildContent>
                </FormSection>

                @if (!Stage && !_model.IsNew)
                {
                    <FormSection Title="Used by" Description="The hosts that pick this profile." Name="usage">
                        @if (Hosts.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pdk-muted">No host uses it yet. Pick it in a host's HTTPS settings.</MudText>
                        }
                        else
                        {
                            <ul class="pdk-list" data-section="usage-list">
                                @foreach (HostConfig host in Hosts)
                                {
                                    <li class="pdk-list-row">
                                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Language" Size="Size.Small" /></span>
                                        <span class="pdk-list-main">
                                            <a class="pdk-row-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                            <span class="pdk-list-sub">@(HostSettingsModel.Summary(host.Settings) is { Count: > 0 } own ? $"Sets its own: {string.Join(", ", own).ToLowerInvariant()}" : "Takes everything from the profile")</span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </FormSection>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="pdk-drawer-actions">
            @if (!Stage && _model is { IsNew: false } && _mayWrite)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="ReviewDeleteAsync" data-action="delete"
                           Class="pdk-drawer-actions-start">Delete</MudButton>
            }
            @if (_mayWrite && _model is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="Cancel" data-action="cancel">Cancel</MudButton>
                @if (Stage)
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Check" data-action="stage">
                        Use this profile
                    </MudButton>
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">
                        Review changes
                    </MudButton>
                }
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cancel" data-action="cancel">Close</MudButton>
            }
        </div>
    </Footer>
</DrawerShell>

@code {
    private ProfileEditModel? _model;
    private ConfigDocument? _document;
    private HostSettings _inherited = HostSettingsModel.BuiltIn;
    private string _storedName = string.Empty;
    private string _opened = string.Empty;
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private readonly HashSet<string> _touched = new(StringComparer.Ordinal);
    private bool _attempted;
    private bool _mayWrite;
    private bool _missing;
    private bool _denied;
    private bool _failed;
    private bool _reviewing;
    private string? _deleteRefusal;
    private RevisionRef? _changedElsewhere;
    private IDisposable? _watch;

    [CascadingParameter]
    private DrawerLevel? Level { get; set; }

    /// <summary>The profile to edit; null for a new one.</summary>
    [Parameter]
    public ProfileId? Id { get; set; }

    /// <summary>Hand the new profile back instead of applying it (opened from a host's form, which applies it with the host).</summary>
    [Parameter]
    public bool Stage { get; set; }

    /// <summary>With <see cref="Stage"/>: a profile made earlier and not applied yet, to change (null: a new one).</summary>
    [Parameter]
    public ProfileConfig? Staged { get; set; }

    /// <summary>Errors about <see cref="Staged"/> (relative to it) from a review that refused it, shown at its fields at once.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? Errors { get; set; }

    /// <summary>With <see cref="Stage"/>: the host form's draft, which the profile is checked against.</summary>
    [Parameter]
    public ConfigDocument? Draft { get; set; }

    private string Title => _missing ? "Profile not found" : Staged is { } staged ? staged.Name : _model is null ? (Id is null ? "New profile" : "Profile") : _model.IsNew ? "New profile" : _storedName;

    private IReadOnlyList<HostConfig> Hosts =>
        _model is null || _document is null || _model.IsNew ? [] : ProfileEditModel.HostsUsing(_document, _model.Id);

    protected override async Task OnInitializedAsync()
    {
        if (!Stage)
        {
            _watch = Config.Watch(committed => InvokeAsync(() => OnCommittedAsync(committed)));
        }

        await LoadAsync();
    }

    public void Dispose() => _watch?.Dispose();

    private async Task LoadAsync()
    {
        _changedElsewhere = null;
        _deleteRefusal = null;
        _attempted = false;
        _failed = false;
        _touched.Clear();
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        try
        {
            _document = Stage && Draft is not null ? Draft : (await Config.GetCurrentAsync()).Document;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't load the profile form.");
            _failed = true;
            return;
        }

        _inherited = HostSettingsModel.Layer(_document.Settings.Defaults, HostSettingsModel.BuiltIn);
        if (Id is { } profileId && !Stage)
        {
            if (_document.Profiles.FirstOrDefault(p => p.Id == profileId) is not { } profile)
            {
                _missing = true;
                return;
            }

            _storedName = profile.Name;
            _model = ProfileEditModel.From(profile);
        }
        else
        {
            _model = Stage && Staged is { } staged ? ProfileEditModel.FromDraft(staged) : ProfileEditModel.New();
        }

        _opened = Fingerprint();
        Validate();
        if (Errors is { Count: > 0 } given)
        {
            Dictionary<string, string> merged = new(_errors, StringComparer.Ordinal);
            foreach ((string path, string message) in given)
            {
                merged[path] = message;
            }

            _errors = merged;
            _attempted = true;
        }
    }

    private string Fingerprint() => _model is null ? string.Empty : StagedChange.Fingerprint(new ConfigDocument(Profiles: [_model.ToConfig()]));

    private static string Overrides(int count) => count switch
    {
        0 => "Inherits everything",
        1 => "Sets 1 setting",
        _ => $"Sets {count} settings",
    };

    private string? E(string path) => (_attempted || _touched.Contains(path)) && _errors.TryGetValue(path, out string? message) ? message : null;

    private void Set(Action apply, string path)
    {
        apply();
        Touch(path);
    }

    private void Touch(string path)
    {
        _touched.Add(path);
        Validate();
        if (Level is not null)
        {
            Level.IsDirty = Fingerprint() != _opened;
        }
    }

    private void Validate()
    {
        if (_model is not null && _document is not null)
        {
            _errors = InlineValidation.ForProfile(_document, _model.ToConfig());
        }
    }

    private async Task SubmitAsync()
    {
        if (_model is null || !_mayWrite || _reviewing)
        {
            return;
        }

        _attempted = true;
        Validate();
        if (_errors.Count > 0)
        {
            return;
        }

        ProfileConfig profile = _model.ToConfig();
        if (Stage)
        {
            Level?.Close(profile);
            return;
        }

        await RunReviewAsync(new ReviewRequest(_model.IsNew ? $"New profile {profile.Name}" : $"Edit profile {profile.Name}", new UpsertProfileCommand(profile))
        {
            SuccessMessage = _model.IsNew ? $"Created the profile {profile.Name}" : $"Saved the profile {profile.Name}",
            OnInvalid = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalid),
        });
    }

    private async Task ReviewDeleteAsync()
    {
        if (_model is null || _model.IsNew || !_mayWrite)
        {
            return;
        }

        if (Hosts.Count > 0)
        {
            _deleteRefusal = $"{string.Join(", ", Hosts.Select(ChangeView.HostTitle))} {(Hosts.Count == 1 ? "uses" : "use")} it. Pick another profile (or none) for them first.";
            Snackbar.Add($"{_storedName} is in use and can't be deleted.", Severity.Warning);
            return;
        }

        await RunReviewAsync(new ReviewRequest($"Delete profile {_storedName}", new DeleteProfileCommand(_model.Id, _model.Version))
        {
            ApplyLabel = "Delete",
            Destructive = true,
            SuccessMessage = $"Deleted the profile {_storedName}",
        });
    }

    private async Task RunReviewAsync(ReviewRequest request)
    {
        _reviewing = true;
        ReviewOutcome outcome;
        try
        {
            outcome = await Drawers.ReviewAsync(request);
        }
        finally
        {
            _reviewing = false;
        }

        if (outcome.Applied is { } applied)
        {
            Level?.Close(applied);
        }
        else if (outcome.Reload)
        {
            await ReloadAsync();
        }
    }

    private void OnInvalid(IReadOnlyList<ConfigError> errors)
    {
        Dictionary<string, string> merged = new(_errors, StringComparer.Ordinal);
        foreach ((string path, string message) in InlineValidation.Relative(errors, string.Empty))
        {
            merged[path] = message;
        }

        _errors = merged;
        _attempted = true;
    }

    private async Task ReloadAsync()
    {
        _model = null;
        await LoadAsync();
        if (Level is not null)
        {
            Level.IsDirty = false;
        }
    }

    private void Cancel() => Level?.RequestClose();

    private async Task OnCommittedAsync(ConfigCommitted committed)
    {
        if (_reviewing || _model is null || _model.IsNew)
        {
            return;
        }

        if (committed.Changes.Any(c => c is ProfileChange p && p.ProfileId == _model.Id))
        {
            _changedElsewhere = committed.Revision;
        }

        try
        {
            _document = (await Config.GetCurrentAsync()).Document;
            _inherited = HostSettingsModel.Layer(_document.Settings.Defaults, HostSettingsModel.BuiltIn);
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't refresh a profile's usage.");
        }

        StateHasChanged();
    }
}
