@using Paduraksa.Application.Compilation
@inherits DraftDrawer<ProfileEditModel, ProfileConfig>

@* A profile in a drawer: a name, notes and the host settings it sets. On its own it goes through Review changes; opened
   from a host's form it is handed back, to be applied with the host in one revision. *@

<DrawerShell Title="@Title"
             Subtitle="@(Staged is not null ? "Not applied yet: it goes in with the host, in one revision." : "Settings that every host with this profile inherits, on top of the global defaults. A host can still set its own.")"
             Icon="@Icons.Material.Outlined.Badge" Name="profile" OnSubmit="SubmitAsync">
    <Banner>
        @if (ChangedElsewhere is { } elsewhere)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" data-banner="changed">
                This profile was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
            </MudAlert>
        }
        @if (DeleteRefusal is { } refusal)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" data-banner="in-use" ShowCloseIcon="true" CloseIconClicked="() => DeleteRefusal = null">
                <strong>@StoredName is still in use, so it can't be deleted.</strong> @refusal
            </MudAlert>
        }
        @if (Failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-alert="load-failed">
                The profile couldn't be read. The details are in the server log.
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
            </MudAlert>
        }
        @if (Denied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@IdentityText.CantReadConfig. @IdentityText.CantReadConfigHelp</MudAlert>
        }
        else if (!MayWrite && Model is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: your role can see this profile but not change it.</MudAlert>
        }
    </Banner>
    <ChildContent>
        @if (Missing)
        {
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such profile" Description="It may have been deleted, or the link is wrong." />
        }
        else if (Model is null || Document is null)
        {
            @if (!Failed && !Denied)
            {
                <div class="pdk-form" aria-busy="true">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mt-2" />
                </div>
            }
        }
        else
        {
            <div class="pdk-form" data-form="profile">
                @if (Attempted && FieldErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pdk-form-summary" data-form="errors">
                        <strong>@(FieldErrors.Count == 1 ? "One thing to fix" : $"{FieldErrors.Count} things to fix"):</strong>
                        <ul class="pdk-error-list">
                            @foreach (var (path, message) in FieldErrors)
                            {
                                <li><span class="pdk-error-where">@ChangeView.Locate(path, null)</span> @message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <FormSection Title="Profile" Name="profile">
                    <div class="pdk-field-grid">
                        <MudTextField T="string" Value="Model.Name" ValueChanged="@(value => Set(() => Model.Name = value, "/name"))" Immediate="true" DebounceInterval="250"
                                      Label="Name" Placeholder="LAN only" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" AutoFocus="Model.IsNew"
                                      Error="@(E("/name") is not null)" ErrorText="@E("/name")" data-field="name" />
                        <MudTextField T="string" Value="Model.Notes" ValueChanged="@(value => Set(() => Model.Notes = value, "/notes"))" Label="Notes"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Error="@(E("/notes") is not null)" ErrorText="@E("/notes")" />
                    </div>
                </FormSection>

                <FormSection Title="Settings" Description="Each one left to inherit takes the global default, shown in brackets." Name="settings">
                    <Aside>
                        <StatusChip Tone="Tone.Primary" Text="@Overrides(SetCount())" Name="overrides" />
                    </Aside>
                    <ChildContent>
                        <HostSettingsFields Settings="Model.Settings" SettingsChanged="SetSettings" Inherited="_inherited" InheritWord="Inherit"
                                            PathPrefix="/settings" Errors="FieldErrors" ShowAll="Attempted" Touched="Touched" ReadOnly="!MayWrite" OnChanged="Touch"
                                            Policies="Document.RateLimitPolicies" AccessLists="Document.AccessLists" RuleSets="Document.RuleSets" AuthProviders="Document.AuthProviders" ProxyMode="Document.Settings.TrustedProxies.Mode" />
                    </ChildContent>
                </FormSection>

                @if (!Stage && !Model.IsNew)
                {
                    <FormSection Title="Used by" Name="usage">
                        @if (Hosts.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pdk-muted">No host uses it yet. Pick it in a host's HTTPS settings.</MudText>
                        }
                        else
                        {
                            <ul class="pdk-list" data-section="usage-list">
                                @foreach (var host in Hosts)
                                {
                                    <li class="pdk-list-row">
                                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Language" Size="Size.Small" /></span>
                                        <span class="pdk-list-main">
                                            <a class="pdk-row-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                            <span class="pdk-list-sub">@(SettingsSummary.Summary(host.Settings, Document) is { Count: > 0 } own ? $"Sets its own: {string.Join(", ", own).ToLowerInvariant()}" : "Takes everything from the profile")</span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </FormSection>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        @if (MayWrite && Model is not null)
        {
            <DrawerActions ShowDelete="@(!Stage && Model.IsNew == false)" OnDelete="ReviewDeleteAsync" OnCancel="Cancel"
                           PrimaryLabel="@(Stage ? "Use this profile" : "Review changes")" PrimaryAction="@(Stage ? "stage" : "review")" Submit="true"
                           StartIcon="@(Stage ? Icons.Material.Rounded.Check : null)" EndIcon="@(Stage ? null : Icons.Material.Rounded.ArrowForward)" />
        }
        else
        {
            <DrawerActions PrimaryLabel="Close" PrimaryAction="cancel" OnPrimary="Cancel" />
        }
    </Footer>
</DrawerShell>

@code {
    private HostSettings _inherited = HostSettingsLayers.BuiltIn;
    private HostSettings? _countedSettings;
    private int _countedSet;

    /// <summary>The profile to edit; null for a new one.</summary>
    [Parameter]
    public ProfileId? Id { get; set; }

    private string Title => Missing ? "Profile not found" : Staged is { } staged ? staged.Name : Model is null ? (Id is null ? "New profile" : "Profile") : Model.IsNew ? "New profile" : StoredName;

    private IReadOnlyList<HostConfig> Hosts =>
        Model is null || Document is null || Model.IsNew ? [] : ProfileEditModel.HostsUsing(Document, Model.Id);

    protected override string LoadFailureMessage => "Couldn't load the profile form.";

    protected override string RefreshFailureMessage => "Couldn't refresh a profile's usage.";

    protected override async Task<ConfigDocument> LoadSourceAsync() => (await Config.GetWorkingAsync()).Document;

    protected override void OnDocumentLoaded() =>
        _inherited = HostSettingsLayers.Merge(HostSettingsLayers.BuiltIn, Document!.Settings.Defaults);

    protected override bool LoadModel(ConfigDocument document)
    {
        if (Id is { } profileId && !Stage)
        {
            if (document.Profiles.FirstOrDefault(p => p.Id == profileId) is not { } profile)
            {
                Missing = true;
                return false;
            }

            StoredName = profile.Name;
            Model = ProfileEditModel.From(profile);
            return true;
        }

        Model = Stage && Staged is { } staged ? ProfileEditModel.FromDraft(staged) : ProfileEditModel.New();
        return true;
    }

    protected override ProfileConfig ToConfig() => Model!.ToConfig();

    protected override string Fingerprint() => Model is null ? string.Empty : StagedChange.Fingerprint(new ConfigDocument(Profiles: [ToConfig()]));

    protected override void Validate()
    {
        if (Model is not null && Document is not null)
        {
            FieldErrors = InlineValidation.ForProfile(Document, Model.ToConfig());
        }
    }

    protected override bool TracksCommits => Model is not { IsNew: true };

    protected override bool IsChangedElsewhere(ConfigCommitted committed) =>
        !Model!.IsNew && committed.Changes.Any(c => c is ProfileChange p && p.ProfileId == Model.Id);

    protected override async Task RefreshAsync()
    {
        Document = (await Config.GetWorkingAsync()).Document;
        OnDocumentLoaded();
    }

    private static string Overrides(int count) => count switch
    {
        0 => "Inherits everything",
        1 => "Sets 1 setting",
        _ => $"Sets {count} settings",
    };

    private void SetSettings(HostSettings settings)
    {
        if (Model is not null)
        {
            Model.Settings = settings;
        }
    }

    /// <summary>How many settings the profile sets, counted once per record instance rather than on every render.</summary>
    private int SetCount()
    {
        var settings = Model?.Settings;
        if (!ReferenceEquals(_countedSettings, settings))
        {
            _countedSettings = settings;
            _countedSet = settings is null ? 0 : HostSettingsEdit.CountSet(settings);
        }

        return _countedSet;
    }

    protected override async Task SubmitAsync()
    {
        if (!CanSubmit())
        {
            return;
        }

        var profile = ToConfig();
        if (Stage)
        {
            Level?.Close(profile);
            return;
        }

        await RunReviewAsync(new ReviewRequest(Model!.IsNew ? $"New profile {profile.Name}" : $"Edit profile {profile.Name}", new UpsertProfileCommand(profile))
        {
            SuccessMessage = Model.IsNew ? $"Created the profile {profile.Name}" : $"Saved the profile {profile.Name}",
            OnInvalid = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalid),
        });
    }

    private async Task ReviewDeleteAsync()
    {
        if (Model is null || Model.IsNew || !MayWrite)
        {
            return;
        }

        if (Hosts.Count > 0)
        {
            DeleteRefusal = $"{string.Join(", ", Hosts.Select(ChangeView.HostTitle))} {(Hosts.Count == 1 ? "uses" : "use")} it. Pick another profile (or none) for them first.";
            Snackbar.Add($"{StoredName} is in use and can't be deleted.", Severity.Warning);
            return;
        }

        await RunReviewAsync(new ReviewRequest($"Delete profile {StoredName}", new DeleteProfileCommand(Model.Id, Model.Version))
        {
            Destructive = true,
            SuccessMessage = $"Deleted the profile {StoredName}",
        });
    }
}
