@using Paduraksa.Application.Commands
@using Paduraksa.Application.Probes
@inject IServiceProvider Services
@inject Microsoft.Extensions.Logging.ILogger<UpstreamDrawer> Logger
@inherits DraftDrawer<UpstreamEditModel, UpstreamConfig>

@* An upstream in a drawer: name, destinations (each checkable with a TCP connection), load balancing and health. On its
   own it goes through Review changes; opened from a host's form it is checked against that form's draft and handed back,
   to be applied with the host in one revision. *@

<DrawerShell Title="@Title"
             Subtitle="@Subtitle" Icon="@Icons.Material.Outlined.Hub" Name="upstream" OnSubmit="SubmitAsync">
    <Banner>
        @if (ChangedElsewhere is { } elsewhere)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" data-banner="changed">
                This upstream was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
            </MudAlert>
        }
        @if (DeleteRefusal is { } refusal)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" data-banner="in-use" ShowCloseIcon="true" CloseIconClicked="() => DeleteRefusal = null">
                <strong>@StoredName is still in use, so it can't be deleted.</strong> @refusal Point those routes at another upstream (or delete them) first.
            </MudAlert>
        }
        @if (Failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-alert="load-failed">
                The upstream couldn't be read. The details are in the server log.
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
            </MudAlert>
        }
        @if (Denied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@IdentityText.CantReadConfig. @IdentityText.CantReadConfigHelp</MudAlert>
        }
        else if (!MayWrite && Model is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: your role can see this upstream but not change it.</MudAlert>
        }
    </Banner>
    <ChildContent>
        @if (Missing)
        {
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such upstream" Description="It may have been deleted, or the link is wrong." />
        }
        else if (Model is null || Document is null)
        {
            @if (!Failed && !Denied)
            {
                <div class="pdk-form" aria-busy="true">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mt-2" />
                </div>
            }
        }
        else
        {
            <div class="pdk-form" data-form="upstream">
                @if (Attempted && FieldErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pdk-form-summary" data-form="errors">
                        <strong>@(FieldErrors.Count == 1 ? "One thing to fix" : $"{FieldErrors.Count} things to fix"):</strong>
                        <ul class="pdk-error-list">
                            @foreach ((string path, string message) in FieldErrors)
                            {
                                <li><span class="pdk-error-where">@ChangeView.Locate(path, null)</span> @message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <FormSection Title="Where requests go" Name="destinations">
                    <MudTextField T="string" Value="Model.Name" ValueChanged="@(value => Set(() => Model.Name = value, "/name"))" Immediate="true" DebounceInterval="250"
                                  Label="Name" Placeholder="jellyfin" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" AutoFocus="Model.IsNew"
                                  Error="@(E("/name") is not null)" ErrorText="@E("/name")" data-field="name" spellcheck="false" autocomplete="off" />

                    <div class="pdk-destination-list">
                        @for (int i = 0; i < Model.Destinations.Count; i++)
                        {
                            int index = i;
                            DestinationEntry destination = Model.Destinations[index];
                            <div class="pdk-destination-row" @key="destination">
                                <MudTextField T="string" Value="destination.Address" ValueChanged="@(value => SetAddress(destination, index, value))"
                                              Immediate="true" DebounceInterval="250" Label="@(index == 0 ? "Address" : $"Address {index + 1}")" Placeholder="http://192.168.1.10:8096"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="pdk-mono-input" ReadOnly="!MayWrite"
                                              HelperText="@(index == 0 ? "An http:// or https:// address, with a port and a base path if needed." : null)"
                                              Error="@(E($"/destinations/{index}/address") is not null)" ErrorText="@E($"/destinations/{index}/address")"
                                              data-field="@($"destination-{index}")" spellcheck="false" autocomplete="off" />
                                <MudSwitch T="bool" Value="destination.Enabled" ValueChanged="@(value => Set(() => destination.Enabled = value, $"/destinations/{index}/enabled"))"
                                           Color="Color.Success" Disabled="!MayWrite" aria-label="@($"Destination {index + 1} enabled")" />
                                @if (MayWrite && Probe is not null)
                                {
                                    <MudTooltip Text="Check that it answers" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Outlined.NetworkCheck" Size="Size.Small" OnClick="() => CheckAsync(destination)" Disabled="_checking.Contains(destination)"
                                                       aria-label="@($"Check destination {index + 1}")" data-action="@($"check-{index}")" />
                                    </MudTooltip>
                                }
                                @if (Model.Destinations.Count > 1 && MayWrite)
                                {
                                    <MudIconButton Icon="@Icons.Material.Outlined.RemoveCircleOutline" Size="Size.Small" OnClick="@(() => Set(() => Model.Destinations.Remove(destination), "/destinations"))"
                                                   aria-label="@($"Remove destination {index + 1}")" />
                                }
                                @if (_probes.TryGetValue(destination, out UpstreamProbeResult? probe))
                                {
                                    <div class="pdk-probe-line" role="status" data-reachable="@(probe.Reachable ? "true" : "false")">
                                        <StatusChip Tone="@(probe.Reachable ? Tone.Success : probe.Outcome == UpstreamProbeOutcome.Invalid ? Tone.Warning : Tone.Error)" Dot="true"
                                                    Text="@ProbeWord(probe)" />
                                        <span class="pdk-muted">@ProbeText(probe)</span>
                                    </div>
                                }
                            </div>
                        }
                        @if (FirstUnder("/destinations", exact: true) is { } destinationsError)
                        {
                            <div class="pdk-field-error">@destinationsError</div>
                        }
                        @if (MayWrite)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add" OnClick="@(() => Set(Model.AddDestination, "/destinations"))" Class="pdk-add">Add a destination</MudButton>
                        }
                    </div>
                </FormSection>

                <FormSection Title="Load balancing and health" Name="health">
                    <div class="pdk-field-grid">
                        <MudSelect T="LoadBalancingPolicy?" Value="Model.LoadBalancing" ValueChanged="@(value => Set(() => Model.LoadBalancing = value, "/loadBalancing"))" Label="Load balancing"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ReadOnly="!MayWrite">
                            <MudSelectItem T="LoadBalancingPolicy?" Value="null">Default (power of two choices)</MudSelectItem>
                            <MudSelectItem T="LoadBalancingPolicy?" Value="LoadBalancingPolicy.RoundRobin">Round robin</MudSelectItem>
                            <MudSelectItem T="LoadBalancingPolicy?" Value="LoadBalancingPolicy.LeastRequests">Least requests</MudSelectItem>
                            <MudSelectItem T="LoadBalancingPolicy?" Value="LoadBalancingPolicy.Random">Random</MudSelectItem>
                            <MudSelectItem T="LoadBalancingPolicy?" Value="LoadBalancingPolicy.PowerOfTwoChoices">Power of two choices (pinned)</MudSelectItem>
                            <MudSelectItem T="LoadBalancingPolicy?" Value="LoadBalancingPolicy.FirstAlphabetical">First alphabetical (failover)</MudSelectItem>
                        </MudSelect>
                        <div class="pdk-span-2 pdk-health">
                            <MudSwitch T="bool" Value="Model.SessionAffinity" ValueChanged="@(value => Set(() => Model.SessionAffinity = value, "/sessionAffinity"))" Color="Color.Primary"
                                       Label="Sticky sessions (cookie)" Disabled="!MayWrite" />
                            <MudSwitch T="bool" Value="Model.ActiveHealth" ValueChanged="@(value => Set(() => Model.ActiveHealth = value, "/activeHealth"))" Color="Color.Primary"
                                       Label="Active health checks (probe each destination on a schedule)" Disabled="!MayWrite" data-field="active-health" />
                            @if (Model.ActiveHealth)
                            {
                                <div class="pdk-field-grid pdk-field-grid-3">
                                    <MudTextField T="string" Value="Model.HealthPath" ValueChanged="@(value => Set(() => Model.HealthPath = value, "/activeHealth/path"))" Label="Path"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="pdk-mono-input" ReadOnly="!MayWrite"
                                                  Error="@(E("/activeHealth/path") is not null)" ErrorText="@E("/activeHealth/path")" />
                                    <MudNumericField T="int" Value="Model.HealthIntervalSeconds" ValueChanged="@(value => Set(() => Model.HealthIntervalSeconds = value, "/activeHealth/interval"))"
                                                     Label="Every (seconds)" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite"
                                                     Error="@(E("/activeHealth/interval") is not null)" ErrorText="@E("/activeHealth/interval")" />
                                    <MudNumericField T="int" Value="Model.HealthTimeoutSeconds" ValueChanged="@(value => Set(() => Model.HealthTimeoutSeconds = value, "/activeHealth/timeout"))"
                                                     Label="Timeout (seconds)" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite"
                                                     Error="@(E("/activeHealth/timeout") is not null)" ErrorText="@E("/activeHealth/timeout")" />
                                </div>
                            }
                            <MudSwitch T="bool" Value="Model.PassiveHealth" ValueChanged="@(value => Set(() => Model.PassiveHealth = value, "/passiveHealth"))" Color="Color.Primary"
                                       Label="Passive health checks (take a destination out after failed requests)" Disabled="!MayWrite" />
                            @if (Model.PassiveHealth)
                            {
                                <MudNumericField T="int?" Value="Model.ReactivationSeconds" ValueChanged="@(value => Set(() => Model.ReactivationSeconds = value, "/passiveHealth/reactivationPeriod"))"
                                                 Label="Back in rotation after (seconds)" Placeholder="YARP's default" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite"
                                                 Error="@(E("/passiveHealth/reactivationPeriod") is not null)" ErrorText="@E("/passiveHealth/reactivationPeriod")" />
                            }
                        </div>
                    </div>
                </FormSection>

                <MudExpansionPanels Elevation="0" Outlined="true" Class="pdk-advanced">
                    <MudExpansionPanel Text="Advanced">
                        <TitleContent>
                            <div class="pdk-advanced-title">
                                <MudText Typo="Typo.subtitle1">Advanced</MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <div class="pdk-field-grid">
                                <MudNumericField T="int?" Value="Model.MaxConnectionsPerServer" ValueChanged="@(value => Set(() => Model.MaxConnectionsPerServer = value, "/maxConnectionsPerServer"))"
                                                 Label="Connections per destination" Placeholder="No limit" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite"
                                                 Error="@(E("/maxConnectionsPerServer") is not null)" ErrorText="@E("/maxConnectionsPerServer")" />
                                <MudTextField T="string" Value="Model.Notes" ValueChanged="@(value => Set(() => Model.Notes = value, "/notes"))" Label="Notes" Lines="2" Sizing="InputSizing.Auto"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Class="pdk-span-2" />
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                @if (!Stage && !Model.IsNew)
                {
                    <FormSection Title="Used by" Name="usage">
                        @if (Uses.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pdk-muted">No host sends requests here yet. Pick it for a route in a host.</MudText>
                        }
                        else
                        {
                            <ul class="pdk-list" data-section="usage-list">
                                @foreach ((HostConfig host, RouteConfig route) in Uses)
                                {
                                    <li class="pdk-list-row">
                                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Language" Size="Size.Small" /></span>
                                        <span class="pdk-list-main">
                                            <a class="pdk-row-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                            <span class="pdk-list-sub pdk-mono">@(route.Match == RouteMatchKind.Exact ? "= " : string.Empty)@route.Path</span>
                                        </span>
                                        @if (!host.Enabled)
                                        {
                                            <StatusChip Text="Off" />
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </FormSection>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="pdk-drawer-actions">
            @if (!Stage && Model is { IsNew: false } && MayWrite)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="ReviewDeleteAsync" data-action="delete"
                           Class="pdk-drawer-actions-start">Delete</MudButton>
            }
            @if (MayWrite && Model is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="Cancel" data-action="cancel">Cancel</MudButton>
                @if (Stage)
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Check" data-action="stage">
                        Use this upstream
                    </MudButton>
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">
                        Review changes
                    </MudButton>
                }
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cancel" data-action="cancel">Close</MudButton>
            }
        </div>
    </Footer>
</DrawerShell>

@code {
    private readonly Dictionary<DestinationEntry, UpstreamProbeResult> _probes = [];
    private readonly HashSet<DestinationEntry> _checking = [];

    /// <summary>The reachability check (the admin app registers it; without it there is no Check button).</summary>
    private UpstreamProbe? Probe => Services.GetService(typeof(UpstreamProbe)) as UpstreamProbe;

    /// <summary>The upstream to edit; null for a new one.</summary>
    [Parameter]
    public UpstreamId? Id { get; set; }

    /// <summary>A name to start a new upstream with.</summary>
    [Parameter]
    public string? SuggestedName { get; set; }

    private string Title => Missing ? "Upstream not found" : Staged is { } staged ? staged.Name : Model is null ? (Id is null ? "New upstream" : "Upstream") : Model.IsNew ? "New upstream" : StoredName;

    private string? Subtitle => Stage
        ? Staged is null ? "It is applied together with the host, in one revision." : "Not applied yet: it goes in with the host, in one revision."
        : null;

    private IReadOnlyList<(HostConfig Host, RouteConfig Route)> Uses =>
        Model is null || Document is null || Model.IsNew ? [] : HostOverview.UsesOf(Document, Model.Id);

    /// <summary><paramref name="basis"/>, or with a number after it when an upstream of <paramref name="document"/> is called that already.</summary>
    public static string UniqueName(ConfigDocument document, string basis)
    {
        ArgumentNullException.ThrowIfNull(document);
        string name = string.IsNullOrWhiteSpace(basis) ? "upstream" : basis.Trim().ToLowerInvariant();
        string candidate = name;
        for (int i = 2; document.Upstreams.Any(u => string.Equals(u.Name, candidate, StringComparison.OrdinalIgnoreCase)); i++)
        {
            candidate = $"{name}-{i}";
        }

        return candidate;
    }

    protected override string LoadFailureMessage => "Couldn't load the upstream form.";

    protected override string RefreshFailureMessage => "Couldn't refresh an upstream's usage.";

    protected override void OnReset() => _probes.Clear();

    protected override async Task<ConfigDocument> LoadSourceAsync() => (await Config.GetCurrentAsync()).Document;

    protected override bool LoadModel(ConfigDocument document)
    {
        if (Id is { } upstreamId && !Stage)
        {
            if (document.Upstreams.FirstOrDefault(u => u.Id == upstreamId) is not { } upstream)
            {
                Missing = true;
                return false;
            }

            StoredName = upstream.Name;
            Model = UpstreamEditModel.From(upstream);
            return true;
        }

        Model = Stage && Staged is { } staged ? UpstreamEditModel.FromDraft(staged) : UpstreamEditModel.New();
        if (Staged is null)
        {
            Model.Name = SuggestedName ?? string.Empty;
        }

        return true;
    }

    protected override UpstreamConfig ToConfig() => Model!.ToConfig();

    protected override string Fingerprint() => Model is null ? string.Empty : StagedChange.Fingerprint(new ConfigDocument(Upstreams: [ToConfig()]));

    protected override void Validate()
    {
        if (Model is not null && Document is not null)
        {
            FieldErrors = InlineValidation.ForUpstream(Document, Model.ToConfig());
        }
    }

    protected override bool TracksCommits => Model is not { IsNew: true };

    protected override bool IsChangedElsewhere(ConfigCommitted committed) =>
        !Model!.IsNew && committed.Changes.Any(c => (c is UpstreamChange u && u.UpstreamId == Model.Id) || (c is DestinationChange d && d.UpstreamId == Model.Id));

    protected override async Task RefreshAsync() => Document = (await Config.GetCurrentAsync()).Document;

    private string? FirstUnder(string prefix, bool exact) =>
        Attempted || Touched.Contains(prefix)
            ? FieldErrors.Where(e => exact ? e.Key == prefix : e.Key.StartsWith(prefix, StringComparison.Ordinal)).Select(e => e.Value).FirstOrDefault()
            : null;

    private void SetAddress(DestinationEntry destination, int index, string value)
    {
        _probes.Remove(destination);
        Set(() => destination.Address = value, $"/destinations/{index}/address");
    }

    private async Task CheckAsync(DestinationEntry destination)
    {
        CommandOrigin? origin = await Caller.OriginAsync();
        if (origin is null || Probe is not { } probe)
        {
            return;
        }

        _checking.Add(destination);
        try
        {
            await Logger.TryAsync(Snackbar, "The check couldn't run.", async () => _probes[destination] = await probe.CheckAsync(destination.Address, origin));
        }
        finally
        {
            _checking.Remove(destination);
        }
    }

    private static string ProbeWord(UpstreamProbeResult probe) => probe.Outcome switch
    {
        UpstreamProbeOutcome.Reachable => "Reachable",
        UpstreamProbeOutcome.Unreachable => "Unreachable",
        UpstreamProbeOutcome.Denied => "Not allowed",
        _ => "Not checked",
    };

    private static string ProbeText(UpstreamProbeResult probe) => probe.Outcome switch
    {
        UpstreamProbeOutcome.Reachable => "The server opened a connection to it.",
        UpstreamProbeOutcome.Unreachable => $"No connection within {(int)UpstreamProbe.Timeout.TotalSeconds} seconds. Requests get 502 until it is up.",
        UpstreamProbeOutcome.Denied => IdentityText.CantChangeConfig,
        _ => probe.Message ?? "The address can't be checked.",
    };

    private async Task SubmitAsync()
    {
        if (!CanSubmit())
        {
            return;
        }

        UpstreamConfig upstream = ToConfig();
        if (Stage)
        {
            Level?.Close(upstream);
            return;
        }

        await RunReviewAsync(new ReviewRequest(Model!.IsNew ? $"New upstream {upstream.Name}" : $"Edit {upstream.Name}", new UpsertUpstreamCommand(upstream))
        {
            SuccessMessage = Model.IsNew ? $"Created {upstream.Name}" : $"Saved {upstream.Name}",
            OnInvalid = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalid),
        });
    }

    private async Task ReviewDeleteAsync()
    {
        if (Model is null || Model.IsNew || !MayWrite)
        {
            return;
        }

        // Refused here with the routes named, rather than by the dry run with a pointer: the service would refuse it the same way.
        if (Uses.Count > 0)
        {
            DeleteRefusal = $"{string.Join(", ", Uses.Select(u => $"{ChangeView.HostTitle(u.Host)} (route {u.Route.Path})"))} {(Uses.Count == 1 ? "sends" : "send")} requests to it.";
            Snackbar.Add($"{StoredName} is still in use and can't be deleted.", Severity.Warning);
            return;
        }

        await RunReviewAsync(new ReviewRequest($"Delete {StoredName}", new DeleteUpstreamCommand(Model.Id, Model.Version))
        {
            ApplyLabel = "Delete",
            Destructive = true,
            SuccessMessage = $"Deleted {StoredName}",
        });
    }
}
