@inherits DraftDrawer<AccessListEditModel, AccessListConfig>

@* An access list in a drawer: a name, the addresses it allows and denies, and the users it asks a password of. On its own it goes
   through Review changes; opened from a host's form it is handed back, to be applied with the host in one revision. Its ID is
   never shown: a host or a route picks it by name. A password is typed or generated here, sent once and never read back. *@

<DrawerShell Title="@Title"
             Subtitle="@(Staged is not null ? "Not applied yet: it goes in with the host, in one revision." : null)"
             Icon="@Icons.Material.Outlined.Lock" Name="access-list" OnSubmit="SubmitAsync">
    <Banner>
        @if (ChangedElsewhere is { } elsewhere)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" data-banner="changed">
                This access list was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
            </MudAlert>
        }
        @if (DeleteRefusal is { } refusal)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" data-banner="in-use" ShowCloseIcon="true" CloseIconClicked="() => DeleteRefusal = null">
                <strong>@StoredName is still in use, so it can't be deleted.</strong> @refusal
            </MudAlert>
        }
        @if (Failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-alert="load-failed">
                The access list couldn't be read. The details are in the server log.
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
            </MudAlert>
        }
        @if (Denied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@IdentityText.CantReadConfig. @IdentityText.CantReadConfigHelp</MudAlert>
        }
        else if (!MayWrite && Model is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: your role can see this access list but not change it.</MudAlert>
        }
    </Banner>
    <ChildContent>
        @if (Missing)
        {
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such access list" Description="It may have been deleted, or the link is wrong." />
        }
        else if (Model is null || Document is null)
        {
            @if (!Failed && !Denied)
            {
                <div class="pdk-form" aria-busy="true">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mt-2" />
                </div>
            }
        }
        else
        {
            <div class="pdk-form" data-form="access-list">
                @if (Attempted && FieldErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pdk-form-summary" data-form="errors">
                        <strong>@(FieldErrors.Count == 1 ? "One thing to fix" : $"{FieldErrors.Count} things to fix"):</strong>
                        <ul class="pdk-error-list">
                            @foreach (var (path, message) in FieldErrors)
                            {
                                <li><span class="pdk-error-where">@ChangeView.Locate(path, null)</span> @message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <FormSection Title="Access list" Name="access-list">
                    <div class="pdk-field-grid">
                        <MudTextField T="string" Value="Model.Name" ValueChanged="@(value => Set(() => Model.Name = value, "/name"))" Immediate="true" DebounceInterval="250"
                                      Label="Name" Placeholder="Office" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" AutoFocus="Model.IsNew"
                                      Error="@(E("/name") is not null)" ErrorText="@E("/name")" data-field="name" />
                        <MudTextField T="string" Value="Model.Notes" ValueChanged="@(value => Set(() => Model.Notes = value, "/notes"))" Label="Notes"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Error="@(E("/notes") is not null)" ErrorText="@E("/notes")" />
                    </div>
                </FormSection>

                <FormSection Title="Addresses" Name="addresses"
                             Description="IP addresses and networks, one per line. A denied address is always refused. With allowed addresses listed, only those get in. Countries and addresses both have to allow a visitor.">
                    <AddressListField Label="Allowed" Placeholder="192.168.1.0/24" Count="Model.AllowCount" Text="@Model.AllowText" ReadOnly="!MayWrite"
                                      TextChanged="@(value => Set(() => Model.AllowText = value, "/ip/allow"))" Error="@FirstUnder("/ip/allow")" Field="allowed" />
                    <AddressListField Label="Denied" Placeholder="203.0.113.9" Count="Model.DenyCount" Text="@Model.DenyText" ReadOnly="!MayWrite"
                                      TextChanged="@(value => Set(() => Model.DenyText = value, "/ip/deny"))" Error="@FirstUnder("/ip/deny")" Field="denied" />
                    <MudSwitch T="bool" Value="Model.DropDenied" ValueChanged="@(value => Set(() => Model.DropDenied = value, "/ip/dropDenied"))" Color="Color.Primary" ReadOnly="!MayWrite"
                               Label="Drop refused connections without an answer" data-field="drop-denied" />
                    @if (E("/ip/dropDenied") is { } dropError)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" data-error="drop-denied">@dropError</MudText>
                    }
                </FormSection>

                <FormSection Title="Countries" Name="countries"
                             Description="The visitor's country, as Cloudflare reports it. A denied country is always refused. With allowed countries listed, only those get in, so a visitor whose country is unknown is refused unless Unknown country is allowed.">
                    @if (!CountryKnown)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" data-banner="no-country-source">
                            The trusted-proxy mode isn't Cloudflare, so every visitor's country is unknown. Change it in <MudLink Href="@DashboardRoutes.Settings" Color="Color.Inherit" Underline="Underline.Always">Settings</MudLink>.
                        </MudAlert>
                    }
                    <CountryPicker Label="Allowed countries" Field="allowed-countries" Selected="Model.AllowCountries" Excluded="Model.DenyCountries" ReadOnly="!MayWrite"
                                   SelectedChanged="@(value => Set(() => Model.AllowCountries = value, "/ip/countries/allow"))" Error="@FirstUnder("/ip/countries/allow")" />
                    <CountryPicker Label="Denied countries" Field="denied-countries" Selected="Model.DenyCountries" Excluded="Model.AllowCountries" ReadOnly="!MayWrite"
                                   SelectedChanged="@(value => Set(() => Model.DenyCountries = value, "/ip/countries/deny"))" Error="@FirstUnder("/ip/countries/deny")" />
                </FormSection>

                <FormSection Title="Passwords" Name="passwords"
                             Description="Visitors sign in with HTTP basic auth. Passwords are kept in the vault and can't be shown again.">
                    <MudTextField T="string" Value="Model.Realm" ValueChanged="@(value => Set(() => Model.Realm = value, "/basicAuth/realm"))" Immediate="true" DebounceInterval="250"
                                  Label="Realm" Placeholder="@(string.IsNullOrWhiteSpace(Model.Name) ? "The list's name" : Model.Name.Trim())" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite"
                                  HelperText="The name the browser's sign-in prompt shows."
                                  Error="@(E("/basicAuth/realm") is not null)" ErrorText="@E("/basicAuth/realm")" data-field="realm" />

                    @if (Model.Users.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pdk-muted" data-section="no-users">No users: only the addresses apply.</MudText>
                    }
                    else
                    {
                        <ul class="pdk-user-rows" data-section="users">
                            @for (var i = 0; i < Model.Users.Count; i++)
                            {
                                var index = i;
                                var user = Model.Users[index];
                                <li class="pdk-user-row" data-user="@index" @key="user">
                                    <MudTextField T="string" Value="user.Username" ValueChanged="@(value => Set(() => user.Username = value, $"/basicAuth/users/{index}/username"))" Immediate="true" DebounceInterval="250"
                                                  Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Class="pdk-mono-input"
                                                  Error="@(E($"/basicAuth/users/{index}/username") is not null)" ErrorText="@E($"/basicAuth/users/{index}/username")"
                                                  data-field="@($"username-{index}")" spellcheck="false" autocomplete="off" />
                                    <MudTextField T="string" Value="user.Password" ValueChanged="@(value => SetPassword(user, index, value))" Immediate="true" DebounceInterval="250"
                                                  Label="@(user.StoredCredential is null || user.LacksPassword ? "Password" : "New password")" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!MayWrite" Class="pdk-mono-input"
                                                  InputType="@(user.Revealed ? InputType.Text : InputType.Password)"
                                                  Placeholder="@(user.StoredCredential is null || user.LacksPassword ? string.Empty : "Unchanged")"
                                                  HelperText="@PasswordHelp(user)"
                                                  Error="@(PasswordError(index) is not null)" ErrorText="@PasswordError(index)"
                                                  data-field="@($"password-{index}")" spellcheck="false" autocomplete="new-password" />
                                    @if (MayWrite)
                                    {
                                        <div class="pdk-user-actions">
                                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Casino" OnClick="() => Generate(user, index)"
                                                       data-action="@($"generate-{index}")">Generate</MudButton>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveUser(user)"
                                                           aria-label="@RemoveLabel(user)" data-action="@($"remove-user-{index}")" />
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    @if (MayWrite)
                    {
                        <div>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add" OnClick="AddUser" data-action="add-user">Add user</MudButton>
                        </div>
                    }
                </FormSection>

                @if (Model.Users.Count > 0)
                {
                    <FormSection Title="How they combine" Name="combine">
                        <MudSelect T="AccessListSatisfy" Value="Model.Satisfy" ValueChanged="@(value => Set(() => Model.Satisfy = value, "/satisfy"))"
                                   Label="A visitor must pass" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ReadOnly="!MayWrite"
                                   HelperText="@SatisfyHelp" Error="@(E("/satisfy") is not null)" ErrorText="@E("/satisfy")" data-field="satisfy">
                            <MudSelectItem Value="AccessListSatisfy.All">@AccessListText.SatisfyText(AccessListSatisfy.All)</MudSelectItem>
                            <MudSelectItem Value="AccessListSatisfy.Any">@AccessListText.SatisfyText(AccessListSatisfy.Any)</MudSelectItem>
                        </MudSelect>
                        <MudSwitch T="bool" Value="Model.PassCredentialsUpstream" ValueChanged="@(value => Set(() => Model.PassCredentialsUpstream = value, "/passCredentialsUpstream"))"
                                   Color="Color.Primary" ReadOnly="!MayWrite" Label="Send the Authorization header to the upstream" data-field="pass-credentials" />
                    </FormSection>
                }

                @if (!Stage && !Model.IsNew)
                {
                    <FormSection Title="Used by" Name="usage">
                        @if (Usage.IsEmpty)
                        {
                            <MudText Typo="Typo.body2" Class="pdk-muted">No host or route uses it yet. Pick it in a host's Access settings.</MudText>
                        }
                        else
                        {
                            <ul class="pdk-list" data-section="usage-list">
                                @foreach (var host in Usage.Hosts)
                                {
                                    <li class="pdk-list-row">
                                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Language" Size="Size.Small" /></span>
                                        <span class="pdk-list-main">
                                            <a class="pdk-row-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                            <span class="pdk-list-sub">Guards the routes that name no list of their own</span>
                                        </span>
                                    </li>
                                }
                                @foreach (var use in Usage.Routes)
                                {
                                    <li class="pdk-list-row">
                                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.AltRoute" Size="Size.Small" /></span>
                                        <span class="pdk-list-main">
                                            <a class="pdk-row-link" href="@DashboardRoutes.Host(use.Host.Id)">@ChangeView.HostTitle(use.Host)</a>
                                            <span class="pdk-list-sub">Route @use.Route.Path uses it</span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </FormSection>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        @if (MayWrite && Model is not null)
        {
            <DrawerActions ShowDelete="@(!Stage && Model.IsNew == false && Usage.IsEmpty)" OnDelete="ReviewDeleteAsync" OnCancel="Cancel"
                           PrimaryLabel="@(Stage ? "Use this access list" : "Review changes")" PrimaryAction="@(Stage ? "stage" : "review")" Submit="true"
                           StartIcon="@(Stage ? Icons.Material.Rounded.Check : null)" EndIcon="@(Stage ? null : Icons.Material.Rounded.ArrowForward)" />
        }
        else
        {
            <DrawerActions PrimaryLabel="Close" PrimaryAction="cancel" OnPrimary="Cancel" />
        }
    </Footer>
</DrawerShell>

@code {
    /// <summary>The list to edit; null for a new one.</summary>
    [Parameter]
    public AccessListId? Id { get; set; }

    private string Title => Missing ? "Access list not found" : Staged is { } staged ? staged.Name : Model is null ? (Id is null ? "New access list" : "Access list") : Model.IsNew ? "New access list" : StoredName;

    private AccessListUsage Usage =>
        Model is null || Document is null || Model.IsNew ? new AccessListUsage([], []) : AccessListUsageOf.Find(Document, Model.Id);

    private string SatisfyHelp => Model is { Satisfy: AccessListSatisfy.Any }
        ? "A visitor the allowed addresses and countries admit gets in without a password; any other visitor, a blocked country included, can still sign in. A denied address or country is refused even with the right password."
        : "The address and country have to be allowed, and then the visitor has to sign in.";

    private bool CountryKnown => Document?.Settings.TrustedProxies.Mode is TrustedProxyMode.CloudflareProxy or TrustedProxyMode.CloudflareTunnel;

    protected override string LoadFailureMessage => "Couldn't load the access-list form.";

    protected override string RefreshFailureMessage => "Couldn't refresh an access list's usage.";

    protected override async Task<ConfigDocument> LoadSourceAsync() => (await Config.GetWorkingAsync()).Document;

    protected override bool LoadModel(ConfigDocument document)
    {
        if (Id is { } listId && !Stage)
        {
            if (document.AccessLists.FirstOrDefault(l => l.Id == listId) is not { } list)
            {
                Missing = true;
                return false;
            }

            StoredName = list.Name;
            Model = AccessListEditModel.From(list);
            MarkUsersWithoutPassword(document, list);
            return true;
        }

        Model = Stage && Staged is { } staged ? AccessListEditModel.FromDraft(staged) : AccessListEditModel.New();
        return true;
    }

    protected override AccessListConfig ToConfig() => Model!.ToConfig();

    protected override string Fingerprint() =>
        Model is null ? string.Empty : StagedChange.Fingerprint(new ConfigDocument(AccessLists: [ToConfig()]));

    protected override void Validate()
    {
        if (Model is not null && Document is not null)
        {
            FieldErrors = InlineValidation.ForAccessList(Document, Model.ToConfig());
        }
    }

    protected override bool TracksCommits => Model is not { IsNew: true };

    protected override bool IsChangedElsewhere(ConfigCommitted committed) =>
        !Model!.IsNew && committed.Changes.Any(c => c is AccessListChange list && list.AccessListId == Model.Id);

    protected override async Task RefreshAsync()
    {
        Document = (await Config.GetWorkingAsync()).Document;
    }

    // The live config's warnings point at the user's own entry (/accessLists/N/basicAuth/users/M), the order the form was filled in.
    private void MarkUsersWithoutPassword(ConfigDocument document, AccessListConfig list)
    {
        var listPath = $"/accessLists/{document.AccessLists.ToList().FindIndex(l => l.Id == list.Id)}";
        var warned = Config.LiveWarnings
            .Where(w => w.Code == Paduraksa.Application.Config.ConfigWarningCodes.AccessListUserNoPassword)
            .Select(w => w.Path)
            .ToHashSet(StringComparer.Ordinal);
        var stored = list.BasicAuth?.Users ?? [];
        for (var i = 0; i < Model!.Users.Count && i < stored.Count; i++)
        {
            Model.Users[i].LacksPassword = Model.Users[i].StoredCredential is not null && warned.Contains($"{listPath}/basicAuth/users/{i}");
        }
    }

    private string? FirstUnder(string path) =>
        FieldErrors.Where(error => error.Key == path || error.Key.StartsWith(path + "/", StringComparison.Ordinal))
            .Select(error => (Touched.Contains(path) || Attempted) ? error.Value : null).FirstOrDefault(message => message is not null);

    private string? PasswordError(int index) => E($"/basicAuth/users/{index}/password");

    private static string? PasswordHelp(AccessListUserEntry user) =>
        user.Revealed && !string.IsNullOrEmpty(user.Password) ? "Copy it now: once the list is saved it can't be shown again."
        : user.LacksPassword && string.IsNullOrEmpty(user.Password) ? "No password is set, so this user can't sign in."
        : null;

    private static string RemoveLabel(AccessListUserEntry user) => string.IsNullOrEmpty(user.Username) ? "Remove user" : $"Remove {user.Username}";

    private void AddUser()
    {
        Model!.Users.Add(new AccessListUserEntry());
        Changed();
    }

    private void RemoveUser(AccessListUserEntry user)
    {
        Model!.Users.Remove(user);
        Changed();
    }

    private void SetPassword(AccessListUserEntry user, int index, string? value)
    {
        Set(() =>
        {
            user.Password = value;

            // Typing over a generated password is an ordinary edit: it is masked again.
            user.Revealed = false;
        }, $"/basicAuth/users/{index}/password");
    }

    private void Generate(AccessListUserEntry user, int index) =>
        Set(() =>
        {
            user.Password = AccessListUserEntry.Generate();
            user.Revealed = true;
        }, $"/basicAuth/users/{index}/password");

    protected override async Task SubmitAsync()
    {
        if (!CanSubmit())
        {
            return;
        }

        var list = ToConfig();
        if (Stage)
        {
            Level?.Close(list);
            return;
        }

        await RunReviewAsync(new ReviewRequest(Model!.IsNew ? $"New access list {list.Name}" : $"Edit access list {list.Name}", new UpsertAccessListCommand(list))
        {
            SuccessMessage = Model.IsNew ? $"Created the access list {list.Name}" : $"Saved the access list {list.Name}",
            OnInvalid = EventCallback.Factory.Create<IReadOnlyList<ConfigError>>(this, OnInvalid),
        });
    }

    private async Task ReviewDeleteAsync()
    {
        if (Model is null || Model.IsNew || !MayWrite)
        {
            return;
        }

        if (!Usage.IsEmpty)
        {
            DeleteRefusal = $"{Usage.CountText} {(Usage.Hosts.Count == 1 && Usage.Routes.Count == 0 ? "uses" : "use")} it. "
                + "Pick another access list (or none) for them first.";
            Snackbar.Add($"{StoredName} is in use and can't be deleted.", Severity.Warning);
            return;
        }

        await RunReviewAsync(new ReviewRequest($"Delete access list {StoredName}", new DeleteAccessListCommand(Model.Id, Model.Version))
        {
            Destructive = true,
            SuccessMessage = $"Deleted the access list {StoredName}",
        });
    }
}
