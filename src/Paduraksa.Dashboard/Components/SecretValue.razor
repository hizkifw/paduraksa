@inject DashboardBrowser Browser
@* A value shown once (an API token, the authenticator key, recovery codes): the owner clears it when the dialog closes,
   and this component keeps nothing of it. *@
<div class="pdk-secret @(Multiline ? "pdk-secret-multiline" : null)" data-secret="@Name">
    @if (Label is not null)
    {
        <span class="pdk-secret-label">@Label</span>
    }
    <div class="pdk-secret-row">
        <code class="pdk-secret-value" tabindex="0" aria-label="@(Label ?? "Value")">@Value</code>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@(_copied ? Icons.Material.Rounded.Check : Icons.Material.Outlined.ContentCopy)"
                   OnClick="CopyAsync" Class="pdk-secret-copy" data-action="copy">@(_copied ? "Copied" : "Copy")</MudButton>
    </div>
</div>

@code {
    private bool _copied;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Label { get; set; }

    /// <summary>The value has several lines (recovery codes).</summary>
    [Parameter]
    public bool Multiline { get; set; }

    /// <summary>A name for tests (<c>data-secret</c>).</summary>
    [Parameter]
    public string? Name { get; set; }

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    private async Task CopyAsync()
    {
        _copied = await Browser.CopyAsync(Value);
        if (!_copied)
        {
            Snackbar.Add("The browser didn't allow copying. Select the text and copy it yourself.", Severity.Warning);
        }
    }
}
