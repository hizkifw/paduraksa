@* A value shown once (an API token, a request ID): the owner clears it when the dialog closes, and this component keeps nothing
   of it. *@
<CopyableCode Value="@Value" Label="@Label" Multiline="Multiline" Secret="true" data-secret="@Name" />

@code {
    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Label { get; set; }

    /// <summary>The value has several lines (recovery codes).</summary>
    [Parameter]
    public bool Multiline { get; set; }

    /// <summary>A name for tests (<c>data-secret</c>).</summary>
    [Parameter]
    public string? Name { get; set; }
}
