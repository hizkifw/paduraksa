@typeparam TItem
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DraftState Drafts
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<SecurityObjectList<TItem>> Logger
@* A list page of one kind of named object that hosts and routes pick. Each row says what the object does and which hosts and routes apply it;
   one in use can't be deleted, so its delete button is not offered. The list's address with an object's ID is that list with its drawer
   open, and with <c>new</c> a new object's. *@

<PageTitle>@Title · Paduraksa</PageTitle>

<PageHeader Title="@Title" ListEmpty="@(_document is not null && Kind.Items(_document).Count == 0)">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Href="@Kind.NewRoute" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="@AddAction">Add @Kind.Noun</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <ConfigDenied />
}
else
{
    @if (_failed)
    {
        <LoadFailedAlert What="@($"The {Kind.Plural}")" OnRetry="LoadAsync" Class="mb-4" />
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true" data-section="@Kind.Section">
        @if (_document is null)
        {
            <RowSkeleton Rows="3" Widths="24% 36% 20%" />
        }
        else if (Kind.Items(_document).Count == 0)
        {
            <EmptyState Icon="@Kind.Icon" Title="@($"No {Kind.Plural} yet")" Description="@Kind.EmptyDescription">
                <Action>
                    @if (_mayWrite)
                    {
                        <MudButton Href="@Kind.NewRoute" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="@AddAction">Add @Kind.Noun</MudButton>
                    }
                </Action>
            </EmptyState>
        }
        else
        {
            <div class="@($"pdk-dt pdk-{Dashed(Kind.Plural)}-table")" role="table" aria-label="@Title">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">@Capitalised(Kind.Noun)</span>
                    <span role="columnheader">@Kind.SummaryHeading</span>
                    <span role="columnheader">Used by</span>
                    <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
                </div>
                @foreach (var item in Kind.Items(_document).OrderBy(Kind.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var name = Kind.Name(item);
                    var usage = Kind.Usage(_document, item);
                    <div class="pdk-dt-row pdk-dt-link" role="row" @onclick="() => Navigation.NavigateTo(Kind.Route(item))" @attributes="RowAttributes(name)" @key="Kind.Route(item)">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Kind.Icon" Size="Size.Small" /></span>
                            <div class="pdk-dt-titles">
                                <a class="pdk-row-link" href="@Kind.Route(item)" @onclick:stopPropagation="true">@name</a>
                                <DraftChip Target="@Kind.DraftTarget(item)" />
                                @if (!string.IsNullOrWhiteSpace(Kind.Notes(item)))
                                {
                                    <span class="pdk-dt-note">@Kind.Notes(item)</span>
                                }
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="@Kind.SummaryHeading">
                            <span class="pdk-dt-note">@Kind.Summary(item)</span>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Used by" @onclick:stopPropagation="true">
                            <UsageCell Usage="usage" />
                        </div>
                        <div role="cell" class="pdk-dt-cell pdk-dt-actions" @onclick:stopPropagation="true">
                            @if (_mayWrite && usage.IsEmpty)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ReviewDeleteAsync(item)"
                                               aria-label="@($"Delete {name}")" data-action="delete" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>

    @if (_document is not null)
    {
        @(After?.Invoke((_document, _mayWrite)))
    }
}

@code {
    private bool _denied;
    private bool _failed;
    private bool _mayWrite;
    private bool _loaded;
    private ConfigDocument? _document;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;

    [Parameter, EditorRequired]
    public SecurityObjectKind<TItem> Kind { get; set; } = default!;

    /// <summary>The address's last segment: an object's ID, or <c>new</c>; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    /// <summary>The new-object drawer's parameters (a rule set starts from a preset).</summary>
    [Parameter]
    public IReadOnlyDictionary<string, object?>? NewParameters { get; set; }

    /// <summary>More under the list once it is loaded, given the document and whether the person may write.</summary>
    [Parameter]
    public RenderFragment<(ConfigDocument Document, bool MayWrite)>? After { get; set; }

    private string Title => Capitalised(Kind.Plural);

    private string AddAction => $"add-{Dashed(Kind.Noun)}";

    private string FailedText => $"The {Kind.Plural} couldn't be read.";

    private static string Capitalised(string text) => char.ToUpperInvariant(text[0]) + text[1..];

    private static string Dashed(string text) => text.Replace(' ', '-');

    private Dictionary<string, object> RowAttributes(string name) => new() { [$"data-{Dashed(Kind.Noun)}"] = name };

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, Kind.ListRoute);
            _watch = Config.Watch(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        if (!_denied)
        {
            _drawer!.Show(Key, OpenDrawer);
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        await Drafts.EnsureLoadedAsync();
        _failed = false;
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        try
        {
            _document = (await Config.GetWorkingAsync()).Document;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, $"Couldn't load the {Kind.Plural}.");
            _failed = true;
            _document ??= new ConfigDocument();
            Snackbar.Add(StoreFailures.Message(FailedText), Severity.Error);
        }
    }

    private DrawerLevel OpenDrawer(string key)
    {
        if (key == DashboardRoutes.NewSegment)
        {
            return Drawers.Push(Kind.Drawer, NewParameters, DrawerWidth.Medium);
        }

        return Kind.DrawerParameters(key) is { } parameters
            ? Drawers.Push(Kind.Drawer, parameters, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For($"{Capitalised(Kind.Noun)} not found", $"There is no such {Kind.Noun}", Kind.BackText), DrawerWidth.Narrow);
    }

    private async Task ReviewDeleteAsync(TItem item)
    {
        if (_document is null || !_mayWrite || !Kind.Usage(_document, item).IsEmpty)
        {
            return;
        }

        var name = Kind.Name(item);
        await Drawers.ReviewAsync(new ReviewRequest($"Delete {Kind.Noun} {name}", Kind.Delete(item))
        {
            Destructive = true,
            SuccessMessage = $"{Kind.Noun} {name} deleted",
        });
    }
}
