<MudPaper Class="pdk-card pdk-stat" Elevation="0" Outlined="true" aria-busy="@(Loading ? "true" : null)">
    <div class="pdk-stat-head">
        <span class="pdk-stat-icon pdk-tone-@Tone.ToString().ToLowerInvariant()"><MudIcon Icon="@Icon" Size="Size.Small" /></span>
        <MudText Typo="Typo.subtitle2" Class="pdk-muted">@Label</MudText>
    </div>
    @* The value and detail lines are always there, so the card is one height before and after the read. *@
    <div class="@("pdk-stat-value" + (Loading ? " pdk-pending" : null))">
        @if (Loading)
        {
            <text>0</text>
        }
        else
        {
            @Value
        }
    </div>
    <MudText Typo="Typo.caption" Class="pdk-muted pdk-stat-detail">@(Loading ? null : Detail)</MudText>
    @if (Href is not null)
    {
        <MudLink Href="@Href" Typo="Typo.caption" Class="pdk-stat-link">@LinkText <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" /></MudLink>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Outlined.Insights;

    [Parameter]
    public RenderFragment? Value { get; set; }

    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public Color Tone { get; set; } = Color.Primary;

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string LinkText { get; set; } = "Open";
}
