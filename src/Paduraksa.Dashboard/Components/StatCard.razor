@* One figure on the overview: a label, the value (or a skeleton while it loads), a detail line and an optional link. *@
<MudPaper Class="pdk-card pdk-stat" Elevation="0" Outlined="true">
    <div class="pdk-stat-head">
        <span class="pdk-stat-icon pdk-tone-@Tone.ToString().ToLowerInvariant()"><MudIcon Icon="@Icon" Size="Size.Small" /></span>
        <MudText Typo="Typo.subtitle2" Class="pdk-muted">@Label</MudText>
    </div>
    @if (Loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="2.25rem" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
    }
    else
    {
        <div class="pdk-stat-value">@Value</div>
        @if (Detail is not null)
        {
            <MudText Typo="Typo.caption" Class="pdk-muted pdk-stat-detail">@Detail</MudText>
        }
    }
    @if (Href is not null && !Loading)
    {
        <MudLink Href="@Href" Typo="Typo.caption" Class="pdk-stat-link">@LinkText <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" /></MudLink>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Outlined.Insights;

    [Parameter]
    public RenderFragment? Value { get; set; }

    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public Color Tone { get; set; } = Color.Primary;

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string LinkText { get; set; } = "Open";
}
