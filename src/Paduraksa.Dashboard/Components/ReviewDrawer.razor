@implements IDisposable
@inject DrawerStack Drawers
@* "Review changes" for a page whose form isn't a drawer itself (the global defaults, a rollback from the history, the wizard's first
   host): Open puts ReviewPanel on the drawer stack, and how it ends comes back through the callbacks. Renders nothing itself. *@

@code {
    private DrawerLevel? _level;
    private ConfigCommand? _reviewed;

    /// <summary>Whether the drawer is open.</summary>
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>What is being reviewed, in words ("New host app.example.com").</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>The command to review and apply. A new instance starts a new review.</summary>
    [Parameter, EditorRequired]
    public ConfigCommand? Command { get; set; }

    /// <summary>For a whole-document command (a rollback): the document it restores, to show the diff against.</summary>
    [Parameter]
    public ConfigDocument? AfterDocument { get; set; }

    [Parameter]
    public string ApplyLabel { get; set; } = "Apply";

    /// <summary>Apply removes something: the button is red.</summary>
    [Parameter]
    public bool Destructive { get; set; }

    /// <summary>The toast's text after Apply ("Created app.example.com").</summary>
    [Parameter]
    public string SuccessMessage { get; set; } = "Change applied";

    /// <summary>A host name the change is about, to pre-fill the simulator.</summary>
    [Parameter]
    public string? SampleHost { get; set; }

    /// <summary>After a commit (live, or stored but not live).</summary>
    [Parameter]
    public EventCallback<ConfigCommandResult> OnApplied { get; set; }

    /// <summary>The dry run's errors about what was sent (object-relative paths), for the form to show at its fields.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<ConfigError>> OnInvalid { get; set; }

    /// <summary>The person chose to reload after a conflict.</summary>
    [Parameter]
    public EventCallback OnReload { get; set; }

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _reviewed = null;
            Close();
            return;
        }

        if (Command is { } command && !ReferenceEquals(command, _reviewed))
        {
            _reviewed = command;
            Close();
            DrawerLevel level = DrawerReview.Open(Drawers, new ReviewRequest(Title, command)
            {
                AfterDocument = AfterDocument,
                ApplyLabel = ApplyLabel,
                Destructive = Destructive,
                SuccessMessage = SuccessMessage,
                SampleHost = SampleHost,
                OnInvalid = OnInvalid,
            });
            _level = level;
            _ = FollowAsync(level);
        }
    }

    public void Dispose() => Close();

    private async Task FollowAsync(DrawerLevel level)
    {
        DrawerResult result = await level.Result;
        if (!ReferenceEquals(_level, level))
        {
            return;
        }

        _level = null;
        _reviewed = null;
        await InvokeAsync(async () =>
        {
            await OpenChanged.InvokeAsync(false);
            if (result.As<ReviewOutcome>() is { } outcome)
            {
                if (outcome.Applied is { } applied)
                {
                    await OnApplied.InvokeAsync(applied);
                }
                else if (outcome.Reload)
                {
                    await OnReload.InvokeAsync();
                }
            }
        });
    }

    private void Close()
    {
        if (_level is { } level)
        {
            _level = null;
            level.Cancel();
        }
    }
}
