@inject DraftState Drafts
@* A whole-document change (rollback, import) while a draft is open: the one warning, with the way to look at the draft first. *@

@if (Drafts.IsOpen)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="pdk-review-alert" data-review="draft-open">
        <div class="pdk-draft-open">
            <span>@DraftNotices.WholeDocument(Drafts.Count)</span>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" OnClick="OnReviewDraft" data-action="review-draft-first">Review the draft first</MudButton>
        </div>
    </MudAlert>
}

@code {
    /// <summary>The person chose to look at the draft first: the caller closes its own sheet and opens it.</summary>
    [Parameter]
    public EventCallback OnReviewDraft { get; set; }
}
