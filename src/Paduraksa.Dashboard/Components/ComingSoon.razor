@* The body of a page that arrives later in M5: what it will do, so the navigation is honest about it. *@
<PageHeader Title="@Title" Overline="@Overline" Lead="@Lead" />
<MudPaper Class="pdk-card" Elevation="0" Outlined="true">
    <EmptyState Icon="@Icon" Title="@($"{Title} is on its way")" Description="@Description">
        <Action>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Outlined.Schedule">Arrives later in M5</MudChip>
        </Action>
    </EmptyState>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Overline { get; set; }

    [Parameter]
    public string? Lead { get; set; }

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Outlined.Construction;

    [Parameter]
    public string? Description { get; set; }
}
