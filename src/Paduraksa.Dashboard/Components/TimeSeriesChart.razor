@using System.Globalization
@using System.Text
@using System.Text.Json
@using Paduraksa.Dashboard.Config
@inject DisplayFormat Fmt
@* A line and area chart as inline SVG: no script and no dependency, so it renders on the server like everything else.
   Points sit at their start times, so a minute wide point can stand among ten second ones. A line is broken wherever a value is
   missing, and a stretch the server wasn't running for is a shaded band: it never draws a line through, or a zero into, what
   nobody observed. Every point has a transparent column over it that carries the point's text in data attributes, and paduraksa.js
   shows it as a tooltip at once (no round trip to the circuit, and nothing to fight Blazor's re-render): data-time, data-values (one
   string per line, in the legend's order) and data-note. The line names and swatches come from the legend. *@
<figure class="pdk-chart" data-chart="@Name" role="img" aria-label="@Summary">
    <div class="pdk-chart-body">
        <div class="pdk-chart-axis" aria-hidden="true">
            <span>@Show(_max)</span>
            <span>@Show(_max / 2)</span>
            <span>@Show(0)</span>
        </div>
        <svg class="pdk-chart-plot" viewBox="0 0 @Width @Height" preserveAspectRatio="none" aria-hidden="true">
            <line class="pdk-chart-grid" x1="0" x2="@Width" y1="0" y2="0" />
            <line class="pdk-chart-grid" x1="0" x2="@Width" y1="@(Height / 2)" y2="@(Height / 2)" />
            <line class="pdk-chart-grid" x1="0" x2="@Width" y1="@Height" y2="@Height" />
            @foreach (var (from, to) in GapBands())
            {
                <rect class="pdk-chart-gap" x="@Coord(from)" y="0" width="@Coord(to - from)" height="@Height" />
            }
            @foreach (var line in Lines)
            {
                @foreach (var run in Runs(line))
                {
                    @if (line.Area)
                    {
                        <path class="pdk-chart-area @line.Css" d="@AreaPath(run)" />
                    }

                    <polyline class="pdk-chart-line @line.Css" points="@PointsOf(run)" vector-effect="non-scaling-stroke" />
                }
            }
            @for (var i = 0; i < Points.Count; i++)
            {
                var index = i;
                <rect class="pdk-chart-hit" x="@Coord(ColumnStart(index))" y="0" width="@Coord(ColumnEnd(index) - ColumnStart(index))" height="@Height"
                      data-time="@Fmt.Exact(Points[index].Start)" data-values="@ValuesOf(index)" data-note="@NoteOf(index)" />
            }
        </svg>
    </div>
    <div class="pdk-chart-x" aria-hidden="true">
        <span>@(Points.Count > 0 ? Fmt.Axis(Points[0].Start, TimeFormat) : string.Empty)</span>
        <span>@(Points.Count > 0 ? Fmt.Axis(Points[^1].Start, TimeFormat) : string.Empty)</span>
    </div>
    <figcaption class="pdk-chart-legend">
        @foreach (var line in Lines)
        {
            <span class="pdk-chart-key"><span class="pdk-chart-swatch @line.Css" aria-hidden="true"></span>@line.Name</span>
        }
    </figcaption>
</figure>

@code {
    private const double Width = 600;
    private const double Height = 140;

    private double _max = 1;

    /// <summary>One point in time: where it starts, how long it lasts, and whether anything was observed during it.</summary>
    /// <param name="Start">The first instant of the point's step.</param>
    /// <param name="Width">How long the step is: the width of its tooltip column, and of a lone point's mark.</param>
    /// <param name="NoData">Nobody was looking (the server was down): the lines break here and the stretch is shaded.</param>
    /// <param name="Note">A line of the tooltip for what is unusual about the point, such as a step observed in part.</param>
    public sealed record ChartPoint(DateTimeOffset Start, TimeSpan Width, bool NoData = false, string? Note = null);

    /// <summary>One line of the chart.</summary>
    /// <param name="Name">What the legend and the tooltip call it.</param>
    /// <param name="Css">A <c>pdk-chart-*</c> class that sets its colour (and dash).</param>
    /// <param name="Values">One value per point, the same length as <see cref="Points"/>; null is no value (the line breaks).</param>
    /// <param name="Area">Fill under the line.</param>
    public sealed record ChartLine(string Name, string Css, IReadOnlyList<double?> Values, bool Area = false);

    private sealed record Run(IReadOnlyList<(double X, double Value)> Points, double EndX);

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<ChartPoint> Points { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ChartLine> Lines { get; set; } = [];

    /// <summary>Writes a value with its unit, for the axis and the tooltips.</summary>
    [Parameter, EditorRequired]
    public Func<double, string>? Format { get; set; }

    /// <summary>The format of the two time labels under the plot, written on the person's clock.</summary>
    [Parameter]
    public string TimeFormat { get; set; } = "HH:mm";

    private string Summary
    {
        get
        {
            if (Points.Count == 0)
            {
                return $"{Name}: no data";
            }

            var peak = 0.0;
            foreach (var line in Lines)
            {
                foreach (var value in line.Values)
                {
                    peak = Math.Max(peak, value ?? 0);
                }
            }

            var gaps = Points.Count(point => point.NoData);
            return $"{Name}, {Points.Count} points from {Fmt.Exact(Points[0].Start)} to {Fmt.Exact(Points[^1].Start)}, highest {Show(peak)}"
                + (gaps > 0 ? $", {gaps} with no data" : string.Empty);
        }
    }

    protected override void OnParametersSet()
    {
        var peak = 0.0;
        foreach (var line in Lines)
        {
            foreach (var value in line.Values)
            {
                if (value is { } v)
                {
                    peak = Math.Max(peak, v);
                }
            }
        }

        _max = Nice(peak);
    }

    /// <summary>The top of the scale: the next 1, 2, 2.5 or 5 times a power of ten, so the axis reads in round numbers.</summary>
    internal static double Nice(double peak)
    {
        if (peak <= 0 || double.IsNaN(peak) || double.IsInfinity(peak))
        {
            return 1;
        }

        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(peak)));
        foreach (var step in new[] { 1.0, 2.0, 2.5, 5.0, 10.0 })
        {
            if (peak <= step * magnitude)
            {
                return step * magnitude;
            }
        }

        return 10 * magnitude;
    }

    private static string Coord(double x) => x.ToString("0.#", CultureInfo.InvariantCulture);

    // The axis is time: from the first point's start to the last's, so steps of different widths sit where they were.
    private double X(DateTimeOffset at)
    {
        var span = (Points[^1].Start - Points[0].Start).TotalSeconds;
        return span <= 0 ? 0 : Math.Clamp((at - Points[0].Start).TotalSeconds / span * Width, 0, Width);
    }

    private double Y(double value) => Height - (Math.Clamp(value, 0, _max) / _max * Height);

    // A tooltip column reaches halfway to its neighbours, so the columns tile the plot whatever the spacing.
    private double ColumnStart(int index) => index == 0 ? 0 : (X(Points[index - 1].Start) + X(Points[index].Start)) / 2;

    private double ColumnEnd(int index) => index == Points.Count - 1 ? Width : (X(Points[index].Start) + X(Points[index + 1].Start)) / 2;

    /// <summary>The points that have a value in unbroken stretches. A stretch of one point is drawn as the width of its step, so it is a mark and not nothing.</summary>
    private List<Run> Runs(ChartLine line)
    {
        List<Run> runs = [];
        List<(double X, double Value)> current = [];
        var count = Math.Min(line.Values.Count, Points.Count);
        for (var i = 0; i <= count; i++)
        {
            if (i < count && line.Values[i] is { } value)
            {
                current.Add((X(Points[i].Start), value));
                continue;
            }

            if (current.Count > 0)
            {
                var last = i - 1;
                runs.Add(new Run(current, X(Points[last].Start + Points[last].Width)));
                current = [];
            }
        }

        return runs;
    }

    private string PointsOf(Run run)
    {
        StringBuilder points = new();
        foreach (var (x, value) in run.Points)
        {
            points.Append(CultureInfo.InvariantCulture, $"{x:0.#},{Y(value):0.#} ");
        }

        if (run.Points.Count == 1)
        {
            points.Append(CultureInfo.InvariantCulture, $"{Math.Max(run.EndX, run.Points[0].X + 2):0.#},{Y(run.Points[0].Value):0.#}");
        }

        return points.ToString().TrimEnd();
    }

    private string AreaPath(Run run)
    {
        StringBuilder path = new();
        path.Append(CultureInfo.InvariantCulture, $"M{run.Points[0].X:0.#},{Height} ");
        foreach (var (x, value) in run.Points)
        {
            path.Append(CultureInfo.InvariantCulture, $"L{x:0.#},{Y(value):0.#} ");
        }

        var endX = run.Points.Count == 1 ? Math.Max(run.EndX, run.Points[0].X + 2) : run.Points[^1].X;
        if (run.Points.Count == 1)
        {
            path.Append(CultureInfo.InvariantCulture, $"L{endX:0.#},{Y(run.Points[0].Value):0.#} ");
        }

        path.Append(CultureInfo.InvariantCulture, $"L{endX:0.#},{Height} Z");
        return path.ToString();
    }

    /// <summary>The stretches nobody observed, each from where its first step begins to where the next observed one does.</summary>
    private IEnumerable<(double From, double To)> GapBands()
    {
        for (var i = 0; i < Points.Count; i++)
        {
            if (!Points[i].NoData)
            {
                continue;
            }

            var end = i;
            while (end + 1 < Points.Count && Points[end + 1].NoData)
            {
                end++;
            }

            yield return (X(Points[i].Start), end + 1 < Points.Count ? X(Points[end + 1].Start) : Width);
            i = end;
        }
    }

    private string Show(double value) => Format?.Invoke(value) ?? Fmt.Number(value, 2);

    // One string per line, in the legend's order; a missing value is "-". A step nobody observed has no values, only its note.
    private string ValuesOf(int index)
    {
        if (Points[index].NoData)
        {
            return "[]";
        }

        var values = new string[Lines.Count];
        for (var i = 0; i < values.Length; i++)
        {
            var line = Lines[i];
            values[i] = index < line.Values.Count && line.Values[index] is { } value ? Show(value) : "-";
        }

        return JsonSerializer.Serialize(values);
    }

    private string? NoteOf(int index) => Points[index].NoData ? "No data: Paduraksa was not running" : Points[index].Note;
}
