@* What a config page shows to a role that can't read the config. *@
<MudPaper Class="pdk-card" Elevation="0" Outlined="true">
    <EmptyState Compact="Compact" Icon="@Icons.Material.Outlined.Lock" Title="@IdentityText.CantReadConfig" Description="@IdentityText.CantReadConfigHelp" />
</MudPaper>

@code {
    [Parameter]
    public bool Compact { get; set; }
}
