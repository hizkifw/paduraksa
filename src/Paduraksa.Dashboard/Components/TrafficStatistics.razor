@implements IAsyncDisposable
@using Paduraksa.Application.Metrics
@using Paduraksa.Contracts.Metrics
@using Paduraksa.Contracts.Config
@using Paduraksa.Dashboard.Config
@using Paduraksa.Dashboard.Pages
@inject MetricsService Metrics
@inject IDashboardConfig Config
@inject TimeProvider Time
@inject DisplayFormat Fmt
@* The traffic over a range: requests per second and latency as charts, the busiest hosts and the upstreams' errors. The host page owns
   the range and the tab's visibility; this reads, polls and draws. The hour reads the sampler's memory every two seconds; longer ranges
   read the one-minute rollups, which only change once a minute, so they are read a tenth as often. *@

<section class="pdk-traffic" data-section="traffic" aria-label="Traffic">
    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-part="failed">
            The traffic figures couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => LoadAsync()" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }
    else if (_overview is null)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" />
    }
    else
    {
        <div class="pdk-home-grid">
            <MudPaper Class="pdk-card" Elevation="0" Outlined="true" data-section="requests-chart">
                <MudText Typo="Typo.subtitle1" HtmlTag="h3">Requests per second</MudText>
                @if (_overview.Series.Count < 2)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.ShowChart" Title="No traffic in this range yet" />
                }
                else
                {
                    <TimeSeriesChart Name="requests" Points="@_points" Lines="@_requestLines" Format="@Fmt.PerSecond" TimeFormat="@TrafficFigures.TimeFormat(_overview.Range)" />
                }
            </MudPaper>
            <MudPaper Class="pdk-card" Elevation="0" Outlined="true" data-section="latency-chart">
                <MudText Typo="Typo.subtitle1" HtmlTag="h3">Latency</MudText>
                @if (_overview.Series.Count < 2)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.ShowChart" Title="No traffic in this range yet" />
                }
                else
                {
                    <TimeSeriesChart Name="latency" Points="@_points" Lines="@_latencyLines" Format="@Fmt.Latency" TimeFormat="@TrafficFigures.TimeFormat(_overview.Range)" />
                }
            </MudPaper>
        </div>

        <div class="pdk-home-grid">
            <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true" data-section="top-hosts">
                <div class="pdk-card-head pdk-card-head-padded">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h3">Busiest hosts</MudText>
                </div>
                @if (_overview.Hosts.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.Language" Title="No requests in this range" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                    <table class="pdk-traffic-table">
                        <thead>
                            <tr><th scope="col">Host</th><th scope="col">Requests</th><th scope="col">Errors</th><th scope="col">p95</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var host in _overview.Hosts)
                            {
                                <tr data-host="@host.Name">
                                    <th scope="row">
                                        @if (host.Id.IsEmpty)
                                        {
                                            <span class="pdk-muted" title="Requests for a name no host has">@host.Name</span>
                                        }
                                        else
                                        {
                                            <a href="@DashboardRoutes.Host(host.Id)">@host.Name</a>
                                        }
                                    </th>
                                    <td>@Fmt.Count(host.Requests)</td>
                                    <td class="@(host.ErrorRate > 0 ? "pdk-traffic-bad" : null)">@Fmt.Percent(host.ErrorRate)</td>
                                    <td>@Fmt.Latency(host.P95Ms)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </MudPaper>
            <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true" data-section="upstream-errors">
                <div class="pdk-card-head pdk-card-head-padded">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h3">Upstream errors</MudText>
                </div>
                @if (_overview.Upstreams.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.Hub" Title="Nothing was forwarded in this range" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                    <table class="pdk-traffic-table">
                        <thead>
                            <tr><th scope="col">Upstream</th><th scope="col">Forwarded</th><th scope="col">Failed</th><th scope="col">p95</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var upstream in _overview.Upstreams)
                            {
                                <tr data-upstream="@upstream.Id">
                                    <th scope="row"><a href="@DashboardRoutes.Upstream(upstream.Id)">@UpstreamName(upstream.Id)</a></th>
                                    <td>@Fmt.Count(upstream.Requests)</td>
                                    <td class="@(upstream.Errors > 0 ? "pdk-traffic-bad" : null)" title="@Fmt.Percent(upstream.ErrorRate) of forwards">@Fmt.Count(upstream.Errors)</td>
                                    <td>@Fmt.Latency(upstream.P95Ms)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </MudPaper>
        </div>
    }
</section>

@code {
    private MetricsOverview? _overview;
    private MetricsRange? _loaded;
    private bool _wasVisible = true;
    private bool _failed;
    private bool _started;
    private IReadOnlyList<TimeSeriesChart.ChartPoint> _points = [];
    private IReadOnlyList<TimeSeriesChart.ChartLine> _requestLines = [];
    private IReadOnlyList<TimeSeriesChart.ChartLine> _latencyLines = [];
    private Dictionary<UpstreamId, string> _upstreamNames = [];
    private CancellationTokenSource? _stop;

    /// <summary>The range to read; the host page's picker.</summary>
    [Parameter, EditorRequired]
    public MetricsRange Range { get; set; }

    /// <summary>Whether the tab is visible: the host page watches it, and polling pauses while it is hidden.</summary>
    [Parameter]
    public bool Visible { get; set; } = true;

    /// <summary>How often the hour is read while the tab is visible. A test shortens it; the person never changes it.</summary>
    [Parameter]
    public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(2);

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            _upstreamNames = (await Config.GetCurrentAsync()).Document.Upstreams.ToDictionary(upstream => upstream.Id, upstream => upstream.Name);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            // Without the config the table names an upstream by its ID.
        }

        _stop = new CancellationTokenSource();
        _started = true;
        _ = PollAsync(_stop);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_started)
        {
            return;
        }

        // A new range starts over; a tab shown again reads at once.
        if (_loaded != Range)
        {
            _overview = null;
            await LoadAsync();
        }
        else if (Visible && !_wasVisible)
        {
            await LoadAsync();
        }

        _wasVisible = Visible;
    }

    private async Task LoadAsync()
    {
        var range = Range;
        try
        {
            var overview = await Metrics.ReadOverviewAsync(range, _stop?.Token ?? CancellationToken.None);
            if (range != Range)
            {
                return;
            }

            _overview = overview;
            _failed = false;
            Shape(overview);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _failed = true;
        }

        _loaded = range;
        StateHasChanged();
    }

    private async Task PollAsync(CancellationTokenSource stop)
    {
        var token = stop.Token;
        try
        {
            // The hour is read at the poll interval; the rollups change once a minute, so the longer ranges wait ten times as long.
            using PeriodicTimer timer = new(PollInterval > TimeSpan.Zero ? PollInterval : TimeSpan.FromSeconds(2), Time);
            var ticks = 0;
            while (await timer.WaitForNextTickAsync(token))
            {
                ticks++;
                if (Visible && !_failed && _overview is not null && (Range == MetricsRange.Hour || ticks % 10 == 0))
                {
                    await InvokeAsync(LoadAsync);
                }
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            // The panel is gone.
        }
    }

    private string UpstreamName(UpstreamId id) => _upstreamNames.TryGetValue(id, out var name) ? name : id.ToString();

    private void Shape(MetricsOverview overview)
    {
        var series = overview.Series;
        _points = [.. series.Select(point => new TimeSeriesChart.ChartPoint(point.Start, TimeSpan.FromSeconds(point.WidthSeconds), point.CoveredSeconds == 0, TrafficFigures.Coverage(point, Fmt)))];
        // A step nobody observed has no value; a step observed that timed nothing has a rate but no latency: both break a line.
        _requestLines =
        [
            new("Requests", "pdk-chart-a", Values(series, point => point.RequestsPerSecond), Area: true),
            new("5xx", "pdk-chart-err", Values(series, point => point.ErrorsPerSecond)),
        ];
        _latencyLines =
        [
            new("p50", "pdk-chart-b", Values(series, point => point.Total.P50Ms, timed: true)),
            new("p95", "pdk-chart-c", Values(series, point => point.Total.P95Ms, timed: true)),
            new("p99", "pdk-chart-err", Values(series, point => point.Total.P99Ms, timed: true)),
            new("Upstream p95", "pdk-chart-up", Values(series, point => point.Upstream.P95Ms, timed: true)),
        ];
    }

    private static double?[] Values(IReadOnlyList<MetricsSeriesPoint> series, Func<MetricsSeriesPoint, double> value, bool timed = false) =>
        [.. series.Select(point => point.CoveredSeconds == 0 || (timed && value(point) <= 0) ? (double?)null : value(point))];

    public async ValueTask DisposeAsync()
    {
        if (_stop is { } stop)
        {
            await stop.CancelAsync();
            stop.Dispose();
        }
    }
}
