@implements IAsyncDisposable
@using Paduraksa.Application.Analytics
@using Paduraksa.Contracts.Analytics
@using Paduraksa.Contracts.Metrics
@using Paduraksa.Dashboard.Pages
@inject AnalyticsService Service
@inject TimeProvider Time
@inject DisplayFormat Fmt
@* Visitors and content, clients and bots for every host or one. The host page owns the range, the host and the tab's visibility; this
   reads, polls and draws. The figures come from the access-log drain, so a host with its access log off is not in them. The hour is
   the stored buckets plus the drain's open one, so it is live to within the drain's few seconds (the service keeps a result for 5 s);
   the longer ranges are mostly stored rows and are read a sixth as often. *@

@if (_failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-part="failed">
        The analytics couldn't be read. The details are in the server log.
        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => LoadAsync()" Class="ml-2">Try again</MudButton>
    </MudAlert>
}
else if (_overview is { Totals.Requests: 0 })
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true" data-section="empty">
        <EmptyState Icon="@Icons.Material.Outlined.Insights" Title="No requests in this range"
                    Description="A host with its access log off is never counted here." />
    </MudPaper>
}
else
{
    // One markup for both states (a skeleton is this frame with placeholders), so the tab keeps its size when the figures arrive. What
    // only exists once loaded is read inside the cards' content, which is not rendered while a card is pending.
    var overview = _overview;
    var pending = overview is null;
    var totals = overview?.Totals;
    <div class="pdk-sec-tiles" data-part="tiles">
        <SecurityTile Name="requests" Label="Requests" Pending="@pending" Value="@(pending ? string.Empty : Fmt.Count(totals!.Requests))"
                      Detail="@(!pending && totals!.BotRequests > 0 ? $"{Fmt.Share(totals.BotRequests, totals.Requests)} from bots" : null)" />
        <SecurityTile Name="bandwidth" Label="Bandwidth" Pending="@pending" Value="@(pending ? string.Empty : Fmt.Bytes(totals!.BytesOut))"
                      Detail="@(!pending && totals!.BytesIn > 0 ? $"sent, {Fmt.Bytes(totals.BytesIn)} received" : "sent")" />
        <SecurityTile Name="visitors" Label="Unique visitors" Pending="@pending" Value="@(pending ? string.Empty : Fmt.Count(totals!.Visitors))" Detail="@AnalyticsFigures.VisitorsAccuracy" />
        <SecurityTile Name="errors" Label="Error rate" Pending="@pending" Value="@(pending ? string.Empty : Fmt.Percent(totals!.ErrorRate))" Detail="5xx answers" />
    </div>

    <section data-section="content" aria-labelledby="pdk-analytics-content">
        <MudText Typo="Typo.h6" HtmlTag="h2" id="pdk-analytics-content" Class="pdk-section-heading">Visitors and content</MudText>
        <div class="pdk-home-grid pdk-analytics-charts">
            @foreach (var chart in pending ? PendingCharts : _charts)
            {
                var empty = !pending && overview!.Series.Count < 2;
                var drawn = !pending && !empty;
                <StatsCard Name="@($"{chart.Name}-chart")" Title="@chart.Title" Chart="true" Pending="@pending">
                    <TimeSeriesChart Name="@chart.Name" Pending="@pending" EmptyMessage="@(empty ? "Not enough time observed yet" : null)" Points="@(drawn ? _points : [])" Lines="@(drawn ? chart.Lines : [])"
                                     Format="@chart.Format" TimeFormat="@(overview is null ? "HH:mm" : TrafficFigures.TimeFormat(overview.Range))" />
                </StatsCard>
            }
        </div>

        <div class="pdk-home-grid">
            <StatsCard Name="status" Title="Status codes" Pending="@pending">
                <ShareList Name="status-classes" Items="@overview!.StatusClasses" Total="@totals!.Requests" Tone="StatusTone" Label="AnalyticsFigures.Status" />
                <ShareList Name="status-codes" Items="@overview!.Statuses" Total="@totals!.Requests" Tone="StatusTone" Label="AnalyticsFigures.Status" />
            </StatsCard>
            <StatsCard Name="methods" Title="Methods" Pending="@pending">
                <ShareList Name="methods" Items="@overview!.Methods" Total="@totals!.Requests" />
            </StatsCard>
            <StatsCard Name="protocols" Title="HTTP versions" Pending="@pending">
                <ShareList Name="protocols" Items="@overview!.Protocols" Total="@totals!.Requests" />
            </StatsCard>
        </div>

        <div class="pdk-home-grid pdk-analytics-tables">
            <StatsCard Name="top-paths" Title="Top paths" Table="true" Pending="@pending">
                @if (overview!.TopPaths.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.Route" Title="No paths in this range" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                        <table class="pdk-traffic-table">
                            <thead>
                                <tr><th scope="col">Path</th><th scope="col">Requests</th><th scope="col">Bandwidth</th><th scope="col">p95</th><th scope="col">Errors</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var path in overview!.TopPaths)
                                {
                                    <tr data-path="@path.Path">
                                        <th scope="row" class="pdk-mono">@PathCell(path.Path)</th>
                                        <td title="@AnalyticsFigures.Range(path.Requests, path.Error, Fmt)">@AnalyticsFigures.Counted(path.Requests, path.Error, Fmt)</td>
                                        <td>@Fmt.Bytes(path.BytesOut)</td>
                                        <td>@Fmt.Latency(path.P95Ms)</td>
                                        <td class="@(path.ErrorRate > 0 ? "pdk-traffic-bad" : null)">@Fmt.Percent(path.ErrorRate)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </StatsCard>
            <StatsCard Name="referers" Title="Top referers" Table="true" Pending="@pending">
                @if (overview!.TopReferers.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.CallReceived" Title="No referers in this range" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                        <table class="pdk-traffic-table">
                            <thead><tr><th scope="col">Source</th><th scope="col">Requests</th></tr></thead>
                            <tbody>
                                @foreach (var referer in overview!.TopReferers)
                                {
                                    <tr data-referer="@referer.Label">
                                        <th scope="row" title="@referer.Label">@referer.Label</th>
                                        <td title="@AnalyticsFigures.Range(referer.Count, referer.Error, Fmt)">@AnalyticsFigures.Counted(referer.Count, referer.Error, Fmt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </StatsCard>
            <StatsCard Name="slowest" Title="Slowest paths" Table="true" Pending="@pending">
                @if (overview!.SlowestPaths.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.Timer" Title="No path has had enough requests yet" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                        <table class="pdk-traffic-table">
                            <thead><tr><th scope="col">Path</th><th scope="col">p95</th><th scope="col">Requests</th></tr></thead>
                            <tbody>
                                @foreach (var path in overview!.SlowestPaths)
                                {
                                    <tr data-path="@path.Path">
                                        <th scope="row" class="pdk-mono">@PathCell(path.Path)</th>
                                        <td>@Fmt.Latency(path.P95Ms)</td>
                                        <td title="@AnalyticsFigures.Range(path.Requests, path.Error, Fmt)">@AnalyticsFigures.Counted(path.Requests, path.Error, Fmt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </StatsCard>
            <StatsCard Name="largest" Title="Largest responses" Table="true" Pending="@pending">
                @if (overview!.LargestResponses.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.Download" Title="No response declared a size" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                        <table class="pdk-traffic-table">
                            <thead><tr><th scope="col">Path</th><th scope="col">Bytes sent</th></tr></thead>
                            <tbody>
                                @foreach (var path in overview!.LargestResponses)
                                {
                                    <tr data-path="@path.Label">
                                        <th scope="row" class="pdk-mono">@PathCell(path.Label)</th>
                                        <td title="@(path.Error > 0 ? $"Between {Fmt.Bytes(Math.Max(0, path.Count - path.Error))} and {Fmt.Bytes(path.Count)}" : null)">@(path.Error > 0 ? $"{AnalyticsFigures.Approximately} " : null)@Fmt.Bytes(path.Count)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </StatsCard>
        </div>
    </section>

    <section data-section="clients" aria-labelledby="pdk-analytics-clients">
        <MudText Typo="Typo.h6" HtmlTag="h2" id="pdk-analytics-clients" Class="pdk-section-heading">Clients and bots</MudText>
        <div class="pdk-home-grid">
            <StatsCard Name="browsers" Title="Browsers" Pending="@pending">
                <ShareList Name="browsers" Items="@overview!.Browsers" />
            </StatsCard>
            <StatsCard Name="systems" Title="Operating systems" Pending="@pending">
                <ShareList Name="systems" Items="@overview!.OperatingSystems" />
            </StatsCard>
            <StatsCard Name="devices" Title="Devices" Pending="@pending">
                <ShareList Name="devices" Items="@overview!.Devices" Total="@totals!.Requests" Label="AnalyticsFigures.Device" />
            </StatsCard>
        </div>

        <div class="pdk-home-grid pdk-analytics-tables">
            <StatsCard Name="bot-kinds" Title="Bots by kind" Pending="@pending">
                @if (totals!.BotRequests == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.SmartToy" Title="No bot made a request" />
                }
                else
                {
                    <ShareList Name="bot-kinds" Items="@BotKindCounts" Total="@totals!.Requests" Label="AnalyticsFigures.Kind" />
                }
            </StatsCard>
            <StatsCard Name="top-bots" Title="Top bots" Table="true" Pending="@pending">
                @if (overview!.TopBots.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.SmartToy" Title="No bot made a request" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                        <table class="pdk-traffic-table">
                            <thead><tr><th scope="col">Bot</th><th scope="col">Kind</th><th scope="col">Requests</th></tr></thead>
                            <tbody>
                                @foreach (var bot in overview!.TopBots)
                                {
                                    <tr data-bot="@bot.Name">
                                        <th scope="row" title="@bot.Name">@bot.Name</th>
                                        <td>@AnalyticsFigures.Kind(bot.Kind)</td>
                                        <td>@Fmt.Count(bot.Count)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </StatsCard>
            <StatsCard Name="ignoring-robots" Title="Bots ignoring robots.txt" Table="true" Pending="@pending">
                @if (overview!.BotsIgnoringRobots.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.GppGood" Title="No bot fetched what a robots.txt disallows"
                                Description="Only hosts that serve a robots.txt (Settings, the host, robots.txt) are checked." />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                        <table class="pdk-traffic-table">
                            <thead><tr><th scope="col">Bot</th><th scope="col">Kind</th><th scope="col">Requests</th></tr></thead>
                            <tbody>
                                @foreach (var bot in overview!.BotsIgnoringRobots)
                                {
                                    <tr data-bot="@bot.Name">
                                        <th scope="row" title="@bot.Name">@bot.Name</th>
                                        <td>@AnalyticsFigures.Kind(bot.Kind)</td>
                                        <td class="pdk-traffic-bad">@Fmt.Count(bot.Count)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </StatsCard>
            <StatsCard Name="user-agents" Title="User agents" Table="true" Pending="@pending">
                @if (overview!.TopUserAgents.Count == 0)
                {
                    <EmptyState Compact="true" Icon="@Icons.Material.Outlined.Devices" Title="No user agents in this range" />
                }
                else
                {
                    <div class="pdk-traffic-scroll">
                        <table class="pdk-traffic-table pdk-analytics-agents">
                            <thead><tr><th scope="col">User agent</th><th scope="col">Requests</th></tr></thead>
                            <tbody>
                                @foreach (var agent in overview!.TopUserAgents)
                                {
                                    <tr data-agent="@agent.Label">
                                        <th scope="row" class="pdk-mono" title="@agent.Label">@agent.Label</th>
                                        <td title="@AnalyticsFigures.Range(agent.Count, agent.Error, Fmt)">@AnalyticsFigures.Counted(agent.Count, agent.Error, Fmt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </StatsCard>
        </div>
    </section>
}


@code {
    private AnalyticsOverview? _overview;
    private (MetricsRange Range, HostId? Host, bool Unmatched)? _loaded;
    private IReadOnlyList<TimeSeriesChart.ChartPoint> _points = [];
    private IReadOnlyList<ChartSpec> _charts = [];
    private bool _wasVisible = true;
    private bool _failed;
    private bool _started;
    private CancellationTokenSource? _stop;

    private sealed record ChartSpec(string Name, string Title, IReadOnlyList<TimeSeriesChart.ChartLine> Lines, Func<double, string>? Format);

    // The charts' names and titles are fixed, so the skeleton has the same three cards the loaded tab has.
    private static readonly IReadOnlyList<ChartSpec> PendingCharts =
    [
        new("requests", "Requests", [], null),
        new("bandwidth", "Bandwidth", [], null),
        new("visitors", "Unique visitors", [], null),
    ];

    /// <summary>
    /// Show the frame and read nothing: the page is still prerendering or checking who is asking, and a read made for someone who may not see
    /// the figures must not start. The frame is what the loaded tab looks like, so the page doesn't change size when this turns false.
    /// </summary>
    [Parameter]
    public bool Hold { get; set; }

    /// <summary>The range to read; the host page's picker.</summary>
    [Parameter, EditorRequired]
    public MetricsRange Range { get; set; }

    /// <summary>One host's figures; every host's when null.</summary>
    [Parameter]
    public HostId? Host { get; set; }

    /// <summary>The requests no host owns, instead of a host's or everyone's.</summary>
    [Parameter]
    public bool Unmatched { get; set; }

    /// <summary>The chosen host's first name, which the live tail knows it by (a link from a path).</summary>
    [Parameter]
    public string? HostName { get; set; }

    /// <summary>Whether the tab is visible: the host page watches it, and polling pauses while it is hidden.</summary>
    [Parameter]
    public bool Visible { get; set; } = true;

    /// <summary>How often the hour is read while the tab is visible. A test shortens it; the person never changes it.</summary>
    [Parameter]
    public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(10);

    private IReadOnlyList<AnalyticsCount> BotKindCounts => [.. _overview!.BotKinds.Select(static kind => new AnalyticsCount(kind.Kind, kind.Count, 0))];

    protected override void OnInitialized()
    {
        if (RendererInfo.IsInteractive && !Hold)
        {
            Start();
        }
    }

    private void Start()
    {
        _stop = new CancellationTokenSource();
        _started = true;
        _ = PollAsync(_stop);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_started)
        {
            if (Hold || !RendererInfo.IsInteractive)
            {
                return;
            }

            Start();
        }

        // A new range or host starts over; a tab shown again reads at once.
        if (_loaded != (Range, Host, Unmatched))
        {
            _overview = null;
            await LoadAsync();
        }
        else if (Visible && !_wasVisible)
        {
            await LoadAsync();
        }

        _wasVisible = Visible;
    }

    private async Task LoadAsync()
    {
        var read = (Range, Host, Unmatched);
        try
        {
            var overview = await Service.ReadOverviewAsync(read.Range, read.Host, read.Unmatched, _stop?.Token ?? CancellationToken.None);
            if (read != (Range, Host, Unmatched))
            {
                return;
            }

            _overview = overview;
            _failed = false;
            Shape(overview);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _failed = true;
        }

        _loaded = read;
        StateHasChanged();
    }

    private async Task PollAsync(CancellationTokenSource stop)
    {
        var token = stop.Token;
        try
        {
            // The hour changes with every bucket the drain closes; the longer ranges are mostly stored rows, so they wait six times as long.
            using PeriodicTimer timer = new(PollInterval > TimeSpan.Zero ? PollInterval : TimeSpan.FromSeconds(10), Time);
            var ticks = 0;
            while (await timer.WaitForNextTickAsync(token))
            {
                ticks++;
                if (Visible && !_failed && _overview is not null && (Range == MetricsRange.Hour || ticks % 6 == 0))
                {
                    await InvokeAsync(LoadAsync);
                }
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            // The tab is gone.
        }
    }

    private void Shape(AnalyticsOverview overview)
    {
        var series = overview.Series;
        _points = [.. series.Select(step => new TimeSeriesChart.ChartPoint(step.Start, TimeSpan.FromSeconds(step.WidthSeconds), step.CoveredSeconds == 0, AnalyticsFigures.Coverage(step, Fmt)))];
        _charts =
        [
            new("requests", "Requests", [new("Requests", "pdk-chart-a", Values(series, step => step.Requests), Area: true), new("5xx", "pdk-chart-err", Values(series, step => step.ServerErrors))], Fmt.Compact),
            new("bandwidth", "Bandwidth", Bandwidth(overview), Fmt.Bytes),
            new("visitors", "Unique visitors", [new("Visitors", "pdk-chart-c", Values(series, step => step.Visitors), Area: true)], Fmt.Compact),
        ];
    }

    // Received only when something was: a flat zero under every download says nothing.
    private static TimeSeriesChart.ChartLine[] Bandwidth(AnalyticsOverview overview)
    {
        TimeSeriesChart.ChartLine sent = new("Bytes sent", "pdk-chart-b", Values(overview.Series, step => step.BytesOut), Area: true);
        return overview.Totals.BytesIn > 0
            ? [sent, new("Bytes received", "pdk-chart-a", Values(overview.Series, step => step.BytesIn))]
            : [sent];
    }

    // A step nobody observed has no value and breaks the line; an observed step with nothing in it is a real zero.
    private static double?[] Values(IReadOnlyList<AnalyticsStep> series, Func<AnalyticsStep, long> value) =>
        [.. series.Select(step => step.CoveredSeconds == 0 ? (double?)null : value(step))];

    private static string? StatusTone(string label) => label switch
    {
        "2xx" => "pdk-share-ok",
        "3xx" => "pdk-share-info",
        "4xx" => "pdk-share-warn",
        "5xx" => "pdk-share-bad",
        "none" => "pdk-share-none",
        _ when label.Length == 3 && label[0] == '2' => "pdk-share-ok",
        _ when label.Length == 3 && label[0] == '3' => "pdk-share-info",
        _ when label.Length == 3 && label[0] == '4' => "pdk-share-warn",
        _ when label.Length == 3 && label[0] == '5' => "pdk-share-bad",
        _ => null,
    };

    private RenderFragment PathCell(string path) => builder =>
    {
        var link = AnalyticsFigures.TailLink(path, HostName);
        if (link is null)
        {
            builder.AddContent(0, path);
            return;
        }

        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", link);
        builder.AddAttribute(3, "title", $"{path}: open it in the live tail");
        builder.AddContent(4, path);
        builder.CloseElement();
    };

    public async ValueTask DisposeAsync()
    {
        if (_stop is { } stop)
        {
            await stop.CancelAsync();
            stop.Dispose();
        }
    }
}
