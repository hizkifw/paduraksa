@inject DraftState Draft
@implements IDisposable
@* The last buttons of a form whose change can go into a draft. With a draft open the primary button adds to it and "Review and apply now"
   is the way around; with none, the primary reviews as ever and "Add to a new draft" is the way in. Enter in the form follows the primary. *@

@if (Draft.IsOpen)
{
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OnApplyNow" data-action="review">Review and apply now</MudButton>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-to-draft">
        Add to draft
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OnAddToNewDraft" data-action="add-to-new-draft">Add to a new draft</MudButton>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">
        Review changes
    </MudButton>
}

@code {
    /// <summary>With a draft open: review this change alone and apply it now.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnApplyNow { get; set; }

    /// <summary>With no draft open: start one with this change.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnAddToNewDraft { get; set; }

    protected override void OnInitialized() => Draft.Changed += OnChanged;

    public void Dispose()
    {
        Draft.Changed -= OnChanged;
        GC.SuppressFinalize(this);
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
