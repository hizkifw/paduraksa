@* A page's title row: the title (the page's one h1, which navigation focuses) level with the page's actions, and under it an
   optional lead for what the page can't show by itself. ListEmpty is for a list page whose empty state carries the same action: the
   action is shown once, where the eye is, and the header has it again as soon as the list has something in it (PLAN §12). *@
<header class="pdk-page-header">
    <div class="pdk-page-header-row">
        <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">@Title</MudText>
        @if (Actions is not null && !ListEmpty)
        {
            <div class="pdk-page-header-actions">@Actions</div>
        }
    </div>
    @if (Lead is not null)
    {
        <MudText Typo="Typo.body2" Class="pdk-muted pdk-page-lead">@Lead</MudText>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Lead { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public bool ListEmpty { get; set; }
}
