@* A page's title row (the design language, PLAN §12): an overline (the area), the title (the page's one h1, which navigation focuses), a
   lead, the page's actions on the right with the primary one last, and under it the area's tabs when the page belongs to one. *@
<header class="pdk-page-header @(Area is null ? null : "pdk-page-header-tabbed")">
    <div class="pdk-page-header-row">
        <div class="pdk-page-header-text">
            @if (Overline is not null)
            {
                <MudText Typo="Typo.overline" Color="Color.Primary">@Overline</MudText>
            }
            <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">@Title</MudText>
            @if (Lead is not null)
            {
                <MudText Typo="Typo.body2" Class="pdk-muted pdk-page-lead">@Lead</MudText>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="pdk-page-header-actions">@Actions</div>
        }
    </div>
    @if (Area is { } area)
    {
        <SectionTabs Area="area" />
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Overline { get; set; }

    [Parameter]
    public string? Lead { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>The area whose tabs show under the header (the page's own marked); none for a page on its own.</summary>
    [Parameter]
    public SectionArea? Area { get; set; }
}
