@attribute [Route(SettingsRoutes.Tokens)]
@implements IDisposable
@using System.Globalization
@using Microsoft.Extensions.Logging
@using Paduraksa.Application.Commands
@using Paduraksa.Application.Identity
@using Paduraksa.Contracts.Identity
@inject IDashboardIdentity Identity
@inject DashboardCaller Caller
@inject TimeProvider Time
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject DrawerStack Drawers
@inject ILogger<ApiTokens> Logger
@* Settings: API tokens. One's own, and everyone's with tokens:all. A new token is made in a drawer, which shows its
   secret once; the page never holds it. *@

<PageTitle>API tokens · Settings · Paduraksa</PageTitle>

<PageHeader Title="API tokens">
    <Actions>
        @if (_mayIssue)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="CreateAsync" data-action="add-token">Create token</MudButton>
        }
    </Actions>
</PageHeader>

<MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
    <div class="pdk-toolbar">
        @if (_mayAll)
        {
            <MudToggleGroup T="bool" Value="_everyone" ValueChanged="SetEveryoneAsync" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary"
                            Outlined="true" Size="Size.Small" aria-label="Whose tokens" data-field="whose">
                <MudToggleItem Value="false" Text="Mine" />
                <MudToggleItem Value="true" Text="Everyone's" />
            </MudToggleGroup>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="pdk-muted">Your tokens</MudText>
        }
        <MudSwitch T="bool" @bind-Value="_showRevoked" Color="Color.Primary" Label="Show revoked and expired" />
    </div>

    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-3" data-alert="load-failed">
            The tokens couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }

    @if (_rows is null)
    {
        @if (!_failed)
        {
            @for (int i = 0; i < 3; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="15%" />
                </div>
            }
        }
    }
    else if (Shown.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Key" Title="@(_rows.Count == 0 ? "No API tokens yet" : "No live tokens")"
                    Description="A token lets a script or a tool use the REST API as you, with only the scopes you give it.">
            <Action>
                @if (_mayIssue)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="CreateAsync">Create token</MudButton>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="pdk-dt pdk-tokens-table @(_everyone ? "pdk-tokens-everyone" : null)" role="table" aria-label="API tokens">
            <div class="pdk-dt-row pdk-dt-head" role="row">
                <span role="columnheader">Token</span>
                @if (_everyone)
                {
                    <span role="columnheader">Owner</span>
                }
                <span role="columnheader">Scopes</span>
                <span role="columnheader">Last used</span>
                <span role="columnheader">Expires</span>
                <span role="columnheader">Status</span>
                <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
            </div>
            @foreach (TokenRow row in Shown)
            {
                (string label, Tone tone) = IdentityText.State(row.Token, _now);
                <div class="pdk-dt-row" role="row" @key="row.Token.Id">
                    <div class="pdk-dt-main" role="cell">
                        <span class="pdk-list-icon pdk-tone-@tone.Css()"><MudIcon Icon="@Icons.Material.Outlined.Key" Size="Size.Small" /></span>
                        <span class="pdk-dt-titles" data-token="@row.Token.Name">
                            <span class="pdk-list-title">@row.Token.Name</span>
                            <span class="pdk-dt-note" title="@RevisionText.Exact(row.Token.CreatedAt)">Created @RevisionText.Ago(row.Token.CreatedAt, _now)</span>
                        </span>
                    </div>
                    @if (_everyone)
                    {
                        <span role="cell" class="pdk-dt-cell" data-label="Owner">@row.Owner</span>
                    }
                    <span role="cell" class="pdk-dt-cell" data-label="Scopes">
                        <span class="pdk-dt-chips">
                            @foreach (Permission scope in row.Token.Scopes.Take(3))
                            {
                                <span class="pdk-tag pdk-mono">@scope.ToName()</span>
                            }
                            @if (row.Token.Scopes.Count > 3)
                            {
                                <span class="pdk-tag" title="@string.Join(", ", row.Token.Scopes.Skip(3).Select(s => s.ToName()))">+@(row.Token.Scopes.Count - 3)</span>
                            }
                        </span>
                    </span>
                    <span role="cell" class="pdk-dt-cell" data-label="Last used">
                        @if (row.Token.LastUsedAt is { } used)
                        {
                            <span title="@RevisionText.Exact(used)">@RevisionText.Ago(used, _now)</span>
                        }
                        else
                        {
                            <span class="pdk-muted">Never</span>
                        }
                    </span>
                    <span role="cell" class="pdk-dt-cell" data-label="Expires"><span class="@(row.Token.ExpiresAt is null ? "pdk-muted" : null)">@IdentityText.Until(row.Token.ExpiresAt, _now)</span></span>
                    <span role="cell" class="pdk-dt-cell" data-label="Status"><StatusChip Tone="tone" Dot="true" Text="@label" Name="status" /></span>
                    <span role="cell" class="pdk-dt-cell pdk-dt-actions">
                        @if (!row.Token.Revoked && (row.Mine || _mayAll))
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => AskRevokeAsync(row)" data-action="revoke">Revoke</MudButton>
                        }
                    </span>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    private IReadOnlyList<TokenRow>? _rows;
    private DateTimeOffset _now;
    private IReadOnlySet<Permission> _held = new HashSet<Permission>();
    private bool _mayIssue;
    private bool _mayAll;
    private bool _everyone;
    private bool _showRevoked;
    private bool _failed;
    private IDisposable? _watch;

    /// <summary>One row: the token, whose it is, and whether it is the caller's.</summary>
    internal sealed record TokenRow(ApiTokenSummary Token, string Owner, bool Mine);

    private IReadOnlyList<TokenRow> Shown =>
        _rows is null ? [] : [.. _rows.Where(r => _showRevoked || IdentityText.IsLive(r.Token, _now))];

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _watch = Identity.Watch(() => InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }));
        await LoadAsync();
    }

    public void Dispose() => _watch?.Dispose();

    private async Task LoadAsync()
    {
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        _now = Time.GetUtcNow();
        _held = user.Permissions;
        _mayIssue = user.Has(Permission.TokensOwn);
        _mayAll = user.Has(Permission.TokensAll);
        UserId me = user.UserId;
        CommandOrigin origin = user.Session.OriginFor(Channel.Dashboard);
        _failed = false;
        try
        {
            List<TokenRow> rows = [];
            if (_everyone && _mayAll)
            {
                // One read for the tokens and one for their owners' names, however many users there are.
                Dictionary<UserId, string> names = (await Identity.ListUsersAsync(origin)).Users.ToDictionary(u => u.Id, u => u.DisplayName);
                ApiTokenListResult tokens = await Identity.ListAllTokensAsync(origin);
                rows.AddRange(tokens.Tokens.Select(t => new TokenRow(t, t.UserId == me ? "You" : names.GetValueOrDefault(t.UserId, t.UserId.ToString()), t.UserId == me)));
            }
            else
            {
                ApiTokenListResult tokens = await Identity.ListTokensAsync(origin);
                rows.AddRange(tokens.Tokens.Select(t => new TokenRow(t, "You", true)));
            }

            _rows = rows;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't read the API tokens.");
            _failed = true;
        }
    }

    private async Task SetEveryoneAsync(bool everyone)
    {
        _everyone = everyone;
        _rows = null;
        await LoadAsync();
    }

    /// <summary>Makes a token in a drawer, which shows its secret once; the list is read again when it closes.</summary>
    private async Task CreateAsync()
    {
        await Drawers.OpenAsync<TokenDrawer>(TokenDrawer.For(_held), DrawerWidth.Medium);
        await LoadAsync();
    }

    private async Task AskRevokeAsync(TokenRow row)
    {
        bool confirmed = await ConfirmActionDialog.AskAsync(
            Dialogs,
            $"Revoke {row.Token.Name}?",
            "Whatever uses it is refused from now on.",
            "Revoke",
            "This can't be undone; a new token is a new secret.",
            icon: Icons.Material.Outlined.KeyOff);
        if (!confirmed || await Caller.OriginAsync() is not { } origin)
        {
            return;
        }

        ApiTokenResult? result = null;
        if (!await Logger.TryAsync(Snackbar, $"Couldn't revoke {row.Token.Name}.", async () => result = await Identity.RevokeTokenAsync(origin, row.Token.Id))
            || result is null)
        {
            return;
        }

        if (result.Succeeded)
        {
            Snackbar.Add($"Revoked {row.Token.Name}.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"Couldn't revoke {row.Token.Name}. {IdentityText.Refusal(result.Status, result.Problem)}", Severity.Error);
        }
    }
}
