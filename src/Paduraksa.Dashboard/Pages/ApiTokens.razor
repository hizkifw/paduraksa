@attribute [Route(SettingsRoutes.Tokens)]
@attribute [Route(SettingsRoutes.Tokens + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Paduraksa.Application.Commands
@using Paduraksa.Application.Identity
@using Paduraksa.Contracts.Identity
@inject IDashboardIdentity Identity
@inject DashboardCaller Caller
@inject TimeProvider Time
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ILogger<ApiTokens> Logger
@inject DisplayFormat Fmt
@* Settings: API tokens. One's own, and everyone's with tokens:all. A new token is made in a drawer, which shows its
   secret once; the page never holds it. A row opens the token's own drawer (its address is the list with that drawer open),
   where it is changed, switched off and on, and revoked. *@

<PageTitle>API tokens · Settings · Paduraksa</PageTitle>

<PageHeader Title="API tokens" ListEmpty="@(_rows is not null && Shown.Count == 0)">
    <Actions>
        @if (_mayIssue)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="CreateAsync" data-action="add-token">Create token</MudButton>
        }
    </Actions>
</PageHeader>

<McpConnect />

<MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
    <div class="pdk-toolbar">
        @if (_mayAll)
        {
            <SegmentedControl T="bool" Options="WhoseOptions" Value="_everyone" ValueChanged="SetEveryoneAsync" AriaLabel="Whose tokens" DataField="whose" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="pdk-muted">Your tokens</MudText>
        }
        <MudSwitch T="bool" @bind-Value="_showRevoked" Color="Color.Primary" Label="Show revoked and expired" />
    </div>

    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-3" data-alert="load-failed">
            The tokens couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="RetryAsync" Class="ml-2">Retry</MudButton>
        </MudAlert>
    }

    @if (_rows is null)
    {
        @if (!_failed)
        {
            @for (var i = 0; i < 3; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="15%" />
                </div>
            }
        }
    }
    else if (Shown.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Key" Title="@(_rows.Count == 0 ? "No API tokens yet" : "No live tokens")"
                    Description="A token lets a script or a tool use the REST API as you, with only the scopes you give it.">
            <Action>
                @if (_mayIssue)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="CreateAsync" data-action="add-token">Create token</MudButton>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="pdk-dt pdk-tokens-table @(_everyone ? "pdk-tokens-everyone" : null)" role="table" aria-label="API tokens">
            <div class="pdk-dt-row pdk-dt-head" role="row">
                <span role="columnheader">Token</span>
                @if (_everyone)
                {
                    <span role="columnheader">Owner</span>
                }
                <span role="columnheader">Scopes</span>
                <span role="columnheader">Last used</span>
                <span role="columnheader">Expires</span>
                <span role="columnheader">Status</span>
            </div>
            @foreach (var row in Shown)
            {
                var (label, tone) = IdentityText.State(row.Token, _now);
                <div class="pdk-dt-row pdk-dt-link @(row.Token.Disabled || row.Token.Revoked ? "pdk-dt-off" : null)" role="row" @key="row.Token.Id"
                     @onclick="() => Open(row.Token)">
                    <div class="pdk-dt-main" role="cell">
                        <span class="pdk-list-icon pdk-tone-@tone.Css()"><MudIcon Icon="@Icons.Material.Outlined.Key" Size="Size.Small" /></span>
                        <span class="pdk-dt-titles" data-token="@row.Token.Name">
                            <a class="pdk-list-title pdk-row-link" href="@DashboardRoutes.Token(row.Token.Id)" @onclick:stopPropagation="true">@row.Token.Name</a>
                            <span class="pdk-dt-note" title="@Fmt.Exact(row.Token.CreatedAt)">Created @Fmt.Ago(row.Token.CreatedAt, _now)</span>
                        </span>
                    </div>
                    @if (_everyone)
                    {
                        <span role="cell" class="pdk-dt-cell" data-label="Owner" @onclick:stopPropagation="true">
                            @if (row.OwnerHref is not null)
                            {
                                <a class="pdk-ref-link" href="@row.OwnerHref" data-link="owner">@row.Owner</a>
                            }
                            else
                            {
                                @row.Owner
                            }
                        </span>
                    }
                    <span role="cell" class="pdk-dt-cell" data-label="Scopes">
                        <span class="pdk-dt-chips">
                            @foreach (var scope in row.Token.Scopes.Take(3))
                            {
                                <span class="pdk-tag pdk-mono">@scope.ToName()</span>
                            }
                            @if (row.Token.Scopes.Count > 3)
                            {
                                <span class="pdk-tag" title="@string.Join(", ", row.Token.Scopes.Skip(3).Select(s => s.ToName()))">+@(row.Token.Scopes.Count - 3)</span>
                            }
                        </span>
                    </span>
                    <span role="cell" class="pdk-dt-cell" data-label="Last used">
                        @if (row.Token.LastUsedAt is { } used)
                        {
                            <span title="@Fmt.Exact(used)">@Fmt.Ago(used, _now)</span>
                        }
                        else
                        {
                            <span class="pdk-muted">Never</span>
                        }
                    </span>
                    <span role="cell" class="pdk-dt-cell" data-label="Expires"><span class="@(row.Token.ExpiresAt is null ? "pdk-muted" : null)">@IdentityText.Until(row.Token.ExpiresAt, _now, Fmt)</span></span>
                    <span role="cell" class="pdk-dt-cell" data-label="Status"><StatusChip Tone="tone" Dot="true" Text="@label" Name="status" /></span>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    private IReadOnlyList<TokenRow>? _rows;
    private DateTimeOffset _now;
    private IReadOnlySet<Permission> _held = new HashSet<Permission>();
    private bool _mayIssue;
    private bool _mayAll;
    private static readonly IReadOnlyList<SegmentOption<bool>> WhoseOptions = [new(false, "Mine"), new(true, "Everyone's", Key: "everyone")];

    private bool _everyone;
    private bool _showRevoked;
    private bool _failed;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;
    private bool _loaded;

    /// <summary>The address's last segment: a token's ID; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    /// <summary>One row: the token, whose it is, whether it is the caller's, and what its owner holds.</summary>
    /// <param name="Token">The token.</param>
    /// <param name="Owner">Whose it is, in words.</param>
    /// <param name="Mine">It is the caller's.</param>
    /// <param name="OwnerHolds">What the owner holds now, which bounds the scopes the token may be given.</param>
    /// <param name="OwnerHref">Where the owner goes: My account for the caller, the user's drawer when the caller could read the users (the name is shown); none otherwise.</param>
    internal sealed record TokenRow(ApiTokenSummary Token, string Owner, bool Mine, IReadOnlySet<Permission> OwnerHolds, string? OwnerHref = null);

    private IReadOnlyList<TokenRow> Shown =>
        _rows is null ? [] : [.. _rows.Where(r => _showRevoked || IdentityText.IsLive(r.Token, _now))];

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, SettingsRoutes.Tokens);
            _watch = Identity.Watch(() => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        // Someone else's token is in the other list: an address that names one looks there when this one doesn't have it.
        if (_rows is not null && !_everyone && _mayAll && ApiTokenId.TryParse(Key, out var wanted) && !_rows.Any(r => r.Token.Id == wanted))
        {
            _everyone = true;
            await LoadAsync();
        }

        _drawer!.Show(_rows is null ? null : Key, OpenDrawer);
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task RetryAsync()
    {
        await LoadAsync();
        _drawer?.Show(_rows is null ? null : Key, OpenDrawer);
    }

    private async Task LoadAsync()
    {
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        _now = Time.GetUtcNow();
        _held = user.Permissions;
        _mayIssue = user.Has(Permission.TokensOwn);
        _mayAll = user.Has(Permission.TokensAll);
        var me = user.UserId;
        var origin = user.Session.OriginFor(Channel.Dashboard);
        _failed = false;
        try
        {
            List<TokenRow> rows = [];
            if (_everyone && _mayAll)
            {
                // One read for the tokens and one for their owners, however many users there are.
                var owners = (await Identity.ListUsersAsync(origin)).Users.ToDictionary(u => u.Id);
                var tokens = await Identity.ListAllTokensAsync(origin);
                rows.AddRange(tokens.Tokens.Select(t => t.UserId == me
                    ? new TokenRow(t, "You", true, _held, DashboardRoutes.Account)
                    : new TokenRow(
                        t,
                        owners.TryGetValue(t.UserId, out var owner) ? owner.DisplayName : t.UserId.ToString(),
                        false,
                        // An owner nobody can read the roles of is offered only what the token has already.
                        owner is null ? new HashSet<Permission>(t.Scopes) : RolePermissions.Of(owner.Roles),
                        owner is null ? null : SettingsRoutes.User(owner.Id))));
            }
            else
            {
                var tokens = await Identity.ListTokensAsync(origin);
                rows.AddRange(tokens.Tokens.Select(t => new TokenRow(t, "You", true, _held, DashboardRoutes.Account)));
            }

            _rows = rows;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't read the API tokens.");
            _failed = true;
        }
    }

    private async Task SetEveryoneAsync(bool everyone)
    {
        _everyone = everyone;
        _rows = null;
        await LoadAsync();
    }

    /// <summary>Makes a token in a drawer, which shows its secret once; the list is read again when it closes.</summary>
    private async Task CreateAsync()
    {
        await Drawers.OpenAsync<TokenDrawer>(TokenDrawer.For(_held), DrawerWidth.Medium);
        await LoadAsync();
    }

    private void Open(ApiTokenSummary token) => Navigation.NavigateTo(DashboardRoutes.Token(token.Id));

    /// <summary>The drawer an address names. Blazor's router has no typed-ID constraint: the segment is parsed here, and anything that isn't one of the listed tokens is not found.</summary>
    private DrawerLevel OpenDrawer(string key)
    {
        if (ApiTokenId.TryParse(key, out var id) && _rows?.FirstOrDefault(r => r.Token.Id == id) is { } row)
        {
            return Drawers.Push<TokenDetailsDrawer>(
                TokenDetailsDrawer.For(row.Token, row.Owner, row.OwnerHolds, (row.Mine && _mayIssue) || _mayAll, row.OwnerHref),
                DrawerWidth.Medium);
        }

        return Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Token not found", "There is no such token", "Back to the tokens"), DrawerWidth.Narrow);
    }
}
