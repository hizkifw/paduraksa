@attribute [Route(DashboardRoutes.RateLimits)]
@attribute [Route(DashboardRoutes.RateLimits + "/{Key}")]
@* Settings: the rate-limit policies. /rate-limits/rlp_... is that policy with its drawer open. *@

<SecurityObjectList Kind="Listing" Key="@Key" />

@code {
    private static readonly SecurityObjectKind<RateLimitPolicyConfig> Listing = new()
    {
        Noun = "rate limit",
        Plural = "rate limits",
        Icon = Icons.Material.Outlined.Speed,
        SummaryHeading = "Applies",
        EmptyDescription = "A rate limit is a named budget, such as 60 requests a minute, that a host or one of its routes applies.",
        BackText = "Back to the rate limits",
        ListRoute = DashboardRoutes.RateLimits,
        NewRoute = DashboardRoutes.NewRateLimit,
        Drawer = typeof(RateLimitPolicyDrawer),
        DrawerParameters = key => RateLimitPolicyId.TryParse(key, out var id) ? new Dictionary<string, object?> { [nameof(RateLimitPolicyDrawer.Id)] = id } : null,
        Items = document => document.RateLimitPolicies,
        Name = policy => policy.Name,
        Notes = policy => policy.Notes,
        Route = policy => DashboardRoutes.RateLimit(policy.Id),
        DraftTarget = policy => DraftTargets.RateLimit(policy.Id),
        Summary = RateLimitText.Summary,
        Usage = (document, policy) => ReferenceUsage.Find(document, s => s.RateLimit?.PolicyId == policy.Id),
        Delete = policy => new DeleteRateLimitPolicyCommand(policy.Id, policy.Version),
    };

    [Parameter]
    public string? Key { get; set; }
}
