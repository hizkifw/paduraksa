@attribute [Route(DashboardRoutes.RateLimits)]
@attribute [Route(DashboardRoutes.RateLimits + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<RateLimits> Logger
@* Settings: the rate-limit policies. Each row says what the policy allows and which hosts and routes apply it; one in use
   can't be deleted, so its delete button is not offered. /rate-limits/rlp_... is this list with that drawer open. *@

<PageTitle>Rate limits · Paduraksa</PageTitle>

<PageHeader Title="Rate limits">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Href="@DashboardRoutes.NewRateLimit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-rate-limit">Add rate limit</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="@IdentityText.CantReadConfig" Description="@IdentityText.CantReadConfigHelp" />
    </MudPaper>
}
else
{
    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            The rate limits couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
        @if (_document is null)
        {
            @for (var i = 0; i < 3; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="24%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="36%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="20%" />
                </div>
            }
        }
        else if (_document.RateLimitPolicies.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Speed" Title="No rate limits yet"
                        Description="A rate limit is a named budget, such as 60 requests a minute, that a host or one of its routes applies.">
                <Action>
                    @if (_mayWrite)
                    {
                        <MudButton Href="@DashboardRoutes.NewRateLimit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add">Add rate limit</MudButton>
                    }
                </Action>
            </EmptyState>
        }
        else
        {
            <div class="pdk-dt pdk-rate-limits-table" role="table" aria-label="Rate limits">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">Rate limit</span>
                    <span role="columnheader">Applies</span>
                    <span role="columnheader">Used by</span>
                    <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
                </div>
                @foreach (var policy in _document.RateLimitPolicies.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var usage = RateLimitUsageOf.Find(_document, policy.Id);
                    <div class="pdk-dt-row pdk-dt-link" role="row" @onclick="() => Open(policy)" data-rate-limit="@policy.Name" @key="policy.Id">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Speed" Size="Size.Small" /></span>
                            <div class="pdk-dt-titles">
                                <a class="pdk-row-link" href="@DashboardRoutes.RateLimit(policy.Id)" @onclick:stopPropagation="true">@policy.Name</a>
                                @if (!string.IsNullOrWhiteSpace(policy.Notes))
                                {
                                    <span class="pdk-dt-note">@policy.Notes</span>
                                }
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Applies">
                            <span class="pdk-dt-note">@RateLimitText.Summary(policy)</span>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Used by" @onclick:stopPropagation="true">
                            @if (usage.IsEmpty)
                            {
                                <span class="pdk-muted">No host or route</span>
                            }
                            else
                            {
                                <div class="pdk-dt-stack">
                                    <span class="pdk-muted">@usage.CountText</span>
                                    <span class="pdk-dt-chips">
                                        @foreach (var host in usage.Hosts)
                                        {
                                            <a class="pdk-tag pdk-tag-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                        }
                                        @foreach (var use in usage.Routes)
                                        {
                                            <a class="pdk-tag pdk-tag-link" href="@DashboardRoutes.Host(use.Host.Id)">@($"{ChangeView.HostTitle(use.Host)} {use.Route.Path}")</a>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                        <div role="cell" class="pdk-dt-cell pdk-dt-actions" @onclick:stopPropagation="true">
                            @if (_mayWrite && usage.IsEmpty)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ReviewDeleteAsync(policy)"
                                               aria-label="@($"Delete {policy.Name}")" data-action="delete" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

@code {
    private bool _denied;
    private bool _failed;
    private bool _mayWrite;
    private bool _loaded;
    private ConfigDocument? _document;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: a policy's ID, or <c>new</c>; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, DashboardRoutes.RateLimits);
            _watch = Config.Watch(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        if (!_denied)
        {
            _drawer!.Show(Key, OpenDrawer);
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        _failed = false;
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        try
        {
            _document = (await Config.GetCurrentAsync()).Document;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't load the rate limits.");
            _failed = true;
            _document ??= new ConfigDocument();
            Snackbar.Add(StoreFailures.Message("The rate limits couldn't be read."), Severity.Error);
        }
    }

    private DrawerLevel OpenDrawer(string key)
    {
        if (key == DashboardRoutes.NewSegment)
        {
            return Drawers.Push<RateLimitPolicyDrawer>(width: DrawerWidth.Medium);
        }

        return RateLimitPolicyId.TryParse(key, out var id)
            ? Drawers.Push<RateLimitPolicyDrawer>(new Dictionary<string, object?> { [nameof(RateLimitPolicyDrawer.Id)] = id }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Rate limit not found", "There is no such rate limit", "Back to the rate limits"), DrawerWidth.Narrow);
    }

    private void Open(RateLimitPolicyConfig policy) => Navigation.NavigateTo(DashboardRoutes.RateLimit(policy.Id));

    private async Task ReviewDeleteAsync(RateLimitPolicyConfig policy)
    {
        if (_document is null || !_mayWrite || !RateLimitUsageOf.Find(_document, policy.Id).IsEmpty)
        {
            return;
        }

        await Drawers.ReviewAsync(new ReviewRequest($"Delete rate limit {policy.Name}", new DeleteRateLimitPolicyCommand(policy.Id, policy.Version))
        {
            ApplyLabel = "Delete",
            Destructive = true,
            SuccessMessage = $"Deleted the rate limit {policy.Name}",
        });
    }
}
