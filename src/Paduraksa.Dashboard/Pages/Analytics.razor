@attribute [Route(DashboardRoutes.Analytics)]
@implements IAsyncDisposable
@using Paduraksa.Contracts.Config
@using Paduraksa.Contracts.Metrics
@using Paduraksa.Dashboard.Components
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject IJSRuntime JS
@inject NavigationManager Navigation
@* Every figure over time, in three tabs under one range: the traffic (the proxy's live counters), the visitors (the access-log drain's
   analytics) and the gate's security counters. The tab and the range are in the address, so a view can be linked to and a range
   survives a change of tab. Only the open tab is mounted, so only it polls; the page watches whether the browser tab is visible. *@

<PageTitle>Analytics · Paduraksa</PageTitle>

<PageHeader Title="Analytics">
    <Actions>
        @if (!_denied)
        {
            @if (Current == AnalyticsTab.Visitors)
            {
                <MudSelect T="string" Value="_scope" ValueChanged="ChooseScope" Label="Host" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="pdk-analytics-host"
                           data-field="host">
                    <MudSelectItem T="string" Value="@AllHosts">All hosts</MudSelectItem>
                    @foreach (var host in _hosts)
                    {
                        <MudSelectItem T="string" Value="@host.Id.ToString()">@host.Name</MudSelectItem>
                    }
                    <MudSelectItem T="string" Value="@NoHost">No host matched</MudSelectItem>
                </MudSelect>
            }
            <SegmentedControl T="MetricsRange" Options="TrafficFigures.RangeOptions" Value="CurrentRange" ValueChanged="ChooseRange" AriaLabel="Time range" DataField="range" />
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="Your role can't read the analytics"
                    Description="An Owner can give you a role that reads the metrics." />
    </MudPaper>
}
else
{
    @* The tabs and the open tab's frame are there from the prerender, held until the circuit knows who is asking, so the page has its size from the first paint. *@
    <div class="pdk-analytics-tabs">
        <SegmentedControl T="AnalyticsTab" Options="AnalyticsView.TabOptions" Value="Current" ValueChanged="ChooseTab" AriaLabel="Analytics" DataField="tab" />
    </div>

    @switch (Current)
    {
        case AnalyticsTab.Visitors:
            <VisitorsStatistics Hold="@(!_started)" Range="CurrentRange" Host="Host" Unmatched="@(_scope == NoHost)" HostName="@HostName" Visible="_visible" PollInterval="PollInterval" />
            break;
        case AnalyticsTab.Security:
            <SecurityStatistics Hold="@(!_started)" Range="CurrentRange" Visible="_visible" PollInterval="SecurityPollInterval" />
            break;
        default:
            <TrafficStatistics Hold="@(!_started)" Range="CurrentRange" Visible="_visible" PollInterval="TrafficPollInterval" />
            break;
    }
}

@code {
    private const string AllHosts = "all";

    private const string NoHost = "unmatched";

    private sealed record HostChoice(HostId Id, string Name);

    private string _scope = AllHosts;
    private IReadOnlyList<HostChoice> _hosts = [];
    private bool _denied;
    private bool _visible = true;
    private bool _started;
    private DotNetObjectReference<Analytics>? _self;

    /// <summary>The tab the address names (<c>?tab=traffic|visitors|security</c>).</summary>
    [SupplyParameterFromQuery(Name = AnalyticsView.TabParameter)]
    public string? TabQuery { get; set; }

    /// <summary>The range the address names (<c>?range=1h|24h|7d|30d</c>).</summary>
    [SupplyParameterFromQuery(Name = AnalyticsView.RangeParameter)]
    public string? RangeQuery { get; set; }

    /// <summary>How often the visitors' hour is read while the tab is visible. A test shortens it; the person never changes it.</summary>
    [Parameter]
    public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(10);

    /// <summary>How often the traffic tab reads the hour. A test shortens it.</summary>
    [Parameter]
    public TimeSpan TrafficPollInterval { get; set; } = TimeSpan.FromSeconds(2);

    /// <summary>How often the security tab reads the hour. A test shortens it.</summary>
    [Parameter]
    public TimeSpan SecurityPollInterval { get; set; } = TimeSpan.FromSeconds(2);

    private AnalyticsTab Current => AnalyticsView.ParseTab(TabQuery);

    private MetricsRange CurrentRange => AnalyticsView.ParseRange(RangeQuery);

    private HostId? Host => _scope != AllHosts && _scope != NoHost && HostId.TryParse(_scope, null, out var id) ? id : null;

    private string? HostName => _scope == NoHost ? "(no host matched)" : _hosts.FirstOrDefault(host => host.Id.ToString() == _scope)?.Name;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.MetricsRead))
        {
            _denied = true;
            return;
        }

        if (user.Has(Permission.ConfigRead))
        {
            try
            {
                _hosts = [.. (await Config.GetCurrentAsync()).Document.Hosts.Where(host => host.Names.Count > 0).Select(host => new HostChoice(host.Id, host.Names[0])).OrderBy(host => host.Name, StringComparer.OrdinalIgnoreCase)];
            }
            catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
            {
                // Without the config the picker offers all hosts and the requests no host owns.
            }
        }

        _started = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _started)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("paduraksa.pageVisibility.watch", _self);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException or TaskCanceledException or ObjectDisposedException)
            {
                // The circuit is gone; nothing watches, and the tab polls until it is disposed.
            }
        }
    }

    /// <summary>The browser tab was hidden or shown: the open tab's polling pauses while it is hidden and reads at once when it is shown.</summary>
    [JSInvokable]
    public async Task PageVisibilityChangedAsync(bool visible)
    {
        await InvokeAsync(() =>
        {
            _visible = visible;
            StateHasChanged();
        });
    }

    // Both choices rewrite the address and leave the page to read it back, so there is one source for the view. Replacing the entry keeps
    // Back for leaving the page, not for stepping through the ranges.
    private void ChooseTab(AnalyticsTab tab) => Navigation.NavigateTo(AnalyticsView.Href(tab, CurrentRange), replace: true);

    private void ChooseRange(MetricsRange range) => Navigation.NavigateTo(AnalyticsView.Href(Current, range), replace: true);

    private void ChooseScope(string scope) => _scope = scope;

    public async ValueTask DisposeAsync()
    {
        if (_self is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("paduraksa.pageVisibility.detach");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException or TaskCanceledException or ObjectDisposedException)
            {
                // The circuit is gone.
            }

            _self.Dispose();
        }
    }
}
