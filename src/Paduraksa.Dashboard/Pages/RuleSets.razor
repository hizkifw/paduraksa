@attribute [Route(DashboardRoutes.RuleSets)]
@attribute [Route(DashboardRoutes.RuleSets + "/{Key}")]
@* Security: the rule sets. The built-in presets are listed under them: read-only, copied into a set of your own to change them.
   /rule-sets/rs_... is that set with its drawer open; /rule-sets/new?copy=rs_... starts a new one from a preset. *@

<SecurityObjectList Kind="Listing" Key="@Key" NewParameters="NewParameters()">
    <After Context="list">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="pdk-section-heading">Built-in presets</MudText>
        <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true" data-section="presets">
            <div class="pdk-dt pdk-presets-table" role="table" aria-label="Built-in presets">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">Preset</span>
                    <span role="columnheader">Rules</span>
                    <span role="columnheader">Used by</span>
                    <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
                </div>
                @foreach (var preset in RuleSetPresets.All)
                {
                    var usage = ReferenceUsage.Find(list.Document, s => s.RuleSet?.RuleSetId == preset.Id);
                    <div class="pdk-dt-row" role="row" data-preset="@preset.Name" @key="preset.Id">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-list-icon pdk-tone-default"><MudIcon Icon="@Icons.Material.Outlined.Rule" Size="Size.Small" /></span>
                            <div class="pdk-dt-titles">
                                <span class="pdk-row-title">@preset.Name</span>
                                <span class="pdk-dt-note pdk-dt-note-wrap">@preset.Notes</span>
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Rules">
                            <span class="pdk-dt-note">@RuleSetText.Summary(preset)</span>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Used by">
                            <UsageCell Usage="usage" />
                        </div>
                        <div role="cell" class="pdk-dt-cell pdk-dt-actions">
                            @if (list.MayWrite)
                            {
                                <MudButton Href="@DashboardRoutes.CopyRuleSet(preset.Id)" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add"
                                           data-action="create-from-preset" aria-label="@($"Create a rule set from {preset.Name}")">Create from preset</MudButton>
                            }
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    </After>
</SecurityObjectList>

@code {
    private static readonly SecurityObjectKind<RuleSetConfig> Listing = new()
    {
        Noun = "rule set",
        Plural = "rule sets",
        Icon = Icons.Material.Outlined.Rule,
        SummaryHeading = "Rules",
        EmptyDescription = "A rule set refuses, drops or allows requests by path, method and user agent. Start from a preset below, or write your own.",
        BackText = "Back to the rules",
        Section = "rule-sets",
        ListRoute = DashboardRoutes.RuleSets,
        NewRoute = DashboardRoutes.NewRuleSet,
        Drawer = typeof(RuleSetDrawer),
        DrawerParameters = key => RuleSetId.TryParse(key, out var id) ? new Dictionary<string, object?> { [nameof(RuleSetDrawer.Id)] = id } : null,
        Items = document => document.RuleSets,
        Name = set => set.Name,
        Notes = set => set.Notes,
        Route = set => DashboardRoutes.RuleSet(set.Id),
        DraftTarget = set => DraftTargets.RuleSet(set.Id),
        Summary = RuleSetText.Summary,
        Usage = (document, set) => ReferenceUsage.Find(document, s => s.RuleSet?.RuleSetId == set.Id),
        Delete = set => new DeleteRuleSetCommand(set.Id, set.Version),
    };

    [Parameter]
    public string? Key { get; set; }

    /// <summary>With <c>new</c>: the built-in preset to start from.</summary>
    [SupplyParameterFromQuery(Name = DashboardRoutes.CopyParameter)]
    public string? Copy { get; set; }

    private IReadOnlyDictionary<string, object?>? NewParameters() =>
        RuleSetId.TryParse(Copy, out var preset) && RuleSetPresets.TryGet(preset, out var source)
            ? new Dictionary<string, object?> { [nameof(RuleSetDrawer.Preset)] = source }
            : null;
}
