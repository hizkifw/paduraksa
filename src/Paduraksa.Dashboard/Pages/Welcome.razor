@attribute [Authorize]
@attribute [Route(SetupWizard.Route)]
@attribute [Route(SetupWizard.Route + "/{Slug}")]
@using Paduraksa.Application.Certificates
@using Paduraksa.Application.Commands
@using Paduraksa.Application.Identity
@using Paduraksa.Application.Issuance
@using Paduraksa.Contracts.Certificates
@using Paduraksa.Contracts.Config
@using Paduraksa.Contracts.Issuance
@using Paduraksa.Dashboard.Certificates
@using Paduraksa.Dashboard.Providers
@using Paduraksa.Dashboard.Setup
@using Microsoft.Extensions.Logging
@inject UserService Users
@inject AcmeAccountService AcmeAccounts
@inject DnsProviderService DnsProviders
@inject CertificateService CertificateInventory
@inject ConfigService Config
@inject ProviderActions Actions
@inject DashboardCaller Caller
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<Welcome> Logger

<PageTitle>Set up · Paduraksa</PageTitle>

<div class="pdk-wizard">
    <PageHeader Title="@(_step == WizardStep.Done ? "You're set up" : "Finish setting up")" Overline="First run"
                Lead="@(_step == WizardStep.Done ? "Here is what this instance has now." : "A few steps to your first proxied host. Skip anything you don't need; the overview keeps a checklist.")" />

    <WizardStepper Current="_step" Skipped="_skipped" />

    @if (_notFound)
    {
        <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
            <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such step" Description="The address names a step the wizard doesn't have.">
                <Action>
                    <MudButton Href="@SetupWizard.Route" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Start from the first step</MudButton>
                </Action>
            </EmptyState>
        </MudPaper>
    }
    else
    {
        WizardStepInfo info = SetupWizard.Info(_step);
        <MudPaper Class="pdk-card pdk-wizard-card" Elevation="0" Outlined="true" data-step="@info.Slug">
            <header class="pdk-wizard-head">
                <span class="pdk-dialog-icon pdk-tone-primary"><MudIcon Icon="@info.Icon" Size="Size.Small" /></span>
                <div>
                    <MudText Typo="Typo.overline" Class="pdk-muted">Step @((int)_step + 1) of @SetupWizard.Steps.Count</MudText>
                    <MudText Typo="Typo.h5" HtmlTag="h2" Class="pdk-wizard-title">@StepTitle</MudText>
                    <MudText Typo="Typo.body2" Class="pdk-muted">@StepLead</MudText>
                </div>
            </header>

            <div class="pdk-wizard-body">
                @if (_progress is null && _failed)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-alert="load-failed">
                        What is set up couldn't be read. The details are in the server log.
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ReloadAsync" Class="ml-2">Try again</MudButton>
                    </MudAlert>
                }
                else if (_progress is null)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" />
                }
                else
                {
                    @switch (_step)
                    {
                        case WizardStep.TwoStep:
                            <TwoStepEnrollment AlreadyEnabled="_progress.TwoStep" Enabled="ReloadAsync" />
                            break;

                        case WizardStep.AcmeAccount:
                            @if (!May(Permission.ProvidersWrite))
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">Your role can't add ACME accounts.</MudAlert>
                            }
                            else if (_progress.Accounts?.FirstOrDefault(a => a.Status == AcmeAccountStatus.Active) is { } account && !_addAnother)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="pdk-wizard-has-account">
                                    Registered with @ProviderDisplay.CaName(account.DirectoryUrl) as @ProviderDisplay.AccountName(account).
                                </MudAlert>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2" OnClick="() => _addAnother = true">Add another account</MudButton>
                            }
                            else
                            {
                                <AcmeAccountForm Submit="s => Actions.CreateAccountAsync(s)" Created="AccountCreatedAsync" SubmitText="Register account" />
                            }
                            break;

                        case WizardStep.DnsProvider:
                            @if (!May(Permission.ProvidersWrite))
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">Your role can't add DNS providers.</MudAlert>
                            }
                            else if (_provider is { } provider)
                            {
                                <div class="pdk-provider pdk-wizard-provider">
                                    <span class="pdk-stat-icon pdk-tone-primary"><MudIcon Icon="@ProviderDisplay.KindIcon(provider.Kind)" Size="Size.Small" /></span>
                                    <div class="pdk-provider-main">
                                        <span class="pdk-provider-title">@provider.Label</span>
                                        <span class="pdk-provider-sub">@ProviderDisplay.KindLabel(provider.Kind) · @DnsProviderService.ApiHostOf(provider.Kind)</span>
                                    </div>
                                    <div class="pdk-provider-actions">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="TestAsync" Disabled="_testing"
                                                   StartIcon="@Icons.Material.Outlined.NetworkCheck" Class="pdk-dns-test">Test</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _provider = null">Use another</MudButton>
                                    </div>
                                    <DnsTestResultView Testing="_testing" Result="_test" ProviderName="@ProviderDisplay.KindLabel(provider.Kind)" />
                                </div>
                            }
                            else
                            {
                                <DnsProviderForm Submit="s => Actions.CreateProviderAsync(s)" Saved="ProviderSavedAsync" SubmitText="Add and test" />
                            }
                            break;

                        case WizardStep.Certificate:
                            @if (!May(Permission.CertificatesWrite))
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">Your role can't add certificates.</MudAlert>
                            }
                            else
                            {
                                <CertificateStep Accounts="_progress.Accounts ?? []" Providers="_progress.Providers ?? []" InitialNames="_names" Issued="CertificateIssuedAsync" />
                            }
                            break;

                        case WizardStep.FirstHost:
                            @if (!May(Permission.ConfigWrite))
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">@IdentityText.CantChangeConfig</MudAlert>
                            }
                            else if (_createdHost is { } host)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="pdk-wizard-host-created">
                                    <strong>@host.Names[0]</strong> is live. Requests for it go to the upstream you gave.
                                </MudAlert>
                            }
                            else
                            {
                                <FirstHostStep InitialName="@HostSuggestion" Created="HostCreatedAsync" />
                            }
                            break;

                        default:
                            <SetupSummary Progress="_progress" Skipped="_skipped" />
                            break;
                    }
                }
            </div>

            <footer class="pdk-wizard-foot">
                @if (_step > SetupWizard.First)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="BackAsync" Class="pdk-wizard-back">Back</MudButton>
                }
                <MudSpacer />
                @if (_step == WizardStep.Done)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@DashboardRoutes.Home" EndIcon="@Icons.Material.Rounded.ArrowForward" Class="pdk-wizard-finish">
                        Go to the overview
                    </MudButton>
                }
                else
                {
                    @if (_progress?.IsDone(_step) != true && info.Skippable)
                    {
                        <MudButton Variant="Variant.Text" OnClick="SkipAsync" Class="pdk-wizard-skip">@SkipText</MudButton>
                    }
                    <MudButton Variant="@(_progress?.IsDone(_step) == true ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="NextAsync"
                               EndIcon="@Icons.Material.Rounded.ArrowForward" Disabled="@(!CanContinue)" Class="pdk-wizard-next">Continue</MudButton>
                }
            </footer>
        </MudPaper>
    }
</div>

@code {
    private WizardStep _step = SetupWizard.First;
    private bool _notFound;
    private SetupProgress? _progress;
    private DashboardPrincipal? _user;
    private readonly HashSet<WizardStep> _skipped = [];
    private bool _addAnother;
    private DnsProviderSummary? _provider;
    private DnsProviderTestResult? _test;
    private bool _testing;
    private IReadOnlyList<string>? _names;
    private HostConfig? _createdHost;
    private bool _certificateIssued;
    private bool _failed;

    /// <summary>The step's slug from the address, parsed at the page's edge.</summary>
    [Parameter]
    public string? Slug { get; set; }

    private bool May(Permission permission) => _user?.Has(permission) == true;

    private string StepTitle => _step switch
    {
        WizardStep.TwoStep => "Turn on two-step sign-in",
        WizardStep.AcmeAccount => "Add an ACME account",
        WizardStep.DnsProvider => "Connect your DNS provider",
        WizardStep.Certificate => "Get a certificate",
        WizardStep.FirstHost => "Add your first host",
        _ => "All done",
    };

    private string StepLead => _step switch
    {
        WizardStep.TwoStep => "A code from your phone on top of the password: the Owner can do everything, so this is worth a minute.",
        WizardStep.AcmeAccount => "Free, browser-trusted certificates from Let's Encrypt (or another ACME CA). Skip it for a LAN-only setup.",
        WizardStep.DnsProvider => "Needed for a wildcard certificate, or when the CA can't reach this server on port 80. With HTTP-01 only, skip it.",
        WizardStep.Certificate => "One certificate for your names (a wildcard covers every subdomain). Skip it, or use the local CA for LAN names.",
        WizardStep.FirstHost => "A name, and the service on your network it should reach.",
        _ => "Change anything later from the dashboard.",
    };

    private string SkipText => _step switch
    {
        WizardStep.DnsProvider => "Skip: HTTP-01 only",
        _ => "Skip for now",
    };

    private string? HostSuggestion => _names?.FirstOrDefault(n => !n.StartsWith("*.", StringComparison.Ordinal))
        ?? (_names?.FirstOrDefault() is { } wildcard ? $"app.{wildcard[2..]}" : null);

    protected override async Task OnParametersSetAsync()
    {
        WizardStep? step = SetupWizard.Parse(Slug);
        _notFound = step is null;
        _step = step ?? SetupWizard.First;
        if (_progress is null)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _user = await Caller.CheckAsync();
        if (_user is null)
        {
            return;
        }

        _failed = false;
        try
        {
            _progress = await SetupProgress.LoadAsync(_user, Users, AcmeAccounts, DnsProviders, CertificateInventory, Config);
            _provider ??= _progress.Providers?.FirstOrDefault();
            _names ??= _progress.Certificates?.OrderByDescending(c => c.CreatedAt).FirstOrDefault()?.Names;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            // The steps keep what they show; a step with nothing yet offers another try.
            Logger.LogStoreFailure(ex, "Couldn't read the setup progress.");
            _failed = true;
        }
    }

    private void Go(WizardStep step) => Navigation.NavigateTo(SetupWizard.PathOf(step));

    private Task NextAsync()
    {
        _skipped.Remove(_step);
        Go(SetupWizard.Next(_step));
        return Task.CompletedTask;
    }

    private Task SkipAsync()
    {
        _skipped.Add(_step);
        Go(SetupWizard.Next(_step));
        return Task.CompletedTask;
    }

    private Task BackAsync()
    {
        Go(SetupWizard.Previous(_step));
        return Task.CompletedTask;
    }

    private async Task AccountCreatedAsync(AcmeAccountSummary account)
    {
        _addAnother = false;
        await ReloadAsync();
    }

    private async Task ProviderSavedAsync(DnsProviderSummary provider)
    {
        _provider = provider;
        await ReloadAsync();
        await TestAsync();
    }

    private async Task TestAsync()
    {
        if (_provider is not { } provider)
        {
            return;
        }

        _testing = true;
        _test = null;
        StateHasChanged();
        try
        {
            await Logger.TryAsync(Snackbar, "The DNS provider test couldn't run.", async () => _test = await Actions.TestAsync(provider.Id));
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task CertificateIssuedAsync(CertificateSummary certificate)
    {
        // The step says the certificate is ready as soon as it is: Continue follows at once, not after the progress has been re-read.
        _names = certificate.Names;
        _certificateIssued = true;
        StateHasChanged();
        await ReloadAsync();
    }

    /// <summary>The step is done: by the progress as last read, or a certificate this page just issued.</summary>
    private bool CanContinue => _progress?.IsDone(_step) == true || (_step == WizardStep.Certificate && _certificateIssued);

    private async Task HostCreatedAsync(HostConfig host)
    {
        _createdHost = host;
        await ReloadAsync();
    }
}
