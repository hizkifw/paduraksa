@attribute [Route(DashboardRoutes.Upstreams)]
@attribute [Route(DashboardRoutes.Upstreams + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DraftState Drafts
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject ILogger<Upstreams> Logger
@* The upstreams: each one's addresses, how it spreads load and checks health, and which hosts send requests to it.
   /upstreams/ups_... is this list with that drawer open. *@

<PageTitle>Upstreams · Paduraksa</PageTitle>

<PageHeader Title="Upstreams" ListEmpty="@(_document is { Upstreams.Count: 0 })">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Href="@DashboardRoutes.NewUpstream" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-upstream">Add upstream</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="@IdentityText.CantReadConfig" Description="@IdentityText.CantReadConfigHelp" />
    </MudPaper>
}
else
{
    <UpstreamHealthFeed Updated="OnHealth" />
    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            The upstreams couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
        @if (_document is not { Upstreams.Count: 0 })
        {
            <ListToolbar Search="@_search" SearchChanged="value => _search = value" Placeholder="Search names, addresses, hosts"
                         Total="_document?.Upstreams.Count" Shown="Filtered.Count" One="upstream" Many="upstreams" />
        }

        @if (_document is null)
        {
            @for (var i = 0; i < 3; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="10px" Height="10px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="22%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="24%" />
                </div>
            }
        }
        else if (_document.Upstreams.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Hub" Title="No upstreams yet"
                        Description="An upstream is a service on your network, such as http://jellyfin:8096. A host's form can add one too.">
                <Action>
                    @if (_mayWrite)
                    {
                        <MudButton Href="@DashboardRoutes.NewUpstream" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-upstream">Add upstream</MudButton>
                    }
                </Action>
            </EmptyState>
        }
        else if (Filtered.Count == 0)
        {
            <EmptyState Compact="true" Icon="@Icons.Material.Outlined.SearchOff" Title="No upstream matches" Description="Try another name, address or host." />
        }
        else
        {
            <div class="pdk-dt pdk-upstreams-table" role="table" aria-label="Upstreams">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">Upstream</span>
                    <span role="columnheader">Destinations</span>
                    <span role="columnheader">Used by</span>
                </div>
                @foreach (var upstream in Filtered)
                {
                    var uses = HostOverview.UsesOf(_document, upstream.Id);
                    var serving = upstream.Destinations.Any(d => d.Enabled);
                    var live = _health.GetValueOrDefault(upstream.Id);
                    var checkedLive = live is { State: not UpstreamHealthState.Unchecked };
                    var dotTone = checkedLive ? HealthDisplay.ToneOf(live!.State).Css() : serving ? "default" : "warning";
                    var dotText = checkedLive ? HealthDisplay.Word(live!.State) : serving ? HealthDisplay.Word(UpstreamHealthState.Unchecked) : "No destination is switched on";
                    <div class="pdk-dt-row pdk-dt-link" role="row" @onclick="() => Open(upstream)" data-upstream="@upstream.Name" @key="upstream.Id">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-status-dot pdk-tone-@dotTone" title="@dotText" role="img" aria-label="@dotText" data-health="@(checkedLive ? live!.State.ToString().ToLowerInvariant() : null)"></span>
                            <div class="pdk-dt-titles">
                                <a class="pdk-row-link" href="@DashboardRoutes.Upstream(upstream.Id)" @onclick:stopPropagation="true">@upstream.Name</a>
                                <DraftChip Target="@DraftTargets.Upstream(upstream.Id)" />
                                <span class="pdk-dt-note">@Describe(upstream)</span>
                                @if (live?.LastChange is { } change)
                                {
                                    <span class="pdk-dt-note pdk-health-change" title="@RevisionText.Exact(change.At)">@HealthDisplay.LastChange(change, Time.GetUtcNow())</span>
                                }
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Destinations">
                            <ul class="pdk-dest-list">
                                @foreach (var destination in upstream.Destinations.Take(3))
                                {
                                    var liveDestination = live?.Destinations.FirstOrDefault(d => d.Id == destination.Id);
                                    <li class="@(destination.Enabled ? null : "pdk-disabled")">
                                        @if (checkedLive && liveDestination is not null && destination.Enabled)
                                        {
                                            <span class="pdk-status-dot pdk-status-dot-small pdk-tone-@HealthDisplay.ToneOf(liveDestination.State).Css()" title="@HealthDisplay.Word(liveDestination.State)"
                                                  role="img" aria-label="@HealthDisplay.Word(liveDestination.State)" data-destination-health="@liveDestination.State.ToString().ToLowerInvariant()"></span>
                                        }
                                        <span class="pdk-dest-detail pdk-mono">@destination.Address</span>
                                        @if (checkedLive && liveDestination is { State: DestinationHealthState.Unhealthy, Reason: { Length: > 0 } reason } && destination.Enabled)
                                        {
                                            <span class="pdk-muted pdk-health-reason">@reason</span>
                                        }
                                        @if (!destination.Enabled)
                                        {
                                            <StatusChip Text="Off" />
                                        }
                                    </li>
                                }
                                @if (upstream.Destinations.Count > 3)
                                {
                                    <li class="pdk-muted">@($"and {upstream.Destinations.Count - 3} more")</li>
                                }
                            </ul>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Used by" @onclick:stopPropagation="true">
                            @if (uses.Count == 0)
                            {
                                <span class="pdk-muted">No host yet</span>
                            }
                            else
                            {
                                <span class="pdk-dt-chips">
                                    @foreach (var host in uses.GroupBy(u => u.Host.Id))
                                    {
                                        <a class="pdk-tag pdk-tag-link" href="@DashboardRoutes.Host(host.Key)">@ChangeView.HostTitle(host.First().Host)@(host.Count() > 1 || host.First().Route.Path != "/" ? $" {string.Join(", ", host.Select(u => u.Route.Path))}" : string.Empty)</a>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

@code {
    private ConfigDocument? _document;
    private Dictionary<UpstreamId, UpstreamHealthView> _health = [];
    private string? _search;
    private bool _mayWrite;
    private bool _denied;
    private bool _failed;
    private bool _loaded;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: an upstream's ID, or <c>new</c>; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    private IReadOnlyList<UpstreamConfig> Filtered =>
        _document is null ? [] : [.. _document.Upstreams.Where(Matches).OrderBy(u => u.Name, StringComparer.OrdinalIgnoreCase)];

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, DashboardRoutes.Upstreams);
            _watch = Config.Watch(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        if (!_denied)
        {
            _drawer!.Show(Key, OpenDrawer);
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        await Drafts.EnsureLoadedAsync();
        _failed = false;
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        try
        {
            _document = (await Config.GetWorkingAsync()).Document;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't load the upstreams.");
            _failed = true;
            _document ??= new ConfigDocument();
        }
    }

    private DrawerLevel OpenDrawer(string key)
    {
        if (key == DashboardRoutes.NewSegment)
        {
            return Drawers.Push<UpstreamDrawer>(width: DrawerWidth.Medium);
        }

        return UpstreamId.TryParse(key, out var id)
            ? Drawers.Push<UpstreamDrawer>(new Dictionary<string, object?> { [nameof(UpstreamDrawer.Id)] = id }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Upstream not found", "There is no such upstream", "Back to the upstreams"), DrawerWidth.Narrow);
    }

    private void OnHealth(IReadOnlyList<UpstreamHealthView> views) => _health = views.ToDictionary(view => view.Id);

    private void Open(UpstreamConfig upstream) => Navigation.NavigateTo(DashboardRoutes.Upstream(upstream.Id));

    private bool Matches(UpstreamConfig upstream)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();
        return upstream.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || upstream.Destinations.Any(d => d.Address.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (_document is not null && HostOverview.UsesOf(_document, upstream.Id).Any(u => u.Host.Names.Any(n => n.Contains(term, StringComparison.OrdinalIgnoreCase))));
    }

    /// <summary>One line about how the upstream spreads load and checks health.</summary>
    internal static string Describe(UpstreamConfig upstream)
    {
        List<string> parts = [upstream.Destinations.Count == 1 ? "1 destination" : $"{upstream.Destinations.Count} destinations"];
        if (upstream.LoadBalancing is { } policy)
        {
            parts.Add(FieldLabels.Value(System.Text.Json.JsonNamingPolicy.CamelCase.ConvertName(policy.ToString())).ToLowerInvariant());
        }

        if (upstream.ActiveHealth is { } active)
        {
            parts.Add($"checks {active.Path} every {Every(active.Interval ?? ActiveHealthConfig.DefaultInterval)}");
        }
        else if (upstream.PassiveHealth is not null)
        {
            parts.Add("passive health");
        }

        if (upstream.SessionAffinity)
        {
            parts.Add("sticky sessions");
        }

        return string.Join(" · ", parts);
    }

    private static string Every(TimeSpan interval) =>
        interval < TimeSpan.FromSeconds(1) ? $"{(int)interval.TotalMilliseconds} ms" : $"{(int)interval.TotalSeconds} s";
}
