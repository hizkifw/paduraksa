@attribute [Route(DashboardRoutes.Hosts)]
@attribute [Route(DashboardRoutes.Hosts + "/{Key}")]
@implements IDisposable
@using Paduraksa.Contracts.Certificates
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject ILogger<Hosts> Logger
@* The hosts: each host's names, where its requests go, its certificate and whether it is on. The address /hosts/host_...
   (or /hosts/new) is this list with that drawer open. *@

<PageTitle>Hosts · Paduraksa</PageTitle>

<PageHeader Title="Hosts">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Href="@DashboardRoutes.NewHost" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-host">Add host</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="@IdentityText.CantReadConfig" Description="@IdentityText.CantReadConfigHelp" />
    </MudPaper>
}
else
{
    <UpstreamHealthFeed Updated="OnHealth" />
    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            The hosts couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
        @if (_rows is not { Count: 0 })
        {
            <ListToolbar Search="@_search" SearchChanged="value => _search = value" Placeholder="Search hostnames, upstreams, addresses, tags"
                         Total="_rows?.Count" Shown="Filtered.Count" One="host" Many="hosts" />
        }

        @if (_rows is null)
        {
            @for (var i = 0; i < 4; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="10px" Height="10px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="28%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="14%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="10%" />
                </div>
            }
        }
        else if (_rows.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.AddLink" Title="No hosts yet"
                        Description="A host puts a service on your network behind a hostname; you can add its upstream from the host form.">
                <Action>
                    @if (_mayWrite)
                    {
                        <MudButton Href="@DashboardRoutes.NewHost" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add">Add host</MudButton>
                    }
                </Action>
            </EmptyState>
        }
        else if (Filtered.Count == 0)
        {
            <EmptyState Compact="true" Icon="@Icons.Material.Outlined.SearchOff" Title="No host matches" Description="Try another hostname, upstream, address or tag." />
        }
        else
        {
            <div class="pdk-dt pdk-hosts-table" role="table" aria-label="Hosts">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">Host</span>
                    <span role="columnheader">Destination</span>
                    <span role="columnheader">HTTPS</span>
                    <span role="columnheader">Status</span>
                </div>
                @foreach (var row in Filtered)
                {
                    var host = row.Host;
                    <div class="pdk-dt-row pdk-dt-link @(host.Enabled ? null : "pdk-dt-off")" role="row" @onclick="() => Open(host)" data-host="@Primary(host)" @key="host.Id">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-status-dot pdk-tone-@row.Health.Css()" title="@HealthText(row)" aria-hidden="true"></span>
                            <div class="pdk-dt-titles">
                                <a class="pdk-row-link" href="@DashboardRoutes.Host(host.Id)" @onclick:stopPropagation="true">@Primary(host)</a>
                                @if (host.Names.Count > 1 || host.Tags.Count > 0)
                                {
                                    <span class="pdk-dt-chips">
                                        @foreach (var name in host.Names.Skip(1).Take(3))
                                        {
                                            <span class="pdk-name-chip pdk-mono">@name</span>
                                        }
                                        @if (host.Names.Count > 4)
                                        {
                                            <span class="pdk-name-chip">+@(host.Names.Count - 4)</span>
                                        }
                                        @foreach (var tag in host.Tags)
                                        {
                                            <span class="pdk-tag">@tag</span>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Destination">
                            <ul class="pdk-dest-list">
                                @foreach (var destination in row.Destinations.Take(3))
                                {
                                    <li class="@(destination.Missing ? "pdk-dest-missing" : null)">
                                        @if (destination.Path is { } path && (row.Destinations.Count > 1 || path != "/"))
                                        {
                                            <span class="pdk-dest-path pdk-mono">@path</span>
                                        }
                                        <MudIcon Icon="@Icons.Material.Rounded.East" Size="Size.Small" Class="pdk-dest-arrow" />
                                        <span class="pdk-dest-label">@destination.Label</span>
                                        @if (destination.Detail is { } detail)
                                        {
                                            <span class="pdk-dest-detail pdk-mono">@detail</span>
                                        }
                                    </li>
                                }
                                @if (row.Destinations.Count > 3)
                                {
                                    <li class="pdk-muted">@($"and {row.Destinations.Count - 3} more routes")</li>
                                }
                            </ul>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="HTTPS">
                            <div class="pdk-dt-stack">
                                @if (row.Certificate is { } certificate)
                                {
                                    <StatusChip Tone="certificate.Tone" Text="@certificate.Label" Detail="@certificate.Detail" Icon="@CertificateIcon(certificate.Tone)" Name="certificate" />
                                }
                                <span class="pdk-dt-note">@row.Https</span>
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell pdk-dt-status" data-label="Status" @onclick:stopPropagation="true">
                            <StatusChip Tone="@StatusTone(row)" Dot="true" Text="@StatusText(row)" Detail="@HealthText(row)" Name="status" />
                            @if (UpstreamProblem(row) is { } problem)
                            {
                                <StatusChip Tone="@HealthDisplay.ToneOf(problem.State)" Text="@(problem.State == UpstreamHealthState.Down ? "Upstream down" : "Upstream degraded")" Detail="@problem.Detail" Name="upstream-health" />
                            }
                            @if (_mayWrite && host.Kind != HostKind.Admin && host.Enabled)
                            {
                                <MudTooltip Text="@(row.InMaintenance ? "End maintenance" : "Put in maintenance")" Placement="Placement.Bottom">
                                    <MudIconButton Icon="@(row.InMaintenance ? Icons.Material.Filled.Construction : Icons.Material.Outlined.Construction)" Size="Size.Medium"
                                                   Color="@(row.InMaintenance ? Color.Warning : Color.Default)" OnClick="() => ToggleMaintenanceAsync(row)"
                                                   aria-label="@($"{(row.InMaintenance ? "End maintenance of" : "Put in maintenance")} {Primary(host)}")" data-action="maintenance" />
                                </MudTooltip>
                            }
                            @if (_mayWrite && host.Kind != HostKind.Admin)
                            {
                                <MudSwitch @key="_toggles" T="bool" Value="host.Enabled" ValueChanged="_ => ToggleAsync(host)" Color="Color.Success"
                                           aria-label="@($"{(host.Enabled ? "Switch off" : "Switch on")} {Primary(host)}")" data-action="toggle" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

@code {
    private IReadOnlyList<HostRow>? _rows;
    private Dictionary<UpstreamId, UpstreamHealthView> _health = [];
    private Dictionary<UpstreamId, string> _upstreamNames = [];
    private string? _search;
    private bool _mayWrite;
    private bool _mayReadCertificates;
    private bool _denied;
    private bool _failed;
    private bool _loaded;
    private int _toggles;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: a host's ID, or <c>new</c>; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    private IReadOnlyList<HostRow> Filtered => _rows is null ? [] : [.. _rows.Where(row => row.Matches(_search))];

    protected override async Task OnParametersSetAsync()
    {
        // The list loads once the page is live (the first render shows its skeleton), and follows every commit from then on.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, DashboardRoutes.Hosts);
            _watch = Config.Watch(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        if (!_denied)
        {
            _drawer!.Show(Key, OpenDrawer);
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        _failed = false;
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        _mayReadCertificates = user.Has(Permission.CertificatesRead);
        try
        {
            var current = await Config.GetCurrentAsync();
            var certificates = _mayReadCertificates ? await Config.ListCertificatesAsync() : null;
            _rows = HostOverview.Rows(current.Document, certificates, Config.LiveWarnings, Time.GetUtcNow());
            _upstreamNames = current.Document.Upstreams.ToDictionary(upstream => upstream.Id, upstream => upstream.Name);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't load the hosts.");
            _failed = true;
            _rows ??= [];
        }
    }

    private void OnHealth(IReadOnlyList<UpstreamHealthView> views) => _health = views.ToDictionary(view => view.Id);

    /// <summary>The worst of the upstreams a host's routes send to, when one is down or degraded; null when they all work (or have no checks).</summary>
    private (UpstreamHealthState State, string Detail)? UpstreamProblem(HostRow row)
    {
        if (!row.Host.Enabled || row.Host.Kind != HostKind.Proxy)
        {
            return null;
        }

        List<UpstreamHealthView> hurt = [.. row.Host.Routes.Select(route => route.UpstreamId).Distinct()
            .Select(id => _health.GetValueOrDefault(id)).OfType<UpstreamHealthView>().Where(view => view.State is UpstreamHealthState.Down or UpstreamHealthState.Degraded)];
        if (hurt.Count == 0)
        {
            return null;
        }

        var state = hurt.Any(view => view.State == UpstreamHealthState.Down) ? UpstreamHealthState.Down : UpstreamHealthState.Degraded;
        var names = string.Join(", ", hurt.Select(view => $"{_upstreamNames.GetValueOrDefault(view.Id) ?? view.Id.ToString()} is {HealthDisplay.Word(view.State).ToLowerInvariant()}"));
        return (state, names);
    }

    /// <summary>The drawer an address names. Blazor's router has no typed-ID constraint: the segment is parsed here, and anything that isn't a host ID is not found.</summary>
    private DrawerLevel OpenDrawer(string key)
    {
        if (key == DashboardRoutes.NewSegment)
        {
            return Drawers.Push<HostDrawer>(width: DrawerWidth.Wide);
        }

        return HostId.TryParse(key, out var id)
            ? Drawers.Push<HostDrawer>(new Dictionary<string, object?> { [nameof(HostDrawer.Id)] = id }, DrawerWidth.Wide)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Host not found", "There is no such host", "Back to the hosts"), DrawerWidth.Narrow);
    }

    private void Open(HostConfig host) => Navigation.NavigateTo(DashboardRoutes.Host(host.Id));

    /// <summary>The switch in the list: the host on or off, through review like every change.</summary>
    private async Task ToggleAsync(HostConfig host)
    {
        if (!_mayWrite)
        {
            return;
        }

        var name = ChangeView.HostTitle(host);
        var on = !host.Enabled;
        await Drawers.ReviewAsync(new ReviewRequest($"{(on ? "Switch on" : "Switch off")} {name}", new UpsertHostCommand(host with { Enabled = on }))
        {
            ApplyLabel = on ? "Switch on" : "Switch off",
            SuccessMessage = $"{(on ? "Switched on" : "Switched off")} {name}",
            SampleHost = host.Names.FirstOrDefault(n => !n.StartsWith('*')),
        });

        // The switches show what is stored: made again, one that was flipped and then not applied flips back.
        _toggles++;
    }

    /// <summary>The wrench in the list: maintenance on or off for the host, through review like every change. A host that inherits the setting gets its own value.</summary>
    private async Task ToggleMaintenanceAsync(HostRow row)
    {
        if (!_mayWrite)
        {
            return;
        }

        var host = row.Host;
        var name = ChangeView.HostTitle(host);
        var on = !row.InMaintenance;
        var changed = host with { Settings = HostSettingsEdit.WithMaintenance(host.Settings, maintenance => maintenance with { Enabled = on }) };
        await Drawers.ReviewAsync(new ReviewRequest($"{(on ? "Put in maintenance" : "End maintenance of")} {name}", new UpsertHostCommand(changed))
        {
            ApplyLabel = on ? "Put in maintenance" : "End maintenance",
            SuccessMessage = on ? $"{name} is in maintenance" : $"{name} is out of maintenance",
            SampleHost = host.Names.FirstOrDefault(n => !n.StartsWith('*')),
        });
    }

    private static string Primary(HostConfig host) => host.Names.Count > 0 ? host.Names[0] : "Unnamed host";

    private static string HealthText(HostRow row) => row.Health switch
    {
        Tone.Default => "Switched off",
        _ when row.InMaintenance => "In maintenance: every request gets the maintenance page",
        Tone.Warning => row.Problems.Count > 0 ? string.Join(" ", row.Problems) : row.Certificate?.Detail ?? "Needs attention",
        _ => "Serving",
    };

    private static string StatusText(HostRow row) => row.Health switch
    {
        Tone.Default => "Off",
        _ when row.InMaintenance => "Maintenance",
        Tone.Warning => "Attention",
        _ => "Online",
    };

    private static Tone StatusTone(HostRow row) => row.Health == Tone.Default ? Tone.Default : row.Health == Tone.Warning || row.InMaintenance ? Tone.Warning : Tone.Success;

    private static string CertificateIcon(Tone tone) => tone switch
    {
        Tone.Success => Icons.Material.Rounded.Lock,
        Tone.Default => Icons.Material.Rounded.LockOpen,
        _ => Icons.Material.Rounded.GppMaybe,
    };
}
