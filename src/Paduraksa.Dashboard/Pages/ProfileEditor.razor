@attribute [Route(SettingsRoutes.NewProfile)]
@attribute [Route(SettingsRoutes.Profiles + "/{Key}")]
@implements IDisposable
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_model is { IsNew: false } ? _storedName : "New profile") · Profiles · Paduraksa</PageTitle>

@if (_notFound)
{
    <PageHeader Title="Profile not found" Overline="Profiles" />
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such profile" Description="It may have been deleted, or the link is wrong.">
            <Action>
                <MudButton Href="@ProfilesHref" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Back to the profiles</MudButton>
            </Action>
        </EmptyState>
    </MudPaper>
}
else if (_denied)
{
    <PageHeader Title="Profiles" Overline="Settings" />
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="Your role can't read the config" Description="An Owner can give you the Viewer role or another that can." />
    </MudPaper>
}
else
{
    <PageHeader Title="@(_model is { IsNew: false } ? _storedName : "New profile")" Overline="Settings · Profiles"
                Lead="Settings that every host with this profile inherits, on top of the global defaults. A host can still set its own.">
        <Actions>
            <MudButton Href="@ProfilesHref" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack">All profiles</MudButton>
            @if (_model is { IsNew: false } && _mayWrite)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="ReviewDelete" data-action="delete">Delete</MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_changedElsewhere is { } elsewhere)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" data-banner="changed">
            This profile was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
        </MudAlert>
    }

    @if (_deleteRefusal is { } refusal)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" data-banner="in-use" ShowCloseIcon="true" CloseIconClicked="() => _deleteRefusal = null">
            <strong>@_storedName is still in use, so it can't be deleted.</strong> @refusal
        </MudAlert>
    }

    @if (_model is null || _document is null)
    {
        <MudPaper Class="pdk-card" Elevation="0" Outlined="true" aria-busy="true">
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="28px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mt-3" />
        </MudPaper>
    }
    else
    {
        <div class="pdk-editor-layout">
            <form class="pdk-editor" @onsubmit="Review" @onsubmit:preventDefault="true" novalidate data-form="profile">
                <div class="pdk-form-grid">
                    @if (_attempted && _errors.Count > 0)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pdk-form-summary" data-form="errors">
                            <strong>@(_errors.Count == 1 ? "One thing to fix" : $"{_errors.Count} things to fix"):</strong>
                            <ul class="pdk-error-list">
                                @foreach ((string path, string message) in _errors)
                                {
                                    <li><span class="pdk-error-where">@ChangeView.Locate(path, null)</span> @message</li>
                                }
                            </ul>
                        </MudAlert>
                    }

                    <MudPaper Class="pdk-card pdk-form-card" Elevation="0" Outlined="true">
                        <div class="pdk-card-head">
                            <div>
                                <MudText Typo="Typo.h6" HtmlTag="h2">Profile</MudText>
                                <MudText Typo="Typo.caption" Class="pdk-muted">A name hosts pick it by, and a note on what it is for.</MudText>
                            </div>
                        </div>
                        <div class="pdk-field-grid">
                            <MudTextField T="string" Value="_model.Name" ValueChanged="@(value => Set(() => _model.Name = value, "/name"))" Immediate="true" DebounceInterval="250"
                                          Label="Name" Placeholder="LAN only" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_mayWrite" AutoFocus="_model.IsNew"
                                          Error="@(E("/name") is not null)" ErrorText="@E("/name")" data-field="name" />
                            <MudTextField T="string" Value="_model.Notes" ValueChanged="@(value => Set(() => _model.Notes = value, "/notes"))" Label="Notes"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_mayWrite" Error="@(E("/notes") is not null)" ErrorText="@E("/notes")" />
                        </div>
                    </MudPaper>

                    <MudPaper Class="pdk-card pdk-form-card" Elevation="0" Outlined="true">
                        <div class="pdk-card-head">
                            <div>
                                <MudText Typo="Typo.h6" HtmlTag="h2">Settings</MudText>
                                <MudText Typo="Typo.caption" Class="pdk-muted">Each one left to inherit takes the global default, shown in brackets.</MudText>
                            </div>
                            <span class="pdk-badge pdk-tone-primary" data-overrides="@_model.Settings.Overrides">@Overrides(_model.Settings.Overrides)</span>
                        </div>
                        <HostSettingsFields Model="_model.Settings" Inherited="_inherited" InheritedFrom="the global defaults" InheritWord="Inherit"
                                            PathPrefix="/settings" Errors="_errors" ShowAll="_attempted" Touched="_touched" ReadOnly="!_mayWrite" OnChanged="Touch" />
                    </MudPaper>
                </div>

                @if (_mayWrite)
                {
                    <div class="pdk-editor-bar">
                        <MudButton Href="@ProfilesHref" Variant="Variant.Text">Cancel</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">Review changes</MudButton>
                    </div>
                }
            </form>

            <aside class="pdk-editor-side">
                <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h2">Used by</MudText>
                    @if (Hosts.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pdk-muted mt-2">No host uses it yet. Pick it in a host's HTTPS settings.</MudText>
                    }
                    else
                    {
                        <ul class="pdk-list" data-section="usage">
                            @foreach (HostConfig host in Hosts)
                            {
                                <li class="pdk-list-row">
                                    <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Language" Size="Size.Small" /></span>
                                    <span class="pdk-list-main">
                                        <a class="pdk-row-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                        <span class="pdk-list-sub">@(HostSettingsModel.Summary(host.Settings) is { Count: > 0 } own ? $"Sets its own: {string.Join(", ", own).ToLowerInvariant()}" : "Takes everything from the profile")</span>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </MudPaper>
            </aside>
        </div>
    }

    <ReviewDrawer @bind-Open="_reviewing" Title="@_reviewTitle" Command="_command" ApplyLabel="@(_command is DeleteProfileCommand ? "Delete" : "Apply")"
                  Destructive="@(_command is DeleteProfileCommand)" SuccessMessage="@_successMessage"
                  OnApplied="OnApplied" OnInvalid="OnInvalid" OnReload="ReloadAsync" />
}

@code {
    private const string ProfilesHref = SettingsRoutes.Profiles;

    private ProfileEditModel? _model;
    private ConfigDocument? _document;
    private HostSettings _inherited = HostSettingsModel.BuiltIn;
    private string _storedName = string.Empty;
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private readonly HashSet<string> _touched = new(StringComparer.Ordinal);
    private bool _attempted;
    private bool _mayWrite;
    private bool _notFound;
    private bool _denied;
    private bool _reviewing;
    private bool _applying;
    private ConfigCommand? _command;
    private string _reviewTitle = string.Empty;
    private string _successMessage = string.Empty;
    private string? _deleteRefusal;
    private RevisionRef? _changedElsewhere;
    private IDisposable? _watch;

    /// <summary>The profile's ID as it came in the address; null for a new profile.</summary>
    [Parameter]
    public string? Key { get; set; }

    private IReadOnlyList<HostConfig> Hosts =>
        _model is null || _document is null || _model.IsNew ? [] : ProfileEditModel.HostsUsing(_document, _model.Id);

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _watch ??= Config.Watch(committed => InvokeAsync(() => OnCommitted(committed)));
        await LoadAsync();
    }

    public void Dispose() => _watch?.Dispose();

    private async Task LoadAsync()
    {
        _notFound = false;
        _changedElsewhere = null;
        _deleteRefusal = null;
        _attempted = false;
        _touched.Clear();
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        ProfileId? id = null;
        if (Key is not null)
        {
            if (!ProfileId.TryParse(Key, out ProfileId parsed))
            {
                _notFound = true;
                return;
            }

            id = parsed;
        }

        _document = (await Config.GetCurrentAsync()).Document;
        _inherited = HostSettingsModel.Layer(_document.Settings.Defaults, HostSettingsModel.BuiltIn);
        if (id is { } profileId)
        {
            if (_document.Profiles.FirstOrDefault(p => p.Id == profileId) is not { } profile)
            {
                _notFound = true;
                return;
            }

            _storedName = profile.Name;
            _model = ProfileEditModel.From(profile);
        }
        else
        {
            _model = ProfileEditModel.New();
        }

        Validate();
    }

    private static string Overrides(int count) => count switch
    {
        0 => "Inherits everything",
        1 => "Sets 1 setting",
        _ => $"Sets {count} settings",
    };

    private string? E(string path) => (_attempted || _touched.Contains(path)) && _errors.TryGetValue(path, out string? message) ? message : null;

    private void Set(Action apply, string path)
    {
        apply();
        Touch(path);
    }

    private void Touch(string path)
    {
        _touched.Add(path);
        Validate();
    }

    private void Validate()
    {
        if (_model is not null && _document is not null)
        {
            _errors = InlineValidation.ForProfile(_document, _model.ToConfig());
        }
    }

    private void Review()
    {
        if (_model is null || !_mayWrite)
        {
            return;
        }

        _attempted = true;
        Validate();
        if (_errors.Count > 0)
        {
            return;
        }

        ProfileConfig profile = _model.ToConfig();
        _command = new UpsertProfileCommand(profile);
        _reviewTitle = _model.IsNew ? $"New profile {profile.Name}" : $"Edit profile {profile.Name}";
        _successMessage = _model.IsNew ? $"Created the profile {profile.Name}" : $"Saved the profile {profile.Name}";
        _reviewing = true;
    }

    private void ReviewDelete()
    {
        if (_model is null || _model.IsNew || !_mayWrite)
        {
            return;
        }

        if (Hosts.Count > 0)
        {
            _deleteRefusal = $"{string.Join(", ", Hosts.Select(ChangeView.HostTitle))} {(Hosts.Count == 1 ? "uses" : "use")} it. Pick another profile (or none) for them first.";
            Snackbar.Add($"{_storedName} is in use and can't be deleted.", Severity.Warning);
            return;
        }

        _command = new DeleteProfileCommand(_model.Id, _model.Version);
        _reviewTitle = $"Delete profile {_storedName}";
        _successMessage = $"Deleted the profile {_storedName}";
        _reviewing = true;
    }

    private void OnInvalid(IReadOnlyList<ConfigError> errors)
    {
        Dictionary<string, string> merged = new(_errors, StringComparer.Ordinal);
        foreach ((string path, string message) in InlineValidation.Relative(errors, string.Empty))
        {
            merged[path] = message;
        }

        _errors = merged;
        _attempted = true;
    }

    private void OnApplied(ConfigCommandResult result)
    {
        _applying = true;
        Navigation.NavigateTo(ProfilesHref);
    }

    private async Task ReloadAsync()
    {
        _model = null;
        await LoadAsync();
    }

    private void OnCommitted(ConfigCommitted committed)
    {
        if (_applying || _reviewing || _model is null || _model.IsNew)
        {
            return;
        }

        if (committed.Changes.Any(c => c is ProfileChange p && p.ProfileId == _model.Id))
        {
            _changedElsewhere = committed.Revision;
        }

        _ = RefreshUsageAsync();
    }

    private async Task RefreshUsageAsync()
    {
        _document = (await Config.GetCurrentAsync()).Document;
        _inherited = HostSettingsModel.Layer(_document.Settings.Defaults, HostSettingsModel.BuiltIn);
        await InvokeAsync(StateHasChanged);
    }
}
