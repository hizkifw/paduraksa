@attribute [Authorize]
@attribute [Route(DashboardRoutes.Settings)]
@inject NavigationManager Navigation
@* /settings has no page of its own: every settings page is in the side navigation. The address goes to the first of them the user may
   see, and to their own account when there is none. *@

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DashboardPrincipal? user = AuthenticationState is null ? null : (await AuthenticationState).User.AsDashboardUser();
        NavigationEntry? first = DashboardNavigation.VisibleTo(permission => user?.Has(permission) == true)
            .FirstOrDefault(entry => entry.Group == DashboardNavigation.SettingsGroup);
        Navigation.NavigateTo(first?.Href ?? DashboardRoutes.Account, replace: true);
    }
}
