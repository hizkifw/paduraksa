@attribute [Route(SettingsRoutes.Server)]
@using Paduraksa.Application.Settings
@implements IDisposable
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DraftState Drafts
@inject ServerSettingsState State
@* Settings: the server's own settings (retention, sign-in, notifications, integrations, connections), one card per group, applied through the
   review drawer like the global defaults they are part of. *@

<PageTitle>Server · Settings · Paduraksa</PageTitle>

<PageHeader Title="Server" />

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="@IdentityText.CantReadConfig" Description="@IdentityText.CantReadConfigHelp" />
    </MudPaper>
}
else if (_document is null || _view is null)
{
    <div class="pdk-form-grid" aria-busy="true">
        @for (var i = 0; i < 3; i++)
        {
            <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" Height="28px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="80px" Class="mt-3" />
            </MudPaper>
        }
    </div>
}
else
{
    @if (_changedElsewhere is { } elsewhere)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" data-banner="changed">
            The server settings were changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
        </MudAlert>
    }

    <form class="pdk-editor" @onsubmit="Submit" @onsubmit:preventDefault="true" novalidate data-form="server-settings">
        @if (_attempted && _errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pdk-form-summary" data-form="errors">
                <strong>@(_errors.Count == 1 ? "One thing to fix" : $"{_errors.Count} things to fix"):</strong>
                <ul class="pdk-error-list">
                    @foreach (var (path, message) in _errors)
                    {
                        <li><span class="pdk-error-where">@ChangeView.Locate("/settings" + path, null)</span> @message</li>
                    }
                </ul>
            </MudAlert>
        }

        @foreach (var group in ServerSettingCatalog.All.GroupBy(s => s.Group))
        {
            <MudPaper Class="pdk-card pdk-form-card" Elevation="0" Outlined="true" data-card="@GroupKey(group.Key)">
                <div class="pdk-card-head">
                    <div>
                        <MudText Typo="Typo.h6" HtmlTag="h3">@GroupTitle(group.Key)</MudText>
                    </div>
                </div>
                @foreach (var part in group.GroupBy(s => s.Section))
                {
                    @if (group.Select(s => s.Section).Distinct().Count() > 1)
                    {
                        <MudText Typo="Typo.subtitle2" HtmlTag="h4" Class="pdk-server-section">@part.Key</MudText>
                    }
                    <div class="pdk-setting-list">
                        @foreach (var setting in part)
                        {
                            <ServerSettingField Setting="setting" Settings="_model" SettingsChanged="@(value => Set(value, setting))" Current="State.Current"
                                                View="@_view.Settings.FirstOrDefault(v => v.Key == setting.Key)" Error="@E(setting)" ReadOnly="!_mayWrite" />
                        }
                    </div>
                }
            </MudPaper>
        }

        @if (_mayWrite)
        {
            <div class="pdk-editor-bar">
                @if (_touched.Count > 0)
                {
                    <MudButton Variant="Variant.Text" OnClick="ReloadAsync" data-action="discard">Discard changes</MudButton>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">Review changes</MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" data-banner="read-only">Read-only: changing the server settings needs the Owner or Admin role.</MudAlert>
        }
    </form>

    <ReviewDrawer @bind-Open="_reviewing" Title="Server settings" Command="_command" SuccessMessage="Saved the server settings"
                  OnApplied="ReloadOnAppliedAsync" OnDrafted="ReloadOnDraftedAsync" OnInvalid="OnInvalid" OnReload="ReloadAsync" />
}

@code {
    private bool _denied;
    private ConfigDocument? _document;
    private ServerSettingsView? _view;
    private ServerSettings _model = new();
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private readonly HashSet<string> _touched = new(StringComparer.Ordinal);
    private bool _attempted;
    private bool _mayWrite;
    private bool _reviewing;
    private ConfigCommand? _command;
    private RevisionRef? _changedElsewhere;
    private IDisposable? _watch;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _watch = Config.Watch(committed => InvokeAsync(() => OnCommittedAsync(committed)));
        await LoadAsync();
    }

    public void Dispose() => _watch?.Dispose();

    private static string GroupKey(ServerSettingGroup group) => group switch
    {
        ServerSettingGroup.Retention => "retention",
        ServerSettingGroup.SignIn => "sign-in",
        ServerSettingGroup.Notifications => "notifications",
        ServerSettingGroup.Integrations => "integrations",
        _ => "connections",
    };

    private static string GroupTitle(ServerSettingGroup group) => group switch
    {
        ServerSettingGroup.Retention => "Data retention",
        ServerSettingGroup.SignIn => "Sign-in",
        ServerSettingGroup.Notifications => "Notifications",
        ServerSettingGroup.Integrations => "Integrations",
        _ => "Connections",
    };

    private async Task LoadAsync()
    {
        await Drafts.EnsureLoadedAsync();
        _changedElsewhere = null;
        _attempted = false;
        _touched.Clear();
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite) && user.Has(Permission.ServerWrite);
        _document = (await Config.GetWorkingAsync()).Document;
        _view = ServerSettingsViews.Of(State, _document.Settings);
        _model = _document.Settings.Server ?? new ServerSettings();
        Validate();
    }

    private string? E(ServerSettingDefinition setting)
    {
        var path = "/server/" + setting.Key;
        return (_attempted || _touched.Contains(path)) && _errors.TryGetValue(path, out var message) ? message : null;
    }

    private void Set(ServerSettings value, ServerSettingDefinition setting)
    {
        _model = value;
        _touched.Add("/server/" + setting.Key);
        Validate();
    }

    private void Validate()
    {
        if (_document is not null)
        {
            _errors = InlineValidation.ForSettings(_document, Settings());
        }
    }

    private GlobalSettings Settings() => _document!.Settings with { Server = _model.SetsNothing ? null : _model };

    private void Submit()
    {
        if (_document is null || !_mayWrite)
        {
            return;
        }

        _attempted = true;
        Validate();
        if (_errors.Count == 0)
        {
            _command = new UpdateSettingsCommand(Settings());
            _reviewing = true;
        }
    }

    private void OnInvalid(IReadOnlyList<ConfigError> errors)
    {
        Dictionary<string, string> merged = new(_errors, StringComparer.Ordinal);
        foreach (var (path, message) in InlineValidation.Relative(errors, string.Empty))
        {
            merged[path] = message;
        }

        _errors = merged;
        _attempted = true;
    }

    private Task ReloadOnAppliedAsync(ConfigCommandResult result) => ReloadAsync();

    private Task ReloadOnDraftedAsync(ConfigDraft draft) => ReloadAsync();

    private async Task ReloadAsync()
    {
        _document = null;
        await LoadAsync();
    }

    private async Task OnCommittedAsync(ConfigCommitted committed)
    {
        if (_reviewing || _document is null || !committed.Changes.Any(c => c is SettingsChange))
        {
            return;
        }

        if (_touched.Count == 0)
        {
            await ReloadAsync();
        }
        else
        {
            _changedElsewhere = committed.Revision;
        }

        StateHasChanged();
    }
}
