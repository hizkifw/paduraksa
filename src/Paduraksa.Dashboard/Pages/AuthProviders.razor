@attribute [Route(DashboardRoutes.AuthProviders)]
@attribute [Route(DashboardRoutes.AuthProviders + "/{Key}")]
@* Security: the auth providers (forward-auth endpoints). /auth-providers/authp_... is that provider with its drawer open; /auth-providers/new starts a new one. *@

<SecurityObjectList Kind="Listing" Key="@Key" />

@code {
    private static readonly SecurityObjectKind<AuthProviderConfig> Listing = new()
    {
        Noun = "auth provider",
        Plural = "auth providers",
        Icon = Icons.Material.Outlined.VerifiedUser,
        SummaryHeading = "Endpoint",
        EmptyDescription = "An auth provider asks authentik, Authelia, oauth2-proxy or any forward-auth endpoint who a request is before it is forwarded. Add one, then pick it in a host's Access settings.",
        BackText = "Back to the sign-in providers",
        Section = "auth-providers",
        ListRoute = DashboardRoutes.AuthProviders,
        NewRoute = DashboardRoutes.NewAuthProvider,
        Drawer = typeof(AuthProviderDrawer),
        DrawerParameters = key => AuthProviderId.TryParse(key, out var id) ? new Dictionary<string, object?> { [nameof(AuthProviderDrawer.Id)] = id } : null,
        Items = document => document.AuthProviders,
        Name = provider => provider.Name,
        Notes = provider => provider.Notes,
        Route = provider => DashboardRoutes.AuthProvider(provider.Id),
        DraftTarget = provider => DraftTargets.AuthProvider(provider.Id),
        Summary = AuthProviderText.Summary,
        Usage = (document, provider) => ReferenceUsage.Find(document, s => s.AuthProvider?.AuthProviderId == provider.Id),
        Delete = provider => new DeleteAuthProviderCommand(provider.Id, provider.Version),
    };

    [Parameter]
    public string? Key { get; set; }
}
