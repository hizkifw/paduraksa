@attribute [Route(DashboardRoutes.AuthProviders)]
@attribute [Route(DashboardRoutes.AuthProviders + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<AuthProviders> Logger
@* Security: the auth providers (forward-auth endpoints). Each row says which provider and endpoint a provider is and which hosts and routes ask it; one in use
   can't be deleted, so its delete button is not offered. /sign-in/authp_... is that provider with its drawer open; /sign-in/new starts a new one. *@

<PageTitle>Sign-in · Paduraksa</PageTitle>

<PageHeader Title="Sign-in">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Href="@DashboardRoutes.NewAuthProvider" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-auth-provider">Add auth provider</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="@IdentityText.CantReadConfig" Description="@IdentityText.CantReadConfigHelp" />
    </MudPaper>
}
else
{
    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            The auth providers couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true" data-section="auth-providers">
        @if (_document is null)
        {
            @for (var i = 0; i < 3; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="24%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="36%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="20%" />
                </div>
            }
        }
        else if (_document.AuthProviders.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.VerifiedUser" Title="No auth providers yet"
                        Description="An auth provider asks authentik, Authelia, oauth2-proxy or any forward-auth endpoint who a request is before it is forwarded. Add one, then pick it in a host's Access settings.">
                <Action>
                    @if (_mayWrite)
                    {
                        <MudButton Href="@DashboardRoutes.NewAuthProvider" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add">Add auth provider</MudButton>
                    }
                </Action>
            </EmptyState>
        }
        else
        {
            <div class="pdk-dt pdk-auth-providers-table" role="table" aria-label="Auth providers">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">Auth provider</span>
                    <span role="columnheader">Endpoint</span>
                    <span role="columnheader">Used by</span>
                    <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
                </div>
                @foreach (var set in _document.AuthProviders.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var usage = AuthProviderUsageOf.Find(_document, set.Id);
                    <div class="pdk-dt-row pdk-dt-link" role="row" @onclick="() => Open(set)" data-auth-provider="@set.Name" @key="set.Id">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" /></span>
                            <div class="pdk-dt-titles">
                                <a class="pdk-row-link" href="@DashboardRoutes.AuthProvider(set.Id)" @onclick:stopPropagation="true">@set.Name</a>
                                @if (!string.IsNullOrWhiteSpace(set.Notes))
                                {
                                    <span class="pdk-dt-note">@set.Notes</span>
                                }
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Endpoint">
                            <span class="pdk-dt-note">@AuthProviderText.Summary(set)</span>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Used by" @onclick:stopPropagation="true">
                            <AuthProviderUsageCell Usage="usage" />
                        </div>
                        <div role="cell" class="pdk-dt-cell pdk-dt-actions" @onclick:stopPropagation="true">
                            @if (_mayWrite && usage.IsEmpty)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ReviewDeleteAsync(set)"
                                               aria-label="@($"Delete {set.Name}")" data-action="delete" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>

}

@code {
    private bool _denied;
    private bool _failed;
    private bool _mayWrite;
    private bool _loaded;
    private ConfigDocument? _document;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: a set's ID, or <c>new</c>; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, DashboardRoutes.AuthProviders);
            _watch = Config.Watch(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        if (!_denied)
        {
            _drawer!.Show(Key, OpenDrawer);
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        _failed = false;
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        try
        {
            _document = (await Config.GetCurrentAsync()).Document;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't load the auth providers.");
            _failed = true;
            _document ??= new ConfigDocument();
            Snackbar.Add(StoreFailures.Message("The auth providers couldn't be read."), Severity.Error);
        }
    }

    private DrawerLevel OpenDrawer(string key)
    {
        if (key == DashboardRoutes.NewSegment)
        {
            return Drawers.Push<AuthProviderDrawer>(width: DrawerWidth.Medium);
        }

        return AuthProviderId.TryParse(key, out var id)
            ? Drawers.Push<AuthProviderDrawer>(new Dictionary<string, object?> { [nameof(AuthProviderDrawer.Id)] = id }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Auth provider not found", "There is no such auth provider", "Back to the sign-in providers"), DrawerWidth.Narrow);
    }

    private void Open(AuthProviderConfig set) => Navigation.NavigateTo(DashboardRoutes.AuthProvider(set.Id));

    private async Task ReviewDeleteAsync(AuthProviderConfig set)
    {
        if (_document is null || !_mayWrite || !AuthProviderUsageOf.Find(_document, set.Id).IsEmpty)
        {
            return;
        }

        await Drawers.ReviewAsync(new ReviewRequest($"Delete auth provider {set.Name}", new DeleteAuthProviderCommand(set.Id, set.Version))
        {
            ApplyLabel = "Delete",
            Destructive = true,
            SuccessMessage = $"Deleted the auth provider {set.Name}",
        });
    }
}
