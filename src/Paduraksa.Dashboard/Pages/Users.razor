@attribute [Route(SettingsRoutes.Users)]
@implements IDisposable
@using Paduraksa.Application.Commands
@using Paduraksa.Application.Identity
@using Paduraksa.Contracts.Identity
@inject IDashboardIdentity Identity
@inject DashboardCaller Caller
@inject DashboardOptions Options
@inject TimeProvider Time
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject DrawerStack Drawers
@inject Microsoft.Extensions.Logging.ILogger<Users> Logger
@* Settings: users and roles (PLAN §10.1). The list for users:read; adding and changing (in a drawer) and deleting for users:write (the
   Owner). The services decide, the last-Owner guard included; its refusal is shown where the change was asked for. *@

<PageTitle>Users and roles · Settings · Paduraksa</PageTitle>

<PageHeader Title="Users and roles" Overline="Settings" Area="SectionArea.Settings" Lead="Who can sign in, and what each of them may do.">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PersonAdd" OnClick="() => OpenAsync(null)" data-action="add-user">Add user</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="Your role can't see the users" Description="An Owner can give you a role that can." />
    </MudPaper>
}
else
{
    @if (_refusal is { } refusal)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _refusal = null" data-refusal="@_refusalKind">
            @refusal
        </MudAlert>
    }

    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-alert="load-failed">
            The users couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
        @if (_users is null)
        {
            @if (!_failed)
            {
                @for (int i = 0; i < 3; i++)
                {
                    <div class="pdk-row-skeleton">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="20%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="15%" />
                    </div>
                }
            }
        }
        else
        {
            <div class="pdk-dt pdk-users-table @(_lastSeen is null ? null : "pdk-users-seen")" role="table" aria-label="Users">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">User</span>
                    <span role="columnheader">Roles</span>
                    <span role="columnheader">Status</span>
                    <span role="columnheader">Two-step</span>
                    @if (_lastSeen is not null)
                    {
                        <span role="columnheader">Last seen</span>
                    }
                    <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
                </div>
                @foreach (UserSummary user in _users)
                {
                    <div class="pdk-dt-row @(_mayWrite ? "pdk-dt-link" : null) @(user.Disabled ? "pdk-dt-off" : null)" role="row" @key="user.Id"
                         @onclick="@(_mayWrite ? () => OpenAsync(user) : () => Task.CompletedTask)">
                        <div class="pdk-dt-main" role="cell" data-user="@user.Username">
                            <MudAvatar Size="Size.Small" Color="@(user.Disabled ? Color.Default : Color.Primary)" Variant="Variant.Outlined" Class="pdk-avatar">@UserMenu.Initials(user.DisplayName)</MudAvatar>
                            <span class="pdk-dt-titles">
                                <span class="pdk-list-title">
                                    @user.DisplayName
                                    @if (user.Id == _me)
                                    {
                                        <StatusChip Tone="Tone.Primary" Text="You" />
                                    }
                                </span>
                                <span class="pdk-dt-note pdk-mono">@user.Username</span>
                            </span>
                        </div>
                        <span role="cell" class="pdk-dt-cell" data-label="Roles">
                            <span class="pdk-dt-chips">
                                @foreach (Role role in user.Roles)
                                {
                                    <StatusChip Tone="@(role == Role.Owner ? Tone.Primary : Tone.Default)" Text="@IdentityText.Name(role)" Detail="@IdentityText.Describe(role)" />
                                }
                            </span>
                        </span>
                        <span role="cell" class="pdk-dt-cell" data-label="Status">
                            @if (user.Disabled)
                            {
                                <StatusChip Dot="true" Text="Disabled" Name="status" Class="pdk-status-disabled" />
                            }
                            else if (user.Locked)
                            {
                                <StatusChip Tone="Tone.Warning" Dot="true" Text="Locked" Detail="Too many failed sign-ins: refused for a while. Enabling the user again clears it." Name="status" />
                            }
                            else
                            {
                                <StatusChip Tone="Tone.Success" Dot="true" Text="Enabled" Name="status" />
                            }
                        </span>
                        <span role="cell" class="pdk-dt-cell" data-label="Two-step">
                            @if (user.TwoFactorEnabled)
                            {
                                <StatusChip Tone="Tone.Success" Icon="@Icons.Material.Rounded.Lock" Text="On" Name="two-factor" />
                            }
                            else
                            {
                                <StatusChip Tone="Tone.Warning" Text="Off" Name="two-factor" />
                            }
                        </span>
                        @if (_lastSeen is not null)
                        {
                            <span role="cell" class="pdk-dt-cell" data-label="Last seen">
                                @if (_lastSeen.TryGetValue(user.Id, out DateTimeOffset seen))
                                {
                                    <span title="@RevisionText.Exact(seen)">@RevisionText.Ago(seen, _now)</span>
                                }
                                else
                                {
                                    <span class="pdk-muted">Not signed in</span>
                                }
                            </span>
                        }
                        <span role="cell" class="pdk-dt-cell pdk-dt-actions" @onclick:stopPropagation="true">
                            @if (_mayWrite)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => OpenAsync(user)" aria-label="@($"Edit {user.Username}")" data-action="edit" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => AskDeleteAsync(user)" aria-label="@($"Delete {user.Username}")" data-action="delete" />
                            }
                        </span>
                    </div>
                }
            </div>
        }
    </MudPaper>

    <MudPaper Class="pdk-card mt-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle2" HtmlTag="h3">What the roles can do</MudText>
        <ul class="pdk-role-list" data-section="roles">
            @foreach (Role role in IdentityText.Roles)
            {
                <li>
                    <span class="pdk-badge pdk-tone-@(role == Role.Owner ? "primary" : "default")">@IdentityText.Name(role)</span>
                    <span>@IdentityText.Describe(role)</span>
                </li>
            }
        </ul>
        <MudText Typo="Typo.caption" Class="pdk-muted">A user with several roles may do what any of them allows.</MudText>
    </MudPaper>


}

@code {
    private bool _denied;
    private bool _failed;
    private IReadOnlyList<UserSummary>? _users;
    private Dictionary<UserId, DateTimeOffset>? _lastSeen;
    private DateTimeOffset _now;
    private UserId? _me;
    private bool _mayWrite;
    private string? _refusal;
    private string? _refusalKind;
    private IDisposable? _watch;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _watch = Identity.Watch(() => InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }));
        await LoadAsync();
    }

    public void Dispose() => _watch?.Dispose();

    private async Task LoadAsync()
    {
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.UsersRead))
        {
            _denied = true;
            return;
        }

        _me = user.UserId;
        _mayWrite = user.Has(Permission.UsersWrite);
        _now = Time.GetUtcNow();
        CommandOrigin origin = user.Session.OriginFor(Channel.Dashboard);
        _failed = false;
        try
        {
            UserListResult result = await Identity.ListUsersAsync(origin);
            _users = result.Users;
            if (user.Has(Permission.SessionsAll))
            {
                Dictionary<UserId, DateTimeOffset> seen = [];
                foreach (UserSummary listed in result.Users)
                {
                    SessionListResult sessions = await Identity.ListSessionsAsync(origin, listed.Id, null);
                    if (sessions.Sessions.Count > 0)
                    {
                        seen[listed.Id] = sessions.Sessions.Max(s => s.LastSeenAt);
                    }
                }

                _lastSeen = seen;
            }
            else
            {
                _lastSeen = null;
            }
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't read the users.");
            _failed = true;
        }
    }

    /// <summary>Adds a user, or changes one, in a drawer; the list follows the identity feed (and is read again for this circuit).</summary>
    private async Task OpenAsync(UserSummary? user)
    {
        DrawerResult result = await Drawers.OpenAsync<UserDrawer>(UserDrawer.For(user, _me), DrawerWidth.Medium);
        if (!result.Canceled)
        {
            _refusal = null;
            await LoadAsync();
        }
    }

    private async Task AskDeleteAsync(UserSummary user)
    {
        bool confirmed = await ConfirmActionDialog.AskAsync(
            Dialogs,
            $"Delete {user.DisplayName}?",
            $"{user.Username} can no longer sign in: their sessions end and their API tokens stop working at once. The audit log keeps what they did.",
            "Delete user",
            user.Id == _me ? "This is you: you will be signed out." : null);
        if (!confirmed || await Caller.OriginAsync() is not { } origin)
        {
            return;
        }

        IdentityResult? result = null;
        if (!await Logger.TryAsync(Snackbar, $"Couldn't delete {user.Username}.", async () => result = await Identity.DeleteUserAsync(origin, user.Id))
            || result is null)
        {
            return;
        }

        if (result.Succeeded)
        {
            Snackbar.Add($"Deleted {user.Username}.", Severity.Success);
            _refusal = null;
            await LoadAsync();
            return;
        }

        _refusalKind = result.Status == IdentityStatus.LastOwner ? "last-owner" : result.Status.ToString().ToLowerInvariant();
        _refusal = result.Status == IdentityStatus.LastOwner
            ? $"{user.Username} is the last enabled Owner, so they can't be deleted. Make someone else an Owner first."
            : $"Couldn't delete {user.Username}. {IdentityText.Refusal(result.Status, result.Problem)}";
        Snackbar.Add($"{user.Username} wasn't deleted.", Severity.Warning);
    }
}
