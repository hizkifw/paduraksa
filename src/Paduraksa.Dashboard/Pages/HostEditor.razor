@attribute [Route(DashboardRoutes.NewHost)]
@attribute [Route(DashboardRoutes.Hosts + "/{Key}")]
@implements IDisposable
@using Paduraksa.Contracts.Certificates
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject NavigationManager Navigation
@inject ILogger<HostEditor> Logger

<PageTitle>@(_model is { IsNew: false } ? $"{ChangeView.HostTitle(_model.ToConfig())} · Hosts" : "New host") · Paduraksa</PageTitle>

@if (_notFound)
{
    <PageHeader Title="Host not found" Overline="Hosts" />
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="There is no such host" Description="It may have been deleted, or the link is wrong." >
            <Action>
                <MudButton Href="@DashboardRoutes.Hosts" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Back to the hosts</MudButton>
            </Action>
        </EmptyState>
    </MudPaper>
}
else if (_denied)
{
    <PageHeader Title="Hosts" Overline="Traffic" />
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="Your role can't read the config" Description="An Owner can give you the Viewer role or another that can." />
    </MudPaper>
}
else
{
    <PageHeader Title="@HeaderTitle" Overline="Hosts" Lead="@HeaderLead">
        <Actions>
            @if (_model is { IsNew: false } && _maySimulate)
            {
                <MudButton Href="@SimulateHref" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Science">Simulate</MudButton>
            }
            @if (_model is { IsNew: false } && _mayWrite)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="ReviewDelete" data-action="delete">Delete</MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_changedElsewhere is { } elsewhere)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" data-banner="changed">
            This host was changed elsewhere (@elsewhere). Your edits are kept here; reload to start from the new version.
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="ReloadAsync" Class="ml-2">Reload</MudButton>
        </MudAlert>
    }

    @if (!_mayWrite && _model is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4">Read-only: your role can see this host but not change it.</MudAlert>
    }

    @if (_model is null || _current is null)
    {
        <div class="pdk-form-grid" aria-busy="true">
            @for (int i = 0; i < 3; i++)
            {
                <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="28px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Class="mt-3" />
                </MudPaper>
            }
        </div>
    }
    else
    {
        <form class="pdk-editor" @onsubmit="ReviewAsync" @onsubmit:preventDefault="true" novalidate>
            <HostForm Model="_model" Upstreams="_current.Document.Upstreams" Profiles="_current.Document.Profiles" Certificates="_certificates"
                      InheritedForceHttps="InheritedForceHttps" Errors="_errors" ShowAll="_attempted" ReadOnly="!_mayWrite" OnChanged="Validate" />

            @if (_mayWrite)
            {
                <div class="pdk-editor-bar">
                    <MudButton Href="@DashboardRoutes.Hosts" Variant="Variant.Text">Cancel</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" data-action="review">Review changes</MudButton>
                </div>
            }
        </form>
    }

    <ReviewDrawer @bind-Open="_reviewing" Title="@_reviewTitle" Command="_command" ApplyLabel="@(_command is DeleteHostCommand ? "Delete" : "Apply")"
                  Destructive="@(_command is DeleteHostCommand)" SuccessMessage="@_successMessage" SampleHost="@SampleHost"
                  OnApplied="OnAppliedAsync" OnInvalid="OnInvalid" OnReload="ReloadAsync" />
}

@code {
    private HostEditModel? _model;
    private CurrentConfig? _current;
    private IReadOnlyList<CertificateSummary>? _certificates;
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, string> _serverErrors = new Dictionary<string, string>();
    private bool _attempted;
    private bool _mayWrite;
    private bool _maySimulate;
    private bool _notFound;
    private bool _denied;
    private bool _reviewing;
    private bool _applying;
    private ConfigCommand? _command;
    private string _reviewTitle = string.Empty;
    private string _successMessage = string.Empty;
    private RevisionRef? _changedElsewhere;
    private IDisposable? _watch;

    /// <summary>The host's ID as it came in the address (<c>/hosts/host_...</c>); null for a new host.</summary>
    [Parameter]
    public string? Key { get; set; }

    private string HeaderTitle => _model is null ? "Host" : _model.IsNew ? "New host" : ChangeView.HostTitle(_model.ToConfig());

    private string HeaderLead => _model is { IsNew: true }
        ? "Give a service on your network a name. Nothing changes until you review and apply."
        : "Edit the host. Every change is reviewed as a diff before it goes live, and can be undone.";

    private string? SampleHost => _model?.Names.Select(n => n.Value.Trim()).FirstOrDefault(n => n.Length > 0 && !n.StartsWith('*'));

    private string SimulateHref => SampleHost is { } host ? $"{DashboardRoutes.Simulator}?url={Uri.EscapeDataString($"https://{host}/")}" : DashboardRoutes.Simulator;

    private bool InheritedForceHttps =>
        (_model?.ProfileId is { } profile ? _current?.Document.Profiles.FirstOrDefault(p => p.Id == profile)?.Settings.ForceHttps : null)
        ?? _current?.Document.Settings.Defaults.ForceHttps
        ?? false;

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _watch ??= Config.Watch(committed => InvokeAsync(() => OnCommitted(committed)));
        await LoadAsync();
    }

    public void Dispose() => _watch?.Dispose();

    private async Task LoadAsync()
    {
        _notFound = false;
        _changedElsewhere = null;
        _attempted = false;
        _serverErrors = new Dictionary<string, string>();
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        _maySimulate = user.Has(Permission.Simulate);
        HostId? id = null;
        if (Key is not null)
        {
            // Blazor's router has no typed-ID constraint: the segment is parsed here, and anything that isn't a host ID is not found.
            if (!HostId.TryParse(Key, out HostId parsed))
            {
                _notFound = true;
                return;
            }

            id = parsed;
        }

        try
        {
            _current = await Config.GetCurrentAsync();
            _certificates = user.Has(Permission.CertificatesRead) ? await Config.ListCertificatesAsync() : null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't load the host form.");
            throw;
        }

        if (id is { } hostId)
        {
            if (_current.Document.Hosts.FirstOrDefault(h => h.Id == hostId) is not { } host)
            {
                _notFound = true;
                return;
            }

            _model = HostEditModel.From(host);
        }
        else
        {
            _model = HostEditModel.New(_current.Document.Upstreams.Count == 1 ? _current.Document.Upstreams[0].Id : null);
        }

        Validate();
    }

    private void Validate()
    {
        if (_model is null || _current is null)
        {
            return;
        }

        IReadOnlyDictionary<string, string> inline = InlineValidation.ForHost(_current.Document, _model.ToConfig());
        Dictionary<string, string> merged = new(_serverErrors, StringComparer.Ordinal);
        foreach ((string path, string message) in inline)
        {
            merged[path] = message;
        }

        _errors = merged;
        _serverErrors = new Dictionary<string, string>();
    }

    private void ReviewAsync()
    {
        if (_model is null || !_mayWrite)
        {
            return;
        }

        _attempted = true;
        Validate();
        if (_errors.Count > 0)
        {
            return;
        }

        HostConfig host = _model.ToConfig();
        _command = new UpsertHostCommand(host);
        _reviewTitle = _model.IsNew ? $"New host {ChangeView.HostTitle(host)}" : $"Edit {ChangeView.HostTitle(host)}";
        _successMessage = _model.IsNew ? $"Created {ChangeView.HostTitle(host)}" : $"Saved {ChangeView.HostTitle(host)}";
        _reviewing = true;
    }

    private void ReviewDelete()
    {
        if (_model is null || _model.IsNew || !_mayWrite || _current is null)
        {
            return;
        }

        HostConfig stored = _current.Document.Hosts.First(h => h.Id == _model.Id);
        _command = new DeleteHostCommand(_model.Id, _model.Version);
        _reviewTitle = $"Delete {ChangeView.HostTitle(stored)}";
        _successMessage = $"Deleted {ChangeView.HostTitle(stored)}";
        _reviewing = true;
    }

    private void OnInvalid(IReadOnlyList<ConfigError> errors)
    {
        _serverErrors = InlineValidation.Relative(errors, string.Empty);
        _attempted = true;
        Dictionary<string, string> merged = new(_errors, StringComparer.Ordinal);
        foreach ((string path, string message) in _serverErrors)
        {
            merged[path] = message;
        }

        _errors = merged;
    }

    private Task OnAppliedAsync(ConfigCommandResult result)
    {
        _applying = true;
        Navigation.NavigateTo(DashboardRoutes.Hosts);
        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _model = null;
        await LoadAsync();
    }

    private void OnCommitted(ConfigCommitted committed)
    {
        if (_applying || _reviewing || _model is null || _model.IsNew)
        {
            return;
        }

        if (committed.Changes.Any(c => c is HostChange h && h.HostId == _model.Id || c is RouteChange r && r.HostId == _model.Id))
        {
            _changedElsewhere = committed.Revision;
            StateHasChanged();
        }
    }
}
