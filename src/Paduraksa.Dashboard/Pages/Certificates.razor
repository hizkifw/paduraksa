@attribute [Authorize]
@attribute [Route(DashboardRoutes.Certificates)]
@attribute [Route(DashboardRoutes.Certificates + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Paduraksa.Application.Certificates
@using Paduraksa.Application.Commands
@using Paduraksa.Application.Issuance
@using Paduraksa.Contracts.Certificates
@using Paduraksa.Dashboard.Certificates
@inject CertificateService CertificateInventory
@inject AcmeIssuanceService Issuance
@inject ConfigService Config
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IServiceProvider Services
@inject ILogger<Certificates> Logger
@* The certificates: everything this instance can serve, where it came from, who uses it and when it ends. The address
   /certificates/crt_... is this list with that drawer open. *@

<PageTitle>Certificates · Paduraksa</PageTitle>

<PageHeader Title="Certificates" ListEmpty="@(_view is { Rows.Count: 0 })">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => Add(null)" Class="pdk-add-certificate"
                       data-action="add-certificate">Add certificate</MudButton>
        }
    </Actions>
</PageHeader>

@if (_failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-6">
        The certificates couldn't be read. The details are in the server log.
        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
    </MudAlert>
}

<div class="pdk-toolbar-row">
    <SegmentedControl T="string" Options="FilterOptions" Value="@(_filter ?? AllKey)" ValueChanged="ChooseFilter" AriaLabel="Show only" DataField="filter" Disabled="_view is null" />
</div>

<MudPaper Class="pdk-card pdk-table-card pdk-cert-card" Elevation="0" Outlined="true">
    @if (_view is null)
    {
        @for (var i = 0; i < 4; i++)
        {
            <div class="pdk-row-skeleton">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="15%" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="15%" />
            </div>
        }
    }
    else if (_view.Rows.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.WorkspacePremium" Title="No certificates yet"
                    Description="Request one from Let's Encrypt or another ACME CA, issue one from the local CA for LAN hostnames, or upload your own.">
            <Action>
                @if (_mayWrite)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => Add(null)" Class="pdk-add-certificate" data-action="add-certificate">Add certificate</MudButton>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="pdk-dt pdk-certs-table" role="table" aria-label="Certificates">
            <div class="pdk-dt-row pdk-dt-head" role="row">
                <span role="columnheader">Certificate</span>
                <span role="columnheader">Source</span>
                <span role="columnheader">Status</span>
                <span role="columnheader">Expires</span>
                <span role="columnheader">Issuer</span>
                <span role="columnheader">Used by</span>
            </div>
            @foreach (var row in Shown)
            {
                var s = row.Summary;
                <div class="pdk-dt-row pdk-dt-link @(_drawer?.Key == row.Id.ToString() ? "pdk-dt-selected" : null)" role="row" @onclick="() => Open(row)"
                     data-certificate="@row.Id" @key="row.Id">
                    <div class="pdk-dt-main" role="cell">
                        <span class="pdk-list-icon pdk-tone-@CertificateDisplay.StatusTone(s.Status, s.NotBefore, s.NotAfter, _now)">
                            <MudIcon Icon="@CertificateDisplay.Icon(row.Origin)" Size="Size.Small" />
                        </span>
                        <span class="pdk-dt-titles">
                            <a class="pdk-row-link pdk-list-title" href="@DashboardRoutes.Certificate(row.Id)" @onclick:stopPropagation="true">@row.Name</a>
                            <span class="pdk-dt-note pdk-mono">@CertificateDisplay.NamesLine(s)</span>
                        </span>
                    </div>
                    <span role="cell" class="pdk-dt-cell" data-label="Source">@CertificateDisplay.Label(row.Origin)</span>
                    <span role="cell" class="pdk-dt-cell" data-label="Status">
                        @if (Issuance.GetProgress(row.Id) is not null)
                        {
                            <span class="pdk-pill pdk-tone-info"><MudProgressCircular Indeterminate="true" Size="Size.Small" Class="pdk-pill-spinner" /> Issuing</span>
                        }
                        else
                        {
                            <span class="pdk-pill pdk-tone-@CertificateDisplay.StatusTone(s.Status, s.NotBefore, s.NotAfter, _now)">@CertificateDisplay.StatusLabel(s.Status, s.NotBefore, s.NotAfter, _now)</span>
                        }
                    </span>
                    <span role="cell" class="pdk-dt-cell" data-label="Expires">
                        @if (s.Status == CertificateStatus.Pending)
                        {
                            <span class="pdk-muted">-</span>
                        }
                        else
                        {
                            <ExpiryCountdown NotAfter="s.NotAfter" Now="_now" />
                        }
                    </span>
                    <span role="cell" class="pdk-dt-cell pdk-cert-issuer" data-label="Issuer">@(s.Status == CertificateStatus.Pending ? "-" : CertificateDisplay.CommonName(s.Issuer))</span>
                    <span role="cell" class="pdk-dt-cell" data-label="Used by">
                        @if (!_view.UsageKnown)
                        {
                            <span class="pdk-muted">-</span>
                        }
                        else if (row.Uses.Count == 0)
                        {
                            <span class="pdk-muted">Unused</span>
                        }
                        else
                        {
                            <span class="pdk-use-chips">
                                @foreach (var use in row.Uses.Take(2))
                                {
                                    <span class="pdk-name-chip">@(use.Kind == CertificateUseKind.Default ? "default" : use.HostName)</span>
                                }
                                @if (row.Uses.Count > 2)
                                {
                                    <span class="pdk-name-chip">+@(row.Uses.Count - 2)</span>
                                }
                            </span>
                        }
                    </span>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    private CertificateInventoryView? _view;
    private bool _mayWrite;
    private bool _mayReadConfig;
    private bool _failed;
    private DateTimeOffset _now;
    private LiveUpdates? _live;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: a certificate's ID; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    private const string AllKey = "all";

    private string? _filter;

    /// <summary>"All", then each state that has certificates (or is the one picked), each with its count and tone.</summary>
    private IReadOnlyList<SegmentOption<string>> FilterOptions
    {
        get
        {
            if (_view is null)
            {
                return [new(AllKey, "All")];
            }

            List<SegmentOption<string>> options = [new(AllKey, "All", Count: _view.Rows.Count)];
            foreach (var filter in Filters)
            {
                var count = _view.Rows.Count(row => filter.Matches(row, _now));
                if (count > 0 || _filter == filter.Key)
                {
                    options.Add(new(filter.Key, filter.Label, Tooltip: filter.Tooltip, Count: count, Tone: filter.Tone));
                }
            }

            return options;
        }
    }

    private void ChooseFilter(string key) => _filter = key == AllKey ? null : key;

    private sealed record CertificateFilter(string Key, string Tone, string Label, string? Tooltip, Func<CertificateSummary, DateTimeOffset, bool> Test)
    {
        public bool Matches(CertificateRow row, DateTimeOffset now) => Test(row.Summary, now);
    }

    private static readonly CertificateFilter[] Filters =
    [
        new("active", "success", "Active", null, (s, now) => s.Status == CertificateStatus.Active && now >= s.NotBefore && now <= s.NotAfter),
        new("expiring", "warning", "Expiring", $"Expire within {CertificateDisplay.WarningDays} days",
            (s, now) => s.Status == CertificateStatus.Active && s.NotAfter > now && s.NotAfter - now <= TimeSpan.FromDays(CertificateDisplay.WarningDays)),
        new("failed", "error", "Failed or expired", null, (s, now) => s.Status == CertificateStatus.Failed || (s.Status == CertificateStatus.Active && now > s.NotAfter)),
        new("pending", "info", "Pending", null, (s, _) => s.Status == CertificateStatus.Pending),
    ];

    /// <summary>The rows the picked filter lets through; every row without one.</summary>
    private IEnumerable<CertificateRow> Shown =>
        _filter is null || Filters.FirstOrDefault(f => f.Key == _filter) is not { } filter
            ? _view!.Rows
            : _view!.Rows.Where(row => filter.Matches(row, _now));

    protected override async Task OnInitializedAsync()
    {
        _now = Time.GetUtcNow();
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        _mayWrite = user.Has(Permission.CertificatesWrite);
        _mayReadConfig = user.Has(Permission.ConfigRead);
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _drawer ??= new RoutedDrawer(Navigation, DashboardRoutes.Certificates);
        _drawer.Show(Key, OpenDrawer);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Live from the moment the page is interactive: a change anywhere (another tab, the scheduler, the API) refreshes the list.
        if (firstRender && RendererInfo.IsInteractive && _live is null)
        {
            _live = LiveUpdates.Start(Config, InvokeAsync, RefreshAsync, followConfig: _mayReadConfig, "certificate.", "acme.order.");
        }
    }

    public void Dispose()
    {
        _live?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        _failed = false;
        try
        {
            _now = Time.GetUtcNow();
            _view = await CertificateInventoryView.LoadAsync(
                CertificateInventory, Issuance, _mayReadConfig ? Config : null, Services.GetService(typeof(IBuiltInCertificates)) as IBuiltInCertificates, _now);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't load the certificates.");
            _failed = true;
            _view ??= new CertificateInventoryView([], null, null, false);
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    /// <summary>The drawer an address names: the segment is parsed here, and anything that isn't a certificate ID is not found.</summary>
    private DrawerLevel OpenDrawer(string key) =>
        CertificateId.TryParse(key, out var id)
            ? Drawers.Push<CertificateDrawer>(new Dictionary<string, object?> { [nameof(CertificateDrawer.Id)] = id }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Certificate not found", "There is no such certificate", "Back to the certificates"), DrawerWidth.Narrow);

    private void Open(CertificateRow row) => Navigation.NavigateTo(DashboardRoutes.Certificate(row.Id));

    /// <summary>Opens the new-certificate drawer without holding up the menu item's click, so the menu closes first.</summary>
    private void Add(AddCertificateKind? kind) => _ = InvokeAsync(() => AddAsync(kind));

    private async Task AddAsync(AddCertificateKind? kind)
    {
        var result = await Drawers.OpenAsync<CertificateCreateDrawer>(
            new Dictionary<string, object?> { [nameof(CertificateCreateDrawer.Method)] = kind },
            DrawerWidth.Medium);
        await LoadAsync();
        if (result.As<CertificateSummary>() is { } created)
        {
            Navigation.NavigateTo(DashboardRoutes.Certificate(created.Id));
        }
    }
}
