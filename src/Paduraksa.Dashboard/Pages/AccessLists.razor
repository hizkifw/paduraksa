@attribute [Route(DashboardRoutes.AccessLists)]
@attribute [Route(DashboardRoutes.AccessLists + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DraftState Drafts
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<AccessLists> Logger
@* Security: the access lists. Each row says which addresses and users a list lets in and which hosts and routes apply it; one in
   use can't be deleted, so its delete button is not offered. /access-lists/acl_... is this list with that drawer open. *@

<PageTitle>Access lists · Paduraksa</PageTitle>

<PageHeader Title="Access lists" ListEmpty="@(_document is { AccessLists.Count: 0 })">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Href="@DashboardRoutes.NewAccessList" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-access-list">Add access list</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="@IdentityText.CantReadConfig" Description="@IdentityText.CantReadConfigHelp" />
    </MudPaper>
}
else
{
    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            The access lists couldn't be read. The details are in the server log.
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync" Class="ml-2">Try again</MudButton>
        </MudAlert>
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
        @if (_document is null)
        {
            @for (var i = 0; i < 3; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="24%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="36%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="20%" />
                </div>
            }
        }
        else if (_document.AccessLists.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="No access lists yet"
                        Description="An access list names the addresses a host or route lets in or refuses, and the users it asks a password of.">
                <Action>
                    @if (_mayWrite)
                    {
                        <MudButton Href="@DashboardRoutes.NewAccessList" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-access-list">Add access list</MudButton>
                    }
                </Action>
            </EmptyState>
        }
        else
        {
            <div class="pdk-dt pdk-access-lists-table" role="table" aria-label="Access lists">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">Access list</span>
                    <span role="columnheader">Rules</span>
                    <span role="columnheader">Used by</span>
                    <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
                </div>
                @foreach (var list in _document.AccessLists.OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var usage = AccessListUsageOf.Find(_document, list.Id);
                    <div class="pdk-dt-row pdk-dt-link" role="row" @onclick="() => Open(list)" data-access-list="@list.Name" @key="list.Id">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" /></span>
                            <div class="pdk-dt-titles">
                                <a class="pdk-row-link" href="@DashboardRoutes.AccessList(list.Id)" @onclick:stopPropagation="true">@list.Name</a>
                                <DraftChip Target="@DraftTargets.AccessList(list.Id)" />
                                @if (!string.IsNullOrWhiteSpace(list.Notes))
                                {
                                    <span class="pdk-dt-note">@list.Notes</span>
                                }
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Rules">
                            <span class="pdk-dt-note">@AccessListText.Summary(list)</span>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Used by" @onclick:stopPropagation="true">
                            @if (usage.IsEmpty)
                            {
                                <span class="pdk-muted">No host or route</span>
                            }
                            else
                            {
                                <div class="pdk-dt-stack">
                                    <span class="pdk-muted">@usage.CountText</span>
                                    <span class="pdk-dt-chips">
                                        @foreach (var host in usage.Hosts)
                                        {
                                            <a class="pdk-tag pdk-tag-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                        }
                                        @foreach (var use in usage.Routes)
                                        {
                                            <a class="pdk-tag pdk-tag-link" href="@DashboardRoutes.Host(use.Host.Id)">@($"{ChangeView.HostTitle(use.Host)} {use.Route.Path}")</a>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                        <div role="cell" class="pdk-dt-cell pdk-dt-actions" @onclick:stopPropagation="true">
                            @if (_mayWrite && usage.IsEmpty)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ReviewDeleteAsync(list)"
                                               aria-label="@($"Delete {list.Name}")" data-action="delete" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

@code {
    private bool _denied;
    private bool _failed;
    private bool _mayWrite;
    private bool _loaded;
    private ConfigDocument? _document;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: a list's ID, or <c>new</c>; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, DashboardRoutes.AccessLists);
            _watch = Config.Watch(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        if (!_denied)
        {
            _drawer!.Show(Key, OpenDrawer);
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        await Drafts.EnsureLoadedAsync();
        _failed = false;
        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        try
        {
            _document = (await Config.GetWorkingAsync()).Document;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't load the access lists.");
            _failed = true;
            _document ??= new ConfigDocument();
            Snackbar.Add(StoreFailures.Message("The access lists couldn't be read."), Severity.Error);
        }
    }

    private DrawerLevel OpenDrawer(string key)
    {
        if (key == DashboardRoutes.NewSegment)
        {
            return Drawers.Push<AccessListDrawer>(width: DrawerWidth.Medium);
        }

        return AccessListId.TryParse(key, out var id)
            ? Drawers.Push<AccessListDrawer>(new Dictionary<string, object?> { [nameof(AccessListDrawer.Id)] = id }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Access list not found", "There is no such access list", "Back to the access lists"), DrawerWidth.Narrow);
    }

    private void Open(AccessListConfig list) => Navigation.NavigateTo(DashboardRoutes.AccessList(list.Id));

    private async Task ReviewDeleteAsync(AccessListConfig list)
    {
        if (_document is null || !_mayWrite || !AccessListUsageOf.Find(_document, list.Id).IsEmpty)
        {
            return;
        }

        await Drawers.ReviewAsync(new ReviewRequest($"Delete access list {list.Name}", new DeleteAccessListCommand(list.Id, list.Version))
        {
            Destructive = true,
            SuccessMessage = $"Deleted the access list {list.Name}",
        });
    }
}
