@attribute [Route(DashboardRoutes.AccessLists)]
@attribute [Route(DashboardRoutes.AccessLists + "/{Key}")]
@* Security: the access lists. /access-lists/acl_... is that list with its drawer open. *@

<SecurityObjectList Kind="Listing" Key="@Key" />

@code {
    private static readonly SecurityObjectKind<AccessListConfig> Listing = new()
    {
        Noun = "access list",
        Plural = "access lists",
        Icon = Icons.Material.Outlined.Lock,
        SummaryHeading = "Rules",
        EmptyDescription = "An access list names the addresses a host or route lets in or refuses, and the users it asks a password of.",
        BackText = "Back to the access lists",
        ListRoute = DashboardRoutes.AccessLists,
        NewRoute = DashboardRoutes.NewAccessList,
        Drawer = typeof(AccessListDrawer),
        DrawerParameters = key => AccessListId.TryParse(key, out var id) ? new Dictionary<string, object?> { [nameof(AccessListDrawer.Id)] = id } : null,
        Items = document => document.AccessLists,
        Name = list => list.Name,
        Notes = list => list.Notes,
        Route = list => DashboardRoutes.AccessList(list.Id),
        DraftTarget = list => DraftTargets.AccessList(list.Id),
        Summary = AccessListText.Summary,
        Usage = (document, list) => ReferenceUsage.Find(document, s => s.AccessList?.AccessListId == list.Id),
        Delete = list => new DeleteAccessListCommand(list.Id, list.Version),
    };

    [Parameter]
    public string? Key { get; set; }
}
