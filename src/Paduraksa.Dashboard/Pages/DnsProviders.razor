@attribute [Authorize]
@attribute [Route(DashboardRoutes.DnsProviders)]
@attribute [Route(DashboardRoutes.DnsProviders + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Paduraksa.Application.Commands
@using Paduraksa.Application.Issuance
@using Paduraksa.Contracts.Issuance
@using Paduraksa.Dashboard.Providers
@inject IDashboardProviders Providers
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ILogger<DnsProviders> Logger
@inject DisplayFormat Fmt
@* The DNS providers, as the certificates are listed. /certificates/dns/dnsp_... is this list with that provider's drawer open. A provider has
   no states to filter by, and what it last answered to a test isn't kept, so the table has neither. *@

<PageTitle>DNS providers · Paduraksa</PageTitle>

<PageHeader Title="DNS providers" ListEmpty="@(_providers is { Count: 0 })">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="Add" Class="pdk-add-dns"
                       data-action="add-provider">Add provider</MudButton>
        }
    </Actions>
</PageHeader>

@if (_failed)
{
    <LoadFailedAlert What="The DNS providers" OnRetry="LoadAsync" Class="mb-6" />
}

<MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
    @if (_providers is null)
    {
        <RowSkeleton Rows="4" Circle="32px" Widths="40% 15% 15%" />
    }
    else if (_providers.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Dns" Title="No DNS providers yet"
                    Description="HTTP-01 needs none. Add Cloudflare or deSEC to get wildcard certificates, or certificates for hostnames the CA can't reach.">
            <Action>
                @if (_mayWrite)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="Add" Class="pdk-add-dns" data-action="add-provider">Add provider</MudButton>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="pdk-dt pdk-dns-table" role="table" aria-label="DNS providers">
            <div class="pdk-dt-row pdk-dt-head" role="row">
                <span role="columnheader">Provider</span>
                <span role="columnheader">Type</span>
                <span role="columnheader">Token updated</span>
                <span role="columnheader">Added</span>
                <span role="columnheader">Certificates</span>
            </div>
            @foreach (var provider in _providers)
            {
                <div class="pdk-dt-row pdk-dt-link @(_drawer?.Key == provider.Id.ToString() ? "pdk-dt-selected" : null)" role="row" @onclick="() => Open(provider)"
                     data-provider="@provider.Id" @key="provider.Id">
                    <div class="pdk-dt-main" role="cell">
                        <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@ProviderDisplay.KindIcon(provider.Kind)" Size="Size.Small" /></span>
                        <span class="pdk-dt-titles">
                            <a class="pdk-row-link pdk-list-title" href="@DashboardRoutes.DnsProvider(provider.Id)" @onclick:stopPropagation="true">@provider.Label</a>
                        </span>
                    </div>
                    <span role="cell" class="pdk-dt-cell" data-label="Type">@ProviderDisplay.KindLabel(provider.Kind)</span>
                    <span role="cell" class="pdk-dt-cell" data-label="Token updated">@Fmt.Date(provider.UpdatedAt)</span>
                    <span role="cell" class="pdk-dt-cell" data-label="Added">@Fmt.Date(provider.CreatedAt)</span>
                    <span role="cell" class="pdk-dt-cell" data-label="Certificates">
                        @if (_counts.GetValueOrDefault(provider.Id) is > 0 and var count)
                        {
                            @count
                        }
                        else
                        {
                            <span class="pdk-muted">None</span>
                        }
                    </span>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    private IReadOnlyList<DnsProviderSummary>? _providers;
    private IReadOnlyDictionary<DnsProviderId, int> _counts = new Dictionary<DnsProviderId, int>();
    private bool _mayWrite;
    private bool _failed;
    private IDisposable? _live;
    private RoutedDrawer? _drawer;
    private DnsProviderId? _testOnOpen;

    /// <summary>The address's last segment: a provider's ID; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Loads once the page is live (the prerender shows the skeleton): its buttons would otherwise be there to click before the
        // circuit has a handler for them, and the click is lost.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        _mayWrite = user.Has(Permission.ProvidersWrite);
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _drawer ??= new RoutedDrawer(Navigation, DashboardRoutes.DnsProviders);
        _drawer.Show(Key, OpenDrawer);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive && _live is null)
        {
            _live = Providers.Watch(InvokeAsync, RefreshAsync);
        }
    }

    public void Dispose()
    {
        _live?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        try
        {
            _failed = false;
            _providers = [.. (await Providers.ListDnsProvidersAsync()).OrderBy(p => p.Label, StringComparer.OrdinalIgnoreCase)];
            _counts = await Providers.DnsCertificateCountsAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't load the DNS providers.");
            _failed = true;
            _providers ??= [];
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    /// <summary>The drawer an address names: anything that isn't a provider's ID is not found.</summary>
    private DrawerLevel OpenDrawer(string key) =>
        DnsProviderId.TryParse(key, out var id)
            ? Drawers.Push<DnsProviderDetailsDrawer>(
                new Dictionary<string, object?> { [nameof(DnsProviderDetailsDrawer.Id)] = id, [nameof(DnsProviderDetailsDrawer.TestOnOpen)] = TakeTestOnOpen(id) }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Provider not found", "There is no such DNS provider", "Back to the providers"), DrawerWidth.Narrow);

    /// <summary>Whether the provider was just added, and so is tested as its drawer opens (once).</summary>
    private bool TakeTestOnOpen(DnsProviderId id)
    {
        var test = _testOnOpen == id;
        _testOnOpen = null;
        return test;
    }

    private void Open(DnsProviderSummary provider) => Navigation.NavigateTo(DashboardRoutes.DnsProvider(provider.Id));

    /// <summary>Opens the form without holding up the click, so the button's own ripple finishes first.</summary>
    private void Add() => _ = InvokeAsync(AddAsync);

    private async Task AddAsync()
    {
        var result = await Drawers.OpenAsync<DnsProviderDrawer>(DnsProviderDrawer.For(null), DrawerWidth.Narrow);
        // The new provider's drawer opens, and tests the token as a new one has always been.
        if (result.As<DnsProviderSummary>() is { } added)
        {
            _testOnOpen = added.Id;
            Navigation.NavigateTo(DashboardRoutes.DnsProvider(added.Id));
        }

        await RefreshAsync();
    }
}
