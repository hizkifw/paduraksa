@attribute [Route(SettingsRoutes.Profiles)]
@attribute [Route(SettingsRoutes.Profiles + "/{Key}")]
@implements IDisposable
@using Paduraksa.Dashboard.Editors
@using Microsoft.Extensions.Logging
@inject IDashboardConfig Config
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<Profiles> Logger
@* Settings: profiles (PLAN §5.1). Each row says what the profile sets and which hosts use it; one in use can't be deleted. A profile
   opens in a drawer; its address (/settings/profiles/prof_..., /settings/profiles/new) is the list with that drawer open. *@

<PageTitle>Profiles · Settings · Paduraksa</PageTitle>

<PageHeader Title="Profiles" Overline="Settings" Lead="Named sets of host settings, such as an allow list for your LAN, that hosts pick instead of repeating them.">
    <Actions>
        <MudButton Href="@DashboardRoutes.Settings" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack">Settings</MudButton>
        @if (_mayWrite)
        {
            <MudButton Href="@SettingsRoutes.NewProfile" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" data-action="add-profile">Add profile</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied)
{
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="Your role can't read the config" Description="An Owner can give you a role that can." />
    </MudPaper>
}
else
{
    @if (_deleteRefusal is { } refusal)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" data-banner="in-use" ShowCloseIcon="true" CloseIconClicked="() => _deleteRefusal = null">
            @refusal
        </MudAlert>
    }

    <MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
        @if (_document is null)
        {
            @for (int i = 0; i < 2; i++)
            {
                <div class="pdk-row-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="24%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="36%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="20%" />
                </div>
            }
        }
        else if (_document.Profiles.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Badge" Title="No profiles yet"
                        Description="A profile is a named set of settings, such as an allow list for your LAN, that any number of hosts can pick.">
                <Action>
                    @if (_mayWrite)
                    {
                        <MudButton Href="@SettingsRoutes.NewProfile" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add">Add profile</MudButton>
                    }
                </Action>
            </EmptyState>
        }
        else
        {
            <div class="pdk-dt pdk-profiles-table" role="table" aria-label="Profiles">
                <div class="pdk-dt-row pdk-dt-head" role="row">
                    <span role="columnheader">Profile</span>
                    <span role="columnheader">Sets</span>
                    <span role="columnheader">Used by</span>
                    <span role="columnheader"><span class="pdk-visually-hidden">Actions</span></span>
                </div>
                @foreach (ProfileConfig profile in _document.Profiles.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase))
                {
                    IReadOnlyList<HostConfig> hosts = ProfileEditModel.HostsUsing(_document, profile.Id);
                    IReadOnlyList<string> sets = HostSettingsModel.Summary(profile.Settings);
                    <div class="pdk-dt-row pdk-dt-link" role="row" @onclick="() => Open(profile)" data-profile="@profile.Name" @key="profile.Id">
                        <div role="cell" class="pdk-dt-main">
                            <span class="pdk-list-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" /></span>
                            <div class="pdk-dt-titles">
                                <a class="pdk-row-link" href="@SettingsRoutes.Profile(profile.Id)" @onclick:stopPropagation="true">@profile.Name</a>
                                @if (!string.IsNullOrWhiteSpace(profile.Notes))
                                {
                                    <span class="pdk-dt-note">@profile.Notes</span>
                                }
                            </div>
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Sets">
                            @if (sets.Count == 0)
                            {
                                <span class="pdk-muted">Nothing yet: hosts with it inherit the global defaults.</span>
                            }
                            else
                            {
                                <span class="pdk-dt-chips">
                                    @foreach (string part in sets)
                                    {
                                        <StatusChip Tone="Tone.Primary" Text="@part" />
                                    }
                                </span>
                            }
                        </div>
                        <div role="cell" class="pdk-dt-cell" data-label="Used by" @onclick:stopPropagation="true">
                            @if (hosts.Count == 0)
                            {
                                <span class="pdk-muted">No host yet</span>
                            }
                            else
                            {
                                <span class="pdk-dt-chips">
                                    @foreach (HostConfig host in hosts)
                                    {
                                        <a class="pdk-tag pdk-tag-link" href="@DashboardRoutes.Host(host.Id)">@ChangeView.HostTitle(host)</a>
                                    }
                                </span>
                            }
                        </div>
                        <div role="cell" class="pdk-dt-cell pdk-dt-actions" @onclick:stopPropagation="true">
                            @if (_mayWrite)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ReviewDeleteAsync(profile)"
                                               aria-label="@($"Delete {profile.Name}")" data-action="delete" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

@code {
    private bool _denied;
    private ConfigDocument? _document;
    private bool _mayWrite;
    private bool _loaded;
    private string? _deleteRefusal;
    private IDisposable? _watch;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: a profile's ID, or <c>new</c>; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            _drawer = new RoutedDrawer(Navigation, SettingsRoutes.Profiles);
            _watch = Config.Watch(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }));
            await LoadAsync();
        }

        if (!_denied)
        {
            _drawer!.Show(Key, OpenDrawer);
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        if (!user.Has(Permission.ConfigRead))
        {
            _denied = true;
            return;
        }

        _mayWrite = user.Has(Permission.ConfigWrite);
        try
        {
            _document = (await Config.GetCurrentAsync()).Document;
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't load the profiles.");
            Snackbar.Add(StoreFailures.Message("The profiles couldn't be read."), Severity.Error);
            _document ??= new ConfigDocument();
        }
    }

    private DrawerLevel OpenDrawer(string key)
    {
        if (key == DashboardRoutes.NewSegment)
        {
            return Drawers.Push<ProfileDrawer>(width: DrawerWidth.Medium);
        }

        return ProfileId.TryParse(key, out ProfileId id)
            ? Drawers.Push<ProfileDrawer>(new Dictionary<string, object?> { [nameof(ProfileDrawer.Id)] = id }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Profile not found", "There is no such profile", "Profiles", "Back to the profiles"), DrawerWidth.Narrow);
    }

    private void Open(ProfileConfig profile) => Navigation.NavigateTo(SettingsRoutes.Profile(profile.Id));

    private async Task ReviewDeleteAsync(ProfileConfig profile)
    {
        if (_document is null || !_mayWrite)
        {
            return;
        }

        // Refused here with the hosts named, rather than by the dry run with a pointer: the validator would refuse it the same way.
        IReadOnlyList<HostConfig> hosts = ProfileEditModel.HostsUsing(_document, profile.Id);
        if (hosts.Count > 0)
        {
            _deleteRefusal = $"{profile.Name} is still used by {string.Join(", ", hosts.Select(ChangeView.HostTitle))}, so it can't be deleted. "
                + "Pick another profile (or none) for those hosts first.";
            Snackbar.Add($"{profile.Name} is in use and can't be deleted.", Severity.Warning);
            return;
        }

        _deleteRefusal = null;
        await Drawers.ReviewAsync(new ReviewRequest($"Delete profile {profile.Name}", new DeleteProfileCommand(profile.Id, profile.Version))
        {
            ApplyLabel = "Delete",
            Destructive = true,
            SuccessMessage = $"Deleted the profile {profile.Name}",
        });
    }
}
