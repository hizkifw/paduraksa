@attribute [Authorize]
@attribute [Route(DashboardRoutes.AcmeAccounts)]
@attribute [Route(DashboardRoutes.AcmeAccounts + "/{Key}")]
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Paduraksa.Application.Commands
@using Paduraksa.Contracts.Issuance
@using Paduraksa.Dashboard.Providers
@inject IDashboardProviders Providers
@inject DashboardCaller Caller
@inject DrawerStack Drawers
@inject NavigationManager Navigation
@inject ILogger<AcmeAccounts> Logger
@inject DisplayFormat Fmt
@* The ACME accounts, as the certificates are listed. /certificates/acme/acct_... is this list with that account's drawer open. *@

<PageTitle>ACME accounts · Paduraksa</PageTitle>

<PageHeader Title="ACME accounts" ListEmpty="@(_accounts is { Count: 0 })">
    <Actions>
        @if (_mayWrite)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="Add" Class="pdk-add-account"
                       data-action="add-account">Add account</MudButton>
        }
    </Actions>
</PageHeader>

@if (_failed)
{
    <LoadFailedAlert What="The accounts" OnRetry="LoadAsync" Class="mb-6" />
}

<div class="pdk-toolbar-row">
    <SegmentedControl T="string" Options="FilterOptions" Value="@_filter" ValueChanged="ChooseFilter" AriaLabel="Show" DataField="filter" Disabled="_accounts is null" />
</div>

<MudPaper Class="pdk-card pdk-table-card" Elevation="0" Outlined="true">
    @if (_accounts is null)
    {
        <RowSkeleton Rows="4" Circle="32px" Widths="40% 15% 15%" />
    }
    else if (_accounts.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Badge" Title="No ACME accounts yet"
                    Description="An account is how a CA such as Let's Encrypt knows who orders certificates.">
            <Action>
                @if (_mayWrite)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="Add" Class="pdk-add-account" data-action="add-account">Add account</MudButton>
                }
            </Action>
        </EmptyState>
    }
    else if (Shown.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="pdk-muted pdk-compact-empty" data-empty="@_filter">@(_filter == DeactivatedKey ? "No deactivated accounts." : "No active accounts.")</MudText>
    }
    else
    {
        <div class="pdk-dt pdk-acme-table" role="table" aria-label="ACME accounts">
            <div class="pdk-dt-row pdk-dt-head" role="row">
                <span role="columnheader">Account</span>
                <span role="columnheader">CA</span>
                <span role="columnheader">Key</span>
                <span role="columnheader">Added</span>
                <span role="columnheader">Certificates</span>
            </div>
            @foreach (var account in Shown)
            {
                var active = account.Status == AcmeAccountStatus.Active;
                <div class="pdk-dt-row pdk-dt-link @(_drawer?.Key == account.Id.ToString() ? "pdk-dt-selected" : null)" role="row" @onclick="() => Open(account)"
                     data-account="@account.Id" @key="account.Id">
                    <div class="pdk-dt-main" role="cell">
                        <span class="pdk-list-icon pdk-tone-@(active ? "primary" : "default")"><MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" /></span>
                        <span class="pdk-dt-titles">
                            <a class="pdk-row-link pdk-list-title" href="@DashboardRoutes.AcmeAccount(account.Id)" @onclick:stopPropagation="true">@ProviderDisplay.AccountTitle(account)</a>
                            @if (account.Contacts.Count > 1)
                            {
                                <span class="pdk-dt-note">@string.Join(", ", account.Contacts.Select(ProviderDisplay.Contact))</span>
                            }
                        </span>
                    </div>
                    <span role="cell" class="pdk-dt-cell" data-label="CA">
                        <span class="pdk-dt-chips">
                            <span>@ProviderDisplay.CaName(account.DirectoryUrl)</span>
                            @if (ProviderDisplay.IsStaging(account.DirectoryUrl))
                            {
                                <span class="pdk-pill pdk-tone-warning">Staging</span>
                            }
                            @if (account.EabKid is not null)
                            {
                                <span class="pdk-pill pdk-tone-info" title="Bound with an EAB key ID; the key itself stays in the vault">EAB</span>
                            }
                        </span>
                    </span>
                    <span role="cell" class="pdk-dt-cell" data-label="Key">@account.KeyAlgorithm</span>
                    <span role="cell" class="pdk-dt-cell" data-label="Added">@Fmt.Date(account.CreatedAt)</span>
                    <span role="cell" class="pdk-dt-cell" data-label="Certificates">
                        @if (_counts.GetValueOrDefault(account.Id) is > 0 and var count)
                        {
                            @count
                        }
                        else
                        {
                            <span class="pdk-muted">None</span>
                        }
                    </span>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    private const string ActiveKey = "active";
    private const string DeactivatedKey = "deactivated";

    private IReadOnlyList<AcmeAccountSummary>? _accounts;
    private IReadOnlyDictionary<AcmeAccountId, int> _counts = new Dictionary<AcmeAccountId, int>();
    private bool _mayWrite;
    private bool _failed;
    private string _filter = ActiveKey;
    private IDisposable? _live;
    private RoutedDrawer? _drawer;

    /// <summary>The address's last segment: an account's ID; null for the list alone.</summary>
    [Parameter]
    public string? Key { get; set; }

    private IReadOnlyList<SegmentOption<string>> FilterOptions
    {
        get
        {
            var active = _accounts?.Count(a => a.Status == AcmeAccountStatus.Active);
            var deactivated = _accounts?.Count(a => a.Status != AcmeAccountStatus.Active);
            return [new(ActiveKey, "Active", Count: active), new(DeactivatedKey, "Deactivated", Count: deactivated)];
        }
    }

    private IReadOnlyList<AcmeAccountSummary> Shown =>
        [.. _accounts!.Where(a => (a.Status == AcmeAccountStatus.Active) == (_filter == ActiveKey))];

    private void ChooseFilter(string key) => _filter = key;

    protected override async Task OnInitializedAsync()
    {
        // Loads once the page is live (the prerender shows the skeleton): its buttons would otherwise be there to click before the
        // circuit has a handler for them, and the click is lost.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        _mayWrite = user.Has(Permission.ProvidersWrite);
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _drawer ??= new RoutedDrawer(Navigation, DashboardRoutes.AcmeAccounts);
        _drawer.Show(Key, OpenDrawer);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive && _live is null)
        {
            _live = Providers.Watch(InvokeAsync, RefreshAsync);
        }
    }

    public void Dispose()
    {
        _live?.Dispose();
        _drawer?.Dispose();
    }

    private async Task LoadAsync()
    {
        try
        {
            _failed = false;
            _accounts = [.. (await Providers.ListAccountsAsync()).OrderByDescending(a => a.CreatedAt)];
            _counts = await Providers.AccountCertificateCountsAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't load the ACME accounts.");
            _failed = true;
            _accounts ??= [];
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    /// <summary>The drawer an address names: anything that isn't an account's ID is not found.</summary>
    private DrawerLevel OpenDrawer(string key) =>
        AcmeAccountId.TryParse(key, out var id)
            ? Drawers.Push<AcmeAccountDetailsDrawer>(new Dictionary<string, object?> { [nameof(AcmeAccountDetailsDrawer.Id)] = id }, DrawerWidth.Medium)
            : Drawers.Push<NotFoundDrawer>(NotFoundDrawer.For("Account not found", "There is no such ACME account", "Back to the accounts"), DrawerWidth.Narrow);

    private void Open(AcmeAccountSummary account) => Navigation.NavigateTo(DashboardRoutes.AcmeAccount(account.Id));

    /// <summary>Opens the form without holding up the click, so a menu or the button's own ripple finishes first.</summary>
    private void Add() => _ = InvokeAsync(AddAsync);

    private async Task AddAsync()
    {
        var result = await Drawers.OpenAsync<AcmeAccountDrawer>(width: DrawerWidth.Narrow);
        // The new account's drawer opens before the list is read again: the CA call is done, but the read follows the vault.
        if (result.As<AcmeAccountSummary>() is { } created)
        {
            Navigation.NavigateTo(DashboardRoutes.AcmeAccount(created.Id));
        }

        await RefreshAsync();
    }
}
