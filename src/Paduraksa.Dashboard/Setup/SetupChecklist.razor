@* "Finish setting up" on the overview: the tasks that aren't done yet, each linking to the page that does it, until they
   are done or the person dismisses the list. Nothing shows while it loads, so a finished setup never flashes it. *@
@inject UserService Users
@inject AcmeAccountService AcmeAccounts
@inject DnsProviderService DnsProviders
@inject CertificateService CertificateInventory
@inject ConfigService Config
@inject DashboardCaller Caller
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_progress is { } progress && !_dismissed && Visible(progress) is { Count: > 0 } open)
{
    <MudPaper Class="pdk-card pdk-checklist" Elevation="0" Outlined="true" role="region" aria-label="Finish setting up">
        <div class="pdk-card-head">
            <div class="pdk-card-head-main">
                <span class="pdk-stat-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Checklist" Size="Size.Small" /></span>
                <div>
                    <MudText Typo="Typo.h6" HtmlTag="h2">Finish setting up</MudText>
                    <MudText Typo="Typo.caption" Class="pdk-muted">@Wording.Plural(open.Count, "thing is", "things are") left to set up.</MudText>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="DismissAsync" aria-label="Dismiss the checklist" Class="pdk-checklist-dismiss" />
        </div>
        <MudProgressLinear Value="Percent(progress, open.Count)" Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mb-3" />
        <ul class="pdk-list">
            @foreach (var task in open)
            {
                var info = SetupTasks.Info(task);
                <li class="pdk-list-row pdk-checklist-item" data-step="@info.Slug">
                    <span class="pdk-list-icon pdk-tone-default"><MudIcon Icon="@info.Icon" Size="Size.Small" /></span>
                    <span class="pdk-list-main">
                        <span class="pdk-list-title">@info.Title</span>
                        <span class="pdk-list-sub">@info.Hint</span>
                    </span>
                    <MudButton Href="@info.Href" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Set up</MudButton>
                </li>
            }
        </ul>
    </MudPaper>
}

@code {
    private const string ModulePath = "./_content/Paduraksa.Dashboard/setup-checklist.js";

    private SetupProgress? _progress;
    private bool _dismissed = true;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _dismissed = await _module.InvokeAsync<bool>("isDismissed");
        }
        catch (JSException)
        {
            _dismissed = false;
        }

        if (_dismissed)
        {
            return;
        }

        var user = await Caller.CheckAsync();
        if (user is not null)
        {
            _progress = await SetupProgress.LoadAsync(user, Users, AcmeAccounts, DnsProviders, CertificateInventory, Config);
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone.
            }
        }
    }

    /// <summary>The open tasks worth listing: the DNS provider only matters once there is an ACME account.</summary>
    internal static IReadOnlyList<SetupTask> Visible(SetupProgress progress) =>
        [.. progress.Remaining.Where(task => task != SetupTask.DnsProvider || progress.HasAccount == true)];

    private static double Percent(SetupProgress progress, int open)
    {
        var total = SetupTasks.All.Count(t => progress.IsDone(t.Task) is not null);
        return total == 0 ? 100 : 100.0 * (total - open) / total;
    }

    private async Task DismissAsync()
    {
        _dismissed = true;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dismiss");
        }
    }
}
