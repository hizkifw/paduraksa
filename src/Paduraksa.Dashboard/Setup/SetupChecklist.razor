@* "Finish setting up" on the overview: the tasks that aren't done yet, each linking to the page that does it, until they
   are done or the person dismisses the list. It is read while the page is prerendered (what is open comes from the data, and the
   dismissal from a cookie) and carried into the circuit, so it is on the page, or not, from the first paint. *@
@using Microsoft.Extensions.Logging
@inject UserService Users
@inject AcmeAccountService AcmeAccounts
@inject DnsProviderService DnsProviders
@inject CertificateService CertificateInventory
@inject ConfigService Config
@inject DashboardCaller Caller
@inject IJSRuntime JS
@inject ChecklistPreference Preference
@inject ILogger<SetupChecklist> Logger

@if (!Preference.IsDismissed && State is { Open.Count: > 0 } state)
{
    var open = state.Open;
    <MudPaper Class="pdk-card pdk-checklist" Elevation="0" Outlined="true" role="region" aria-label="Finish setting up">
        <div class="pdk-card-head">
            <div class="pdk-card-head-main">
                <span class="pdk-stat-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Checklist" Size="Size.Small" /></span>
                <div>
                    <MudText Typo="Typo.h6" HtmlTag="h2">Finish setting up</MudText>
                    <MudText Typo="Typo.caption" Class="pdk-muted">@Wording.Plural(open.Count, "thing is", "things are") left to set up.</MudText>
                </div>
            </div>
            @* Nothing is listening before the circuit is live: a click on it then would be lost. *@
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" Disabled="@(!RendererInfo.IsInteractive)" OnClick="DismissAsync" aria-label="Dismiss the checklist" Class="pdk-checklist-dismiss" />
        </div>
        <MudProgressLinear Value="state.Percent" Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mb-3" />
        <ul class="pdk-list">
            @foreach (var task in open)
            {
                var info = SetupTasks.Info(task);
                <li class="pdk-list-row pdk-checklist-item" data-step="@info.Slug">
                    <span class="pdk-list-icon pdk-tone-default"><MudIcon Icon="@info.Icon" Size="Size.Small" /></span>
                    <span class="pdk-list-main">
                        <span class="pdk-list-title">@info.Title</span>
                        <span class="pdk-list-sub">@info.Hint</span>
                    </span>
                    <MudButton Href="@info.Href" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Set up</MudButton>
                </li>
            }
        </ul>
    </MudPaper>
}

@code {
    /// <summary>What is left to do, carried from the prerender into the circuit.</summary>
    public sealed record ChecklistView(IReadOnlyList<SetupTask> Open, int Total)
    {
        public double Percent => Total == 0 ? 100 : 100.0 * (Total - Open.Count) / Total;
    }

    [PersistentState]
    public ChecklistView? State { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // A dismissed checklist reads nothing, and a state carried from the prerender is not read again.
        if (Preference.IsDismissed || State is not null)
        {
            return;
        }

        try
        {
            var user = await Caller.CheckAsync();
            if (user is not null)
            {
                var progress = await SetupProgress.LoadAsync(user, Users, AcmeAccounts, DnsProviders, CertificateInventory, Config);
                State = new ChecklistView(Visible(progress), SetupTasks.All.Count(t => progress.IsDone(t.Task) is not null));
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The checklist is a nicety: a store that can't be read leaves it out, and the overview reports that itself.
            Logger.LogWarning(ex, "Couldn't read the setup checklist.");
        }
    }

    /// <summary>The open tasks worth listing: the DNS provider only matters once there is an ACME account.</summary>
    internal static IReadOnlyList<SetupTask> Visible(SetupProgress progress) =>
        [.. progress.Remaining.Where(task => task != SetupTask.DnsProvider || progress.HasAccount == true)];

    private async Task DismissAsync()
    {
        Preference.Dismiss();
        try
        {
            await JS.InvokeVoidAsync("paduraksa.dismissSetupChecklist");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException or TaskCanceledException or ObjectDisposedException)
        {
            // The circuit is gone, or the browser refused the cookie: it shows again next load.
        }
    }
}
