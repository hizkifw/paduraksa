@* "Finish setting up" on the overview: the wizard's steps that aren't done yet, each linking back into it, until they are done or the
   person dismisses the list (remembered in this browser). Nothing shows while it loads, so a finished setup never flashes it. *@
@inject UserService Users
@inject AcmeAccountService AcmeAccounts
@inject DnsProviderService DnsProviders
@inject CertificateService CertificateInventory
@inject ConfigService Config
@inject DashboardCaller Caller
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_progress is { } progress && !_dismissed && Visible(progress) is { Count: > 0 } open)
{
    <MudPaper Class="pdk-card pdk-checklist" Elevation="0" Outlined="true" role="region" aria-label="Finish setting up">
        <div class="pdk-card-head">
            <div class="pdk-card-head-main">
                <span class="pdk-stat-icon pdk-tone-primary"><MudIcon Icon="@Icons.Material.Outlined.Checklist" Size="Size.Small" /></span>
                <div>
                    <MudText Typo="Typo.h6" HtmlTag="h2">Finish setting up</MudText>
                    <MudText Typo="Typo.caption" Class="pdk-muted">@CertificateDisplay.Plural(open.Count, "step is", "steps are") left. Each takes a minute.</MudText>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="DismissAsync" aria-label="Dismiss the checklist" Class="pdk-checklist-dismiss" />
        </div>
        <MudProgressLinear Value="Percent(progress, open.Count)" Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mb-3" />
        <ul class="pdk-list">
            @foreach (WizardStep step in open)
            {
                WizardStepInfo info = SetupWizard.Info(step);
                <li class="pdk-list-row pdk-checklist-item" data-step="@info.Slug">
                    <span class="pdk-list-icon pdk-tone-default"><MudIcon Icon="@info.Icon" Size="Size.Small" /></span>
                    <span class="pdk-list-main">
                        <span class="pdk-list-title">@info.Title</span>
                        <span class="pdk-list-sub">@Hint(step)</span>
                    </span>
                    <MudButton Href="@SetupWizard.PathOf(step)" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Set up</MudButton>
                </li>
            }
        </ul>
    </MudPaper>
}

@code {
    private const string ModulePath = "./_content/Paduraksa.Dashboard/setup-checklist.js";

    private SetupProgress? _progress;
    private bool _dismissed = true;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _dismissed = await _module.InvokeAsync<bool>("isDismissed");
        }
        catch (JSException)
        {
            _dismissed = false;
        }

        if (_dismissed)
        {
            return;
        }

        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is not null)
        {
            _progress = await SetupProgress.LoadAsync(user, Users, AcmeAccounts, DnsProviders, CertificateInventory, Config);
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone.
            }
        }
    }

    /// <summary>The open steps worth listing: the DNS provider only matters once there is an ACME account.</summary>
    internal static IReadOnlyList<WizardStep> Visible(SetupProgress progress) =>
        [.. progress.Remaining.Where(step => step != WizardStep.DnsProvider || progress.HasAccount == true)];

    private static double Percent(SetupProgress progress, int open)
    {
        int total = SetupWizard.Steps.Count(s => s.Step >= SetupWizard.First && s.Step < WizardStep.Done && progress.IsDone(s.Step) is not null);
        return total == 0 ? 100 : 100.0 * (total - open) / total;
    }

    private static string Hint(WizardStep step) => step switch
    {
        WizardStep.TwoStep => "A code from your phone on top of your password.",
        WizardStep.AcmeAccount => "For free, browser-trusted certificates from Let's Encrypt.",
        WizardStep.DnsProvider => "For wildcard certificates (DNS-01).",
        WizardStep.Certificate => "So your hosts answer over HTTPS.",
        _ => "Proxy a name to a service on your network.",
    };

    private async Task DismissAsync()
    {
        _dismissed = true;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dismiss");
        }
    }
}
