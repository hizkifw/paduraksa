@* The wizard's certificate: from the ACME CA (a wildcard through DNS-01, or names over HTTP-01) with live progress, or from the local CA
   for names a public CA can't validate. *@
@inject AcmeIssuanceService Issuance
@inject CertificateOperations Operations
@inject DashboardCaller Caller
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime

@if (_issued is { } issued)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="pdk-cert-issued">
        <strong>@CertificateDisplay.DisplayName(issued)</strong> is ready: @string.Join(", ", issued.Names). Hosts with these names use it on their own.
    </MudAlert>
}
else if (_start is not null)
{
    <AcmeRunPanel @key="_run" Start="_start" ChallengeType="_challenge" Finished="OnFinished" />
    @if (_failed)
    {
        <div class="pdk-form-actions mt-3">
            <MudButton Variant="Variant.Text" OnClick="() => { _start = null; _failed = false; }">Change the request</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="UseLocalCa">Use the local CA instead</MudButton>
        </div>
    }
}
else
{
    <div class="pdk-choice-grid mb-4" role="radiogroup" aria-label="Where the certificate comes from">
        <button type="button" class="pdk-choice pdk-cert-source-acme @(!_local ? "pdk-choice-on" : null)" role="radio" aria-checked="@(!_local ? "true" : "false")"
                disabled="@(Accounts.Count == 0)" @onclick="() => _local = false">
            <MudIcon Icon="@Icons.Material.Outlined.Public" Size="Size.Small" />
            <span class="pdk-choice-title">ACME CA</span>
            <span class="pdk-choice-hint">@(Accounts.Count == 0 ? "Needs an ACME account (the step before)." : "Trusted by every browser. The names must be public.")</span>
        </button>
        <button type="button" class="pdk-choice pdk-cert-source-local @(_local ? "pdk-choice-on" : null)" role="radio" aria-checked="@(_local ? "true" : "false")"
                @onclick="() => _local = true">
            <MudIcon Icon="@Icons.Material.Outlined.Lan" Size="Size.Small" />
            <span class="pdk-choice-title">Local CA</span>
            <span class="pdk-choice-hint">For LAN names. Trusted wherever its root is installed.</span>
        </button>
    </div>
    @if (_local)
    {
        <LocalCertificateForm LocalCa="true" Submit="IssueLocalAsync" Issued="Done" SubmitText="Issue certificate" InitialNames="InitialNames" />
    }
    else
    {
        <AcmeRequestForm Accounts="Accounts" Providers="Providers" Submit="StartAcme" InitialNames="AcmeNames" SubmitText="Request certificate" />
    }
}

@code {
    private bool _local;
    private Func<IProgress<AcmeOrderProgress>, Task<IssuanceResult>>? _start;
    private AcmeChallengeType _challenge;
    private CertificateSummary? _issued;
    private bool _failed;
    private int _run;

    [Parameter, EditorRequired]
    public IReadOnlyList<AcmeAccountSummary> Accounts { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<DnsProviderSummary> Providers { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string>? InitialNames { get; set; }

    /// <summary>After a certificate was issued (either way).</summary>
    [Parameter]
    public EventCallback<CertificateSummary> Issued { get; set; }

    /// <summary>With a DNS provider, a domain's wildcard comes along.</summary>
    private IReadOnlyList<string>? AcmeNames =>
        Providers.Count > 0 && InitialNames is [var first] && !first.StartsWith("*.", StringComparison.Ordinal) ? [first, $"*.{first}"] : InitialNames;

    protected override void OnInitialized() => _local = Accounts.All(a => a.Status != AcmeAccountStatus.Active);

    private async Task StartAcme(CertificateIssueRequest request)
    {
        CommandOrigin? origin = await Caller.OriginAsync();
        if (origin is null)
        {
            return;
        }

        _challenge = request.ChallengeType;
        _failed = false;
        _run++;
        _start = progress => Issuance.RequestCertificateAsync(request, origin, progress, Lifetime.ApplicationStopping);
    }

    private async Task OnFinished(IssuanceResult result)
    {
        if (result is { Outcome: IssuanceOutcome.Issued, Certificate: { } certificate })
        {
            await Done(certificate);
        }
        else
        {
            _failed = true;
        }
    }

    private void UseLocalCa()
    {
        _start = null;
        _failed = false;
        _local = true;
    }

    private async Task<CertificateOperationResult?> IssueLocalAsync(LocalCertificateRequest request)
    {
        CommandOrigin? origin = await Caller.OriginAsync();
        return origin is null ? null : await LocalCa.IssueAsync(Operations, request, origin);
    }

    private async Task Done(CertificateSummary certificate)
    {
        _issued = certificate;
        await Issued.InvokeAsync(certificate);
    }
}
