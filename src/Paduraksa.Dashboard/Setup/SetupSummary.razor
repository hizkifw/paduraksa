@* The wizard's last page: what is set up, what was skipped (with a link back), where to go next, and the reminder to trust the local CA. *@

<ul class="pdk-summary-list">
    @foreach ((WizardStep step, string label, string? detail, string href) in Items)
    {
        bool? done = Progress.IsDone(step);
        if (done is null)
        {
            continue;
        }

        <li class="pdk-summary-item pdk-summary-@(done == true ? "done" : "open")" data-step="@SetupWizard.Info(step).Slug">
            <span class="pdk-list-icon pdk-tone-@(done == true ? "success" : "warning")">
                <MudIcon Icon="@(done == true ? Icons.Material.Rounded.Check : Icons.Material.Outlined.Schedule)" Size="Size.Small" />
            </span>
            <span class="pdk-list-main">
                <span class="pdk-list-title">@label</span>
                <span class="pdk-list-sub">@(done == true ? detail : Skipped.Contains(step) ? "Skipped: you can come back to it any time." : "Not set up yet.")</span>
            </span>
            <MudButton Href="@href" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">@(done == true ? "Open" : "Set up")</MudButton>
        </li>
    }
</ul>

<div class="pdk-home-grid mt-4">
    <TrustRootCard Root="Progress.Root" />
    <MudPaper Class="pdk-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">Where next</MudText>
        <ul class="pdk-next-links">
            <li><MudLink Href="@DashboardRoutes.Hosts">Hosts</MudLink>: add more names, redirects and fixed answers.</li>
            <li><MudLink Href="@DashboardRoutes.Certificates">Certificates</MudLink>: renewals run on their own; watch them here.</li>
            <li><MudLink Href="@DashboardRoutes.Simulator">Simulator</MudLink>: see what a request would do before it happens.</li>
            <li><MudLink Href="@DashboardRoutes.Settings">Settings</MudLink>: ACME accounts and DNS providers.</li>
        </ul>
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired]
    public SetupProgress Progress { get; set; } = default!;

    [Parameter]
    public IReadOnlySet<WizardStep> Skipped { get; set; } = new HashSet<WizardStep>();

    private IEnumerable<(WizardStep Step, string Label, string? Detail, string Href)> Items
    {
        get
        {
            yield return (WizardStep.TwoStep, "Two-step sign-in", "On for your account.", SetupWizard.PathOf(WizardStep.TwoStep));
            yield return (WizardStep.AcmeAccount, "ACME account",
                Progress.Accounts?.FirstOrDefault(a => a.Status == AcmeAccountStatus.Active) is { } account ? ProviderDisplay.AccountName(account) : null, SettingsRoutes.AcmeAccounts);
            yield return (WizardStep.DnsProvider, "DNS provider", Progress.Providers?.FirstOrDefault()?.Label, SettingsRoutes.DnsProviders);
            yield return (WizardStep.Certificate, "Certificate",
                Progress.Certificates?.OrderByDescending(c => c.CreatedAt).FirstOrDefault() is { } certificate ? string.Join(", ", certificate.Names) : null, DashboardRoutes.Certificates);
            yield return (WizardStep.FirstHost, "First host", Progress.Hosts is { } hosts ? CertificateDisplay.Plural(hosts, "host", "hosts") + " configured." : null, DashboardRoutes.Hosts);
        }
    }
}
