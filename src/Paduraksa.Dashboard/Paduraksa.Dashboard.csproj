<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- UI talks to Application services + Contracts DTOs only; never Data. -->
  <ItemGroup>
    <ProjectReference Include="../Paduraksa.Application/Paduraksa.Application.csproj" />
    <ProjectReference Include="../Paduraksa.Contracts/Paduraksa.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MudBlazor" />
  </ItemGroup>
  <ItemGroup>
    <!-- The About page's license texts: the repository's own files, so there is no copy to keep in step. The notices are generated: scripts/generate-third-party-notices.py. -->
    <EmbeddedResource Include="../../LICENSE" LogicalName="Paduraksa.Dashboard.About.LICENSE" />
    <EmbeddedResource Include="../../NOTICE" LogicalName="Paduraksa.Dashboard.About.NOTICE" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.json" LogicalName="Paduraksa.Dashboard.About.THIRD-PARTY-NOTICES.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Paduraksa.Tests.Dashboard" />
  </ItemGroup>
</Project>
