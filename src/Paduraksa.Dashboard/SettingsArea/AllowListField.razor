@* The IP allow list field: off inherits the list below, on replaces it as a whole, an empty list being "no restriction",
   which is how a layer lifts an inherited one. *@
<SettingRow Title="IP allow list" Help="@HelpText" Wide="true">
    <div class="pdk-setting-control pdk-allow">
        <MudSwitch T="bool" Value="_set" ValueChanged="SetAsync" Color="Color.Primary"
                   Label="@(_set ? "Set here" : "Inherit")" Disabled="@ReadOnly" data-field="allow-list-set" />
        @if (_set)
        {
            <MudTextField T="string" Value="_text" ValueChanged="TextChangedAsync" Label="Addresses and networks"
                          Placeholder="192.168.1.0/24, 10.0.0.5" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pdk-mono-input" ReadOnly="@ReadOnly"
                          HelperText="One per line. Empty lifts an inherited list." Error="@(Error is not null)" ErrorText="@Error"
                          data-field="allow-list" />
            <MudSwitch T="bool" Value="_dropDenied" ValueChanged="DropDeniedChangedAsync" Color="Color.Primary"
                       Label="Drop refused requests without an answer" Disabled="@ReadOnly" />
        }
    </div>
</SettingRow>

@code {
    private bool _set;
    private string _text = string.Empty;
    private bool _dropDenied;
    private IpAllowListSettings? _seen;
    private bool _initialised;

    /// <summary>The layer's own list; null inherits.</summary>
    [Parameter]
    public IpAllowListSettings? Value { get; set; }

    [Parameter]
    public EventCallback<IpAllowListSettings?> ValueChanged { get; set; }

    /// <summary>The list this layer would inherit, resolved.</summary>
    [Parameter]
    public IpAllowListSettings? Inherited { get; set; }

    /// <summary>Where the inherited list comes from, in words ("the global defaults").</summary>
    [Parameter]
    public string InheritedFrom { get; set; } = "the built-in defaults";

    /// <summary>An error anywhere under the field (the list's shape, one address).</summary>
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    private string HelpText =>
        "Only these addresses and networks get through; others get a 403." + (_set ? string.Empty : $" Now: {InheritedText}.");

    private string InheritedText => Inherited is { Addresses.Count: > 0 } inherited
        ? $"inherits {inherited.Addresses.Count} {(inherited.Addresses.Count == 1 ? "entry" : "entries")} from {InheritedFrom}"
        : "no restriction";

    protected override void OnParametersSet()
    {
        // The parent's record is the value: when it changes underneath us (a reload, an undo), the field follows it again.
        if (!_initialised || !ReferenceEquals(Value, _seen))
        {
            _set = Value is not null;
            _text = string.Join('\n', Value?.Addresses ?? []);
            _dropDenied = Value?.DropDenied ?? false;
            _seen = Value;
            _initialised = true;
        }
    }

    private Task SetAsync(bool set)
    {
        _set = set;
        return EmitAsync(set ? new IpAllowListSettings(HostEditModel.SplitList(_text), _dropDenied) : null);
    }

    private Task TextChangedAsync(string? text)
    {
        _text = text ?? string.Empty;
        return EmitAsync(new IpAllowListSettings(HostEditModel.SplitList(_text), _dropDenied));
    }

    private Task DropDeniedChangedAsync(bool dropDenied)
    {
        _dropDenied = dropDenied;
        return EmitAsync(new IpAllowListSettings(HostEditModel.SplitList(_text), _dropDenied));
    }

    private Task EmitAsync(IpAllowListSettings? value)
    {
        _seen = value;
        return ValueChanged.InvokeAsync(value);
    }
}
