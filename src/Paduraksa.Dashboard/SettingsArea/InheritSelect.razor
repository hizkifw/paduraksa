@typeparam T where T : struct
@* A settings field with an "inherit" choice: a nullable value where null means the layer below's, and an option that
   says in words what that inherited value would be. *@
<SettingRow Title="@Title" Help="@Help" HelpContent="@HelpContent">
    <MudSelect T="T?" Value="Value" ValueChanged="OnValueChanged" Label="@Label"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ReadOnly="@ReadOnly" Disabled="@Disabled"
               Class="pdk-setting-control" Error="@(Error is not null)" ErrorText="@Error" data-field="@Field">
        <MudSelectItem T="T?" Value="null">@InheritWord (@InheritedText)</MudSelectItem>
        @ChildContent
    </MudSelect>
</SettingRow>

@code {
    [Parameter, EditorRequired]
    public T? Value { get; set; }

    [Parameter]
    public EventCallback<T?> ValueChanged { get; set; }

    /// <summary>The value this layer would inherit, resolved.</summary>
    [Parameter, EditorRequired]
    public T Inherited { get; set; }

    /// <summary>The inherited value in words ("redirect", "1 year", "upstream and the client").</summary>
    [Parameter, EditorRequired]
    public Func<T, string> Format { get; set; } = default!;

    /// <summary>The words of the inherit choice: "Inherit" or "Built-in default".</summary>
    [Parameter]
    public string InheritWord { get; set; } = "Inherit";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Help { get; set; }

    [Parameter]
    public RenderFragment? HelpContent { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>The <c>data-field</c> the tests and the browser select it by.</summary>
    [Parameter, EditorRequired]
    public string Field { get; set; } = string.Empty;

    /// <summary>The message to show at the field, if any.</summary>
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The choices besides the inherited one, each a <see cref="MudSelectItem{T}"/> of <c>T?</c>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string InheritedText => Format(Inherited);

    private Task OnValueChanged(T? value) => ValueChanged.InvokeAsync(value);
}
