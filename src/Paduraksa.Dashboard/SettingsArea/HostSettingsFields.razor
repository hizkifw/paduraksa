@using Paduraksa.Application.Compilation
@* The fields of one layer of host settings, shared by the global defaults, the profiles and the hosts: each binds to the
   contract's own record, where null means inherit, and says what it would inherit. Paths are relative to the layer. *@
<div class="pdk-setting-list">
    @ChildContent

    <h4 class="pdk-setting-section">HTTPS and TLS</h4>

    @if (ShowForceHttps)
    {
        <InheritSelect T="bool" Value="_current.ForceHttps" ValueChanged="@(value => Update(_current with { ForceHttps = value }, "/forceHttps"))"
                      Inherited="@Resolved.ForceHttps!.Value" Format="@(value => value ? "redirect" : "don't redirect")"
                      InheritWord="@InheritWord" Title="HTTPS redirect"
                      Help="Send plain-HTTP requests to HTTPS before anything else. A host without a certificate can't redirect."
                      Label="HTTPS redirect" Field="force-https" Error="@E("/forceHttps")" ReadOnly="@ReadOnly" Disabled="@ForceHttpsDisabled">
            <MudSelectItem T="bool?" Value="true">Redirect to HTTPS</MudSelectItem>
            <MudSelectItem T="bool?" Value="false">Don't redirect</MudSelectItem>
        </InheritSelect>
    }

    <InheritSelect T="TlsMinimumVersion" Value="_current.Tls?.MinimumVersion" ValueChanged="@(value => Update(WithTls(tls => tls with { MinimumVersion = value }), "/tls"))"
                  Inherited="@Resolved.Tls!.MinimumVersion!.Value" Format="@(value => SettingsSummary.TlsText(value))" InheritWord="@InheritWord"
                  Title="Minimum TLS version" Help="The oldest TLS a client may use over TCP. HTTP/3 always uses TLS 1.3."
                  Label="Minimum TLS version" Field="minimum-tls" Error="@E("/tls")" ReadOnly="@ReadOnly">
        <MudSelectItem T="TlsMinimumVersion?" Value="TlsMinimumVersion.Tls12">TLS 1.2</MudSelectItem>
        <MudSelectItem T="TlsMinimumVersion?" Value="TlsMinimumVersion.Tls13">TLS 1.3</MudSelectItem>
    </InheritSelect>

    <InheritSelect T="TcpAlpn" Value="_current.Tls?.TcpAlpn" ValueChanged="@(value => Update(WithTls(tls => tls with { TcpAlpn = value }), "/tls"))"
                  Inherited="@Resolved.Tls!.TcpAlpn!.Value" Format="@(value => SettingsSummary.AlpnText(value))" InheritWord="@InheritWord"
                  Title="Protocols over TCP" Help="What is offered in the TLS handshake. HTTP/1.1 only helps an old client or a picky upstream."
                  Label="Protocols over TCP" Field="tcp-alpn" Error="@E("/tls")" ReadOnly="@ReadOnly">
        <MudSelectItem T="TcpAlpn?" Value="TcpAlpn.Http2AndHttp11">HTTP/2 and HTTP/1.1</MudSelectItem>
        <MudSelectItem T="TcpAlpn?" Value="TcpAlpn.Http11Only">HTTP/1.1 only</MudSelectItem>
    </InheritSelect>

    <InheritSelect T="bool" Value="_current.Tls?.Http3" ValueChanged="@(value => Update(WithTls(tls => tls with { Http3 = value }), "/tls"))"
                  Inherited="@Resolved.Tls!.Http3!.Value" Format="@(value => value ? "on" : "off")" InheritWord="@InheritWord"
                  Title="HTTP/3" Help="Serve over QUIC as well, when the HTTP/3 listener is on. Browsers find it through Alt-Svc."
                  Label="HTTP/3" Field="http3" Error="@E("/tls")" ReadOnly="@ReadOnly">
        <MudSelectItem T="bool?" Value="true">On</MudSelectItem>
        <MudSelectItem T="bool?" Value="false">Off</MudSelectItem>
    </InheritSelect>

    <InheritSelect T="bool" Value="_current.Hsts?.Enabled" ValueChanged="@(value => Update(WithHsts(hsts => hsts with { Enabled = value }), "/hsts"))"
                  Inherited="@Resolved.Hsts!.Enabled!.Value" Format="@(value => value ? "on" : "off")" InheritWord="@InheritWord"
                  Title="HSTS" Help="Tell browsers to reach this host over HTTPS only, for as long as it is remembered." Label="HSTS" Field="hsts-enabled" Error="@E("/hsts")" ReadOnly="@ReadOnly">
        <MudSelectItem T="bool?" Value="true">On</MudSelectItem>
        <MudSelectItem T="bool?" Value="false">Off</MudSelectItem>
    </InheritSelect>

    <div class="pdk-setting-children">
        <HstsMaxAgeField Value="_current.Hsts" ValueChanged="@(value => Update(WithHsts(_ => value ?? new HstsSettings()), "/hsts/maxAge"))"
                         Inherited="@Resolved.Hsts!.MaxAge!.Value" HstsOn="HstsOn" InheritWord="@InheritWord" Error="@E("/hsts/maxAge")" ReadOnly="@ReadOnly" />

        @if (HstsOn)
        {
            <InheritSelect T="bool" Value="_current.Hsts?.IncludeSubDomains" ValueChanged="@(value => Update(WithHsts(hsts => hsts with { IncludeSubDomains = value }), "/hsts/includeSubDomains"))"
                          Inherited="@Resolved.Hsts!.IncludeSubDomains!.Value" Format="@(value => value ? "on" : "off")" InheritWord="@InheritWord"
                          Title="Every subdomain" HelpContent="@SubdomainHelp" Label="Every subdomain" Field="hsts-include-subdomains"
                          Error="@E("/hsts/includeSubDomains")" ReadOnly="@ReadOnly">
                <MudSelectItem T="bool?" Value="true">On</MudSelectItem>
                <MudSelectItem T="bool?" Value="false">Off</MudSelectItem>
            </InheritSelect>

            <InheritSelect T="bool" Value="_current.Hsts?.Preload" ValueChanged="@(value => Update(WithHsts(hsts => hsts with { Preload = value }), "/hsts/preload"))"
                          Inherited="@Resolved.Hsts!.Preload!.Value" Format="@(value => value ? "on" : "off")" InheritWord="@InheritWord"
                          Title="Preload list" HelpContent="@PreloadHelp" Label="Preload list" Field="hsts-preload" Error="@E("/hsts/preload")" ReadOnly="@ReadOnly">
                <MudSelectItem T="bool?" Value="true">On</MudSelectItem>
                <MudSelectItem T="bool?" Value="false">Off</MudSelectItem>
            </InheritSelect>
        }
    </div>

    <h4 class="pdk-setting-section">Access</h4>

    <AllowListField Value="_current.IpAllowList" ValueChanged="@(value => Update(_current with { IpAllowList = value }, "/ipAllowList"))"
                    Inherited="Inherited.IpAllowList" InheritedFrom="@InheritedFrom" Error="@FirstUnder("/ipAllowList")" ReadOnly="@ReadOnly" />

    <SettingRow Title="Rate limit" Help="Requests over the policy's rate get a 429. Each host counts its clients separately.">
        <RateLimitField Value="_current.RateLimit" ValueChanged="SetRateLimit" Inherited="@(Resolved.RateLimit ?? new RateLimitSettings())"
                        Policies="Policies" Staged="StagedRateLimits" InheritWord="@InheritWord" OnNew="OnNewRateLimit"
                        Error="@RateLimitError" ReadOnly="@ReadOnly" Class="pdk-setting-control" />
    </SettingRow>

    <InheritSelect T="bool" Value="_current.ProofOfWork?.Enabled" ValueChanged="@(value => Update(WithProofOfWork(pow => pow with { Enabled = value }), "/proofOfWork/enabled"))"
                   Inherited="@Resolved.ProofOfWork!.Enabled!.Value" Format="@(value => value ? "on" : "off")" InheritWord="@InheritWord"
                   Title="Browser check" Help="A browser solves a small proof of work once and keeps a signed cookie, so a plain scraper never gets in."
                   Label="Browser check" Field="proof-of-work-enabled" Error="@E("/proofOfWork/enabled")" ReadOnly="@ReadOnly">
        <MudSelectItem T="bool?" Value="true">On</MudSelectItem>
        <MudSelectItem T="bool?" Value="false">Off</MudSelectItem>
    </InheritSelect>

    <div class="pdk-setting-children">
        <InheritSelect T="int" Value="_current.ProofOfWork?.Difficulty" ValueChanged="@(value => Update(WithProofOfWork(pow => pow with { Difficulty = value }), "/proofOfWork/difficulty"))"
                       Inherited="@Resolved.ProofOfWork!.Difficulty!.Value" Format="@(value => $"{value} bits ({SettingsSummary.DifficultyText(value)})")" InheritWord="@InheritWord"
                       Title="Difficulty" Help="Leading zero bits a solution needs. Each extra bit doubles the work, for the visitor and for a bot."
                       Label="Difficulty" Field="proof-of-work-difficulty" Error="@E("/proofOfWork/difficulty")" ReadOnly="@ReadOnly">
            @for (var bits = 8; bits <= 28; bits++)
            {
                var value = bits;
                <MudSelectItem T="int?" Value="value">@value bits (@SettingsSummary.DifficultyText(value))</MudSelectItem>
            }
        </InheritSelect>

        <ProofOfWorkLifetimeField Value="_current.ProofOfWork" ValueChanged="@(value => Update(WithProofOfWork(_ => value ?? new ProofOfWorkSettings()), "/proofOfWork/tokenLifetimeHours"))"
                                  Inherited="@Resolved.ProofOfWork!.TokenLifetimeHours!.Value" InheritWord="@InheritWord"
                                  Error="@E("/proofOfWork/tokenLifetimeHours")" ReadOnly="@ReadOnly" />
    </div>

    <InheritSelect T="RobotsMode" Value="_current.Robots?.Mode" ValueChanged="SetRobotsMode"
                   Inherited="@Resolved.Robots!.Mode!.Value" Format="@(mode => SettingsSummary.RobotsModeText(mode))" InheritWord="@InheritWord"
                   Title="robots.txt" Help="The file a crawler reads at /robots.txt. It is cached for an hour, so a change is picked up within the hour."
                   Label="robots.txt" Field="robots-mode" Error="@E("/robots/mode")" ReadOnly="@ReadOnly">
        <MudSelectItem T="RobotsMode?" Value="RobotsMode.Passthrough">Pass through to the upstream</MudSelectItem>
        <MudSelectItem T="RobotsMode?" Value="RobotsMode.DisallowAll">Disallow all crawlers</MudSelectItem>
        <MudSelectItem T="RobotsMode?" Value="RobotsMode.BlockAiCrawlers">Block AI crawlers</MudSelectItem>
        <MudSelectItem T="RobotsMode?" Value="RobotsMode.Custom">Custom</MudSelectItem>
    </InheritSelect>

    <div class="pdk-setting-children">
        @if (EffectiveRobotsMode == RobotsMode.Custom)
        {
            <SettingRow Title="Custom text" Help="Served as typed, with a final newline. Left empty, an inherited text is used if there is one." Wide="true">
                <MudTextField T="string" Value="@(_current.Robots?.CustomText ?? string.Empty)"
                              ValueChanged="@(value => Update(WithRobots(robots => robots with { CustomText = string.IsNullOrEmpty(value) ? null : value }), "/robots/customText"))"
                              Label="Text" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="8" ReadOnly="@ReadOnly"
                              Class="pdk-mono-input" Error="@(E("/robots/customText") is not null)" ErrorText="@E("/robots/customText")"
                              data-field="robots-custom-text" />
            </SettingRow>
        }
        else if (EffectiveRobotsMode == RobotsMode.BlockAiCrawlers)
        {
            <SettingRow Title="Blocked crawlers" Help="Each gets Disallow: /; every other crawler is allowed." Wide="true">
                <div class="pdk-robots">
                    <details data-field="robots-crawlers">
                        <summary>@RobotsText.AiCrawlers.Count user agents</summary>
                        <div class="pdk-robots-agents">
                            @foreach (var crawler in RobotsText.AiCrawlers)
                            {
                                <code>@crawler</code>
                            }
                        </div>
                    </details>
                    <details data-field="robots-preview">
                        <summary>Preview the served file</summary>
                        <pre class="pdk-robots-preview">@RobotsText.BlockAiCrawlers</pre>
                    </details>
                </div>
            </SettingRow>
        }
    </div>

    <h4 class="pdk-setting-section">Headers and logging</h4>

    <InheritSelect T="ServerHeaderMode" Value="_current.ServerHeader?.Mode" ValueChanged="@(value => Update(WithServerHeader(server => server with { Mode = value }), "/serverHeader/mode"))"                  Inherited="@Resolved.ServerHeader!.Mode!.Value" Format="@(mode => SettingsSummary.ServerHeaderText(mode, Resolved.ServerHeader!.Value))"
                  InheritWord="@InheritWord" Title="Server header" Help="Hiding the upstream's header stops it advertising its software and version." Label="Server header" Field="server-header-mode"
                  Error="@E("/serverHeader/mode")" ReadOnly="@ReadOnly">
        <MudSelectItem T="ServerHeaderMode?" Value="ServerHeaderMode.Paduraksa">Paduraksa (no version)</MudSelectItem>
        <MudSelectItem T="ServerHeaderMode?" Value="ServerHeaderMode.Custom">Custom value</MudSelectItem>
        <MudSelectItem T="ServerHeaderMode?" Value="ServerHeaderMode.Upstream">The upstream's header</MudSelectItem>
        <MudSelectItem T="ServerHeaderMode?" Value="ServerHeaderMode.Remove">Remove</MudSelectItem>
    </InheritSelect>

    <div class="pdk-setting-children">
        @if (ServerValueVisible)
        {
            <SettingRow Title="Custom value">
                <MudTextField T="string" Value="@(_current.ServerHeader?.Value ?? string.Empty)"
                              ValueChanged="@(value => Update(WithServerHeader(server => server with { Value = string.IsNullOrEmpty(value) ? null : value }), "/serverHeader/value"))"
                              Label="Value" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@ReadOnly" MaxLength="128"
                              HelperText="1-128 visible ASCII characters" Class="pdk-mono-input"
                              Error="@(E("/serverHeader/value") is not null)" ErrorText="@E("/serverHeader/value")" data-field="server-header-value" />
            </SettingRow>
        }
    </div>

    <InheritSelect T="RequestIdPropagation" Value="_current.RequestIdPropagation" ValueChanged="@(value => Update(_current with { RequestIdPropagation = value }, "/requestIdPropagation"))"
                  Inherited="@Resolved.RequestIdPropagation!.Value" Format="@(value => SettingsSummary.PropagationText(value))" InheritWord="@InheritWord"
                  Title="Request ID" Help="One ID ties a line in the access log to the same request in the app's own log."
                  Label="Request ID" Field="request-id-propagation" Error="@E("/requestIdPropagation")" ReadOnly="@ReadOnly">
        <MudSelectItem T="RequestIdPropagation?" Value="RequestIdPropagation.UpstreamAndResponse">Upstream and the client</MudSelectItem>
        <MudSelectItem T="RequestIdPropagation?" Value="RequestIdPropagation.UpstreamOnly">Upstream only</MudSelectItem>
        <MudSelectItem T="RequestIdPropagation?" Value="RequestIdPropagation.ResponseOnly">The client only</MudSelectItem>
        <MudSelectItem T="RequestIdPropagation?" Value="RequestIdPropagation.Off">Off</MudSelectItem>
    </InheritSelect>

    <InheritSelect T="bool" Value="_current.AccessLog" ValueChanged="@(value => Update(_current with { AccessLog = value }, "/accessLog"))"
                  Inherited="@Resolved.AccessLog!.Value" Format="@(value => value ? "on" : "off")" InheritWord="@InheritWord"
                  Title="Access log" Help="One line per request, whatever answered it. Turn it off for a host whose app keeps its own log."
                  Label="Access log" Field="access-log" Error="@E("/accessLog")" ReadOnly="@ReadOnly">
        <MudSelectItem T="bool?" Value="true">On</MudSelectItem>
        <MudSelectItem T="bool?" Value="false">Off</MudSelectItem>
    </InheritSelect>
</div>

@code {
    /// <summary>The layer being edited; a null field inherits.</summary>
    [Parameter, EditorRequired]
    public HostSettings Settings { get; set; } = new();

    /// <summary>A field changed: the layer as it now is.</summary>
    [Parameter]
    public EventCallback<HostSettings> SettingsChanged { get; set; }

    /// <summary>What this layer would inherit, resolved (the global defaults over the built-in ones, for a profile).</summary>
    [Parameter, EditorRequired]
    public HostSettings Inherited { get; set; } = HostSettingsLayers.BuiltIn;

    /// <summary>Where the inherited values come from, in words ("the global defaults", "the built-in defaults").</summary>
    [Parameter]
    public string InheritedFrom { get; set; } = "the built-in defaults";

    /// <summary>The words of the "inherit" choice: "Inherit" or "Built-in default".</summary>
    [Parameter]
    public string InheritWord { get; set; } = "Inherit";

    /// <summary>The layer's path in the errors (<c>/defaults</c>, <c>/settings</c>).</summary>
    [Parameter]
    public string PathPrefix { get; set; } = string.Empty;

    /// <summary>The errors by path; only those under <see cref="PathPrefix"/> are shown here.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> Errors { get; set; } = new Dictionary<string, string>();

    /// <summary>Whether every error shows (after a review attempt), or only those of touched fields.</summary>
    [Parameter]
    public bool ShowAll { get; set; }

    [Parameter]
    public IReadOnlySet<string> Touched { get; set; } = new HashSet<string>();

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>False leaves out the HTTPS redirect (the admin host, which is always HTTPS).</summary>
    [Parameter]
    public bool ShowForceHttps { get; set; } = true;

    /// <summary>The HTTPS redirect can't be changed (a host without a certificate).</summary>
    [Parameter]
    public bool ForceHttpsDisabled { get; set; }

    /// <summary>Rows before the settings, in the same layout.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The rate-limit policies a host or a profile can pick, including those staged in a host's draft.</summary>
    [Parameter]
    public IReadOnlyList<RateLimitPolicyConfig> Policies { get; set; } = [];

    /// <summary>The policies made in this host's drawer (marked "New").</summary>
    [Parameter]
    public IReadOnlySet<RateLimitPolicyId> StagedRateLimits { get; set; } = new HashSet<RateLimitPolicyId>();

    /// <summary>"New rate limit..." in the picker: the host's drawer makes one and selects it.</summary>
    [Parameter]
    public EventCallback OnNewRateLimit { get; set; }

    /// <summary>A field changed; its path (with the prefix).</summary>
    [Parameter]
    public EventCallback<string> OnChanged { get; set; }

    private HostSettings _current = new();
    private HostSettings? _seen;
    private bool _initialised;

    /// <summary>What the layer below says, with the one place that states the built-in defaults underneath it.</summary>
    private HostSettings Resolved { get; set; } = HostSettingsLayers.BuiltIn;

    protected override void OnParametersSet()
    {
        // The parent's record is the layer: a reload or an undo changes the instance, while our own edits are already
        // _current, so a render before the page has caught up can't put an old value back.
        if (!_initialised || !ReferenceEquals(Settings, _seen))
        {
            _current = Settings;
            _seen = Settings;
            _initialised = true;
        }

        Resolved = HostSettingsLayers.Merge(HostSettingsLayers.BuiltIn, Inherited);
    }

    /// <summary>Whether the HSTS fields under the switch apply: this layer's choice, else what it inherits.</summary>
    private bool HstsOn => _current.Hsts?.Enabled ?? Resolved.Hsts?.Enabled ?? false;

    /// <summary>Which robots.txt dependent row applies: this layer's mode, else what it inherits.</summary>
    private RobotsMode EffectiveRobotsMode => _current.Robots?.Mode ?? Resolved.Robots?.Mode ?? RobotsMode.Passthrough;

    /// <summary>An error at either field the picker owns: the reference the validator refuses, or the old switch's path.</summary>
    private string? RateLimitError => E("/rateLimit/policyId") ?? E("/rateLimit/enabled");

    /// <summary>The custom value shows for a custom mode, or when this layer or an error has one to show.</summary>
    private bool ServerValueVisible =>
        _current.ServerHeader?.Mode == ServerHeaderMode.Custom || !string.IsNullOrEmpty(_current.ServerHeader?.Value) || E("/serverHeader/value") is not null;

    private RenderFragment SubdomainHelp => @<text>Pins every name under this one too (<code>includeSubDomains</code>). Only when each of them has a
        certificate: a plain-HTTP subdomain stops working.</text>;

    private RenderFragment PreloadHelp => @<text>Asks the browser vendors to ship the host as HTTPS-only (<code>preload</code>). Needs every subdomain and
        a year, and is hard to undo: browsers that ship the list keep refusing plain HTTP.</text>;

    private HostSettings WithTls(Func<TlsSettings, TlsSettings> change) => HostSettingsEdit.WithTls(_current, change);

    private HostSettings WithHsts(Func<HstsSettings, HstsSettings> change) => HostSettingsEdit.WithHsts(_current, change);

    private HostSettings WithServerHeader(Func<ServerHeaderSettings, ServerHeaderSettings> change) => HostSettingsEdit.WithServerHeader(_current, change);

    private HostSettings WithProofOfWork(Func<ProofOfWorkSettings, ProofOfWorkSettings> change) => HostSettingsEdit.WithProofOfWork(_current, change);

    private HostSettings WithRobots(Func<RobotsSettings, RobotsSettings> change) => HostSettingsEdit.WithRobots(_current, change);

    /// <summary>
    /// A concrete mode other than custom clears this layer's text: kept beside it, the validator would refuse the text as
    /// unexpected rather than ignore it, so switching modes would leave a document that can't be saved. Inherit keeps it:
    /// a layer may set only the text, for the custom mode a layer below resolves.
    /// </summary>
    private Task SetRobotsMode(RobotsMode? mode) =>
        Update(
            WithRobots(robots => mode is { } chosen && chosen != RobotsMode.Custom ? robots with { Mode = mode, CustomText = null } : robots with { Mode = mode }),
            "/robots/mode");

    /// <summary>The picker's record: null (or one that sets nothing) is no layer at all, which is how a layer inherits.</summary>
    private Task SetRateLimit(RateLimitSettings? value) =>
        Update(HostSettingsEdit.WithRateLimit(_current, _ => value ?? new RateLimitSettings()), "/rateLimit/policyId");

    /// <summary>Hands the changed layer to the form, then says which field changed (so its errors show and it revalidates).</summary>
    private async Task Update(HostSettings settings, string path)
    {
        _current = settings;
        _seen = settings;
        await SettingsChanged.InvokeAsync(settings);
        await OnChanged.InvokeAsync(PathPrefix + path);
    }

    private string? E(string path)
    {
        var full = PathPrefix + path;
        return (ShowAll || Touched.Contains(full)) && Errors.TryGetValue(full, out var message) ? message : null;
    }

    private string? FirstUnder(string path)
    {
        var full = PathPrefix + path;
        return ShowAll || Touched.Contains(full)
            ? Errors.Where(e => e.Key == full || e.Key.StartsWith(full + "/", StringComparison.Ordinal)).Select(e => e.Value).FirstOrDefault()
            : null;
    }
}
