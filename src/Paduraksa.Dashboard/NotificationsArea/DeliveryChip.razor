@* One delivery as a chip: the channel and what became of the message, the error or the time in its tooltip. *@
<StatusChip Tone="DeliveryDisplay.ToneOf(Delivery.State)" Icon="@DeliveryDisplay.IconOf(Delivery.State)" Text="@DeliveryDisplay.Label(Delivery, WithChannel)"
            Detail="@DeliveryDisplay.Detail(Delivery)" Name="@("delivery-" + Delivery.State.ToName())" Class="pdk-nh-chip" />

@code {
    [Parameter, EditorRequired]
    public NotificationDeliverySummary Delivery { get; set; } = null!;

    /// <summary>Whether the chip names the channel (the history does; a channel's own drawer does not).</summary>
    [Parameter]
    public bool WithChannel { get; set; } = true;
}
