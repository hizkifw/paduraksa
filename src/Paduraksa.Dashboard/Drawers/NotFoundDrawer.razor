<DrawerShell Title="@Title" Icon="@Icons.Material.Outlined.WrongLocation" IconTone="Tone.Warning" Name="not-found">
    <ChildContent>
        <EmptyState Icon="@Icons.Material.Outlined.WrongLocation" Title="@Message" Description="It may have been deleted, or the link is wrong." />
    </ChildContent>
    <Footer>
        <DrawerActions PrimaryLabel="@BackLabel" OnPrimary="() => Level?.Cancel()" />
    </Footer>
</DrawerShell>

@code {
    [CascadingParameter]
    private DrawerLevel? Level { get; set; }

    /// <summary>"Host not found".</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>"There is no such host".</summary>
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string BackLabel { get; set; } = "Back to the list";

    /// <summary>The parameters for <see cref="DrawerStack.Push{TComponent}"/>.</summary>
    public static IReadOnlyDictionary<string, object?> For(string title, string message, string backLabel = "Back to the list") =>
        new Dictionary<string, object?>
        {
            [nameof(Title)] = title,
            [nameof(Message)] = message,
            [nameof(BackLabel)] = backLabel,
        };
}
