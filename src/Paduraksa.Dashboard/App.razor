@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en" data-theme="@_themeAttribute">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="no-referrer" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["_content/Paduraksa.Dashboard/favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/app.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/pages.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/lists.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/forms.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/drawers.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/history.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/feedback.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/auth.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/reconnect.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/rule-sets.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/controls.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/analytics.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/certificates.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/setup.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Paduraksa.Dashboard/settings.css"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" Preference="_preference" SystemPrefersLight="_systemPrefersLight" ZoneId="@_zoneId" Locale="@_locale" />
    @* Shown while the live connection is down, in place of Blazor's own dialog: Blazor puts a state class on it
       (components-reconnect-show, -retrying, -failed, ...) and paduraksa.js runs the buttons. *@
    <div id="components-reconnect-modal" class="pdk-reconnect">
        <div class="pdk-reconnect-card" role="status" aria-live="polite">
            <span class="pdk-reconnect-spinner" aria-hidden="true"></span>
            <span class="pdk-reconnect-alert" aria-hidden="true">!</span>
            <div class="pdk-reconnect-text">
                <p class="pdk-reconnect-when-show"><strong>Connection lost.</strong> Reconnecting...</p>
                <p class="pdk-reconnect-when-retrying"><strong>Still reconnecting.</strong> Next try in <span id="components-seconds-to-next-attempt"></span>s.</p>
                <p class="pdk-reconnect-when-failed"><strong>Couldn't reconnect.</strong> The server may be down or restarting.</p>
                <p class="pdk-reconnect-when-rejected"><strong>The server restarted.</strong> Reload the page to carry on.</p>
                <p class="pdk-reconnect-when-paused"><strong>This page was paused</strong> while it was idle.</p>
                <p class="pdk-reconnect-when-resume-failed"><strong>This page couldn't be resumed.</strong> Reload it to carry on.</p>
            </div>
            <button type="button" class="pdk-reconnect-action pdk-reconnect-when-retry" data-reconnect="retry">Retry now</button>
            <button type="button" class="pdk-reconnect-action pdk-reconnect-when-resume" data-reconnect="resume">Resume</button>
            <button type="button" class="pdk-reconnect-action pdk-reconnect-when-reload" data-reconnect="reload">Reload</button>
        </div>
    </div>
    <div id="blazor-error-ui" role="alert">
        The connection to the server had a problem, so this page stopped updating.
        <a href="" class="reload">Reload</a>
    </div>
    <script src="@Assets["_content/Paduraksa.Dashboard/paduraksa.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    private ThemePreference _preference;
    private bool _systemPrefersLight;
    private string? _themeAttribute;
    private string? _zoneId;
    private string? _locale;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>The app's pages are interactive (server); the sign-in and setup pages opt out and stay plain HTML forms.</summary>
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    protected override void OnInitialized()
    {
        _preference = ThemeState.ParsePreference(HttpContext.Request.Cookies[ThemeState.PreferenceCookie]);
        _systemPrefersLight = HttpContext.Request.Cookies[ThemeState.SystemSchemeCookie] == "light";
        _zoneId = HttpContext.Request.Cookies[DisplayFormat.ZoneCookie];
        _locale = HttpContext.Request.Cookies[DisplayFormat.LocaleCookie];
        _themeAttribute = _preference == ThemePreference.System ? null : ThemeState.ToCookieValue(_preference);
    }
}
