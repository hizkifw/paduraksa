@inject DrawerStack Drawers
@* My account: two-step verification. Off: set up an authenticator (the same enrolment as the first-run wizard). On: new recovery codes
   or turn it off, each behind the current password, in a drawer (TwoFactorDrawer) that holds the password and the codes. *@
<MudPaper Class="pdk-card pdk-account-card" Elevation="0" Outlined="true" data-card="two-factor" data-state="@(Enabled ? "on" : "off")">
    <div class="pdk-card-head">
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">Two-step verification</MudText>
            <MudText Typo="Typo.caption" Class="pdk-muted">A code from an authenticator app after your password, so a leaked password alone isn't enough.</MudText>
        </div>
        @if (Enabled)
        {
            <span class="pdk-badge pdk-tone-success"><MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" Style="font-size: 0.85rem" /> On</span>
        }
        else
        {
            <span class="pdk-badge pdk-tone-warning">Off</span>
        }
    </div>

    @if (Enabled)
    {
        <MudText Typo="Typo.body2" Class="mb-3">
            Signing in asks for a code from your authenticator app. If you lose it, a recovery code gets you in once.
        </MudText>
        <div class="pdk-form-actions pdk-form-actions-start">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Autorenew" OnClick="() => Open(TwoFactorStep.Regenerate)" data-action="regenerate">New recovery codes</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.LockOpen" OnClick="() => Open(TwoFactorStep.Disable)" data-action="disable-totp">Turn off</MudButton>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-3">Your account is protected by its password only.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.QrCode2" OnClick="() => Open(TwoFactorStep.Enrol)" data-action="enrol">Set up an authenticator</MudButton>
    }
</MudPaper>


@code {
    [Parameter]
    public bool Enabled { get; set; }

    [Parameter]
    public string? Username { get; set; }

    /// <summary>After the second factor was turned on or off (or new codes were made).</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private async Task Open(TwoFactorStep step)
    {
        DrawerResult result = await Drawers.OpenAsync<TwoFactorDrawer>(TwoFactorDrawer.For(step, Username), step == TwoFactorStep.Enrol ? DrawerWidth.Medium : DrawerWidth.Narrow);
        if (!result.Canceled)
        {
            await Changed.InvokeAsync();
        }
    }
}
