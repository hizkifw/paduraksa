@using Paduraksa.Application.Identity
@using Paduraksa.Contracts.Identity
@inject IDashboardIdentity Identity
@inject DashboardCaller Caller
@inject Microsoft.Extensions.Logging.ILogger<PasswordCard> Logger
@inject DashboardOptions Options
@* My account: change the password. Every other session of yours ends; the fields are emptied as the change is sent,
   whatever the answer. *@
<MudPaper Class="pdk-card pdk-account-card" Elevation="0" Outlined="true" data-card="password">
    <div class="pdk-card-head">
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">Password</MudText>
            <MudText Typo="Typo.caption" Class="pdk-muted">Changing it signs you out everywhere else.</MudText>
        </div>
    </div>

    @if (_done)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _done = false" data-result="changed">
            Password changed. Your other sessions were signed out; this one stays signed in.
        </MudAlert>
    }
    @if (_error is { } error)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3" data-result="refused">@error</MudAlert>
    }

    <form class="pdk-password-form" @onsubmit="ChangeAsync" @onsubmit:preventDefault="true" novalidate>
        <MudTextField T="string" @bind-Value="_current" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                      autocomplete="current-password" Immediate="true" Error="@(_attempted && string.IsNullOrEmpty(_current))" ErrorText="Enter your current password."
                      data-field="current-password" />
        <div>
            <MudTextField T="string" @bind-Value="_new" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                          autocomplete="new-password" Immediate="true" Error="@((_attempted || !string.IsNullOrEmpty(_new)) && NewError is not null)" ErrorText="@NewError"
                          HelperText="@($"At least {Options.MinPasswordLength} characters. A few unrelated words make a strong one.")" data-field="new-password" />
            @if (!string.IsNullOrEmpty(_new))
            {
                (int level, string label) = PasswordStrength.Of(_new, Options.MinPasswordLength);
                <div class="pdk-strength pdk-strength-@level" data-strength="@level" aria-live="polite">
                    <span class="pdk-strength-bar"><span></span><span></span><span></span><span></span></span>
                    <span class="pdk-strength-label">@label</span>
                </div>
            }
        </div>
        <MudTextField T="string" @bind-Value="_repeat" Label="New password again" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                      autocomplete="new-password" Immediate="true" Error="@((_attempted || !string.IsNullOrEmpty(_repeat)) && RepeatError is not null)" ErrorText="@RepeatError"
                      data-field="repeat-password" />
        <div class="pdk-form-actions">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" data-action="change-password">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Change password
            </MudButton>
        </div>
    </form>
</MudPaper>

@code {
    private string? _current;
    private string? _new;
    private string? _repeat;
    private bool _attempted;
    private bool _busy;
    private bool _done;
    private string? _error;

    private string? NewError =>
        string.IsNullOrEmpty(_new) ? "Enter a new password."
        : _new.EnumerateRunes().Count() < Options.MinPasswordLength ? $"At least {Options.MinPasswordLength} characters."
        : _new == _current ? "That is the password you have now."
        : null;

    private string? RepeatError => _repeat == _new ? null : "The two new passwords differ.";

    private async Task ChangeAsync()
    {
        _attempted = true;
        _done = false;
        _error = null;
        if (string.IsNullOrEmpty(_current) || NewError is not null || RepeatError is not null)
        {
            return;
        }

        ChangePasswordRequest request = new(_current, _new!);
        _current = _new = _repeat = null;
        _attempted = false;
        DashboardPrincipal? user = await Caller.CheckAsync();
        if (user is null)
        {
            return;
        }

        _busy = true;
        try
        {
            IdentityResult? result = await Identity.ChangePasswordAsync(user.Session.OriginFor(Channel.Dashboard), request, user.SessionId);
            if (result is null)
            {
                _error = IdentityText.Busy;
            }
            else if (result.Succeeded)
            {
                _done = true;
            }
            else
            {
                _error = result.Status == IdentityStatus.InvalidCredentials
                    ? "Your current password isn't right. Too many wrong tries lock the account for a while."
                    : IdentityText.Refusal(result.Status, result.Problem);
            }
        }
        catch (Exception ex) when (StoreFailures.Survivable(ex))
        {
            Logger.LogStoreFailure(ex, "Couldn't change a password.");
            _error = StoreFailures.Message("Your password couldn't be changed.");
        }
        finally
        {
            _busy = false;
        }
    }
}
