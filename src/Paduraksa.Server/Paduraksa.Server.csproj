<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Composition root: hosts the public proxy app and the admin app in one process. -->
  <PropertyGroup>
    <AssemblyName>paduraksa</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- The dashboard's components live in Paduraksa.Dashboard, so the SDK can't tell this app needs Blazor's own script
         (_framework/blazor.web.js); ask for the framework's web assets explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <!-- The build date the About page shows. A release build is reproducible: CI and the container build give the commit's timestamp as SOURCE_DATE_EPOCH (or
       -p:PaduraksaBuildDate=). A local build records only today's date: a date that changed on every build would make this project, and every project that references it, rebuild each time. -->
  <PropertyGroup>
    <PaduraksaEpochIsValid Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SOURCE_DATE_EPOCH)', '^[0-9]{1,11}$'))">true</PaduraksaEpochIsValid>
    <PaduraksaBuildDate Condition="'$(PaduraksaBuildDate)' == '' and '$(PaduraksaEpochIsValid)' == 'true'">$([System.DateTimeOffset]::FromUnixTimeSeconds($(SOURCE_DATE_EPOCH)).ToString('yyyy-MM-ddTHH:mm:ssZ'))</PaduraksaBuildDate>
    <PaduraksaBuildDate Condition="'$(PaduraksaBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</PaduraksaBuildDate>
  </PropertyGroup>
  <Target Name="CheckSourceDateEpoch" BeforeTargets="BeforeBuild;GenerateAssemblyInfo">
    <Error Condition="'$(SOURCE_DATE_EPOCH)' != '' and '$(PaduraksaEpochIsValid)' != 'true'"
           Text="SOURCE_DATE_EPOCH must be seconds since the epoch (digits only), but it is '$(SOURCE_DATE_EPOCH)'." />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(PaduraksaBuildDate)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Paduraksa.Core/Paduraksa.Core.csproj" />
    <ProjectReference Include="../Paduraksa.Data/Paduraksa.Data.csproj" />
    <ProjectReference Include="../Paduraksa.Storage/Paduraksa.Storage.csproj" />
    <ProjectReference Include="../Paduraksa.Application/Paduraksa.Application.csproj" />
    <ProjectReference Include="../Paduraksa.Proxy/Paduraksa.Proxy.csproj" />
    <ProjectReference Include="../Paduraksa.Vault/Paduraksa.Vault.csproj" />
    <ProjectReference Include="../Paduraksa.Admin/Paduraksa.Admin.csproj" />
    <ProjectReference Include="../Paduraksa.Mcp/Paduraksa.Mcp.csproj" />
    <ProjectReference Include="../Paduraksa.Dashboard/Paduraksa.Dashboard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Paduraksa.Tests.Integration" />
    <InternalsVisibleTo Include="Paduraksa.Bench.Runner" />
    <InternalsVisibleTo Include="Paduraksa.Tests.Dashboard" />
  </ItemGroup>
</Project>
