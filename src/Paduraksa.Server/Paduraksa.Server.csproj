<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Composition root: hosts the public proxy app and the admin app in one process. -->
  <PropertyGroup>
    <AssemblyName>paduraksa</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- The dashboard's components live in Paduraksa.Dashboard, so the SDK can't tell this app needs Blazor's own script
         (_framework/blazor.web.js); ask for the framework's web assets explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Paduraksa.Core/Paduraksa.Core.csproj" />
    <ProjectReference Include="../Paduraksa.Data/Paduraksa.Data.csproj" />
    <ProjectReference Include="../Paduraksa.Storage/Paduraksa.Storage.csproj" />
    <ProjectReference Include="../Paduraksa.Application/Paduraksa.Application.csproj" />
    <ProjectReference Include="../Paduraksa.Proxy/Paduraksa.Proxy.csproj" />
    <ProjectReference Include="../Paduraksa.Vault/Paduraksa.Vault.csproj" />
    <ProjectReference Include="../Paduraksa.Admin/Paduraksa.Admin.csproj" />
    <ProjectReference Include="../Paduraksa.Dashboard/Paduraksa.Dashboard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Paduraksa.Tests.Integration" />
    <InternalsVisibleTo Include="Paduraksa.Bench.Runner" />
    <InternalsVisibleTo Include="Paduraksa.Tests.Dashboard" />
  </ItemGroup>
</Project>
