<Project Sdk="Microsoft.NET.Sdk">
  <!-- Provider-neutral: the relational package, no SQLite. The [TypedId] generator is wired up for every project in Directory.Build.props, and ships in Paduraksa.TypedIds. -->
  <Import Project="../Packaging.TypedIds.props" />
  <PropertyGroup>
    <PackageId>Paduraksa.TypedIds.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core support for Paduraksa.TypedIds: one model convention maps every typed ID to a binary or integer column, with its ordering intact, and as a string inside JSON. Seeds the Int64 generator from the stored keys at startup.</Description>
    <!-- EF Core 10 only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>$(PackageTags);efcore;entity-framework-core</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Paduraksa.TypedIds/Paduraksa.TypedIds.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Internals are for the mapping tests. -->
    <InternalsVisibleTo Include="Paduraksa.TypedIds.Tests" />
  </ItemGroup>
</Project>
