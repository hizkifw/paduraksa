<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- MCP in code mode (docs/design/admin-surfaces.md "MCP in code mode (M10)"): the official SDK over streamable HTTP, and the pure managed JS interpreter that runs the model's code. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Jint" Version="4.17.0" />
    <!-- Source generator (keep at or below the SDK's Roslyn version) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Test / bench -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="bunit" Version="2.14.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Property-based tests (fixed seed, bounded cases) and coverage-guided fuzzing (instrumented with the sharpfuzz tool). -->
    <PackageVersion Include="CsCheck" Version="5.0.0" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>
</Project>
