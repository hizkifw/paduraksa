<Project>
  <!-- The vault's in-memory password registry (hash, cache, handles) compiled into a test project, so tests that need the capability
       without a vault database run the real verifier and cache, not a look-alike. The sources are internal to the vault; here they
       are internal to the test assembly. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)TestPasswords.cs" Link="Shared/TestPasswords.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../src/Paduraksa.Vault/Passwords/PasswordHash.cs" Link="Shared/Vault/PasswordHash.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../src/Paduraksa.Vault/Passwords/PasswordVerificationCache.cs" Link="Shared/Vault/PasswordVerificationCache.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../src/Paduraksa.Vault/Passwords/PasswordCredentialSlot.cs" Link="Shared/Vault/PasswordCredentialSlot.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../src/Paduraksa.Vault/Passwords/PasswordRegistry.cs" Link="Shared/Vault/PasswordRegistry.cs" />
  </ItemGroup>
</Project>
