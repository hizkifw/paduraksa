<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <!-- KeyMaterialBanTests compiles probes with Roslyn and runs the real BannedApiAnalyzers on them. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BannedApiAnalyzersDirectory</_Parameter1>
      <_Parameter2>$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Paduraksa.Core/Paduraksa.Core.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Contracts/Paduraksa.Contracts.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Data/Paduraksa.Data.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Application/Paduraksa.Application.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Proxy/Paduraksa.Proxy.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Vault/Paduraksa.Vault.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Acme/Paduraksa.Acme.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Admin/Paduraksa.Admin.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Dashboard/Paduraksa.Dashboard.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Server/Paduraksa.Server.csproj" />
  </ItemGroup>
</Project>
