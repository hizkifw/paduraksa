<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Generator tests drive TypedIdGenerator directly via CSharpGeneratorDriver. -->
    <PaduraksaIdsGeneratorReferenceOutputAssembly>true</PaduraksaIdsGeneratorReferenceOutputAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Paduraksa.Core/Paduraksa.Core.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Contracts/Paduraksa.Contracts.csproj" />
    <!-- Pure Application logic: the config document, the audit chain encoding. -->
    <ProjectReference Include="../../src/Paduraksa.Application/Paduraksa.Application.csproj" />
    <!-- The admin app's pure pieces: the source allowlist, the sign-in throttle, the cookie reader, the HTTP JSON contract. -->
    <ProjectReference Include="../../src/Paduraksa.Admin/Paduraksa.Admin.csproj" />
    <ProjectReference Include="../../src/Paduraksa.Mcp/Paduraksa.Mcp.csproj" />
    <Compile Include="../Shared/TestPermissions.cs" Link="Shared/TestPermissions.cs" />
  </ItemGroup>
  <Import Project="../Shared/TestPasswords.props" />
  <ItemGroup>
    <Compile Include="../Shared/TestMapping.cs" Link="Shared/TestMapping.cs" />
    <Compile Include="../Shared/Property.cs" Link="Shared/Property.cs" />
    <Compile Include="../Shared/McpTestSpec.cs" Link="Shared/McpTestSpec.cs" />
    <Using Include="Paduraksa.Tests.Shared" />
  </ItemGroup>
</Project>
