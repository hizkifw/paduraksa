<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Known vulnerabilities in packages (threat model G9). Restore reports moderate and worse in direct and transitive packages; with TreatWarningsAsErrors every
         one would fail the build, so the choice is made here: high and critical (NU1903, NU1904) always fail, and a moderate one (NU1902) stays a warning in the
         log, because a moderate advisory with no fixed release yet would otherwise stop every build, the Dependabot pull request that updates the package included. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902</WarningsNotAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <Authors>Hizkia Felix</Authors>
    <Product>Paduraksa</Product>
    <Copyright>Copyright 2026 Hizkia Felix</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Per-project BannedSymbols.txt (trust boundary + TypedId enforcement), plus a repo-wide list. -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="BannedSymbols.txt" Condition="Exists('BannedSymbols.txt')" />
    <!-- Trust boundary: only projects that set PaduraksaKeyMaterialBoundary=true may touch key material.
         (Item conditions are evaluated after all properties, so the csproj can set this.)
         Entries are exact doc-IDs: an M: line without parameters bans only the parameterless overload, so every
         overload is listed. KeyMaterialBanTests (architecture tests) checks coverage and runs the analyzer. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.KeyMaterial.txt"
                     Condition="'$(PaduraksaKeyMaterialBoundary)' != 'true'" />
  </ItemGroup>

  <!-- Typed IDs can be declared in any assembly (Core, Data, Contracts, tests...), so every project gets the
       [TypedId] source generator as an analyzer. It's a no-op where no [TypedId] is used. Opt out with
       PaduraksaIdsGenerator=false; set PaduraksaIdsGeneratorReferenceOutputAssembly=true to also reference the
       generator assembly (generator tests). -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true' and '$(PaduraksaIdsGenerator)' != 'false'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Paduraksa.Ids.Generator/Paduraksa.Ids.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="$([MSBuild]::ValueOrDefault('$(PaduraksaIdsGeneratorReferenceOutputAssembly)', 'false'))" />
  </ItemGroup>
</Project>
