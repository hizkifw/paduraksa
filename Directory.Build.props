<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <Authors>Hizkia Felix</Authors>
    <Product>Paduraksa</Product>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- Per-project BannedSymbols.txt (trust boundary + TypedId enforcement), plus a repo-wide list. -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="BannedSymbols.txt" Condition="Exists('BannedSymbols.txt')" />
    <!-- Trust boundary: only projects that set PaduraksaKeyMaterialBoundary=true may touch key material.
         (Item conditions are evaluated after all properties, so the csproj can set this.) -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.KeyMaterial.txt"
                     Condition="'$(PaduraksaKeyMaterialBoundary)' != 'true'" />
  </ItemGroup>
</Project>
