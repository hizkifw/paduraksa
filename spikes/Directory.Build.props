<Project>
  <!--
    Spikes are throwaway experiments, not product code. They import the repo-wide settings
    (TFM, nullable, central package management) but relax them so an experiment is never
    blocked by product rules:
      * warnings are not errors; the .NET analyzers (AnalysisLevel none), code-style
        enforcement and XML docs are off;
      * the banned-API analyzer is still imported, but its hits (RS0030) are silenced. That
        covers both the repo-wide list (e.g. Guid.NewGuid) and the key-material list: spikes
        legitimately generate / load / export certificates and keys (S1 builds a throwaway CA
        in-process). None of this code ships.
    Spike projects must never be added to Paduraksa.slnx.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>
</Project>
